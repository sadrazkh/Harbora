<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The one test project that references both codebases, and the reason it exists.

    Harbora.NodeAgent.Tests is deliberately free of EF Core, ASP.NET and everything else the panel
    drags in; Harbora.Tests is deliberately free of the agent. Neither can host a test that runs the
    real gateway and the real agent against each other, and adding the missing half to either would
    undo the isolation both were arranged for.

    So the seam gets its own project. Everything here is an end-to-end test across the two: real
    sockets, real TLS, real framing, real HTTP.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Harbora.NodeIngress.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Harbora.Data\Harbora.Data.csproj" />
    <ProjectReference Include="..\..\src\Harbora.Infrastructure\Harbora.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Harbora.NodeAgent\Harbora.NodeAgent.csproj" />
    <ProjectReference Include="..\..\src\Harbora.NodeAgent.Contracts\Harbora.NodeAgent.Contracts.csproj" />
  </ItemGroup>

</Project>
