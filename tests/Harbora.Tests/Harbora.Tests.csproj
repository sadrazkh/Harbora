<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.4" />
    <!--
      The HTTP lane (tests/Harbora.Tests/Http) boots Harbora.Web's real pipeline in-process through
      WebApplicationFactory. Everything else in this project exercises classes directly; this is the
      only reference that needs a server.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.4" />
    <!--
      A real HTML5 parser for the one class of bug a string match cannot see: which <form> a button
      actually belongs to. The nested-form defect that shipped in EditFunction.cshtml was invisible to
      any assertion over the Razor output — the inner <form> tag *is* in the file — because a
      spec-compliant parser silently drops it. Asking AngleSharp what it built is the only way to have
      caught that, and the only way a regression in the fix would be caught again.
    -->
    <PackageReference Include="AngleSharp" Version="1.7.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Harbora.Domain\Harbora.Domain.csproj" />
    <ProjectReference Include="..\..\src\Harbora.Application\Harbora.Application.csproj" />
    <ProjectReference Include="..\..\src\Harbora.Infrastructure\Harbora.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Harbora.Data\Harbora.Data.csproj" />
    <ProjectReference Include="..\..\src\Harbora.Web\Harbora.Web.csproj" />
    <ProjectReference Include="..\..\src\Harbora.Cli\Harbora.Cli.csproj" />
    <ProjectReference Include="..\..\src\Harbora.NodeAgent.Contracts\Harbora.NodeAgent.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Backup\Harbora.Modules.Backup.Contracts\Harbora.Modules.Backup.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Backup\Harbora.Modules.Backup.Domain\Harbora.Modules.Backup.Domain.csproj" />
    <ProjectReference Include="..\..\src\Modules\Backup\Harbora.Modules.Backup.Infrastructure\Harbora.Modules.Backup.Infrastructure.csproj" />
  </ItemGroup>

</Project>
