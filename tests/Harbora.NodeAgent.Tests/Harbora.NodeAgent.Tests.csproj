<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kept separate from Harbora.Tests on purpose: the node agent has no EF Core, no ASP.NET and no
    panel dependencies, and its test project should not acquire them by proximity. A test that can
    only pass because the panel's DI container happened to be in the room is not testing the agent.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Harbora.NodeAgent.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Harbora.NodeAgent.Contracts\Harbora.NodeAgent.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Harbora.NodeAgent\Harbora.NodeAgent.csproj" />
  </ItemGroup>

</Project>
