  "payload": {
    "spec": {
      "workloadId": "wl-7f2a91",
      "name": "acme-api",
      "tenantId": "ws-acme",
      "appId": "acme-api",
      "appVersion": "1.14.0",
      "supportedArchitectures": ["amd64", "arm64"],
      "minimumAgentVersion": "0.2.0",
      "containers": [
        {
          "name": "api",
          "image": {
            "repository": "registry.example.com/acme/api",
            "tag": "1.14.0",
            "digest": "sha256:9b2c1f4d7e8a0b3c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c"
          },
          "env": { "ASPNETCORE_ENVIRONMENT": "Production", "LOG_LEVEL": "info" },
          "secrets": [
            { "name": "ConnectionStrings__Default", "value": "REDACTED-AT-REST", "mountAs": "environment" }
          ],
          "ports": [{ "containerPort": 8080, "protocol": "tcp", "publishToHost": false }],
          "mounts": [{ "volumeName": "acme-api-data", "mountPath": "/var/lib/app", "readOnly": false }],
          "networkAliases": ["api"],
          "resources": { "cpuCores": 1.0, "memoryBytes": 1073741824, "memoryReservationBytes": 268435456, "pidsLimit": 512 },
          "healthCheck": {
            "kind": "http",
            "path": "/healthz",
            "port": 8080,
            "intervalSeconds": 10,
            "timeoutSeconds": 5,
            "retries": 5,
            "startPeriodSeconds": 20,
            "expectedStatus": 200
          },
          "restartPolicy": { "mode": "unlessStopped" },
          "readOnlyRootFilesystem": true,
          "capabilitiesDrop": ["ALL"],
          "privileged": false,
          "hostNetwork": false,
          "hostPidNamespace": false,
          "stopGracePeriodSeconds": 15
        }
      ],
      "networks": [{ "name": "harbora-ws-acme", "internal": false }],
      "volumes": [{ "name": "acme-api-data", "persistent": true }],
      "httpRoutes": [
        {
          "routeId": "rt-acme-api",
          "domain": "api.acme.example.com",
          "targetContainer": "api",
          "targetPort": 8080,
          "tls": true,
          "redirectHttpToHttps": true,
          "webSocket": false
        }
      ],
      "upgrade": { "mode": "blueGreen", "healthGraceSeconds": 90, "autoRollbackOnFailure": true },
      "labels": { "harbora.app": "acme-api" }
    },
    "dryRun": false
  }
