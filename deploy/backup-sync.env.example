# Harbora Backup & Sync — environment for deploy/backup-sync.compose.yml.
#
# Append to deploy/.env. Committing a filled-in copy of this file commits a Syncthing API key, which
# is a credential for a daemon that can read every synced file. Keep .env out of git — it already is.

# ---------------------------------------------------------------------------------------------
# Feature flags — both OFF until deliberately switched on
# ---------------------------------------------------------------------------------------------
# Enabling Backup adds the Backup Center page and starts the policy scheduler.
FEATURE_BACKUP=false
# Enabling Sync adds the Sync page and starts the status refresher.
FEATURE_SYNC=false
# EXPERIMENTAL. Lets a node be added to a space as an untrusted, ciphertext-only device. The
# guarantee comes from Syncthing's untrusted-device support, not from Harbora, and the failure mode
# — the node quietly holding plaintext — is not something Harbora can detect. Leave off unless you
# have tested the arrangement yourself.
FEATURE_ENCRYPTED_SYNC_NODE=false

# ---------------------------------------------------------------------------------------------
# Image versions — pinned, never `latest`
# ---------------------------------------------------------------------------------------------
# These tags were NOT verified against a registry from the machine this branch was written on.
# Confirm they exist, then repin by digest:
#   docker image inspect syncthing/syncthing:$SYNCTHING_VERSION --format '{{index .RepoDigests 0}}'
SYNCTHING_VERSION=1.27.9
KOPIA_VERSION=0.17.0

# ---------------------------------------------------------------------------------------------
# Syncthing
# ---------------------------------------------------------------------------------------------
# REQUIRED. How Harbora authenticates to Syncthing's REST API.
#   openssl rand -hex 32
SYNCTHING_API_KEY=

# Runs as this uid/gid, which must own SYNC_DATA_PATH and the config volume.
SYNCTHING_UID=1000
SYNCTHING_GID=1000

# Admin API. Published to LOOPBACK ONLY by the compose file — changing the host part of that binding
# publishes a second, separately-authenticated way into every synced file. Don't.
SYNCTHING_API_PORT=8384

# Sync protocol. This one IS meant to be reachable: it is TLS with mutual device-id authentication,
# and closing it does not make anything safer — it forces transfers through a public relay instead,
# which is slower and puts a third party on the path.
SYNCTHING_SYNC_PORT=22000

# LAN discovery. Remove the mapping from the compose file entirely if devices are not on one LAN.
SYNCTHING_DISCOVERY_PORT=21027

# Where synced folders live on the host. Mounted by BOTH Syncthing and the panel, at the same path,
# because Harbora scans the directory itself to find conflict files.
# Must match Sync:Module:AllowedRoots.
SYNC_DATA_PATH=/srv/harbora/sync

# Sample limits. A first scan of a large folder is genuinely memory-hungry — raise rather than
# remove, and watch the container before deciding.
SYNCTHING_CPU_LIMIT=1.0
SYNCTHING_MEMORY_LIMIT=1g
