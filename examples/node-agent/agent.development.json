{
  "//": [
    "A development configuration for running the node agent against a panel on localhost.",
    "Copy to /etc/harbora-node/agent.conf on a real node, or pass it with:",
    "  dotnet run --project src/Harbora.NodeAgent -- --config examples/node-agent/agent.development.json",
    "",
    "The two Security switches below are development-only and the agent validates them as such."
  ],

  "Logging": {
    "LogLevel": {
      "Default": "Debug"
    }
  },

  "NodeAgent": {
    "ControlPlaneUrl": "http://localhost:5000",
    "EnrollmentToken": "dev-enrollment-token",
    "NodeName": "dev-node-01",
    "Region": "local",
    "Environment": "development",
    "Labels": {
      "tier": "dev"
    },

    "DataDirectory": "/tmp/harbora-node-dev",
    "DockerHost": "unix:///var/run/docker.sock",
    "MaintenanceImage": "docker.io/library/busybox:1.36",
    "ArtifactTransferImage": "docker.io/curlimages/curl:8.10.1",

    "HeartbeatIntervalSeconds": 10,
    "MaxConcurrentCommands": 2,
    "IdempotencyRetentionHours": 1,

    "TunnelGatewayUrl": "localhost:8443",

    "Reconnect": {
      "InitialDelayMs": 500,
      "MaxDelayMs": 10000,
      "Multiplier": 2.0,
      "Jitter": true
    },

    "Metrics": {
      "Enabled": true,
      "BindAddress": "127.0.0.1",
      "Port": 9701
    },

    "Security": {
      "//": "Both of these are refused in a production configuration check. The enrollment token travels over the control-plane connection, which is why plain http needs an explicit opt-in.",
      "AllowInsecureControlPlane": true,
      "TrustAnyControlPlaneCertificate": false,

      "//privileged": "Left off even in development, so a dev run exercises the same refusals a node does.",
      "AllowPrivilegedWorkloads": false,
      "AllowIsolatedDockerWorkspace": false
    },

    "Ports": {
      "Start": 31000,
      "End": 31999
    },

    "Workspace": {
      "CpuCores": 1.0,
      "MemoryBytes": 1073741824,
      "PidsLimit": 512,
      "DiskBytes": 5368709120,
      "NetworkIsolated": true
    }
  }
}
