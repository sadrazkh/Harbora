<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Harbora node agent: a headless service installed on customer and infrastructure servers.

    Deliberately not a web project. The agent listens on nothing except a loopback metrics port,
    because "installing a node opens no inbound port" is a property of the install, not a
    configuration option — and a project that can serve HTTP eventually does.

    Dependencies are held to the container runtime and the hosting primitives. Everything the panel
    needs (EF Core, AWS SDK, LibGit2Sharp) would be dead weight on a 1 GB VPS and extra surface on a
    process that runs as root.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>harbora-node-agent</AssemblyName>
    <RootNamespace>Harbora.NodeAgent</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Release builds are self-contained single files; a node must not need a .NET runtime. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>

    <!-- Test project reaches into internals rather than widening the public surface for tests. -->
    <EnableDefaultNoneItems>true</EnableDefaultNoneItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harbora.NodeAgent.Contracts\Harbora.NodeAgent.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Docker.DotNet" Version="3.125.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Harbora.NodeAgent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
