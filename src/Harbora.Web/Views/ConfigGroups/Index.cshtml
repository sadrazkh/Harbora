@model ConfigGroupsPageViewModel
@{
    ViewData["Title"] = "Config groups";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var err = TempData["Error"] as string;
    var msg = TempData["Message"] as string;
}
<div class="mb-6">
    <partial name="Design/_PageHeader" model="@(new PageHeaderModel(
        isFa ? "گروه‌های متغیر مشترک" : "Config groups",
        isFa
            ? "یک بار تعریف کنید، به هر اپی که لازم دارد وصل کنید. مقدار خودِ اپ همیشه برنده است."
            : "Define once, attach to every app that needs it. An app's own value always wins."))" />
</div>

@if (err is not null)
{
    <div class="alert-warning rounded-lg px-4 py-3 text-sm mb-4">@err</div>
}
@if (msg is not null)
{
    <div class="rounded-lg bg-ok-soft text-ok px-4 py-3 text-sm mb-4">@msg</div>
}

<section class="rounded-xl border border-line bg-surface p-5 mb-6" data-config-groups>
    <h2 class="text-sm font-semibold mb-3">@(isFa ? "گروه‌ها" : "Groups")</h2>

    @if (Model.Groups.Count == 0)
    {
        <partial name="Design/_EmptyState" model="@(new EmptyStateModel("layers-3",
            isFa ? "هنوز گروهی ساخته نشده است." : "No config groups yet."))" />
    }
    else
    {
        <div class="space-y-3 mb-5">
            @foreach (var g in Model.Groups)
            {
                var apps = Model.AttachedApps.TryGetValue(g.Id, out var list) ? list : [];
                var staleCount = apps.Count(a => a.HasUnpublishedChanges);
                <div class="rounded-lg bg-surface-2 px-3 py-3 text-sm" data-config-group-row data-config-group-id="@g.Id" data-config-group-name="@g.Name">
                    <div class="flex items-center justify-between gap-2">
                        <div>
                            <span class="font-semibold">@g.Name</span>
                            <span class="text-ink-faint">
                                · @(isFa ? $"{g.EntryCount} متغیر" : $"{g.EntryCount} variable(s)")
                                @if (g.SecretCount > 0)
                                {
                                    @(isFa ? $" ({g.SecretCount} رمز)" : $" ({g.SecretCount} secret)")
                                }
                            </span>
                        </div>
                        <form asp-controller="ConfigGroups" asp-action="Delete" asp-route-id="@g.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button class="text-xs text-danger" aria-label="@(isFa ? $"حذف {g.Name}" : $"Delete {g.Name}")">✕</button>
                        </form>
                    </div>

                    @* The group page lists which apps will pick the change up — the plan's own words for
                       why editing a group must never restart anything by itself. *@
                    <div class="mt-2 text-xs" data-config-group-apps>
                        @if (apps.Count == 0)
                        {
                            <span class="text-ink-faint">@(isFa ? "به هیچ اپی متصل نیست." : "Not attached to any app.")</span>
                        }
                        else
                        {
                            <span class="text-ink-faint">@(isFa ? "متصل به:" : "Attached to:")</span>
                            @foreach (var a in apps)
                            {
                                <span class="ms-1 inline-flex items-center gap-1 rounded bg-surface px-1.5 py-0.5" data-attached-app="@a.AppName" data-attached-app-stale="@(a.HasUnpublishedChanges ? "true" : "false")">
                                    @a.AppName
                                    @if (a.HasUnpublishedChanges)
                                    {
                                        <span class="rounded bg-warn-soft px-1 text-warn" title="@(isFa ? "با استقرار بعدی اعمال می‌شود" : "Applies on next deploy")">●</span>
                                    }
                                </span>
                            }
                            @if (staleCount > 0)
                            {
                                <p class="mt-1 text-warn">
                                    @(isFa
                                        ? $"{staleCount} اپ هنوز نسخهٔ قدیمی این گروه را اجرا می‌کند؛ با استقرار بعدی به‌روز می‌شود."
                                        : $"{staleCount} app(s) are still running an older version of this group — it applies on their next deploy.")
                                </p>
                            }
                        }
                    </div>

                    <div class="mt-2 divide-y divide-line border-t border-line font-mono">
                        @foreach (var e in Model.Entries.Where(x => x.ConfigGroupId == g.Id))
                        {
                            <div class="flex items-center justify-between py-1.5 text-xs" data-config-entry data-config-entry-key="@e.Key" data-config-entry-secret="@(e.IsSecret ? "true" : "false")">
                                <span>@e.Key @if (e.IsSecret){<span class="text-[10px] not-italic rounded bg-surface px-1 text-warn font-sans">secret</span>}</span>
                                <div class="flex items-center gap-2">
                                    <span class="text-ink-faint">@(e.IsSecret ? "••••••" : e.Value)</span>
                                    <form asp-controller="ConfigGroups" asp-action="DeleteEntry" asp-route-id="@g.Id" asp-route-entryId="@e.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button class="text-danger" aria-label="@(isFa ? $"حذف {e.Key}" : $"Delete {e.Key}")">✕</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                    <form asp-controller="ConfigGroups" asp-action="AddEntry" asp-route-id="@g.Id" method="post" class="mt-2 grid grid-cols-1 sm:grid-cols-5 gap-2">
                        @Html.AntiForgeryToken()
                        <input name="key" placeholder="KEY" class="sm:col-span-2 rounded-lg bg-surface border border-line-strong px-2 py-1.5 text-xs font-mono" />
                        <input name="value" placeholder="value" class="sm:col-span-2 rounded-lg bg-surface border border-line-strong px-2 py-1.5 text-xs font-mono" />
                        <label class="flex items-center gap-1 text-xs"><input type="checkbox" name="isSecret" value="true"> @(isFa ? "رمز" : "secret")</label>
                        <button class="sm:col-span-5 rounded-lg bg-accent hover:bg-accent-hover text-white px-3 py-1.5 text-xs font-semibold w-fit">+ @(isFa ? "افزودن متغیر" : "Add variable")</button>
                    </form>
                </div>
            }
        </div>
    }

    <details>
        <summary class="cursor-pointer text-sm text-accent-text">+ @(isFa ? "گروه تازه" : "New group")</summary>
        <form asp-controller="ConfigGroups" asp-action="Create" method="post" class="mt-3 flex gap-2">
            @Html.AntiForgeryToken()
            <input name="name" placeholder="@(isFa ? "نام گروه" : "Group name")" class="flex-1 rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            <button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm font-semibold">
                @(isFa ? "ایجاد گروه" : "Create group")
            </button>
        </form>
    </details>
</section>
