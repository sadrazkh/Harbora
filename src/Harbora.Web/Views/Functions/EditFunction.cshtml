@model FunctionEditViewModel
@using Harbora.Domain.Functions
@using Harbora.Infrastructure.Functions
@{
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var isNew = Model.FunctionId is null;
    var extension = FunctionStarters.Extension(Model.Runtime);
}

<div class="mb-5">
    <div class="text-xs text-ink-faint">
        <a href="/functions" class="hover:text-ink">@(isFa ? "فانکشن‌ها" : "Functions")</a> ·
        <a href="/functions/@Model.AppId" class="hover:text-ink">@Model.AppName</a>
    </div>
    <h1 class="text-2xl font-bold tracking-tight text-ink">
        @(isNew ? (isFa ? "فانکشن تازه" : "New function") : Model.Form.Name)
    </h1>
</div>

<form method="post" action="/functions/@Model.AppId/save" class="grid gap-5 xl:grid-cols-3">
    @Html.AntiForgeryToken()
    @if (Model.FunctionId is { } id) { <input type="hidden" name="functionId" value="@id" /> }

    <div class="space-y-4 xl:col-span-2">
        <div asp-validation-summary="All" class="text-sm text-danger"></div>

        <div class="rounded-2xl border border-line bg-surface p-4 shadow-panel">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-xs font-medium uppercase tracking-wide text-ink-faint" dir="ltr">
                    @(string.IsNullOrWhiteSpace(Model.Form.Name) ? "function" : FunctionSlug.Normalise(Model.Form.Name)).@extension
                </span>
                <span class="text-xs text-ink-faint">@FunctionStarters.Label(Model.Runtime)</span>
            </div>
            @* A plain textarea, monospace and LTR whatever the panel's direction is — code is not
               prose, and an RTL editor mangles it. The island below (main.ts, CodeEditor.vue)
               mounts a trimmed, lazily-loaded CodeMirror over it and keeps this element's value in
               sync as the source of truth for the form post; this textarea is the fallback if that
               script never loads, not a placeholder for it — it is complete and correct on its
               own. *@
            <div id="function-code-editor" data-island="function-code-editor"
                 data-runtime="@Model.Runtime" data-lang="@(isFa ? "fa" : "en")">
                <textarea id="function-code" name="Code" rows="22" spellcheck="false" dir="ltr" required
                          class="w-full resize-y rounded-xl border border-line bg-canvas p-4 font-mono text-[13px] leading-relaxed text-ink focus:border-accent focus:outline-none">@Model.Form.Code</textarea>
            </div>
        </div>

        @if (Model.Runs is { Count: > 0 })
        {
            <div class="overflow-hidden rounded-2xl border border-line bg-surface shadow-panel">
                <div class="border-b border-line px-4 py-3 text-sm font-semibold text-ink">
                    @(isFa ? "اجراهای اخیر" : "Recent runs")
                </div>
                <table class="w-full text-sm">
                    <tbody>
                    @foreach (var run in Model.Runs)
                    {
                        <tr class="border-t border-line">
                            @* Second precision: two runs of the same schedule inside one minute is the
                               case somebody is looking at this table to understand. *@
                            <td class="px-4 py-2 text-xs text-ink-muted" dir="ltr">@run.StartedAt.LocalDateTime.ToString(Dates.Precise)</td>
                            <td class="px-4 py-2 text-xs text-ink-faint">
                                @run.Trigger
                                @* F1 reversal (2026-08-21 functions-and-services plan follow-up): a row
                                   nobody at the panel watched happen must say so, not blend in with one
                                   the panel made and observed itself. data-run-origin is the
                                   language-independent hook — the panel renders Persian by default in
                                   tests. *@
                                @if (run.Origin == FunctionInvocationOrigin.PublicCall)
                                {
                                    <span data-run-origin="public-call" class="ms-1 rounded bg-surface-2 px-1 py-0.5 text-[10px] text-ink-faint" title="@(isFa
                                        ? "پنل این تماس را ندید — خودِ فانکشن پس از پاسخ‌دادن، این را گزارش کرد."
                                        : "The panel never saw this call — the function reported it back itself after answering.")">
                                        @(isFa ? "گزارش‌شده" : "reported")
                                    </span>
                                }
                                else
                                {
                                    <span data-run-origin="panel" class="sr-only"></span>
                                }
                            </td>
                            <td class="px-4 py-2 text-xs">
                                @if (run.StillRunning)
                                {
                                    <span class="text-ink-faint">@(isFa ? "در صف" : "queued")</span>
                                }
                                else if (run.Succeeded)
                                {
                                    <span class="text-ok">@run.StatusCode @(run.DurationMs)ms</span>
                                }
                                else
                                {
                                    <span class="text-danger">@(run.StatusCode?.ToString() ?? "—") @run.Error</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <aside class="space-y-4">
        <div class="space-y-4 rounded-2xl border border-line bg-surface p-5 shadow-panel">
            <label class="form-field">
                <span>@(isFa ? "نام" : "Name")</span>
                <input name="Name" value="@Model.Form.Name" required maxlength="60" class="form-control"
                       placeholder="@(isFa ? "مثلاً: send-report" : "e.g. send-report")" />
            </label>

            <label class="form-field">
                <span>@(isFa ? "تریگر" : "Trigger")</span>
                <select name="Trigger" class="form-control" data-trigger>
                    <option value="@((int)FunctionTrigger.Http)" selected="@(Model.Form.Trigger == FunctionTrigger.Http)">HTTP</option>
                    <option value="@((int)FunctionTrigger.Cron)" selected="@(Model.Form.Trigger == FunctionTrigger.Cron)">@(isFa ? "زمان‌بندی" : "Schedule")</option>
                    <option value="@((int)FunctionTrigger.Event)" selected="@(Model.Form.Trigger == FunctionTrigger.Event)">@(isFa ? "رویداد" : "Event")</option>
                    <option value="@((int)FunctionTrigger.Queue)" selected="@(Model.Form.Trigger == FunctionTrigger.Queue)">@(isFa ? "صف" : "Queue")</option>
                </select>
            </label>

            <label class="form-field" data-when="@((int)FunctionTrigger.Http)">
                <span>@(isFa ? "مسیر (اختیاری)" : "Route (optional)")</span>
                <input name="Route" value="@Model.Form.Route" class="form-control font-mono" dir="ltr"
                       placeholder="@(isFa ? "خالی = نام فانکشن" : "blank = the function name")" />
            </label>

            @* Only an HTTP trigger ever sits behind the visitor route this flag gates — the controller
               forces it off for Cron/Event regardless of what is posted here, so hiding it for those
               triggers matches what the server actually does with it. The warning text sits beside the
               checkbox itself, unconditionally, so it is read before the box is ever checked — not
               revealed afterward as a surprise. *@
            <div class="space-y-2 rounded-xl border border-line bg-surface-2 p-3" data-when="@((int)FunctionTrigger.Http)">
                <label class="flex items-center gap-2.5 text-sm text-ink">
                    <input type="checkbox" name="IsPublic" value="true" checked="@Model.Form.IsPublic" data-public-toggle />
                    <span>@(isFa ? "عمومی" : "Public")</span>
                </label>
                <input type="hidden" name="IsPublic" value="false" />
                <p class="text-xs text-ink-muted" data-public-warning>
                    @(isFa
                        ? "هرکسی در اینترنت می‌تواند این آدرس را بدون کلید یا امضا صدا بزند. خاموش (پیش‌فرض) یعنی فقط پنل — زمان‌بندی، رویدادها و «اجرا کن» — می‌تواند این فانکشن را صدا بزند."
                        : "Anyone on the internet can call this URL — no key, no signature required. Off (the default) means only the panel — schedules, events, and Run now — can reach this function.")
                </p>

                @if (Model.Form.IsPublic)
                {
                    if (Model.FunctionUrl is { } functionUrl)
                    {
                        <div class="connection-string" data-function-url>
                            <code id="functionUrl" dir="ltr" class="text-sm font-semibold">@functionUrl</code>
                            <button type="button" data-copy-function-url title="@(isFa ? "کپی" : "Copy")">
                                <i data-lucide="copy" class="h-4 w-4"></i>
                            </button>
                        </div>
                        @* The owner made this, made it public, published it, and still could not tell
                           whether it worked — because the box that showed the address never said what it
                           was for, and there was nothing to run to prove it. Both gaps close here: one
                           sentence naming the ordinary uses (a webhook, a payment callback, a Telegram
                           bot), and — once the address is actually live — a one-line curl a person can
                           paste without composing anything by hand. *@
                        <p class="text-xs text-ink-muted" data-function-url-usage>
                            @(isFa
                                ? "همین آدرس را به یک وب‌هوک، بازگشت پرداخت یا ربات تلگرام بدهید — هرکسی که آن را داشته باشد می‌تواند فانکشن شما را صدا بزند."
                                : "Give this exact address to a webhook, a payment callback, or a Telegram bot — anyone who has it can call your function.")
                        </p>
                        @* The address is real the moment it is copied, but it only answers once the image
                           behind it is the one on screen — exposure ships on publish like every other
                           function change. Saying so here is the same honesty the "Run now" panel already
                           gives the published-code question. Same warn-soft chip as the "never-published" /
                           "stale" notes beside Run now further down this page — one visual language for
                           "this button/address will not do what it looks like it does yet", not a second one
                           invented here. *@
                        @if (!Model.IsPublished || Model.HasUnpublishedChanges)
                        {
                            <p class="rounded-lg bg-warn-soft px-3 py-2 text-xs text-warn" data-function-url-not-live>
                                @(isFa
                                    ? "تا وقتی «انتشار» را نزنید، این آدرس پاسخی نمی‌دهد."
                                    : "This address answers nothing until you press Publish.")
                            </p>
                        }
                        else
                        {
                            @* Only shown once the deployed image is actually the one this page describes —
                               a curl against an unpublished or stale address would fail for a reason that
                               has nothing to do with the command, which is exactly the confusion this whole
                               feature exists to remove. .cli-callout is the existing "here is a command,
                               copy it" idiom (Apps/Create.cshtml's `harbora deploy <slug>`), reused rather
                               than inventing a second box style for the same idea. *@
                            <div class="cli-callout" data-function-url-curl>
                                <i data-lucide="terminal-square" class="h-5 w-5"></i>
                                <div>
                                    <strong>@(isFa ? "همین حالا امتحانش کنید" : "Try it right now")</strong>
                                    <code dir="ltr" data-copy-text>curl -X POST @functionUrl</code>
                                    <small>
                                        @(isFa
                                            ? "این را در ترمینال کپی کنید تا پاسخ فانکشن‌تان را ببینید."
                                            : "Copy this into a terminal and watch your function answer.")
                                    </small>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-xs text-ink-faint" data-function-url-pending>
                            @(isFa
                                ? "این اپ هنوز آدرسی ندارد یا منتشر نشده — بعد از انتشار، لینک دقیق اینجا نشان داده می‌شود."
                                : "This app has no address yet, or has never been published — the exact link appears here once it does.")
                        </p>
                    }

                    @* F1 reversal (2026-08-21 functions-and-services plan follow-up): this used to say a
                       public call is never recorded here — that was the wrong call, reversed. The
                       function itself now reports each one back right after it answers, fire-and-forget,
                       marked "reported" above so it never blends in with a call the panel actually
                       watched. Still honest about the gap that leaves: the report can be lost (a panel
                       mid-restart, mid-deploy) without the visitor's own call failing, so this still
                       points at the app's Logs for the complete account. *@
                    <p class="text-xs text-ink-faint" data-public-history-note>
                        @(isFa
                            ? "تماس‌های عمومی هم اینجا ثبت می‌شوند — خودِ فانکشن، بلافاصله پس از پاسخ‌دادن، آن را به‌صورت best-effort گزارش می‌کند (برچسب «گزارش‌شده» در جدول بالا). اگر همان لحظه پنل در دسترس نبود، گزارشی ثبت نمی‌شود — بدون این‌که پاسخ به بازدیدکننده تأخیر بیفتد یا شکست بخورد. برای فهرست کامل هر تماس، در هر حال، "
                            : "Public calls are recorded here too — the function reports each one back, best-effort, right after it answers (tagged \"reported\" in the table above). If the panel was unreachable at that exact moment, there is simply no row for it — the visitor's own response never waits on this or fails because of it. For the complete account of every call regardless, ")
                        <a href="/apps/@Model.AppId/logs" class="text-accent-text hover:underline">@(isFa ? "لاگ‌های اپ" : "the app's Logs")</a>
                        @(isFa ? " هنوز هم در دسترس است." : " still has it.")
                    </p>
                }
            </div>

            <label class="form-field" data-when="@((int)FunctionTrigger.Cron)">
                <span>@(isFa ? "زمان‌بندی (cron پنج‌بخشی)" : "Schedule (five-field cron)")</span>
                <input name="CronExpression" value="@Model.Form.CronExpression" class="form-control font-mono" dir="ltr"
                       placeholder="0 3 * * *" />
            </label>

            <label class="form-field" data-when="@((int)FunctionTrigger.Event)">
                <span>@(isFa ? "رویداد" : "Event")</span>
                <select name="EventKey" class="form-control" data-event-select>
                    @foreach (var group in Model.Events.GroupBy(e => e.Group))
                    {
                        <optgroup label="@group.Key">
                            @foreach (var evt in group)
                            {
                                <option value="@evt.Key" selected="@(Model.Form.EventKey == evt.Key)">@evt.Name(isFa)</option>
                            }
                        </optgroup>
                    }
                    @* F3, 2026-08-21 functions-and-services plan: custom.* keys a workspace's own
                       apps have already emitted through /events/ingest. Listed here rather than left
                       for somebody to type blind — this is the "surface the keys that have been
                       seen" half of the plan's own visibility requirement. *@
                    @if (Model.CustomEventKeys is { Count: > 0 })
                    {
                        <optgroup label="@(isFa ? "سفارشی (دیده‌شده)" : "Custom (seen)")">
                            @foreach (var key in Model.CustomEventKeys)
                            {
                                <option value="@key" selected="@(string.IsNullOrWhiteSpace(Model.Form.CustomEventKey) && Model.Form.EventKey == key)" dir="ltr">@key</option>
                            }
                        </optgroup>
                    }
                </select>
            </label>

            <label class="form-field" data-when="@((int)FunctionTrigger.Event)">
                <span>@(isFa ? "یا یک کلید سفارشی تازه بنویسید" : "Or type a new custom key")</span>
                <input name="CustomEventKey" value="@Model.Form.CustomEventKey" class="form-control font-mono" dir="ltr"
                       placeholder="order.paid" data-custom-event-key />
                <p class="text-xs text-ink-faint">
                    @(isFa
                        ? "با پیشوند «custom.» ذخیره می‌شود، حتی اگر خودتان ننویسید. پر بودن این فیلد، گزینه‌ی انتخاب‌شده در بالا را نادیده می‌گیرد."
                        : "Stored under the \"custom.\" prefix whether or not you type it. Filled in, this overrides whatever is selected above.")
                </p>
            </label>

            @{ var brokers = Model.AvailableBrokers ?? []; }
            <div class="space-y-3" data-when="@((int)FunctionTrigger.Queue)">
                @if (brokers.Count == 0)
                {
                    <p class="text-xs text-ink-muted" data-no-brokers>
                        @(isFa
                            ? "این ورک‌اسپیس سرویس RabbitMQ ندارد. اول یکی از صفحه‌ی سرویس‌ها اضافه کنید."
                            : "This workspace has no RabbitMQ service yet. Add one from the Services page first.")
                    </p>
                }
                else
                {
                    <label class="form-field">
                        <span>@(isFa ? "بروکر RabbitMQ" : "RabbitMQ service")</span>
                        <select name="QueueServiceId" class="form-control">
                            <option value=""></option>
                            @foreach (var broker in brokers)
                            {
                                <option value="@broker.Id" selected="@(Model.Form.QueueServiceId == broker.Id)">@broker.Name</option>
                            }
                        </select>
                    </label>
                }
                <label class="form-field">
                    <span>@(isFa ? "نام صف" : "Queue name")</span>
                    <input name="QueueName" value="@Model.Form.QueueName" class="form-control font-mono" dir="ltr"
                           placeholder="orders.created" />
                    <p class="text-xs text-ink-faint">
                        @(isFa
                            ? "اگر این صف روی بروکر وجود نداشته باشد، همان لحظه‌ی اولین اتصال ساخته می‌شود."
                            : "Declared automatically on first connection if it does not already exist on the broker.")
                    </p>
                </label>

                @* Honesty about throughput, said plainly rather than discovered under load — the
                   plan's own instruction. One panel process, one connection per queue function,
                   prefetch 1: this is not a scaled worker pool. *@
                <p class="rounded-lg bg-surface-2 px-3 py-2 text-xs text-ink-muted" data-queue-throughput-note>
                    @(isFa
                        ? "این پل توسط یک مصرف‌کننده‌ی سمت پنل اجرا می‌شود، نه یک استخر کارگر مقیاس‌پذیر — پیام‌ها یکی‌یکی پردازش می‌شوند. برای بارهای سنگین هنوز مناسب نیست."
                        : "This bridge runs as one panel-side consumer, not a scaled worker pool — messages are handled one at a time. Not yet a fit for high-throughput workloads.")
                </p>

                @if (Model.QueueLastError is { Length: > 0 } queueError)
                {
                    <div class="rounded-lg border border-danger bg-danger-soft px-3 py-2 text-xs text-danger" data-queue-broker-error>
                        @(isFa ? "اتصال به بروکر برقرار نشد: " : "Could not stay connected to the broker: ")@queueError
                    </div>
                }
            </div>

            <label class="flex items-center gap-2.5 text-sm text-ink">
                <input type="checkbox" name="IsEnabled" value="true" checked="@Model.Form.IsEnabled" />
                <span>@(isFa ? "فعال" : "Enabled")</span>
            </label>
            <input type="hidden" name="IsEnabled" value="false" />

            <div class="flex items-center gap-3 border-t border-line pt-4">
                <button data-action="save" class="btn-primary px-5 py-2.5">@(isFa ? "ذخیره" : "Save")</button>
                <a href="/functions/@Model.AppId" data-action="cancel" class="btn-secondary">@(isFa ? "انصراف" : "Cancel")</a>
            </div>
        </div>

        @if (Model.FunctionId is { } fnId)
        {
            <div class="rounded-2xl border border-line bg-surface p-5 shadow-panel">
                <h2 class="mb-1 text-sm font-semibold text-ink">
                    @(isFa ? "اجرای نسخه‌ی منتشرشده" : "Run the published version")
                </h2>
                <p class="mb-3 text-xs text-ink-muted">
                    @(isFa
                        ? "از همان مسیری که زمان‌بندی استفاده می‌کند — پس دقیقاً همان چیزی را می‌آزمایید که ساعت ۳ بامداد اتفاق می‌افتد."
                        : "Through the same door a schedule uses — so you are testing exactly what happens at 03:00.")
                </p>
                @if (!Model.IsPublished)
                {
                    @* Disabled rather than allowed-and-then-refused. FunctionInvoker.QueueAsync returns
                       null when ActiveDeploymentId is null, so the press would land back here with an
                       error; saying it on the button is the same fact, one step earlier. *@
                    <p data-run-state="never-published" class="mb-3 rounded-lg bg-warn-soft px-3 py-2 text-xs text-warn">
                        @(isFa
                            ? "این اپ هنوز منتشر نشده، پس چیزی برای اجرا وجود ندارد. اول «انتشار» را بزنید."
                            : "This app has never been published, so there is nothing to run yet. Press Publish first.")
                    </p>
                }
                else if (Model.HasUnpublishedChanges)
                {
                    @* The honest half of the Run-now decision. Running the buffer would mean rebuilding
                       the image on every press — which is Publish under another name — so instead this
                       says plainly which code the button will reach. *@
                    <p data-run-state="stale" class="mb-3 rounded-lg bg-warn-soft px-3 py-2 text-xs text-warn">
                        @(isFa
                            ? "ویرایش‌های منتشرنشده دارید. این دکمه نسخه‌ی منتشرشده را اجرا می‌کند، نه کد روی این صفحه — برای اجرای این کد، «انتشار» را بزنید."
                            : "You have unpublished edits. This runs the published version, not the code on this page — press Publish to make this code the one that runs.")
                    </p>
                }
                @* A submit button of the form above, not a form of its own: a <form> nested inside
                   another is silently dropped by the HTML parser (a spec-compliant one discards the
                   inner start tag), so both buttons would submit to Save and this one would never run
                   anything. `formaction` gives one button its own destination without a second <form>. *@
                <button type="submit" formaction="/functions/@Model.AppId/@fnId/run" formmethod="post"
                        data-action="run" class="btn-secondary w-full" disabled="@(!Model.IsPublished)">
                    @(isFa ? "اجرا کن" : "Run now")
                </button>
            </div>
        }
    </aside>
</form>

@* Deliberately outside the form above. Nesting a per-row restore <form> inside the Save form is
   exactly §3(a)'s original bug — an HTML5 parser drops the inner start tag — so each row here is
   its own top-level form, the same shape Details.cshtml already uses for its own per-row delete. *@
@if (Model.FunctionId is { } editingId && Model.Revisions is { Count: > 0 })
{
    <div class="mt-5 rounded-2xl border border-line bg-surface p-5 shadow-panel">
        <h2 class="mb-1 text-sm font-semibold text-ink">@(isFa ? "تاریخچه‌ی نسخه‌ها" : "Revision history")</h2>
        <p class="mb-3 text-xs text-ink-muted">
            @(isFa
                ? $"آخرین {FunctionAppService.MaxRevisions} نسخه‌ی ذخیره‌شده نگه داشته می‌شود. بازگردانی یک نسخه خودش نسخه‌ی تازه‌ای می‌سازد."
                : $"The last {FunctionAppService.MaxRevisions} saved versions are kept. Restoring one writes a new version of its own.")
        </p>
        <ul class="divide-y divide-line text-xs">
            @foreach (var revision in Model.Revisions)
            {
                <li class="flex items-center justify-between gap-3 py-2" data-revision-id="@revision.Id">
                    <span class="text-ink-muted" dir="ltr">@revision.CreatedAt.LocalDateTime.ToString(Dates.Precise)</span>
                    @if (revision.IsCurrent)
                    {
                        <span data-revision-current class="text-ink-faint">@(isFa ? "نسخه‌ی فعلی" : "Current")</span>
                    }
                    else
                    {
                        <form method="post" action="/functions/@Model.AppId/@editingId/revisions/@revision.Id/restore"
                              onsubmit="return confirm('@(isFa
                                  ? "کد به این نسخه بازگردانده شود؟ نسخه‌ی فعلی هم در تاریخچه می‌ماند."
                                  : "Restore the code to this version? The current version stays in the history too.")');">
                            @Html.AntiForgeryToken()
                            <button type="submit" data-action="restore-revision" class="text-accent-text hover:underline">
                                @(isFa ? "بازگردانی" : "Restore")
                            </button>
                        </form>
                    }
                </li>
            }
        </ul>
    </div>
}

@* F2: dead letters — messages the queue consumer could not get this function to accept twice in a
   row. Deliberately outside the Save form for the same reason revisions are: each row's own
   discard is its own top-level form, and nesting it would be the parser bug §3(a) already avoided
   above. Three states, per the design system: data, empty, and — since this section only exists for
   a Queue-triggered function that has been saved at least once — "not applicable" is folded into not
   rendering the section at all rather than a fabricated zero. *@
@if (Model.FunctionId is { } fnIdForDeadLetters && Model.Form.Trigger == FunctionTrigger.Queue)
{
    <div class="mt-5 rounded-2xl border border-line bg-surface p-5 shadow-panel">
        <h2 class="mb-1 text-sm font-semibold text-ink">@(isFa ? "پیام‌های ازکارافتاده" : "Dead letters")</h2>
        <p class="mb-3 text-xs text-ink-muted">
            @(isFa
                ? "پیامی که دو بار (اول و پس از یک تلاش دوباره) رد شد، اینجا نگه داشته می‌شود تا از بین نرود."
                : "A message that failed twice — once, and once more after a retry — is parked here rather than dropped.")
        </p>
        @if (Model.DeadLetters is { Count: > 0 })
        {
            <ul class="divide-y divide-line text-xs" data-dead-letters>
                @foreach (var letter in Model.DeadLetters)
                {
                    <li class="space-y-1.5 py-2.5" data-dead-letter-id="@letter.Id">
                        <div class="flex items-center justify-between gap-3">
                            <span class="text-ink-muted" dir="ltr">@letter.CreatedAt.LocalDateTime.ToString(Dates.Precise)</span>
                            <form method="post" action="/functions/@Model.AppId/@fnIdForDeadLetters/deadletters/@letter.Id/discard">
                                @Html.AntiForgeryToken()
                                <button type="submit" data-action="discard-dead-letter" class="text-ink-faint underline hover:text-danger">
                                    @(isFa ? "کنار گذاشتن" : "Discard")
                                </button>
                            </form>
                        </div>
                        <div class="text-danger">@letter.Reason</div>
                        <code class="block truncate rounded-lg bg-surface-2 px-2 py-1.5 text-ink" dir="ltr">@letter.Body</code>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-xs text-ink-faint" data-dead-letters-empty>
                @(isFa ? "چیزی اینجا نیست." : "Nothing here.")
            </p>
        }
    </div>
}

@section Scripts {
<script>
    // Only the fields the chosen trigger uses. The server validates the same rule, so this is a
    // courtesy — a route posted with a cron trigger is ignored there, not trusted here.
    (function () {
        var select = document.querySelector('[data-trigger]');
        if (!select) return;
        function paint() {
            document.querySelectorAll('[data-when]').forEach(function (el) {
                el.style.display = el.dataset.when === select.value ? '' : 'none';
            });
        }
        select.addEventListener('change', paint);
        paint();
    })();

    // The function's own URL, shown copy-ready once Public — same idiom as the database connection
    // string box (Views/Databases/Details.cshtml): a <code> the eye can read and a button that copies
    // the exact text, nothing typed by hand that could drift from what the container actually answers.
    (function () {
        var button = document.querySelector('[data-copy-function-url]');
        var code = document.getElementById('functionUrl');
        if (!button || !code) return;
        button.addEventListener('click', function () {
            navigator.clipboard?.writeText(code.textContent.trim());
        });
    })();

    // The ready-to-run curl line beside it — click-to-copy, the same idiom Apps/Details.cshtml and
    // Templates/Deploy.cshtml already use for a single command nobody should have to retype by hand.
    document.querySelectorAll('[data-copy-text]').forEach(function (el) {
        el.style.cursor = 'copy';
        el.addEventListener('click', function () {
            navigator.clipboard?.writeText(el.textContent.trim());
        });
    });

    // Draft protection. Today's only total failure: no dirty tracking, no beforeunload guard, a
    // Cancel that discards silently, and — sharper than it looks — Run now navigates away too
    // (formaction on a button inside this same form) without ever saving the buffer it runs
    // instead of. A failed save already keeps the typed code, because SaveFunction re-renders this
    // view from the posted model on refusal rather than reloading from the database — this guards
    // the other way to lose it: leaving before saving at all.
    (function () {
        var form = document.querySelector('form[action$="/save"]');
        if (!form) return;

        var dirty = false;
        form.addEventListener('input', function () { dirty = true; });
        form.addEventListener('change', function () { dirty = true; });

        var discardMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isFa
            ? "تغییرات ذخیره‌نشده‌ای دارید. کنار گذاشته شوند؟"
            : "You have unsaved changes. Discard them?"));

        form.addEventListener('submit', function (e) {
            var submitter = e.submitter;
            // Save persists whatever is on screen, so leaving right after it loses nothing. Run now
            // does not — it calls the published version, not the buffer — so it is, for this
            // purpose, exactly like Cancel: a way to leave the page that would otherwise lose
            // unsaved edits in silence.
            if (submitter && submitter.dataset.action === 'run' && dirty && !window.confirm(discardMessage)) {
                e.preventDefault();
                return;
            }
            dirty = false;
        });

        window.addEventListener('beforeunload', function (e) {
            if (!dirty) return;
            e.preventDefault();
            e.returnValue = '';
        });

        document.querySelectorAll('[data-action="cancel"]').forEach(function (a) {
            a.addEventListener('click', function (e) {
                if (dirty && !window.confirm(discardMessage)) e.preventDefault();
            });
        });
    })();
</script>
}
