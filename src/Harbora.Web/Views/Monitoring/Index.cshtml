@model MonitoringDashboardViewModel
@{
    ViewData["Title"] = "Monitoring";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var msg = TempData["Message"] as string;
    var err = TempData["Error"] as string;
    string Pct(double? d) => d is null ? "" : d.Value.ToString("0.#");
    string Gb(long b) => b <= 0 ? "—" : $"{b / 1024.0 / 1024 / 1024:0.0} GB";
    // RestartRate is not a percentage of an allocation the way the other two metrics are — the
    // summary line has to say so rather than appending "%" to a restart count.
    string ThresholdSummary(Harbora.Domain.Monitoring.Alert a, string? appName) => a.Metric switch
    {
        AlertMetric.RestartRate => isFa
            ? $"روی «{appName}» · بیش از {Pct(a.ThresholdPercent)} بار ری‌استارت در {a.SustainedMinutes} دقیقه"
            : $"watches {appName} · more than {Pct(a.ThresholdPercent)} restart(s) in {a.SustainedMinutes}m",
        _ => isFa
            ? $"روی «{appName}» · {(a.Metric == AlertMetric.CpuPercent ? "CPU" : "حافظه")} ≥ {Pct(a.ThresholdPercent)}٪ به مدت {a.SustainedMinutes} دقیقه"
            : $"watches {appName} · {a.Metric} ≥ {Pct(a.ThresholdPercent)}% for {a.SustainedMinutes}m"
    };
    string HealthClass(string s) => s.ToLower() switch
    {
        "running" => "bg-ok/15 text-ok",
        "exited" or "crashed" or "failed" => "bg-danger/15 text-danger",
        _ => "bg-slate-500/15 text-ink"
    };
    // Reuses AlertEvent — the same vocabulary the notification router matches on — so a condition's
    // name reads the same here as it does in the rule that watches for it.
    string ConditionLabel(AlertEvent c) => (c, isFa) switch
    {
        (AlertEvent.DeployFailed, true) => "استقرار ناموفق", (AlertEvent.DeployFailed, false) => "Deploy failed",
        (AlertEvent.AppCrashed, true) => "خرابی برنامه", (AlertEvent.AppCrashed, false) => "App crashed",
        (AlertEvent.SslExpiring, true) => "انقضای گواهی SSL", (AlertEvent.SslExpiring, false) => "SSL expiring",
        (AlertEvent.DiskWarning, true) => "هشدار فضای دیسک", (AlertEvent.DiskWarning, false) => "Disk warning",
        (AlertEvent.BackupFailed, true) => "پشتیبان‌گیری ناموفق", (AlertEvent.BackupFailed, false) => "Backup failed",
        (AlertEvent.ThresholdBreached, true) => "عبور از آستانه", (AlertEvent.ThresholdBreached, false) => "Threshold breached",
        (AlertEvent.LowBalance, true) => "موجودی کم", (AlertEvent.LowBalance, false) => "Low balance",
        _ => c.ToString()
    };
    // The one interesting fact an incident that only says "closed" would have lost — see
    // IncidentClosedReason's own doc comment for why each of the three is worded the way it is.
    string ReasonLabel(IncidentClosedReason r) => (r, isFa) switch
    {
        (IncidentClosedReason.Resolved, true) => "به‌طور خودکار برطرف شد", (IncidentClosedReason.Resolved, false) => "resolved automatically",
        (IncidentClosedReason.Acknowledged, true) => "تأیید شد", (IncidentClosedReason.Acknowledged, false) => "acknowledged",
        (IncidentClosedReason.Expired, true) => "منقضی شد", (IncidentClosedReason.Expired, false) => "expired",
        _ => r.ToString()
    };
    // N1 (2026-08-16 notification-system spec): the delivery log. Pending/Sent/Failed/Suppressed —
    // the same four-way split NotificationDeliveryStatus itself carries, so a row's own colour never
    // has to be reasoned about separately from its meaning.
    string DeliveryStatusLabel(Harbora.Domain.Common.NotificationDeliveryStatus s) => (s, isFa) switch
    {
        (Harbora.Domain.Common.NotificationDeliveryStatus.Pending, true) => "در صف",
        (Harbora.Domain.Common.NotificationDeliveryStatus.Pending, false) => "pending",
        (Harbora.Domain.Common.NotificationDeliveryStatus.Sent, true) => "ارسال شد",
        (Harbora.Domain.Common.NotificationDeliveryStatus.Sent, false) => "sent",
        (Harbora.Domain.Common.NotificationDeliveryStatus.Failed, true) => "ناموفق",
        (Harbora.Domain.Common.NotificationDeliveryStatus.Failed, false) => "failed",
        (Harbora.Domain.Common.NotificationDeliveryStatus.Suppressed, true) => "ارسال نشد",
        (Harbora.Domain.Common.NotificationDeliveryStatus.Suppressed, false) => "suppressed",
        _ => s.ToString()
    };
    string DeliveryPurposeLabel(Harbora.Domain.Common.NotificationDeliveryPurpose p) => (p, isFa) switch
    {
        (Harbora.Domain.Common.NotificationDeliveryPurpose.AlertDispatch, true) => "قانون هشدار",
        (Harbora.Domain.Common.NotificationDeliveryPurpose.AlertDispatch, false) => "alert rule",
        (Harbora.Domain.Common.NotificationDeliveryPurpose.NoRecipientFallback, true) => "بدون قانون هشدار — به مدیران",
        (Harbora.Domain.Common.NotificationDeliveryPurpose.NoRecipientFallback, false) => "no alert rule — sent to admins",
        (Harbora.Domain.Common.NotificationDeliveryPurpose.PasswordReset, true) => "بازنشانی رمز عبور",
        (Harbora.Domain.Common.NotificationDeliveryPurpose.PasswordReset, false) => "password reset",
        (Harbora.Domain.Common.NotificationDeliveryPurpose.EmailVerification, true) => "تأیید ایمیل",
        (Harbora.Domain.Common.NotificationDeliveryPurpose.EmailVerification, false) => "email verification",
        (Harbora.Domain.Common.NotificationDeliveryPurpose.WorkspaceInvite, true) => "دعوت به ورک‌اسپیس",
        (Harbora.Domain.Common.NotificationDeliveryPurpose.WorkspaceInvite, false) => "workspace invite",
        (Harbora.Domain.Common.NotificationDeliveryPurpose.PlatformInvite, true) => "دعوت به پلتفرم",
        (Harbora.Domain.Common.NotificationDeliveryPurpose.PlatformInvite, false) => "platform invite",
        _ => p.ToString()
    };
    string DeliveryStatusClass(Harbora.Domain.Common.NotificationDeliveryStatus s) => s switch
    {
        Harbora.Domain.Common.NotificationDeliveryStatus.Sent => "bg-ok/15 text-ok",
        Harbora.Domain.Common.NotificationDeliveryStatus.Failed => "bg-danger/15 text-danger",
        Harbora.Domain.Common.NotificationDeliveryStatus.Suppressed => "bg-slate-500/15 text-ink-faint",
        _ => "bg-slate-500/15 text-ink"
    };
}
@{
    var monitoringHeader = new Harbora.Web.ViewModels.PageHeaderModel(
        T["Monitoring"].Value,
        isFa ? "وضعیت زندهٔ زیرساخت و سرویس‌ها." : "Real-time visibility into your infrastructure.");
}
<div class="mb-6">
    <partial name="Design/_PageHeader" model="monitoringHeader" />
</div>

@if (msg is not null){<div class="mb-4 rounded-lg bg-ok-soft border border-ok text-ok px-4 py-2 text-sm">@msg</div>}
@if (err is not null){<div class="mb-4 rounded-lg bg-danger-soft border border-danger text-danger px-4 py-2 text-sm">@err</div>}
@if (!Model.DockerAvailable)
{
    <div class="mb-4 rounded-lg bg-warn-soft border border-warn text-warn px-4 py-2 text-sm">@(isFa ? "دسترسی به Docker daemon نیست — سنجه‌های زنده متوقف‌اند." : "Docker daemon unreachable — live metrics paused.")</div>
}
@if (Model.DiskWarning)
{
    <div class="mb-4 rounded-lg bg-danger-soft border border-danger text-danger px-4 py-2 text-sm" data-disk-warning data-disk-warn-ratio="@Model.DiskWarnRatio.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)">⚠ @(isFa ? "فضای دیسک رو به اتمام است" : "Disk space is running low") — @Gb(Model.DiskUsed) / @Gb(Model.DiskTotal)</div>
}
@if (User.IsInRole("Owner") || User.IsInRole("Admin"))
{
    @* Removes only Harbora's own build images: orphans of deleted apps, and anything past each
       app's rollback window. Customer images are never candidates, and an image still in use is
       left alone by the engine's own contract. *@
    <form asp-controller="Monitoring" asp-action="Cleanup" method="post" class="mb-4 flex items-center gap-3">
        @Html.AntiForgeryToken()
        <button class="rounded-lg bg-surface-2 hover:bg-surface-2 px-4 py-2 text-sm">🧹 @(isFa ? "پاک‌سازی دیسک" : "Clean up disk")</button>
        <span class="text-xs text-ink-faint">@(isFa ? "فقط ایمیج‌های ساخت خود Harbora؛ بازهٔ بازگردانی دست نمی‌خورد." : "Only Harbora's own build images; the rollback window is untouched.")</span>
    </form>
}
@if (Model.BackupWarning)
{
    <div class="mb-4 rounded-lg bg-warn-soft border border-warn text-warn px-4 py-2 text-sm" data-backup-warning>⚠ @Model.BackupWarningText</div>
}

@{
    // Routed through the honesty gate so an unreachable daemon shows "not collected yet" rather
    // than a confident 0%. The mockup's uptime, request count, error rate and p95 latency are not
    // collected at all yet, so they are absent rather than fabricated.
    var cpuStat = new Harbora.Web.ViewModels.StatCardModel("server", T["CPU"].Value,
        Harbora.Infrastructure.Monitoring.MetricDisplay.For(Model.DockerAvailable ? Model.CpuPercent : null, "%"),
        isFa ? "میانگین نود" : "node average");

    double? diskPct = Model.DiskTotal > 0 ? (double)Model.DiskUsed / Model.DiskTotal * 100 : null;
    var diskStat = new Harbora.Web.ViewModels.StatCardModel("archive", T["Disk"].Value,
        Harbora.Infrastructure.Monitoring.MetricDisplay.For(diskPct, "%"),
        Model.DiskTotal > 0 ? $"{Gb(Model.DiskUsed)} / {Gb(Model.DiskTotal)}" : null);

    var memStat = new Harbora.Web.ViewModels.StatCardModel("layers", T["Memory"].Value,
        Harbora.Infrastructure.Monitoring.MetricDisplay.For(
            Model.MemTotal > 0 ? Model.MemTotal / 1073741824.0 : null, " GB"),
        isFa ? "کل نود" : "node total");

    var containerStat = new Harbora.Web.ViewModels.StatCardModel("boxes",
        isFa ? "کانتینرها" : "Containers",
        Harbora.Infrastructure.Monitoring.MetricDisplay.For(Model.DockerAvailable ? Model.ContainersRunning : null),
        isFa ? "در حال اجرا" : "running");
}
<div class="mb-6 grid grid-cols-2 gap-4 xl:grid-cols-4">
    <partial name="Design/_StatCard" model="cpuStat" />
    <partial name="Design/_StatCard" model="diskStat" />
    <partial name="Design/_StatCard" model="memStat" />
    <partial name="Design/_StatCard" model="containerStat" />
</div>

<!-- CPU chart (Vue island) -->
<div class="rounded-xl border border-line bg-surface p-4 mb-6">
    <div class="text-sm text-ink-muted mb-2">CPU % (@(isFa ? "۶۰ دقیقه اخیر" : "last 60 min"))</div>
    <div id="metrics-chart" data-name="cpu.percent" data-label="CPU %" data-color="#818cf8" style="min-height:120px"></div>
</div>

<div class="grid lg:grid-cols-2 gap-6">
    <!-- App health -->
    <section class="rounded-xl border border-line bg-surface">
        <div class="px-4 py-3 border-b border-line font-semibold">@T["Applications"]</div>
        <div class="divide-y divide-line">
            @if (Model.Apps.Count == 0){<div class="p-4 text-ink-muted text-sm">—</div>}
            @foreach (var a in Model.Apps)
            {
                <div class="flex items-center justify-between p-3">
                    <a href="/apps" class="text-sm font-medium">@a.Name</a>
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-ink-faint">@Harbora.Web.Infrastructure.StatusLabel.Deploy(a.LastDeployStatus, isFa)</span>
                        <span class="rounded-full px-2 py-0.5 text-xs @HealthClass(a.ContainerState)">@Harbora.Web.Infrastructure.StatusLabel.Container(a.ContainerState, isFa)</span>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Recent deploys -->
    <section class="rounded-xl border border-line bg-surface">
        <div class="px-4 py-3 border-b border-line font-semibold flex items-center justify-between">
            <span>@T["Recent Deployments"]</span>
            @if (Model.FailedDeploys > 0){<span class="text-xs text-danger">@Model.FailedDeploys @T["Failed"]</span>}
        </div>
        <div class="divide-y divide-line">
            @if (Model.RecentDeploys.Count == 0){<div class="p-4 text-ink-muted text-sm">—</div>}
            @foreach (var d in Model.RecentDeploys)
            {
                <a href="/deployments/details/@d.Id" class="flex items-center justify-between p-3 hover:bg-surface-2">
                    <span class="text-sm">@d.App?.Name #@d.Number</span>
                    <partial name="_DeployStatusBadge" model="d.Status" />
                </a>
            }
        </div>
    </section>
</div>

<!-- SSL / domains -->
<section class="rounded-xl border border-line bg-surface mt-6">
    <div class="px-4 py-3 border-b border-line font-semibold">SSL &amp; @T["Domains"]</div>
    <div class="divide-y divide-line">
        @if (Model.Domains.Count == 0){<div class="p-4 text-ink-muted text-sm">—</div>}
        @foreach (var d in Model.Domains)
        {
            <div class="flex items-center justify-between p-3 text-sm">
                <span class="font-mono">@d.Host</span>
                <span class="text-xs @(d.SslEnabled ? "text-ok" : "text-ink-muted")">@(d.SslEnabled ? "🔒 Let's Encrypt" : (isFa ? "بدون SSL" : "no SSL"))</span>
            </div>
        }
    </div>
</section>

<!-- Incident timeline: things that fired, and — where it has happened — how they stopped firing. -->
<section id="timeline" class="rounded-xl border border-line bg-surface mt-6 p-5">
    <div class="flex items-center justify-between mb-3">
        <h2 class="text-[15px] font-semibold text-ink flex items-center gap-2">
            <i data-lucide="history" class="h-4 w-4"></i>
            @(isFa ? "جدول زمانی رخدادها" : "Incident timeline")
        </h2>
        @{ var openCount = Model.Incidents.Count(i => i.ClosedAt is null); }
        @if (openCount > 0)
        {
            <span class="rounded-full bg-danger/15 px-2 py-0.5 text-xs text-danger" data-open-incident-count="@openCount">
                @openCount @(isFa ? "باز" : "open")
            </span>
        }
    </div>
    <div class="space-y-2">
        @if (Model.Incidents.Count == 0)
        {
            <partial name="Design/_EmptyState" model="@(new EmptyStateModel("history",
                isFa ? "هنوز رخدادی ثبت نشده است." : "No incidents yet."))" />
        }
        @foreach (var incident in Model.Incidents)
        {
            var isOpen = incident.ClosedAt is null;
            <div class="rounded-lg bg-surface-2 px-3 py-2 text-sm"
                 data-incident-row data-incident-id="@incident.Id"
                 data-incident-condition="@incident.Condition" data-incident-subject="@(incident.SubjectRef ?? "")"
                 data-incident-open="@(isOpen ? "true" : "false")"
                 data-incident-closed-reason="@(incident.ClosedReason?.ToString() ?? "")">
                <div class="flex items-center justify-between gap-2">
                    <span>
                        <strong>@ConditionLabel(incident.Condition)</strong>
                        <span class="text-ink-faint">· @incident.Title</span>
                    </span>
                    <div class="flex shrink-0 items-center gap-2">
                        @if (isOpen)
                        {
                            <span class="rounded-full bg-danger/15 px-2 py-0.5 text-xs text-danger">@(isFa ? "باز" : "open")</span>
                            <form asp-controller="Monitoring" asp-action="AcknowledgeIncident" asp-route-id="@incident.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button class="text-xs text-accent-text" aria-label="@(isFa ? $"تأیید {incident.Title}" : $"Acknowledge {incident.Title}")">@(isFa ? "تأیید" : "acknowledge")</button>
                            </form>
                        }
                        else
                        {
                            <span class="rounded-full bg-ok/15 px-2 py-0.5 text-xs text-ok" data-incident-reason-label>@ReasonLabel(incident.ClosedReason!.Value)</span>
                        }
                    </div>
                </div>
                <p class="mt-1 text-xs text-ink-faint break-all">@incident.Body</p>
            </div>
        }
    </div>
</section>

<!-- Alerts -->
<section id="alerts" class="rounded-xl border border-line bg-surface mt-6 p-5">
    <h2 class="text-[15px] font-semibold text-ink mb-3">@(isFa ? "هشدارها و اعلان‌ها" : "Alerts & Notifications")</h2>
    <div class="space-y-2 mb-4">
        @if (Model.Alerts.Count == 0)
        {
            <partial name="Design/_EmptyState" model="@(new EmptyStateModel("bell",
                isFa ? "هنوز هشداری تعریف نشده است." : "No alert rules yet."))" />
        }
        @foreach (var a in Model.Alerts)
        {
            var watchedApp = a.AppId is { } watchedId ? Model.Apps.FirstOrDefault(x => x.Id == watchedId) : null;
            var hasThreshold = a.AppId is not null && a.Metric is not null && a.ThresholdPercent is not null;
            @* A channel that is failing says so here, rather than only in the panel logs — the person
               who needs to know is the one looking at this list. A disabled rule stays in this list
               too — deleting used to be the only way off it, and that is the defect this page fixes. *@
            <div class="rounded-lg bg-surface-2 px-3 py-2 text-sm@(a.IsEnabled ? "" : " opacity-60")"
                 data-alert-row data-alert-id="@a.Id" data-alert-enabled="@(a.IsEnabled ? "true" : "false")"
                 data-alert-metric="@(a.Metric?.ToString() ?? "")" data-alert-app-id="@(a.AppId?.ToString() ?? "")"
                 data-alert-threshold-percent="@Pct(a.ThresholdPercent)">
              <div class="flex items-center justify-between">
                <span>@a.Name <span class="text-ink-faint">· @a.Channel · ≥@a.MinSeverity</span>
                    @if (!a.IsEnabled)
                    {
                        <span class="text-xs text-ink-faint">· @(isFa ? "غیرفعال" : "disabled")</span>
                    }
                    @if (a.LastError is not null)
                    {
                        <span class="text-xs text-danger">· @(isFa ? "ناموفق" : "failing")</span>
                    }
                    else if (a.LastAttemptAt is not null)
                    {
                        <span class="text-xs text-ok">· @(isFa ? "سالم" : "delivering")</span>
                    }
                </span>
                <div class="flex items-center gap-2">
                    <form asp-controller="Alerts" asp-action="Toggle" asp-route-id="@a.Id" method="post">@Html.AntiForgeryToken()<button class="text-xs text-accent-text" aria-label="@(isFa ? $"تغییر وضعیت {a.Name}" : $"Toggle alert {a.Name}")">@(a.IsEnabled ? (isFa ? "غیرفعال کردن" : "disable") : (isFa ? "فعال کردن" : "enable"))</button></form>
                    <form asp-controller="Alerts" asp-action="Test" asp-route-id="@a.Id" method="post">@Html.AntiForgeryToken()<button class="text-xs text-accent-text">@(isFa ? "آزمایش" : "test")</button></form>
                    <form asp-controller="Alerts" asp-action="Delete" asp-route-id="@a.Id" method="post">@Html.AntiForgeryToken()<button class="text-xs text-danger" aria-label="@(isFa ? $"حذف هشدار {a.Name}" : $"Delete alert {a.Name}")">✕</button></form>
                </div>
              </div>
              @if (hasThreshold)
              {
                  <p class="mt-1 text-xs text-ink-faint" data-alert-threshold-summary>
                      @ThresholdSummary(a, watchedApp?.Name)
                  </p>
              }
              @if (a.LastError is not null)
              {
                  <p class="mt-1 text-xs text-danger/90 break-all">@a.LastError</p>
              }

              <details class="mt-2">
                  <summary class="cursor-pointer text-xs text-accent-text">@(isFa ? "ویرایش" : "edit")</summary>
                  <form asp-controller="Alerts" asp-action="Edit" asp-route-id="@a.Id" method="post" class="mt-3 grid sm:grid-cols-2 gap-3" data-alert-form>
                      @Html.AntiForgeryToken()
                      <input name="name" value="@a.Name" placeholder="Name" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                      <select name="channel" data-alert-channel class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm">
                          <option value="Telegram" selected="@(a.Channel == AlertChannel.Telegram)">Telegram</option>
                          <option value="Discord" selected="@(a.Channel == AlertChannel.Discord)">Discord</option>
                          <option value="Webhook" selected="@(a.Channel == AlertChannel.Webhook)">Custom webhook</option>
                          <option value="Email" selected="@(a.Channel == AlertChannel.Email)">Email</option>
                      </select>
                      <select name="minSeverity" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm">
                          <option value="Info" selected="@(a.MinSeverity == AlertSeverity.Info)">Info</option>
                          <option value="Warning" selected="@(a.MinSeverity == AlertSeverity.Warning)">Warning</option>
                          <option value="Critical" selected="@(a.MinSeverity == AlertSeverity.Critical)">Critical</option>
                      </select>
                      <div></div>

                      <div data-ch="Telegram" class="grid grid-cols-2 gap-2 sm:col-span-2">
                          <input name="telegramToken" placeholder="@(isFa ? "بدون تغییر — خالی بگذارید تا حفظ شود" : "unchanged — leave blank to keep")" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                          <input name="telegramChatId" placeholder="@(isFa ? "بدون تغییر — خالی بگذارید تا حفظ شود" : "unchanged — leave blank to keep")" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                      </div>
                      <div data-ch="Discord Webhook" class="sm:col-span-2" style="display:none">
                          <input name="webhookUrl" placeholder="@(isFa ? "بدون تغییر — خالی بگذارید تا حفظ شود" : "unchanged — leave blank to keep")" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                      </div>
                      <div data-ch="Email" class="grid grid-cols-2 gap-2 sm:col-span-2" style="display:none">
                          <input name="smtpHost" placeholder="@(isFa ? "بدون تغییر" : "unchanged")" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                          <input name="smtpPort" type="number" placeholder="@(isFa ? "بدون تغییر" : "unchanged")" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                          <input name="smtpUser" placeholder="@(isFa ? "بدون تغییر" : "unchanged")" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                          <input name="smtpPassword" type="password" placeholder="@(isFa ? "بدون تغییر" : "unchanged")" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                          <input name="emailFrom" placeholder="@(isFa ? "بدون تغییر" : "unchanged")" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                          <input name="emailTo" placeholder="@(isFa ? "بدون تغییر" : "unchanged")" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                      </div>
                      <p class="sm:col-span-2 text-xs text-ink-faint">
                          @(isFa
                              ? "مقصد کانال (توکن یا آدرس) فقط با نوشتن مقدار تازه در همین‌جا تغییر می‌کند؛ خالی بماند یعنی همان مقدار قبلی حفظ می‌شود."
                              : "The channel's target only changes if you type a new value here — leave it blank and the stored one is kept.")
                      </p>

                      <div class="sm:col-span-2 flex flex-wrap gap-3 text-sm">
                          <label class="flex items-center gap-1"><input type="checkbox" name="onDeployFailed" value="true" checked="@a.OnDeployFailed"> deploy failed</label>
                          <label class="flex items-center gap-1"><input type="checkbox" name="onAppCrashed" value="true" checked="@a.OnAppCrashed"> app crashed</label>
                          <label class="flex items-center gap-1"><input type="checkbox" name="onSslExpiring" value="true" checked="@a.OnSslExpiring"> SSL expiring</label>
                          <label class="flex items-center gap-1"><input type="checkbox" name="onDiskWarning" value="true" checked="@a.OnDiskWarning"> disk warning</label>
                          <label class="flex items-center gap-1"><input type="checkbox" name="onBackupFailed" value="true" checked="@a.OnBackupFailed"> backup failed</label>
                      </div>

                      <details class="sm:col-span-2" open="@hasThreshold">
                          <summary class="cursor-pointer text-sm text-accent-text">@(isFa ? "یا: هشدار روی مصرف یک اپ" : "Or: alert on one app's usage")</summary>
                          <div class="mt-3 grid gap-2 sm:grid-cols-4">
                              <select name="appId" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm">
                                  <option value="">@(isFa ? "— بدون اپ —" : "— no app —")</option>
                                  @foreach (var app in Model.Apps)
                                  {
                                      <option value="@app.Id" selected="@(a.AppId == app.Id)">@app.Name</option>
                                  }
                              </select>
                              <select name="metric" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm">
                                  <option value="" selected="@(a.Metric is null)">@(isFa ? "— بدون سنجه —" : "— no metric —")</option>
                                  <option value="MemoryPercent" selected="@(a.Metric == AlertMetric.MemoryPercent)">@(isFa ? "حافظه" : "Memory")</option>
                                  <option value="CpuPercent" selected="@(a.Metric == AlertMetric.CpuPercent)">CPU</option>
                                  <option value="RestartRate" selected="@(a.Metric == AlertMetric.RestartRate)">@(isFa ? "نرخ ری‌استارت" : "Restart rate")</option>
                              </select>
                              <input name="thresholdPercent" type="number" min="1" max="1000" step="1" value="@Pct(a.ThresholdPercent)" placeholder="@(isFa ? "٪ آستانه / تعداد" : "% threshold / count")"
                                     class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                              <input name="sustainedMinutes" type="number" min="0" max="1440" value="@a.SustainedMinutes" placeholder="@(isFa ? "دقیقه" : "minutes")"
                                     class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                          </div>
                      </details>

                      <div><button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm font-semibold">@(isFa ? "ذخیره تغییرات" : "Save changes")</button></div>
                  </form>
              </details>
            </div>
        }
    </div>

    <details>
        <summary class="cursor-pointer text-sm text-accent-text">+ @(isFa ? "افزودن هشدار" : "Add alert")</summary>
        <form asp-controller="Alerts" asp-action="Create" method="post" class="mt-3 grid sm:grid-cols-2 gap-3" data-alert-form>
            @Html.AntiForgeryToken()
            <input name="name" placeholder="Name" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            <select name="channel" data-alert-channel class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm">
                <option value="Telegram">Telegram</option><option value="Discord">Discord</option>
                <option value="Webhook">Custom webhook</option><option value="Email">Email</option>
            </select>
            <select name="minSeverity" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm">
                <option value="Info">Info</option><option value="Warning" selected>Warning</option><option value="Critical">Critical</option>
            </select>
            <div></div>

            <div data-ch="Telegram" class="grid grid-cols-2 gap-2 sm:col-span-2">
                <input name="telegramToken" placeholder="Bot token" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                <input name="telegramChatId" placeholder="Chat id" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            </div>
            <div data-ch="Discord Webhook" class="sm:col-span-2" style="display:none">
                <input name="webhookUrl" placeholder="Webhook URL" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            </div>
            <div data-ch="Email" class="grid grid-cols-2 gap-2 sm:col-span-2" style="display:none">
                <input name="smtpHost" placeholder="SMTP host" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                <input name="smtpPort" type="number" value="587" placeholder="Port" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                <input name="smtpUser" placeholder="User" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                <input name="smtpPassword" type="password" placeholder="Password" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                <input name="emailFrom" placeholder="From" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                <input name="emailTo" placeholder="To" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            </div>

            <div class="sm:col-span-2 flex flex-wrap gap-3 text-sm">
                <label class="flex items-center gap-1"><input type="checkbox" name="onDeployFailed" value="true" checked> deploy failed</label>
                <label class="flex items-center gap-1"><input type="checkbox" name="onAppCrashed" value="true" checked> app crashed</label>
                <label class="flex items-center gap-1"><input type="checkbox" name="onSslExpiring" value="true"> SSL expiring</label>
                <label class="flex items-center gap-1"><input type="checkbox" name="onDiskWarning" value="true" checked> disk warning</label>
                <label class="flex items-center gap-1"><input type="checkbox" name="onBackupFailed" value="true" checked> backup failed</label>
            </div>
            @* Optional second half. Left empty, this is exactly the event-driven rule it always
               was; filled in, the same channel also fires when one app holds above a line. *@
            <details class="sm:col-span-2">
                <summary class="cursor-pointer text-sm text-accent-text">@(isFa ? "یا: هشدار روی مصرف یک اپ" : "Or: alert on one app's usage")</summary>
                <div class="mt-3 grid gap-2 sm:grid-cols-4">
                    <select name="appId" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm">
                        <option value="">@(isFa ? "— بدون اپ —" : "— no app —")</option>
                        @foreach (var a in Model.Apps)
                        {
                            <option value="@a.Id">@a.Name</option>
                        }
                    </select>
                    <select name="metric" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm">
                        <option value="" selected>@(isFa ? "— بدون سنجه —" : "— no metric —")</option>
                        <option value="MemoryPercent">@(isFa ? "حافظه" : "Memory")</option>
                        <option value="CpuPercent">CPU</option>
                        <option value="RestartRate">@(isFa ? "نرخ ری‌استارت" : "Restart rate")</option>
                    </select>
                    <input name="thresholdPercent" type="number" min="1" max="1000" step="1" placeholder="@(isFa ? "٪ آستانه / تعداد" : "% threshold / count")"
                           class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                    <input name="sustainedMinutes" type="number" min="0" max="1440" value="5" placeholder="@(isFa ? "دقیقه" : "minutes")"
                           class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                </div>
                <p class="mt-2 text-xs text-ink-faint">
                    @(isFa
                        ? "برای CPU/حافظه: درصد از سهم خودِ اپ که باید در تمام بازه بالای خط بماند — یک نمونهٔ گذرا هشدار نمی‌دهد. برای نرخ ری‌استارت: تعداد دفعات ری‌استارت در بازهٔ زمانی (دقیقه) به‌جای درصد."
                        : "For CPU/memory: percentage of the app's own allocation, held for the whole window — a passing spike says nothing. For restart rate: a plain restart count within the window (in minutes), not a percentage.")
                </p>
            </details>

            <div><button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm font-semibold">@T["Save"]</button></div>
        </form>
    </details>
</section>

<!-- Delivery log (N1, 2026-08-16 notification-system spec): one durable row per (message x
     destination), beside the rules whose channels they went out on — LastError above is a
     convenience mirror of the newest row here, not the record any more. -->
<section id="deliveries" class="rounded-xl border border-line bg-surface mt-6 p-5">
    <h2 class="text-[15px] font-semibold text-ink mb-3 flex items-center gap-2">
        <i data-lucide="send" class="h-4 w-4"></i>
        @(isFa ? "گزارش ارسال اعلان‌ها" : "Notification delivery log")
    </h2>
    <div class="space-y-2">
        @if (Model.Deliveries.Count == 0)
        {
            <partial name="Design/_EmptyState" model="@(new EmptyStateModel("send",
                isFa ? "هنوز اعلانی صف نشده است." : "No deliveries queued yet."))" />
        }
        @foreach (var d in Model.Deliveries)
        {
            <div class="rounded-lg bg-surface-2 px-3 py-2 text-sm"
                 data-delivery-row data-delivery-id="@d.Id" data-delivery-status="@d.Status"
                 data-delivery-purpose="@d.Purpose" data-delivery-channel="@d.Channel"
                 data-delivery-attempts="@d.Attempts">
                <div class="flex items-center justify-between gap-2">
                    <span>
                        <strong>@d.Subject</strong>
                        <span class="text-ink-faint">· @DeliveryPurposeLabel(d.Purpose) · @d.Channel</span>
                    </span>
                    <span class="rounded-full px-2 py-0.5 text-xs shrink-0 @DeliveryStatusClass(d.Status)" data-delivery-status-label>
                        @DeliveryStatusLabel(d.Status)
                    </span>
                </div>
                <p class="mt-1 text-xs text-ink-faint">
                    @(isFa ? $"تلاش‌ها: {d.Attempts}" : $"attempts: {d.Attempts}")
                </p>
                @if (d.LastError is not null)
                {
                    <p class="mt-1 text-xs text-danger/90 break-all" data-delivery-last-error>@d.LastError</p>
                }
            </div>
        }
    </div>
</section>

@section Scripts {
<script>
    document.querySelectorAll('[data-alert-form]').forEach(function (form) {
        var sel = form.querySelector('[data-alert-channel]');
        function sync() {
            form.querySelectorAll('[data-ch]').forEach(function (el) {
                el.style.display = el.getAttribute('data-ch').split(' ').indexOf(sel.value) > -1 ? '' : 'none';
            });
        }
        sel.addEventListener('change', sync); sync();
    });
</script>
}
