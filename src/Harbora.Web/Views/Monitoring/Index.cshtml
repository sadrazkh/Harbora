@model MonitoringDashboardViewModel
@{
    ViewData["Title"] = "Monitoring";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
}
@{
    var monitoringHeader = new Harbora.Web.ViewModels.PageHeaderModel(
        T["Monitoring"].Value,
        isFa ? "وضعیت زندهٔ زیرساخت و سرویس‌ها." : "Real-time visibility into your infrastructure.");
}
<div class="mb-6">
    <partial name="Design/_PageHeader" model="monitoringHeader" />
</div>

@* This page is what a worried person opens when something is wrong, so it reads in the order they
   need it: what is wrong now, what changed recently, what the numbers say, and — last, folded — what
   the rules are. Nothing below was removed in this pass; every alert, metric, control and route
   reachable before this redesign still is, just reordered and split into partials (2026-08-19). *@

<partial name="_Banners" model="Model" />

<partial name="_OpenIncidents" model="Model" />

<h2 class="mb-3 mt-2 text-xs font-semibold uppercase tracking-wide text-ink-faint">@(isFa ? "چه تغییری کرده" : "What changed recently")</h2>
<div class="space-y-6 mb-8">
    <partial name="_IncidentTimeline" model="Model" />
    <div class="grid lg:grid-cols-2 gap-6">
        <partial name="_RecentDeploys" model="Model" />
        <partial name="_DeliveryLog" model="Model" />
    </div>
</div>

<h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-ink-faint">@(isFa ? "اعداد چه می‌گویند" : "What the numbers say")</h2>
<div class="mb-8">
    <partial name="_StatCards" model="Model" />
    <div class="grid lg:grid-cols-2 gap-6">
        <partial name="_AppHealth" model="Model" />
        <partial name="_Domains" model="Model" />
    </div>
</div>

<h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-ink-faint">@(isFa ? "قوانین هشدار" : "Alert rules")</h2>
<partial name="_AlertRules" model="Model" />

@section Scripts {
<script>
    document.querySelectorAll('[data-alert-form]').forEach(function (form) {
        var sel = form.querySelector('[data-alert-channel]');
        function sync() {
            form.querySelectorAll('[data-ch]').forEach(function (el) {
                el.style.display = el.getAttribute('data-ch').split(' ').indexOf(sel.value) > -1 ? '' : 'none';
            });
        }
        sel.addEventListener('change', sync); sync();
    });
</script>
}
