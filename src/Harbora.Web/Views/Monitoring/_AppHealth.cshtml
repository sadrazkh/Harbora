@model MonitoringDashboardViewModel
@{
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
}
<section class="rounded-xl border border-line bg-surface">
    <div class="px-4 py-3 border-b border-line font-semibold">@T["Applications"]</div>
    <div class="divide-y divide-line">
        @if (Model.Apps.Count == 0)
        {
            <partial name="Design/_EmptyState" model="@(new EmptyStateModel("boxes",
                isFa ? "هنوز اپی ساخته نشده است." : "No applications yet.", isFa ? "ساخت اپ" : "New app", "/apps/create"))" />
        }
        @foreach (var a in Model.Apps)
        {
            @* The live container state is "right now"; the 30-day uptime/restart figures beside it
               (Phase 6 M3, LifecycleHistory) are a real window — the same two numbers the app's own
               Overview tab shows, surfaced here so a worried person does not have to open every app
               in turn to find the flaky one. An app with nothing collected reports unknown, never a
               fabricated 100%/0. *@
            var uptimeView = Harbora.Infrastructure.Monitoring.MetricDisplay.For(a.UptimePercent30d, "%");
            var restartsLabel = a.RestartCount30d is { } r
                ? (isFa ? $"{r} بار ری‌استارت" : r == 1 ? "1 restart" : $"{r} restarts")
                : (isFa ? "ری‌استارت نامشخص" : "restarts unknown");
            <div class="flex items-center justify-between gap-3 p-3">
                <div class="min-w-0">
                    <a href="/apps" class="block truncate text-sm font-medium">@a.Name</a>
                    <div class="mt-0.5 text-[11px]" data-app-uptime data-app-slug="@a.Slug">
                        @if (uptimeView.HasData)
                        {
                            <span dir="ltr" class="font-mono text-ink-faint">@uptimeView.Text</span> <span class="text-ink-faint">· @restartsLabel · @(isFa ? "۳۰ روز اخیر" : "last 30d")</span>
                        }
                        else
                        {
                            <span class="text-ink-faint">@(isFa ? "پایداری هنوز جمع‌آوری نشده" : "uptime not collected yet")</span>
                        }
                    </div>
                </div>
                <div class="flex shrink-0 items-center gap-2">
                    <span class="text-xs text-ink-faint">@Harbora.Web.Infrastructure.StatusLabel.Deploy(a.LastDeployStatus, isFa)</span>
                    <partial name="Design/_StatusPill" model="@(new StatusPillModel(Harbora.Web.Infrastructure.StatusLabel.Container(a.ContainerState, isFa), MonitoringLabels.ContainerTone(a.ContainerState)))" />
                </div>
            </div>
        }
    </div>
</section>
