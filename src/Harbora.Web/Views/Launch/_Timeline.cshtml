@model LaunchProgressModel
@using Harbora.Domain.Authorization
@using Harbora.Domain.Launch
@using Harbora.Infrastructure.Launch
@using Harbora.Infrastructure.Verification
@{
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var view = Model.View;
    var canCreate = NavigationCapabilities.For(User)(Capabilities.AppsCreate);

    var isWorker = Model.AppKind == ServiceKind.Worker;
    var appPage = view.AppId is { } appId ? $"/apps/details/{appId}" : null;
    var failedStep = view.Steps.FirstOrDefault(s => s.State == LaunchStepState.Failed);
    var finished = view.Status is LaunchStatus.Succeeded or LaunchStatus.SucceededWithProblems;

    // A person acts on what failed first. The rest of the list is still true, so it stays below.
    IReadOnlyList<AppCheck> checks = view.Checks
        .OrderBy(c => c.Status switch
        {
            AppCheckStatus.Failed => 0,
            AppCheckStatus.Warning => 1,
            AppCheckStatus.Pending => 2,
            AppCheckStatus.Skipped => 3,
            _ => 4
        })
        .ToList();
    var skipped = view.Checks.Any(c => c.Status == AppCheckStatus.Skipped);

    // A host with no scheme still has to open as a link.
    var address = view.PublicUrl is { Length: > 0 } url
        ? (url.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? url : "https://" + url)
        : null;

    string? Moving() => (view.Status, isFa) switch
    {
        (LaunchStatus.Creating, true) => "دارم می‌سازمش…",
        (LaunchStatus.Creating, false) => "Creating it…",
        (LaunchStatus.WaitingForServices, true) => "منتظرم دیتابیس آماده شود…",
        (LaunchStatus.WaitingForServices, false) => "Waiting for the database to be ready…",
        (LaunchStatus.Deploying, true) => "دارم اجرایش می‌کنم…",
        (LaunchStatus.Deploying, false) => "Getting it running…",
        (LaunchStatus.Verifying, true) => "دارم امتحانش می‌کنم…",
        (LaunchStatus.Verifying, false) => "Testing it…",
        _ => null
    };

    // Nothing but the reading of the source had happened, so "nothing was made" is a thing that can be said.
    var nothingMade = view.AppId is null && view.Steps
        .Where(s => s.Key != LaunchStepKeys.Source)
        .All(s => s.State is LaunchStepState.Waiting or LaunchStepState.Skipped);
    var madeServices = view.Steps
        .Where(s => s.Key == LaunchStepKeys.Services && s.State is LaunchStepState.Done or LaunchStepState.Failed)
        .Select(s => isFa ? s.DetailFa : s.Detail)
        .FirstOrDefault(d => d is { Length: > 0 });
}

@switch (view.Status)
{
    case LaunchStatus.Succeeded:
        <div class="text-center" data-launch-outcome="succeeded">
            <i data-lucide="circle-check" class="mx-auto h-10 w-10 text-ok"></i>
            @if (isWorker)
            {
                <h1 class="mt-3 text-2xl font-bold tracking-tight text-ink">@(isFa ? "ربات اجرا شده" : "Your bot is running")</h1>
                <a href="/apps/@view.AppId/logs" class="mt-2 inline-block text-sm font-medium text-accent-text hover:underline" data-launch-logs-link>@(isFa ? "لاگش را ببین" : "See its logs")</a>
            }
            else
            {
                <h1 class="mt-3 text-2xl font-bold tracking-tight text-ink">@(isFa ? "اپت بالاست" : "Your app is up")</h1>
                @if (address is not null)
                {
                    <a href="@address" target="_blank" rel="noopener noreferrer" dir="ltr" class="mt-2 inline-block break-all text-lg font-semibold text-accent-text hover:underline" data-launch-address-link>@address</a>
                }
                else
                {
                    <p class="mt-2 text-sm text-ink-muted">@(isFa ? "هنوز آدرس عمومی ندارد. از صفحه‌ی اپ می‌توانی یکی به آن بدهی." : "It has no public address yet. You can give it one from the app's page.")</p>
                }
            }
        </div>
        break;

    case LaunchStatus.SucceededWithProblems:
        @* Never the green treatment: it is running and being billed, and something about it is wrong. *@
        <div class="text-center" data-launch-outcome="problems">
            <i data-lucide="triangle-alert" class="mx-auto h-10 w-10 text-warn"></i>
            <h1 class="mt-3 text-2xl font-bold tracking-tight text-ink">@(isFa ? "اپ بالا آمد، ولی یک چیز درست نیست" : "The app came up, but something isn't right")</h1>
            @if (address is not null)
            {
                <a href="@address" target="_blank" rel="noopener noreferrer" dir="ltr" class="mt-2 inline-block break-all text-sm text-accent-text hover:underline" data-launch-address-link>@address</a>
            }
        </div>
        break;

    case LaunchStatus.Failed:
        <div class="flex items-start gap-3" data-launch-outcome="failed">
            <i data-lucide="circle-x" class="mt-1 h-6 w-6 shrink-0 text-danger"></i>
            <div class="min-w-0">
                <h1 class="text-xl font-bold tracking-tight text-ink">
                    @if (failedStep is not null)
                    {
                        @(isFa ? $"اینجا گیر کرد: {failedStep.TitleFa}" : $"It stopped here: {failedStep.Title}")
                    }
                    else
                    {
                        @(isFa ? "اینجا گیر کرد" : "It stopped here")
                    }
                </h1>
                @if ((isFa ? view.FailureMessageFa : view.FailureMessage) is { Length: > 0 } failure)
                {
                    <p class="mt-2 break-words text-sm text-ink" data-launch-failure>@failure</p>
                }
                <p class="mt-3 break-words text-xs text-ink-muted" data-launch-exists>
                    @if (nothingMade)
                    {
                        @(isFa ? "هنوز چیزی ساخته نشده." : "Nothing has been created yet.")
                    }
                    else
                    {
                        @(isFa ? "چیزی پاک نشد؛ آنچه تا اینجا ساخته شده سر جایش است." : "Nothing was removed: what was made so far is still there.")
                        if (view.AppName is { Length: > 0 } && appPage is not null)
                        {
                            <text> </text><a href="@appPage" class="text-accent-text hover:underline" dir="ltr">@view.AppName</a>
                        }
                        if (madeServices is not null)
                        {
                            <text> · @madeServices</text>
                        }
                    }
                </p>
                @if (view.CanRetry && canCreate)
                {
                    <form method="post" action="/launch/@view.Id/retry" class="mt-4" data-launch-retry>
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-primary"><i data-lucide="rotate-cw" class="h-4 w-4"></i>@(isFa ? "دوباره امتحان کن" : "Try again")</button>
                    </form>
                }
            </div>
        </div>
        break;

    default:
        <div class="text-center" data-launch-outcome="moving">
            <h1 class="text-xl font-bold tracking-tight text-ink">@Moving()</h1>
            <p class="mt-1 text-xs text-ink-muted">@(isFa ? "می‌توانی این صفحه را ببندی؛ کار ادامه دارد." : "You can close this page: it keeps going.")</p>
        </div>
        break;
}

@if (checks.Count > 0)
{
    <div class="mt-6" data-launch-checks>
        <partial name="Design/_AppChecks" model="checks" />
        @if (skipped)
        {
            <p class="mt-2 text-xs text-ink-muted" data-launch-skipped-note>@(isFa ? "بعضی چیزها را نتوانستم بررسی کنم. این یعنی نمی‌دانم، نه اینکه درست است." : "Some things I couldn't check. That means I don't know, not that they work.")</p>
        }
    </div>
}

@if (finished && appPage is not null)
{
    <div class="mt-6 text-center">
        <a href="@appPage" class="btn-secondary justify-center" data-launch-app-link>@(isFa ? "برو به صفحه‌ی اپ" : "Go to the app's page")</a>
    </div>
}

@* On success the walk is history, folded away. While it is moving, or when it stopped, it is the point. *@
@if (finished)
{
    <details class="mt-6 text-xs text-ink-muted">
        <summary class="cursor-pointer select-none text-center hover:text-ink">@(isFa ? "چه کارهایی انجام شد" : "What was done")</summary>
        <partial name="_Steps" model="Model" />
    </details>
}
else
{
    <div class="mt-6"><partial name="_Steps" model="Model" /></div>
}
