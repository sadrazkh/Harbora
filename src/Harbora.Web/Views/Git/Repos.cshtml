@model RemoteReposViewModel
@{
    ViewData["Title"] = Model.Provider.Name;
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
}
<div class="mb-6">
    <a href="/git" class="text-accent-text text-sm">← @(isFa ? "اتصال Git" : "Git Providers")</a>
    <h1 class="text-2xl font-bold tracking-tight text-ink">@Model.Provider.Name <span class="text-sm text-ink-faint">· @Model.Provider.Type</span></h1>
</div>

@if (Model.Error is not null)
{
    <div class="rounded-lg bg-danger-soft border border-danger text-danger px-4 py-3 text-sm">@Model.Error</div>
}
else if (Model.Repositories.Count == 0)
{
    <div class="rounded-xl border border-dashed border-line-strong p-10 text-center text-ink-muted">@(isFa ? "مخزنی یافت نشد." : "No repositories found.")</div>
}
else
{
    <div class="rounded-xl border border-line bg-surface divide-y divide-line">
        @foreach (var r in Model.Repositories)
        {
            <div class="flex items-center justify-between p-3">
                <div class="min-w-0">
                    <div class="font-mono text-sm truncate">@r.FullName @if (r.Private){<span class="text-xs text-warn">🔒</span>}</div>
                    <div class="text-xs text-ink-faint">@r.DefaultBranch</div>
                </div>
                <form asp-controller="Git" asp-action="ImportRepo" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="providerId" value="@Model.Provider.Id" />
                    <input type="hidden" name="fullName" value="@r.FullName" />
                    <input type="hidden" name="cloneUrl" value="@r.CloneUrl" />
                    <input type="hidden" name="defaultBranch" value="@r.DefaultBranch" />
                    <button class="text-sm rounded-lg bg-accent hover:bg-accent-hover text-white px-3 py-1.5 font-semibold">@(isFa ? "افزودن" : "Add")</button>
                </form>
            </div>
        }
    </div>
}
