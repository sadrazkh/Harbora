@{
    ViewData["Title"] = "Routing";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
}
<div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-ink">@T["Routing"]</h1>
    <p class="text-ink-muted text-sm">@(isFa ? "قوانین مسیریابی را بکشید و رها کنید؛ کانفیگ Traefik خودکار ساخته و اعتبارسنجی می‌شود." : "Drag routing rules to prioritise; the Traefik config is generated and validated for you.")</p>
</div>

@* Vue island: the visual route designer. Initial state + CSRF travel via data attributes. *@
<div id="route-designer"
     data-routes="@ViewBag.RoutesJson"
     data-targets="@ViewBag.TargetsJson"
     data-csrf="@ViewBag.Csrf"
     data-lang="@(isFa ? "fa" : "en")">
    <div class="rounded-xl border border-dashed border-line-strong p-8 text-center text-ink-muted">
        Loading designer… (run <code>npm run build</code> if this doesn't disappear)
    </div>
</div>
