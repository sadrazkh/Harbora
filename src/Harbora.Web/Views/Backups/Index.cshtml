@model BackupsPageViewModel
@using Harbora.Domain.Common
@using Harbora.Domain.Backups
@inject Harbora.Web.Infrastructure.PanelModeProvider PanelModes
@{
    ViewData["Title"] = "Backups";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var msg = TempData["Message"] as string;
    var err = TempData["Error"] as string;
    // P5: set only where a real Job now backs the message (BackupsController.Run).
    var msgLinksToActivity = TempData["MessageLinksToActivity"] is true;

    // Unknown size is not zero bytes: a backup whose size was never recorded is not an empty one. And
    // a recorded size is never "0 MB" — the config backups are a few kilobytes, and forcing them
    // through a megabyte division rounded a real measurement down to nothing.
    string Size(long b) => b <= 0 ? "—" : Harbora.Infrastructure.Tenancy.ByteSize.Measured(b);

    string StatusTone(BackupStatus s) => s switch
    {
        BackupStatus.Completed => Tone.Ok,
        BackupStatus.Failed => Tone.Error,
        BackupStatus.Running or BackupStatus.Pending => Tone.Info,
        _ => Tone.Warn
    };

    // What a schedule or a backup is OF, in the words the target list already uses. A bare guid on
    // this page is a row nobody can act on, because they cannot tell which app it belongs to. A
    // target that no longer exists says so rather than rendering an id.
    string TargetLabel(BackupType type, string reference) =>
        Model.Targets.FirstOrDefault(t => t.Value == $"{type}|{reference}").Label
        ?? (isFa ? $"{type} · حذف‌شده" : $"{type} · removed");

    string DestinationName(Guid id) =>
        Model.Destinations.FirstOrDefault(d => d.Id == id)?.Name ?? (isFa ? "(نامشخص)" : "(unknown)");

    // Every figure here is counted from real backup rows. The mockup also showed a success rate,
    // deduplication savings and a retention policy; none of those are recorded, so none appear.
    var completed = Model.Backups.Count(b => b.Status == BackupStatus.Completed);
    var failedCount = Model.Backups.Count(b => b.Status == BackupStatus.Failed);
    var storedBytes = Model.Backups.Sum(b => b.SizeBytes);
    var latest = Model.Backups
        .Where(b => b.Status == BackupStatus.Completed)
        .OrderByDescending(b => b.CreatedAt)
        .FirstOrDefault();

    var backupsHeader = new Harbora.Web.ViewModels.PageHeaderModel(
        T["Backups"].Value,
        isFa ? "پشتیبان‌گیری و بازگردانی داده‌ها." : "Protect your data with automated backups.");

    var totalCard = new Harbora.Web.ViewModels.StatCardModel("archive",
        T["Backups"].Value,
        Harbora.Infrastructure.Monitoring.MetricDisplay.For(Model.Backups.Count),
        isFa ? $"{completed} موفق" : $"{completed} completed");

    var failedCard = new Harbora.Web.ViewModels.StatCardModel("rocket",
        isFa ? "ناموفق" : "Failed",
        Harbora.Infrastructure.Monitoring.MetricDisplay.For(failedCount),
        failedCount == 0 ? (isFa ? "همه سالم" : "all healthy") : (isFa ? "نیاز به بررسی" : "needs attention"));

    var sizeCard = new Harbora.Web.ViewModels.StatCardModel("layers",
        isFa ? "حجم ذخیره‌شده" : "Stored",
        Harbora.Infrastructure.Monitoring.MetricDisplay.ForText(
            storedBytes > 0 ? Harbora.Infrastructure.Tenancy.ByteSize.Measured(storedBytes) : null),
        isFa ? $"{Model.Destinations.Count} مقصد" : $"{Model.Destinations.Count} destinations");

    // "19 ساعت پیش", not "ساعت 19.2" — raw TotalHours is a number nobody says out loud.
    var lastCard = new Harbora.Web.ViewModels.StatCardModel("activity",
        isFa ? "آخرین پشتیبان" : "Last backup",
        latest is null
            ? Harbora.Infrastructure.Monitoring.MetricDisplay.For(null)
            : Harbora.Infrastructure.Monitoring.MetricDisplay.ForText(
                Dates.Ago(latest.CreatedAt, DateTimeOffset.UtcNow, isFa)),
        latest?.CreatedAt.LocalDateTime.ToString(Dates.Stamp));

    // ---- SFTP add-destination fold (PanelMode fold-never-remove, do-not-change list item 23) ----
    // Simple mode folds the SFTP connection fields; Advanced mode and a rejection both start them
    // open — a block folded over the field the server just complained about (usually the missing
    // host key) is an error nobody can see.
    var destinationSftpRejected = TempData["DestinationSftpRejected"] is true;
    var sftpAdvancedOpen = Harbora.Infrastructure.Navigation.PanelSections.StartsOpen(
        await PanelModes.GetAsync(), destinationSftpRejected);

    // Everything but the password travels back across the redirect, so a rejected submission is one
    // field to fix — not the whole form to retype. Read with ToString() rather than `as string`:
    // TempData re-types a GUID-shaped string as a System.Guid on the way back, and a plain `as string`
    // would silently come back null for one.
    Harbora.Web.ViewModels.RejectedSftpSubmission? rejectedSftp = destinationSftpRejected
        ? new Harbora.Web.ViewModels.RejectedSftpSubmission(
            TempData["RejectedDestinationName"]?.ToString(),
            TempData["RejectedSftpHost"]?.ToString(),
            int.TryParse(TempData["RejectedSftpPort"]?.ToString(), out var rejectedPort) ? rejectedPort : 22,
            TempData["RejectedSftpUsername"]?.ToString(),
            TempData["RejectedSftpDirectory"]?.ToString(),
            TempData["RejectedSftpHostKey"]?.ToString())
        : null;

    var context = new Harbora.Web.ViewModels.BackupsViewContext
    {
        Page = Model,
        IsFa = isFa,
        TargetLabel = TargetLabel,
        DestinationName = DestinationName,
        Size = Size,
        StatusTone = StatusTone,
        SftpAdvancedOpen = sftpAdvancedOpen,
        RejectedSftp = rejectedSftp
    };
}

<div class="mb-6">
    <partial name="Design/_PageHeader" model="backupsHeader" />
</div>

<div class="mb-6 grid grid-cols-2 gap-4 xl:grid-cols-4">
    <partial name="Design/_StatCard" model="totalCard" />
    <partial name="Design/_StatCard" model="failedCard" />
    <partial name="Design/_StatCard" model="sizeCard" />
    <partial name="Design/_StatCard" model="lastCard" />
</div>

@if (msg is not null)
{
    <div class="alert-success mb-4 flex flex-wrap items-center justify-between gap-2">
        <span>@msg</span>
        @if (msgLinksToActivity)
        {
            <a href="/activity" data-message-activity-link class="shrink-0 font-medium underline">@(isFa ? "دیدن در فعالیت" : "View in Activity")</a>
        }
    </div>
}
@if (err is not null){<div class="alert-danger mb-4">@err</div>}

<partial name="_QuickActions" model="context" />
<partial name="_Destinations" model="context" />
<partial name="_Schedules" model="context" />
<partial name="_Deliveries" model="context" />
<partial name="_History" model="context" />

@section Scripts {
<script>
    // Destination form: show only the fields the chosen type uses.
    document.querySelectorAll('[data-dest-form]').forEach(function (form) {
        var sel = form.querySelector('[data-dest-type]');
        function sync(){ form.querySelector('[data-when-local]').style.display = sel.value==='Local'?'':'none';
                         form.querySelector('[data-when-s3]').style.display = sel.value==='S3'?'':'none';
                         form.querySelector('[data-when-sftp]').style.display = sel.value==='Sftp'?'':'none'; }
        sel.addEventListener('change', sync); sync();
    });

    // One handler for every form that wants a word typed before it will submit. It was written for
    // RESTORE alone; delete needs the same thing, and a second copy would be a second chance for one
    // of them to quietly stop asking.
    document.querySelectorAll('[data-confirm-word]').forEach(function (form) {
        form.addEventListener('submit', function (e) {
            var word = form.dataset.confirmWord;
            var typed = prompt(form.dataset.confirmPrompt);
            if (typed !== word) { e.preventDefault(); return; }
            form.querySelector('input[name=confirm]').value = word;
        });
    });
</script>
@* Two script blocks, one section: Razor allows a section name only once per view, and
   the second one made this whole page throw. *@

<script>
// Show only the fields for the chosen channel, and look up Telegram chat ids on request.
(function () {
    const form = document.querySelector('[data-delivery-form]');
    if (!form) return;

    const select = form.querySelector('[data-delivery-channel]');
    const panels = form.querySelectorAll('[data-channel]');
    const show = () => panels.forEach(p => p.classList.toggle('hidden', p.dataset.channel !== select.value));
    select.addEventListener('change', show);
    show();

    form.querySelector('[data-find-chats]').addEventListener('click', async () => {
        const token = form.querySelector('[data-bot-token]').value.trim();
        const hint = form.querySelector('[data-chat-hint]');
        hint.classList.remove('hidden');
        hint.textContent = 'Asking Telegram...';

        const body = new FormData();
        body.append('botToken', token);
        body.append('__RequestVerificationToken', form.querySelector('input[name="__RequestVerificationToken"]').value);

        try {
            const res = await fetch('/backups/deliveries/chat-ids', { method: 'POST', body });
            const data = await res.json();
            if (data.error) { hint.textContent = data.error; return; }
            if (!data.chats || data.chats.length === 0) { hint.textContent = data.hint || 'Nothing found yet.'; return; }

            // One chat is the normal case: fill it in rather than making somebody copy a number.
            form.querySelector('[data-chat-id]').value = data.chats[0].id;
            hint.textContent = data.chats.length === 1
                ? 'Found ' + data.chats[0].title + ' (' + data.chats[0].id + ').'
                : 'Found: ' + data.chats.map(c => c.title + ' = ' + c.id).join(', ');
        } catch (e) {
            hint.textContent = 'Could not reach the server: ' + e.message;
        }
    });
})();
</script>
}
