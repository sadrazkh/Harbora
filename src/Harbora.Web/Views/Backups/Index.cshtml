@model BackupsPageViewModel
@{
    ViewData["Title"] = "Backups";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var msg = TempData["Message"] as string;
    var err = TempData["Error"] as string;
    string Size(long b) => b <= 0 ? "—" : b < 1048576 ? $"{b / 1024.0:0} KB" : $"{b / 1048576.0:0.0} MB";
    string StatusClass(Harbora.Domain.Common.BackupStatus s) => s switch
    {
        Harbora.Domain.Common.BackupStatus.Completed => "bg-ok/15 text-ok",
        Harbora.Domain.Common.BackupStatus.Failed => "bg-danger/15 text-danger",
        Harbora.Domain.Common.BackupStatus.Running or Harbora.Domain.Common.BackupStatus.Pending => "bg-accent-hover/15 text-accent-text animate-pulse",
        _ => "bg-slate-500/15 text-ink"
    };
}
@{
    // Every figure here is counted from real backup rows. The mockup also shows a success rate,
    // deduplication savings and a retention policy; none of those are recorded, so none appear.
    var completed = Model.Backups.Count(b => b.Status == Harbora.Domain.Common.BackupStatus.Completed);
    var failedCount = Model.Backups.Count(b => b.Status == Harbora.Domain.Common.BackupStatus.Failed);
    var storedBytes = Model.Backups.Sum(b => b.SizeBytes);
    var latest = Model.Backups
        .Where(b => b.Status == Harbora.Domain.Common.BackupStatus.Completed)
        .OrderByDescending(b => b.CreatedAt)
        .FirstOrDefault();

    var backupsHeader = new Harbora.Web.ViewModels.PageHeaderModel(
        T["Backups"].Value,
        isFa ? "پشتیبان‌گیری و بازگردانی داده‌ها." : "Protect your data with automated backups.");

    var totalCard = new Harbora.Web.ViewModels.StatCardModel("archive",
        T["Backups"].Value,
        Harbora.Infrastructure.Monitoring.MetricDisplay.For(Model.Backups.Count),
        isFa ? $"{completed} موفق" : $"{completed} completed");

    var failedCard = new Harbora.Web.ViewModels.StatCardModel("rocket",
        isFa ? "ناموفق" : "Failed",
        Harbora.Infrastructure.Monitoring.MetricDisplay.For(failedCount),
        failedCount == 0 ? (isFa ? "همه سالم" : "all healthy") : (isFa ? "نیاز به بررسی" : "needs attention"));

    // Unknown size is not zero bytes: a backup whose size was never recorded is not an empty one.
    var sizeCard = new Harbora.Web.ViewModels.StatCardModel("layers",
        isFa ? "حجم ذخیره‌شده" : "Stored",
        Harbora.Infrastructure.Monitoring.MetricDisplay.For(
            storedBytes > 0 ? storedBytes / 1048576.0 : null, " MB"),
        isFa ? $"{Model.Destinations.Count} مقصد" : $"{Model.Destinations.Count} destinations");

    var lastCard = new Harbora.Web.ViewModels.StatCardModel("activity",
        isFa ? "آخرین پشتیبان" : "Last backup",
        latest is null
            ? Harbora.Infrastructure.Monitoring.MetricDisplay.For(null)
            : Harbora.Infrastructure.Monitoring.MetricDisplay.For(
                (DateTimeOffset.UtcNow - latest.CreatedAt).TotalHours, isFa ? " ساعت" : "h"),
        latest?.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm"));
}

<div class="mb-6">
    <partial name="Design/_PageHeader" model="backupsHeader" />
</div>

<div class="mb-6 grid grid-cols-2 gap-4 xl:grid-cols-4">
    <partial name="Design/_StatCard" model="totalCard" />
    <partial name="Design/_StatCard" model="failedCard" />
    <partial name="Design/_StatCard" model="sizeCard" />
    <partial name="Design/_StatCard" model="lastCard" />
</div>

@if (msg is not null){<div class="mb-4 rounded-lg bg-ok-soft border border-ok text-ok px-4 py-2 text-sm">@msg</div>}
@if (err is not null){<div class="mb-4 rounded-lg bg-danger-soft border border-danger text-danger px-4 py-2 text-sm">@err</div>}

<div class="grid lg:grid-cols-3 gap-6">
    <!-- Run a backup -->
    <section class="rounded-xl border border-line bg-surface p-5">
        <h2 class="text-[15px] font-semibold text-ink mb-3">@T["Run backup"]</h2>
        <form asp-controller="Backups" asp-action="Run" method="post" class="space-y-3">
            @Html.AntiForgeryToken()
            <select name="target" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm">
                @foreach (var (val, label) in Model.Targets){<option value="@val">@label</option>}
            </select>
            <select name="destinationId" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm">
                @foreach (var d in Model.Destinations){<option value="@d.Id">@d.Name (@d.Type)</option>}
            </select>
            <button class="w-full rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm font-semibold">@T["Run backup"]</button>
        </form>
    </section>

    <!-- Destinations -->
    <section class="rounded-xl border border-line bg-surface p-5">
        <h2 class="text-[15px] font-semibold text-ink mb-3">@T["Destinations"]</h2>
        <div class="space-y-1 mb-3 text-sm">
            @foreach (var d in Model.Destinations)
            {
                <div class="flex justify-between"><span>@d.Name</span><span class="text-ink-faint">@d.Type</span></div>
            }
        </div>
        <details>
            <summary class="cursor-pointer text-sm text-accent-text">+ @T["Add destination"]</summary>
            <form asp-controller="Backups" asp-action="CreateDestination" method="post" class="mt-3 space-y-2" data-dest-form>
                @Html.AntiForgeryToken()
                <input name="name" placeholder="Name" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                <select name="type" data-dest-type class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm">
                    <option value="Local">Local</option><option value="S3">S3-compatible</option><option value="Sftp">SFTP</option>
                </select>
                <div data-when-local><input name="localPath" placeholder="/var/lib/harbora/backups" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" /></div>
                <div data-when-s3 class="space-y-2" style="display:none">
                    <input name="endpoint" placeholder="https://s3.example.com" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                    <input name="bucket" placeholder="bucket" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                    <input name="region" placeholder="us-east-1" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                    <input name="accessKey" placeholder="access key" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                    <input name="secretKey" type="password" placeholder="secret key" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                </div>
                <button class="w-full rounded-lg bg-surface-2 hover:bg-surface-2 px-4 py-2 text-sm">@T["Save"]</button>
            </form>
        </details>
    </section>

    <!-- Schedules -->
    <section class="rounded-xl border border-line bg-surface p-5">
        <h2 class="text-[15px] font-semibold text-ink mb-3">@T["Schedules"]</h2>
        <div class="space-y-1 mb-3 text-sm">
            @foreach (var s in Model.Schedules)
            {
                <div class="flex items-center justify-between">
                    <span>@s.Type · every @s.IntervalHours h · keep @s.RetentionCount</span>
                    <form asp-controller="Backups" asp-action="DeleteSchedule" asp-route-id="@s.Id" method="post">@Html.AntiForgeryToken()<button class="text-xs text-danger">✕</button></form>
                </div>
                <div data-when-sftp class="space-y-2" style="display:none">
                    <input name="sftpHost" placeholder="backup.example.com" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                    <input name="sftpPort" type="number" value="22" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                    <input name="sftpUsername" placeholder="harbora" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                    <input name="sftpPassword" type="password" placeholder="password" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                    <input name="sftpDirectory" placeholder="/srv/harbora-backups" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                    <textarea name="sftpHostKey" rows="2" dir="ltr" placeholder="backup.example.com ssh-ed25519 AAAA…" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-xs font-mono"></textarea>
                    @* Required, not optional: without it Harbora cannot tell the real server from
                       anything else answering on that address. *@
                    <p class="text-xs text-ink-faint">
                        @(isFa
                            ? "کلید میزبان لازم است. با «ssh-keyscan your-host» بگیرید — بدون آن نمی‌توان مطمئن شد بکاپ به سرور درست می‌رود."
                            : "The host key is required. Get it with `ssh-keyscan your-host` — without it there is no way to know the backup is going to the right server.")
                    </p>
                </div>
            }
        </div>
        <details>
            <summary class="cursor-pointer text-sm text-accent-text">+ @T["Add schedule"]</summary>
            <form asp-controller="Backups" asp-action="CreateSchedule" method="post" class="mt-3 space-y-2">
                @Html.AntiForgeryToken()
                <select name="target" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm">
                    @foreach (var (val, label) in Model.Targets){<option value="@val">@label</option>}
                </select>
                <select name="destinationId" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm">
                    @foreach (var d in Model.Destinations){<option value="@d.Id">@d.Name</option>}
                </select>
                <div class="flex gap-2">
                    <input name="intervalHours" type="number" value="24" title="@T["Interval (hours)"]" class="w-1/2 rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                    <input name="retentionCount" type="number" value="7" title="@T["Retention"]" class="w-1/2 rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                </div>
                <button class="w-full rounded-lg bg-surface-2 hover:bg-surface-2 px-4 py-2 text-sm">@T["Add schedule"]</button>
            </form>
        </details>
    </section>

    <!-- Delivery: a copy of every scheduled backup, sent where you can reach it -->
    <section class="rounded-xl border border-line bg-surface p-5">
        <h2 class="font-semibold mb-1">@(isFa ? "ارسال بکاپ" : "Send backups to")</h2>
        <p class="text-xs text-ink-muted mb-3">
            @(isFa
                ? "از هر بکاپ (زمان‌بندی‌شده یا دستی) یک کپی به این مقصدها فرستاده می‌شود. نسخه‌ی اصلی همان‌جا که هست می‌ماند، چون بازگردانی از روی چت یا ایمیل ممکن نیست."
                : "A copy of every backup — scheduled or run by hand — is sent here. The stored artifact stays where it is — a chat or a mailbox is not something a restore can read from.")
        </p>

        <div class="space-y-2 mb-3 text-sm">
            @if (Model.Deliveries.Count == 0){<p class="text-ink-faint">—</p>}
            @foreach (var d in Model.Deliveries)
            {
                <div class="rounded-lg bg-surface-2 px-3 py-2">
                    <div class="flex items-center justify-between">
                        <span>
                            @d.Name <span class="text-ink-faint">· @d.Channel</span>
                            @if (d.LastError is not null)
                            {
                                <span class="text-xs text-danger">· @(isFa ? "ناموفق" : "failing")</span>
                            }
                            else if (d.LastAttemptAt is not null)
                            {
                                <span class="text-xs text-ok">· @(isFa ? "سالم" : "delivering")</span>
                            }
                        </span>
                        <div class="flex items-center gap-2">
                            <form asp-controller="Backups" asp-action="TestDelivery" asp-route-id="@d.Id" method="post">@Html.AntiForgeryToken()<button class="text-xs text-accent-text">test</button></form>
                            <form asp-controller="Backups" asp-action="DeleteDelivery" asp-route-id="@d.Id" method="post">@Html.AntiForgeryToken()<button class="text-xs text-danger">✕</button></form>
                        </div>
                    </div>
                    @if (d.LastError is not null)
                    {
                        <p class="mt-1 text-xs text-danger/90 break-all">@d.LastError</p>
                    }
                </div>
            }
        </div>

        <details>
            <summary class="cursor-pointer text-sm text-accent-text">+ @(isFa ? "افزودن مقصد ارسال" : "Add a delivery channel")</summary>
            <form asp-controller="Backups" asp-action="CreateDelivery" method="post" class="mt-3 space-y-2" data-delivery-form>
                @Html.AntiForgeryToken()
                <input name="name" placeholder="@(isFa ? "نام" : "Name")" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                <select name="channel" data-delivery-channel class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm">
                    <option value="Telegram">Telegram</option>
                    <option value="Email">Email</option>
                </select>

                <div data-channel="Telegram" class="space-y-2">
                    <p class="text-xs text-ink-muted">
                        @(isFa
                            ? "۱) در تلگرام از @@BotFather یک ربات بساز و توکنش را اینجا بگذار. ۲) ربات را باز کن و Start را بزن. ۳) دکمه‌ی زیر آی‌دی چت را پیدا می‌کند."
                            : "1) Create a bot with @@BotFather and paste its token. 2) Open the bot and press Start. 3) The button below finds your chat id.")
                    </p>
                    <input name="botToken" data-bot-token placeholder="123456:ABC-DEF..." class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm font-mono" />
                    <div class="flex gap-2">
                        <input name="chatId" data-chat-id placeholder="@(isFa ? "آی‌دی چت" : "Chat id")" class="flex-1 rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm font-mono" />
                        <button type="button" data-find-chats class="rounded-lg bg-surface-2 hover:bg-surface-2 px-3 py-2 text-sm whitespace-nowrap">@(isFa ? "پیدا کن" : "Find")</button>
                    </div>
                    <p data-chat-hint class="text-xs text-ink-muted hidden"></p>
                </div>

                <div data-channel="Email" class="space-y-2 hidden">
                    <div class="flex gap-2">
                        <input name="smtpHost" placeholder="smtp.example.com" class="flex-1 rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                        <input name="smtpPort" type="number" value="587" class="w-24 rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                    </div>
                    <input name="smtpUser" placeholder="@(isFa ? "نام کاربری" : "SMTP user")" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                    <input name="smtpPassword" type="password" placeholder="@(isFa ? "رمز" : "SMTP password")" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                    <input name="emailFrom" placeholder="backups@@example.com" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                    <input name="emailTo" placeholder="you@@example.com" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                </div>

                <label class="block text-xs text-ink-muted">
                    @(isFa ? "بیشترین حجم (مگابایت، خالی = پیش‌فرض کانال)" : "Max size (MB, blank = the channel's own limit)")
                    <input name="maxSizeMb" type="number" min="0" placeholder="0" class="mt-1 w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                </label>

                <button class="w-full rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm font-semibold">@(isFa ? "افزودن" : "Add")</button>
            </form>
        </details>
    </section>
</div>

<!-- History -->
<h2 class="text-lg font-semibold text-ink mt-8 mb-3">@T["History"]</h2>
<div class="rounded-xl border border-line bg-surface overflow-hidden">
    <table class="w-full text-sm">
        <thead class="text-ink-muted border-b border-line">
            <tr>
                <th class="p-3 text-start">@T["Target"]</th><th class="p-3 text-start">@T["Type"]</th>
                <th class="p-3 text-start">@T["Status"]</th><th class="p-3 text-start">@(isFa ? "بازیابی" : "Restore check")</th><th class="p-3 text-start">Size</th>
                <th class="p-3 text-start">@T["Destination"]</th><th class="p-3 text-end">@T["Actions"]</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-line">
            @if (Model.Backups.Count == 0){<tr><td colspan="6" class="p-4 text-ink-muted">—</td></tr>}
            @foreach (var b in Model.Backups)
            {
                <tr>
                    <td class="p-3 font-mono text-xs">@b.TargetRef</td>
                    <td class="p-3">@b.Type</td>
                    <td class="p-3"><span class="rounded-full px-2 py-0.5 text-xs @StatusClass(b.Status)">@b.Status</span></td>
                    @* What matters about a backup is not that it ran, which is already visible, but
                       whether anyone has confirmed it would restore — and how long ago. *@
                    <td class="p-3">
                        @if (b.VerifiedRestorable == true)
                        {
                            <span class="rounded-full px-2 py-0.5 text-xs bg-ok/15 text-ok"
                                  title="@b.VerifiedAt?.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC">
                                @(isFa ? "بازیابی تأیید شد" : "Restore checked")</span>
                        }
                        else if (b.VerifiedRestorable == false)
                        {
                            <span class="rounded-full px-2 py-0.5 text-xs bg-danger/15 text-danger" title="@b.VerificationNote">
                                @(isFa ? "بازیابی نمی‌شود" : "Will not restore")</span>
                        }
                        else if (b.Status == Harbora.Domain.Common.BackupStatus.Completed)
                        {
                            @* Deliberately not blank: "not checked yet" and "checked and fine" are
                               different things and must not look the same. *@
                            <span class="rounded-full px-2 py-0.5 text-xs bg-slate-500/15 text-ink-muted">
                                @(isFa ? "بررسی نشده" : "Not checked yet")</span>
                        }
                    </td>
                    <td class="p-3 text-ink-muted">@Size(b.SizeBytes)</td>
                    <td class="p-3 text-ink-muted">@b.Destination?.Name</td>
                    <td class="p-3">
                        <div class="flex items-center justify-end gap-2">
                            @if (b.Status == Harbora.Domain.Common.BackupStatus.Completed)
                            {
                                <a href="/backups/@b.Id/download" class="text-xs rounded-lg bg-surface-2 hover:bg-surface-2 px-2 py-1">@T["Download"]</a>
                                <form asp-controller="Backups" asp-action="Restore" asp-route-id="@b.Id" method="post" data-restore>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="confirm" />
                                    <button class="text-xs rounded-lg bg-warn-soft hover:bg-warn-soft text-warn px-2 py-1">@T["Restore"]</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    // Destination form: toggle local/S3 fields
    document.querySelectorAll('[data-dest-form]').forEach(function (form) {
        var sel = form.querySelector('[data-dest-type]');
        function sync(){ form.querySelector('[data-when-local]').style.display = sel.value==='Local'?'':'none';
                         form.querySelector('[data-when-s3]').style.display = sel.value==='S3'?'':'none';
                         form.querySelector('[data-when-sftp]').style.display = sel.value==='Sftp'?'':'none'; }
        sel.addEventListener('change', sync); sync();
    });
    // Restore: require typing RESTORE
    document.querySelectorAll('[data-restore]').forEach(function (form) {
        form.addEventListener('submit', function (e) {
            var v = prompt('@(isFa ? "این عملیات داده‌ی فعلی را بازنویسی می‌کند. برای تأیید RESTORE را تایپ کنید:" : "This overwrites current data. Type RESTORE to confirm:")');
            if (v !== 'RESTORE') { e.preventDefault(); return; }
            form.querySelector('input[name=confirm]').value = 'RESTORE';
        });
    });
</script>
@* Two script blocks, one section: Razor allows a section name only once per view, and
   the second one made this whole page throw. *@

<script>
// Show only the fields for the chosen channel, and look up Telegram chat ids on request.
(function () {
    const form = document.querySelector('[data-delivery-form]');
    if (!form) return;

    const select = form.querySelector('[data-delivery-channel]');
    const panels = form.querySelectorAll('[data-channel]');
    const show = () => panels.forEach(p => p.classList.toggle('hidden', p.dataset.channel !== select.value));
    select.addEventListener('change', show);
    show();

    form.querySelector('[data-find-chats]').addEventListener('click', async () => {
        const token = form.querySelector('[data-bot-token]').value.trim();
        const hint = form.querySelector('[data-chat-hint]');
        hint.classList.remove('hidden');
        hint.textContent = 'Asking Telegram...';

        const body = new FormData();
        body.append('botToken', token);
        body.append('__RequestVerificationToken', form.querySelector('input[name="__RequestVerificationToken"]').value);

        try {
            const res = await fetch('/backups/deliveries/chat-ids', { method: 'POST', body });
            const data = await res.json();
            if (data.error) { hint.textContent = data.error; return; }
            if (!data.chats || data.chats.length === 0) { hint.textContent = data.hint || 'Nothing found yet.'; return; }

            // One chat is the normal case: fill it in rather than making someone copy a number.
            form.querySelector('[data-chat-id]').value = data.chats[0].id;
            hint.textContent = data.chats.length === 1
                ? 'Found ' + data.chats[0].title + ' (' + data.chats[0].id + ').'
                : 'Found: ' + data.chats.map(c => c.title + ' = ' + c.id).join(', ');
        } catch (e) {
            hint.textContent = 'Could not reach the server: ' + e.message;
        }
    });
})();
</script>
}
