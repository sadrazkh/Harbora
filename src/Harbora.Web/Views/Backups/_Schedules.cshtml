@model BackupsViewContext
@{
    var isFa = Model.IsFa;
}
@* ---- schedules ----
   Editable now, and pausable. They could only be created and deleted, so changing an interval meant
   losing the row — and pausing one for a maintenance window was not possible at all, which is what
   IsEnabled was on the entity for. *@
<h2 class="mb-3 text-lg font-semibold text-ink">@T["Schedules"]</h2>
@if (Model.Page.Schedules.Count == 0)
{
    <div class="mb-6 rounded-xl border border-line bg-surface">
        <partial name="Design/_EmptyState" model="@(new EmptyStateModel(
            "calendar-clock",
            isFa ? "هنوز هیچ زمان‌بندی‌ای ساخته نشده — پشتیبان‌گیری هنوز فقط دستی است."
                 : "No schedule exists yet — backups are still only ever run by hand."))" />
    </div>
}
<div class="mb-6 grid gap-4 lg:grid-cols-2 xl:grid-cols-3">
    @foreach (var s in Model.Page.Schedules)
    {
        <section class="rounded-xl border border-line bg-surface p-4 @(s.IsEnabled ? "" : "opacity-70")">
            <div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="min-w-0 truncate font-semibold text-ink">@Model.TargetLabel(s.Type, s.TargetRef)</h3>
                @if (!s.IsEnabled)
                {
                    <span class="status-pill bg-warn-soft text-warn">@(isFa ? "متوقف" : "paused")</span>
                }
            </div>
            <p class="mb-3 text-[11px] text-ink-faint">
                @(isFa ? "به" : "to") @Model.DestinationName(s.DestinationId)
                @if (s.NextRunAt is { } next && s.IsEnabled)
                {
                    <span> · @(isFa ? "بعدی" : "next") <span dir="ltr">@next.LocalDateTime.ToString(Dates.Stamp)</span></span>
                }
                else if (s.LastRunAt is { } last)
                {
                    <span> · @(isFa ? "آخرین" : "last") <span dir="ltr">@last.LocalDateTime.ToString(Dates.Stamp)</span></span>
                }
            </p>

            <form asp-controller="Backups" asp-action="UpdateSchedule" asp-route-id="@s.Id" method="post" class="space-y-2">
                @Html.AntiForgeryToken()
                <div class="grid grid-cols-2 gap-2">
                    <label class="form-field"><span>@T["Interval (hours)"]</span>
                        <input name="intervalHours" type="number" min="1" value="@s.IntervalHours" dir="ltr"
                               class="form-control text-sm" /></label>
                    <label class="form-field"><span>@T["Retention"]</span>
                        <input name="retentionCount" type="number" min="1" value="@s.RetentionCount" dir="ltr"
                               class="form-control text-sm" /></label>
                </div>
                @* A hidden false in FRONT of the checkbox: an unchecked box posts nothing at all, and
                   last value wins — after the checkbox it would overwrite every tick. *@
                <input type="hidden" name="enabled" value="false" />
                <label class="flex items-center gap-2 text-xs text-ink">
                    <input type="checkbox" name="enabled" value="true" checked="@s.IsEnabled" />
                    <span>@(isFa ? "فعال" : "Enabled")</span>
                </label>
                <button class="btn-secondary w-full justify-center py-2 text-sm">@T["Save"]</button>
            </form>

            @* Typed confirmation, the same DELETE the destination and History delete buttons ask for
               (do-not-change list item 19). *@
            <form asp-controller="Backups" asp-action="DeleteSchedule" asp-route-id="@s.Id" method="post"
                  class="mt-3 border-t border-line pt-3" data-confirm-word="DELETE"
                  data-confirm-prompt="@(isFa ? "این زمان‌بندی پاک شود؟ نسخه‌های گرفته‌شده می‌مانند. برای تأیید DELETE را تایپ کنید:" : "Delete this schedule? The backups it took are kept. Type DELETE to confirm:")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="confirm" />
                <button class="text-xs text-danger">
                    @(isFa ? "حذف زمان‌بندی" : "Delete schedule")
                </button>
            </form>
        </section>
    }

    <section class="rounded-xl border border-dashed border-line bg-surface-2 p-4">
        <h3 class="mb-3 font-semibold text-ink">+ @T["Add schedule"]</h3>
        <form asp-controller="Backups" asp-action="CreateSchedule" method="post" class="space-y-2">
            @Html.AntiForgeryToken()
            <label class="form-field"><span>@T["Target"]</span>
                <select name="target" class="form-control text-sm">
                    @foreach (var (val, label) in Model.Page.Targets){<option value="@val">@label</option>}
                </select></label>
            <label class="form-field"><span>@T["Destination"]</span>
                <select name="destinationId" class="form-control text-sm">
                    @foreach (var d in Model.Page.Destinations){<option value="@d.Id">@d.Name</option>}
                </select></label>
            <div class="grid grid-cols-2 gap-2">
                <label class="form-field"><span>@T["Interval (hours)"]</span>
                    <input name="intervalHours" type="number" min="1" value="24" dir="ltr" class="form-control text-sm" /></label>
                <label class="form-field"><span>@T["Retention"]</span>
                    <input name="retentionCount" type="number" min="1" value="7" dir="ltr" class="form-control text-sm" /></label>
            </div>
            <button class="btn-secondary w-full justify-center py-2 text-sm">@T["Add schedule"]</button>
        </form>
    </section>
</div>
