@model AppDataEditViewModel
@{
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var parent = Harbora.Infrastructure.Storage.VolumePath.ParentOf(Model.Path) ?? string.Empty;
}

<nav class="breadcrumb mb-4" aria-label="breadcrumb">
    <a href="/apps/details/@Model.AppId">@Model.AppName</a>
    <i data-lucide="chevron-right" class="h-3.5 w-3.5 rtl:rotate-180"></i>
    <a href="/apps/@Model.AppId/data?volumeId=@Model.VolumeId&amp;path=@Uri.EscapeDataString(parent)">@(isFa ? "داده" : "Data")</a>
    <i data-lucide="chevron-right" class="h-3.5 w-3.5 rtl:rotate-180"></i>
    <span dir="ltr">@Harbora.Infrastructure.Storage.VolumePath.NameOf(Model.Path)</span>
</nav>

<partial name="Design/_PageHeader" model="@(new PageHeaderModel(
    Harbora.Infrastructure.Storage.VolumePath.NameOf(Model.Path),
    isFa
        ? "این همان فایلی است که برنامه می‌خواند. ذخیره فوری اعمال می‌شود."
        : "This is the file the application reads. Saving takes effect immediately."))" />

<form asp-action="Save" asp-route-id="@Model.AppId" method="post" class="space-y-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="volumeId" value="@Model.VolumeId" />
    <input type="hidden" name="path" value="@Model.Path" />

    @* Deliberately a plain textarea. A syntax-highlighting editor here would be a second parser
       between somebody and their own file, and the failure mode of that is a saved file that is not
       what was on the screen. *@
    <textarea name="content" rows="24" spellcheck="false" dir="ltr"
              class="form-control w-full font-mono text-xs leading-5"
              @(Model.IsReadOnly ? "readonly" : "")>@Model.Content</textarea>

    <div class="flex flex-wrap items-center gap-3">
        @if (!Model.IsReadOnly)
        {
            <button class="btn-primary px-4 py-2">@(isFa ? "ذخیره" : "Save")</button>
        }
        <a href="/apps/@Model.AppId/data?volumeId=@Model.VolumeId&amp;path=@Uri.EscapeDataString(parent)"
           class="btn-secondary px-4 py-2">@(isFa ? "انصراف" : "Cancel")</a>
        <a href="/apps/@Model.AppId/data/download?volumeId=@Model.VolumeId&amp;path=@Uri.EscapeDataString(Model.Path)"
           class="text-xs text-accent-text hover:underline">@(isFa ? "دانلود نسخهٔ فعلی" : "Download the current copy")</a>
    </div>

    <p class="text-[11px] text-ink-faint">
        @(isFa
            ? "به‌عنوان UTF-8 ذخیره می‌شود. برای اینکه برنامه تغییر را ببیند معمولاً باید ری‌استارت شود."
            : "Saved as UTF-8. The application usually needs a restart before it sees the change.")
    </p>
</form>
