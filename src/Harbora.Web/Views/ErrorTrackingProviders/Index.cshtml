@model ErrorTrackingProvidersPageViewModel
@{
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var message = TempData["Message"] as string;
    var error = TempData["Error"] as string;
}

<partial name="Design/_PageHeader" model="@(new PageHeaderModel(
    isFa ? "رهگیری خطا" : "Error tracking",
    isFa
        ? "DSN سازگار با Sentry خودتان — از یک GlitchTip که با قالب یک‌کلیکی مستقر کرده‌اید، یا از Sentry SaaS. Harbora آن را رمزنگاری و ذخیره می‌کند و به‌صورت متغیر SENTRY_DSN به اپ متصل تزریق می‌کند — بدون رله؛ کانتینر اپ مستقیماً با میزبان DSN صحبت می‌کند. اگر اپی خودش از قبل SENTRY_DSN دارد، مقدار خودِ اپ همیشه برنده است."
        : "Your own Sentry-compatible DSN — from a GlitchTip you deployed with the one-click template, or from Sentry SaaS. Harbora encrypts and stores it and injects it into an attached app as SENTRY_DSN — no relay in front of it; the app's own container speaks directly to the DSN's host. If an app already sets its own SENTRY_DSN, the app's own value always wins."))" />

@if (message is not null) { <div class="alert-success mb-4">@message</div> }
@if (error is not null) { <div class="alert-danger mb-4">@error</div> }

@if (Model.Providers.Count == 0)
{
    <partial name="Design/_EmptyState" model="@(new EmptyStateModel("alert-triangle",
        isFa ? "هنوز ارائه‌دهنده‌ای اضافه نشده." : "No error-tracking providers yet."))" />
}
else
{
    <div class="mb-6 space-y-3">
        @foreach (var provider in Model.Providers)
        {
            <section class="rounded-xl border border-line bg-surface p-5 shadow-panel" data-error-tracking-provider="@provider.Name" data-error-tracking-provider-id="@provider.Id">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0">
                        <strong class="text-sm text-ink">@provider.Name</strong>
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                        <form asp-action="Delete" asp-route-id="@provider.Id" method="post"
                              onsubmit="return confirm('@(isFa ? "ارائه‌دهنده حذف شود؟" : "Delete this error-tracking provider?")');">
                            @Html.AntiForgeryToken()
                            <button class="btn-secondary px-3 py-1.5 text-xs">@(isFa ? "حذف" : "Delete")</button>
                        </form>
                    </div>
                </div>

                <dl class="mt-4 grid gap-3 border-t border-line pt-3 text-xs">
                    <div>
                        <dt class="text-ink-faint">DSN</dt>
                        <dd class="text-ink" dir="ltr">
                            @if (provider.Dsn is { } secret)
                            {
                                <code>@secret</code>
                            }
                            else
                            {
                                @* One at a time, and only on a click — a page that prints every secret
                                   is a page nobody can screen-share (the StorageController rule). *@
                                <a href="/error-tracking?reveal=@provider.Id" class="text-accent-text hover:underline">
                                    @(isFa ? "نمایش" : "Reveal")
                                </a>
                            }
                        </dd>
                    </div>
                </dl>

                @* ---- attach to app ----
                   1.8 (2026-09 market-gaps round two): the EmailProvidersController attach shape (F6),
                   reused — the SENTRY_DSN variable reaches the app's environment on its own next
                   deploy. *@
                <div class="mt-4 border-t border-line pt-3" data-error-tracking-provider-attach-panel data-error-tracking-provider-id="@provider.Id">
                    <div class="flex items-center justify-between gap-2 mb-2">
                        <span class="text-xs font-semibold text-ink-muted">@(isFa ? "اپ‌های متصل" : "Attached apps")</span>
                    </div>

                    @if (provider.AttachedApps.Count == 0)
                    {
                        <p class="text-xs text-ink-faint">@(isFa ? "به هیچ اپی متصل نیست." : "Not attached to any app.")</p>
                    }
                    else
                    {
                        <div class="space-y-1.5">
                            @foreach (var a in provider.AttachedApps)
                            {
                                <div class="flex items-center justify-between gap-2 rounded-lg bg-surface-2 px-3 py-1.5 text-xs" data-attached-app="@a.AppName">
                                    <span>
                                        <span class="font-medium">@a.AppName</span>
                                        @if (a.HasUnpublishedChanges)
                                        {
                                            <span data-error-tracking-provider-attach-state="unpublished" class="ms-1 rounded-md bg-warn-soft px-1.5 py-0.5 text-warn">@(isFa ? "با استقرار بعدی اعمال می‌شود" : "applies on next deploy")</span>
                                        }
                                        else
                                        {
                                            <span data-error-tracking-provider-attach-state="live" class="ms-1 rounded-md bg-ok-soft px-1.5 py-0.5 text-ok">@(isFa ? "به‌روز" : "live")</span>
                                        }
                                    </span>
                                    <form asp-action="Detach" asp-route-id="@provider.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="appId" value="@a.AppId" />
                                        <button class="text-danger" aria-label="@(isFa ? $"جدا کردن {a.AppName}" : $"Detach {a.AppName}")">✕</button>
                                    </form>
                                </div>
                            }
                        </div>
                    }

                    @if (provider.AvailableApps.Count > 0)
                    {
                        <form asp-action="Attach" asp-route-id="@provider.Id" method="post" class="mt-2 flex gap-2">
                            @Html.AntiForgeryToken()
                            <select name="appId" class="flex-1 rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-xs">
                                @foreach (var a in provider.AvailableApps)
                                {
                                    <option value="@a.Id">@a.Name</option>
                                }
                            </select>
                            <button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-3 py-1.5 text-xs font-semibold">
                                @(isFa ? "اتصال" : "Attach")
                            </button>
                        </form>
                    }
                </div>
            </section>
        }
    </div>
}

<section class="rounded-xl border border-line bg-surface p-5">
    <h2 class="text-[15px] font-semibold text-ink mb-3">@(isFa ? "ارائه‌دهندهٔ جدید" : "New error-tracking provider")</h2>

    <form asp-action="Create" method="post" class="grid gap-4 sm:grid-cols-2">
        @Html.AntiForgeryToken()
        <div>
            <label class="form-label" for="et-name">@(isFa ? "نام" : "Name")</label>
            <input id="et-name" name="name" required class="form-control" placeholder="GlitchTip" />
        </div>
        <div>
            <label class="form-label" for="et-dsn">DSN</label>
            <input id="et-dsn" name="dsn" required class="form-control font-mono" dir="ltr" placeholder="https://key@host/1" />
        </div>

        <div class="sm:col-span-2">
            <button class="btn-primary px-4 py-2">@(isFa ? "ساخت ارائه‌دهنده" : "Create provider")</button>
        </div>
    </form>
</section>
