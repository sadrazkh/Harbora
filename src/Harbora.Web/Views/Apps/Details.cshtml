@model App
@{
    ViewData["Title"] = Model.Name;
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var msg = TempData["Message"] as string; var err = TempData["Error"] as string;
    var running = Model.Status == AppStatus.Running;
}
<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
        <a href="/apps" class="text-brand-400 text-sm">← @T["Applications"]</a>
        <h1 class="text-2xl font-bold flex items-center gap-3">@Model.Name <partial name="_StatusBadge" model="Model.Status" /></h1>
        <p class="text-slate-400 text-sm">@Model.Slug · @Model.SourceType @(Model.GitRepository is not null ? "· " + Model.GitRepository.FullName : "")
            @if (!string.IsNullOrEmpty(Model.InstanceSizeKey)){<span>· @Model.InstanceSizeKey</span>}
        </p>
    </div>
    <div class="flex flex-wrap gap-2">
        <form asp-controller="Apps" asp-action="Deploy" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button class="rounded-lg bg-brand-600 hover:bg-brand-500 px-4 py-2 text-sm font-semibold">@T["Deploy"]</button></form>
        @if (Model.Kind == ServiceKind.Cron)
        {
            @* Without this a nightly job cannot be checked until tomorrow. It takes the same path the
               schedule does, so what is tested here is what will happen at 03:00. *@
            <form asp-controller="Apps" asp-action="RunNow" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button class="rounded-lg bg-brand-600 hover:bg-brand-500 px-4 py-2 text-sm font-semibold">▶ @T["Run now"]</button></form>
        }
        <form asp-controller="Apps" asp-action="Restart" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button class="rounded-lg bg-slate-800 hover:bg-slate-700 px-3 py-2 text-sm">↻ @T["Restart"]</button></form>
        @if (running)
        {
            <form asp-controller="Apps" asp-action="Stop" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button class="rounded-lg bg-slate-800 hover:bg-slate-700 px-3 py-2 text-sm">⏸ @T["Stop"]</button></form>
        }
        else
        {
            <form asp-controller="Apps" asp-action="Start" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button class="rounded-lg bg-slate-800 hover:bg-slate-700 px-3 py-2 text-sm">▶ @T["Start"]</button></form>
        }
        <a href="/apps/@Model.Id/logs" class="rounded-lg bg-slate-800 hover:bg-slate-700 px-3 py-2 text-sm">📜 @T["Logs"]</a>
    </div>
</div>

@if (msg is not null){<div class="mb-4 rounded-lg bg-emerald-900/20 border border-emerald-700 text-emerald-300 px-4 py-2 text-sm">@msg</div>}
@if (err is not null){<div class="mb-4 rounded-lg bg-red-900/20 border border-red-700 text-red-300 px-4 py-2 text-sm">@err</div>}

<div class="grid lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
        @* ---- Scheduled runs ----
           For a cron service this is the app: there is no container to look at between runs, so
           "did it run, did it work, what did it say" can only be answered from history. It leads,
           because a deployment list answers none of those questions. *@
        @if (Model.Kind == ServiceKind.Cron)
        {
            var runs = ViewBag.CronRuns as List<Harbora.Domain.Apps.CronRun> ?? new();
            <section class="rounded-xl border border-slate-800 bg-slate-900/60">
                <div class="px-4 py-3 border-b border-slate-800 flex flex-wrap items-baseline justify-between gap-2">
                    <span class="font-semibold">@T["Scheduled runs"]</span>
                    @if (!string.IsNullOrWhiteSpace(Model.Command))
                    {
                        @* What it runs, on the page where its results are — the two are meaningless apart. *@
                        <code dir="ltr" class="rounded bg-black/50 px-2 py-0.5 text-xs text-slate-300">@Model.Command</code>
                    }
                    <span class="text-xs text-slate-400">
                        <span class="font-mono">@Model.CronExpression</span>
                        @{ var described = Harbora.Infrastructure.Deployments.CronSchedule.Describe(Model.CronExpression ?? ""); }
                        @if (described.Length > 0){<span>· @described</span>}
                        @if (Model.NextRunAt is { } next){<span>· @T["Next"]: @next.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</span>}
                    </span>
                </div>
                <div class="divide-y divide-slate-800">
                    @if (runs.Count == 0)
                    {
                        @* Deliberately not "—": a job that has never run looks identical to a broken
                           one unless the screen says which it is. *@
                        <div class="p-4 text-slate-400 text-sm">@T["This job has not run yet."]</div>
                    }
                    @foreach (var r in runs)
                    {
                        var failed = r.Error is not null || (r.ExitCode is not null && r.ExitCode != 0);
                        var stillRunning = r.FinishedAt is null;
                        <div class="p-3">
                            <div class="flex items-center justify-between gap-3 text-sm">
                                <span class="text-slate-300">
                                    @r.StartedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss") UTC
                                    @if (r.IsManual)
                                    {
                                        @* Otherwise a run at 14:32 on an 03:00 schedule looks like a bug. *@
                                        <span class="text-[10px] rounded bg-slate-800 px-1 text-slate-400">@T["run by hand"]</span>
                                    }
                                </span>
                                <div class="flex items-center gap-3">
                                    @if (r.FinishedAt is { } done)
                                    {
                                        <span class="text-xs text-slate-500">@((done - r.StartedAt).TotalSeconds.ToString("0.0"))s</span>
                                    }
                                    @if (stillRunning)
                                    {
                                        <span class="text-xs rounded-full bg-sky-900/40 text-sky-300 px-2 py-0.5">@T["Running"]</span>
                                    }
                                    else if (failed)
                                    {
                                        <span class="text-xs rounded-full bg-red-900/40 text-red-300 px-2 py-0.5">
                                            @if (r.Error is not null){@T["Could not run"]}else{@T["Exit"]<text> </text>@r.ExitCode}
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-xs rounded-full bg-emerald-900/40 text-emerald-300 px-2 py-0.5">@T["Succeeded"]</span>
                                    }
                                </div>
                            </div>
                            @if (r.Error is not null)
                            {
                                <div class="mt-2 text-xs text-red-300">@r.Error</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(r.Output))
                            {
                                @* The tail is where the reason for a failure actually lives, so it is
                                   on the page rather than behind another click. *@
                                <pre dir="ltr" class="mt-2 max-h-40 overflow-auto rounded-lg bg-slate-950/60 p-2 text-[11px] leading-relaxed text-slate-400 whitespace-pre-wrap">@r.Output</pre>
                            }
                        </div>
                    }
                </div>
            </section>
        }

        <section class="rounded-xl border border-slate-800 bg-slate-900/60">
            <div class="px-4 py-3 border-b border-slate-800 font-semibold">@T["Deployments"]</div>
            <div class="divide-y divide-slate-800">
                @if (!Model.Deployments.Any()){<div class="p-4 text-slate-400 text-sm">—</div>}
                @foreach (var d in Model.Deployments.OrderByDescending(x => x.Number))
                {
                    <div class="flex items-center justify-between p-3">
                        <a href="/deployments/details/@d.Id" class="min-w-0">
                            <div class="text-sm font-medium">#@d.Number · @d.Trigger</div>
                            <div class="text-xs text-slate-500 truncate">@(d.CommitMessage ?? d.GitRef) @(d.CommitSha is not null ? "· " + d.CommitSha[..Math.Min(7, d.CommitSha.Length)] : "")</div>
                        </a>
                        <div class="flex items-center gap-3">
                            <partial name="_DeployStatusBadge" model="d.Status" />
                            @if (d.Status == DeploymentStatus.Succeeded && d.Id != Model.ActiveDeploymentId)
                            {
                                @* Confirmation step shows the exact commit/image being restored and
                                   blocks up front if retention already pruned that artifact. *@
                                <a href="/apps/confirmrollback/@Model.Id?deploymentId=@d.Id"
                                   class="text-xs rounded-lg bg-slate-800 hover:bg-slate-700 px-2 py-1">@T["Rollback"]</a>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>

        @* ---- Environment variables ---- *@
        <section class="rounded-xl border border-slate-800 bg-slate-900/60">
            <div class="px-4 py-3 border-b border-slate-800 font-semibold">@T["Environment Variables"]</div>
            <div class="divide-y divide-slate-800">
                @if (!Model.EnvironmentVariables.Any()){<div class="p-4 text-slate-400 text-sm">—</div>}
                @foreach (var e in Model.EnvironmentVariables.OrderBy(x => x.Key))
                {
                    <div class="flex items-center justify-between p-3 text-sm font-mono">
                        <span class="text-slate-300">@e.Key @if (e.IsSecret){<span class="text-[10px] not-italic rounded bg-slate-800 px-1 text-amber-400 font-sans">secret</span>}@if (e.AvailableAtBuild){<span class="text-[10px] rounded bg-slate-800 px-1 text-sky-400 font-sans">build</span>}</span>
                        <div class="flex items-center gap-2">
                            <span class="text-slate-500">@(e.IsSecret ? "••••••" : e.Value)</span>
                            <form asp-controller="Apps" asp-action="DeleteEnv" asp-route-id="@Model.Id" asp-route-envId="@e.Id" method="post">@Html.AntiForgeryToken()<button class="text-xs text-red-400">✕</button></form>
                        </div>
                    </div>
                }
            </div>
            <form asp-controller="Apps" asp-action="AddEnv" asp-route-id="@Model.Id" method="post" class="p-3 border-t border-slate-800 grid grid-cols-1 sm:grid-cols-6 gap-2">
                @Html.AntiForgeryToken()
                <input name="key" placeholder="KEY" class="sm:col-span-2 rounded-lg bg-slate-800 border border-slate-700 px-2 py-1.5 text-sm font-mono" />
                <input name="value" placeholder="value" class="sm:col-span-2 rounded-lg bg-slate-800 border border-slate-700 px-2 py-1.5 text-sm font-mono" />
                <label class="flex items-center gap-1 text-xs"><input type="checkbox" name="isSecret" value="true"> secret</label>
                <button class="rounded-lg bg-brand-600 hover:bg-brand-500 px-3 py-1.5 text-sm font-semibold">+ @T["Save"]</button>
            </form>
        </section>
    </div>

    <div class="space-y-6">
        @* ---- Release task ----
           Shown because it runs on every deploy and can fail one. Set at create time and then
           invisible, it is a command nobody remembers is there until it breaks a release. *@
        @if (!string.IsNullOrWhiteSpace(Model.ReleaseCommand))
        {
            <section class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
                <div class="font-semibold mb-2">@(isFa ? "دستور پیش از انتشار" : "Release task")</div>
                <code dir="ltr" class="block break-all rounded bg-black/50 px-2 py-1 text-xs">@Model.ReleaseCommand</code>
                <p class="text-[11px] text-slate-500 mt-2">
                    @(isFa
                        ? "پیش از راه‌اندازی نسخهٔ جدید اجرا می‌شود. اگر شکست بخورد، نسخهٔ فعلی همچنان سرویس می‌دهد."
                        : "Runs before the new version starts. If it fails, the current version keeps serving.")
                </p>
            </section>
        }

        @* ---- Git auto-deploy ---- *@
        @if (Model.GitRepository is not null)
        {
            <section class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
                <div class="font-semibold mb-2">@(isFa ? "استقرار خودکار (Git)" : "Auto-deploy (Git)")</div>
                <div class="text-xs text-slate-400 mb-2">
                    @(isFa ? "با هر push به" : "On push to") <code class="text-slate-300">@(Model.GitRef ?? Model.GitRepository.DefaultBranch)</code>
                    @(Model.AutoDeployOnPush
                        ? (isFa ? "خودکار دیپلوی می‌شود ✓" : "auto-deploys ✓")
                        : (isFa ? "غیرفعال است" : "is off"))
                </div>
                <div class="text-xs text-slate-400">@(isFa ? "آدرس Webhook (در تنظیمات مخزن قرار دهید):" : "Webhook URL (add it in your repo settings):")</div>
                <code class="block break-all rounded bg-black/50 px-2 py-1 text-xs mt-1">@Context.Request.Scheme://@Context.Request.Host/webhooks/git/@Model.GitRepository.Id</code>
                <div class="text-xs text-slate-400 mt-2">@(isFa ? "سکرت:" : "Secret:") <code class="text-slate-300 break-all">@Model.GitRepository.WebhookSecret</code></div>
                <p class="text-[11px] text-slate-500 mt-2">@(isFa ? "Content-Type را application/json بگذارید. GitHub/Gitea با امضای HMAC و GitLab با هدر توکن تأیید می‌شوند." : "Use Content-Type application/json. GitHub/Gitea verify by HMAC; GitLab by token header.")</p>
            </section>
        }

        @* ---- Domains ----
           The status shown here is probed, not configured: DNS is resolved and a real TLS handshake
           is made. The old "SSL" badge only meant a checkbox was ticked, so a domain that had never
           been pointed at this server still advertised SSL while browsers showed a certificate error. *@
        <section class="rounded-xl border border-slate-800 bg-slate-900/60">
            <div class="px-4 py-3 border-b border-slate-800 font-semibold">@T["Domains"]</div>
            <div class="divide-y divide-slate-800">
                @if (!Model.Domains.Any()){<div class="p-4 text-slate-400 text-sm">—</div>}
                @foreach (var dom in Model.Domains)
                {
                    @* The failure message travels as an attribute, not inside the script: Razor
                       HTML-encodes it either way, and entities are decoded in attributes but not in
                       a <script> body, where they would render as literal &#x…; escapes. *@
                    <div class="p-3 text-sm" data-domain-row data-check-url="/apps/@Model.Id/domains/@dom.Id/check"
                         data-check-failed="@(isFa ? "بررسی دامنه انجام نشد." : "The domain check could not run.")">
                        <div class="flex items-center justify-between gap-2">
                            <a href="@(dom.SslEnabled ? "https" : "http")://@dom.Host" target="_blank" rel="noopener" class="text-brand-400 truncate">@dom.Host</a>
                            <div class="flex items-center gap-2 shrink-0">
                                @if (!dom.SslEnabled){<span class="text-[10px] rounded bg-slate-800 px-1 text-slate-400">HTTP</span>}
                                <span data-domain-state class="text-xs text-slate-500" title="@(isFa ? "در حال بررسی" : "Checking")">…</span>
                                <button type="button" data-domain-recheck class="text-xs text-slate-500 hover:text-slate-300"
                                        title="@(isFa ? "بررسی مجدد" : "Re-check")">↻</button>
                                <form asp-controller="Apps" asp-action="DeleteDomain" asp-route-id="@Model.Id" asp-route-domainId="@dom.Id" method="post">@Html.AntiForgeryToken()<button class="text-xs text-red-400">✕</button></form>
                            </div>
                        </div>
                        @* Filled in by the check: the verdict, and the single action that fixes it. *@
                        <p data-domain-summary class="mt-1 text-xs text-slate-400 hidden"></p>
                        <p data-domain-action class="mt-1 text-xs text-amber-300/90 hidden"></p>
                    </div>
                }
            </div>
            <form asp-controller="Apps" asp-action="AddDomain" asp-route-id="@Model.Id" method="post" class="p-3 border-t border-slate-800 space-y-2">
                @Html.AntiForgeryToken()
                <input name="host" placeholder="app.example.com" class="w-full rounded-lg bg-slate-800 border border-slate-700 px-2 py-1.5 text-sm" />
                <div class="flex items-center justify-between">
                    <label class="flex items-center gap-1 text-xs"><input type="checkbox" name="ssl" value="true" checked> @(isFa ? "SSL خودکار" : "Auto SSL")</label>
                    <button class="rounded-lg bg-brand-600 hover:bg-brand-500 px-3 py-1.5 text-sm font-semibold">+ @(isFa ? "افزودن" : "Add")</button>
                </div>
            </form>
        </section>

        @* ---- Danger zone ---- *@
        <section class="rounded-xl border border-red-900/50 bg-red-950/10 p-4">
            <div class="font-semibold text-red-300 mb-1">@(isFa ? "منطقه‌ی خطر" : "Danger zone")</div>
            <p class="text-xs text-slate-400 mb-3">@(isFa ? "حذف اپ، کانتینر و مسیرهایش را پاک می‌کند." : "Deleting removes the container and its routes.")</p>
            <form asp-controller="Apps" asp-action="Delete" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('@(isFa ? "این اپ حذف شود؟ این عمل برگشت‌ناپذیر است." : "Delete this app? This cannot be undone.")')">
                @Html.AntiForgeryToken()
                <label class="flex items-center gap-1 text-xs mb-2"><input type="checkbox" name="removeVolumes" value="true"> @(isFa ? "حذف داده‌ها (volumes)" : "Also delete data volumes")</label>
                <button class="rounded-lg bg-red-900/40 hover:bg-red-900/60 text-red-300 px-4 py-2 text-sm font-semibold">🗑 @(isFa ? "حذف اپ" : "Delete app")</button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
<script>
// Domain readiness. Each check makes a live DNS lookup and TLS handshake, so it runs here after the
// page has rendered instead of blocking Details on the slowest domain.
(function () {
    const dot = {
        Ready:               ['●', 'text-emerald-400'],
        AwaitingCertificate: ['●', 'text-amber-400'],
        DnsMissing:          ['●', 'text-red-400'],
        DnsNotPointingHere:  ['●', 'text-red-400'],
        Unreachable:         ['●', 'text-red-400'],
        Unknown:             ['●', 'text-slate-500']
    };

    async function check(row) {
        const state = row.querySelector('[data-domain-state]');
        const summary = row.querySelector('[data-domain-summary]');
        const action = row.querySelector('[data-domain-action]');
        state.className = 'text-xs text-slate-500';
        state.textContent = '…';

        try {
            const res = await fetch(row.dataset.checkUrl, { headers: { 'Accept': 'application/json' } });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const s = await res.json();

            const [glyph, colour] = dot[s.readiness] || dot.Unknown;
            state.textContent = glyph;
            state.className = 'text-xs ' + colour;
            state.title = s.readiness;

            summary.textContent = s.summary;
            summary.classList.remove('hidden');
            if (s.action) { action.textContent = s.action; action.classList.remove('hidden'); }
            else { action.textContent = ''; action.classList.add('hidden'); }
        } catch (e) {
            // Say the check failed rather than implying the domain is broken.
            state.textContent = '?';
            state.className = 'text-xs text-slate-500';
            state.title = e.message;
            summary.textContent = row.dataset.checkFailed;
            summary.classList.remove('hidden');
        }
    }

    const rows = document.querySelectorAll('[data-domain-row]');
    rows.forEach(row => {
        row.querySelector('[data-domain-recheck]').addEventListener('click', () => check(row));
        check(row);
    });
})();
</script>
}
