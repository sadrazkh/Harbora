@model Harbora.Web.ViewModels.AppOverviewViewModel
@using Harbora.Infrastructure.Projects
@inject Harbora.Web.Infrastructure.PanelModeProvider PanelModes
@{
    // The header and tab strip now live in _Shell.cshtml, which is typed to AppTabViewModel rather
    // than to the raw App entity — this local alias is what lets the rest of this file go on reading
    // "app.Whatever" exactly as it read "Model.Whatever" before the split.
    Layout = "_Shell";
    var app = Model.App;

    ViewData["Title"] = app.Name;

    // Simple mode folds the specialist parts of this page; Advanced leaves them open, so the page
    // is unchanged for anyone who was already using it. Folded, never dropped — the settings are
    // one click away and the summary says what is inside.
    var advancedOpen = Harbora.Infrastructure.Navigation.PanelSections.StartsOpen(await PanelModes.GetAsync());
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var msg = TempData["Message"] as string; var err = TempData["Error"] as string;
}

@if (msg is not null){<div class="mb-4 rounded-lg bg-ok-soft border border-ok text-ok px-4 py-2 text-sm">@msg</div>}
@if (err is not null){<div class="mb-4 rounded-lg bg-danger-soft border border-danger text-danger px-4 py-2 text-sm">@err</div>}

<div class="grid lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-6">
        @* ---- Scheduled runs ----
           For a cron service this is the app: there is no container to look at between runs, so
           "did it run, did it work, what did it say" can only be answered from history. It leads,
           because a deployment list answers none of those questions. *@
        @if (app.Kind == ServiceKind.Cron)
        {
            var runs = ViewBag.CronRuns as List<Harbora.Domain.Apps.CronRun> ?? new();
            <section class="rounded-xl border border-line bg-surface">
                <div class="px-4 py-3 border-b border-line flex flex-wrap items-baseline justify-between gap-2">
                    <span class="font-semibold">@T["Scheduled runs"]</span>
                    @if (!string.IsNullOrWhiteSpace(app.Command))
                    {
                        @* What it runs, on the page where its results are — the two are meaningless apart. *@
                        <code dir="ltr" class="rounded bg-code text-code-ink px-2 py-0.5 text-xs text-ink">@app.Command</code>
                    }
                    <span class="text-xs text-ink-muted">
                        <span class="font-mono">@app.CronExpression</span>
                        @{ var described = Harbora.Infrastructure.Deployments.CronSchedule.Describe(app.CronExpression ?? ""); }
                        @if (described.Length > 0){<span>· @described</span>}
                        @if (app.NextRunAt is { } next){<span>· @T["Next"]: @next.UtcDateTime.ToString(Dates.Stamp) UTC</span>}
                    </span>
                </div>
                <div class="divide-y divide-line">
                    @if (runs.Count == 0)
                    {
                        @* Deliberately not "—": a job that has never run looks identical to a broken
                           one unless the screen says which it is. *@
                        <div class="p-4 text-ink-muted text-sm">@T["This job has not run yet."]</div>
                    }
                    @foreach (var r in runs)
                    {
                        var failed = r.Error is not null || (r.ExitCode is not null && r.ExitCode != 0);
                        var stillRunning = r.FinishedAt is null;
                        <div class="p-3">
                            <div class="flex items-center justify-between gap-3 text-sm">
                                <span class="text-ink">
                                    @r.StartedAt.UtcDateTime.ToString(Dates.Precise) UTC
                                    @if (r.IsManual)
                                    {
                                        @* Otherwise a run at 14:32 on an 03:00 schedule looks like a bug. *@
                                        <span class="text-[10px] rounded bg-surface-2 px-1 text-ink-muted">@T["run by hand"]</span>
                                    }
                                </span>
                                <div class="flex items-center gap-3">
                                    @if (r.FinishedAt is { } done)
                                    {
                                        <span class="text-xs text-ink-faint">@((done - r.StartedAt).TotalSeconds.ToString("0.0"))s</span>
                                    }
                                    @if (stillRunning)
                                    {
                                        <span class="text-xs rounded-full bg-info-soft text-info px-2 py-0.5">@T["Running"]</span>
                                    }
                                    else if (failed)
                                    {
                                        <span class="text-xs rounded-full bg-danger-soft text-danger px-2 py-0.5">
                                            @if (r.Error is not null){@T["Could not run"]}else{@T["Exit"]<text> </text>@r.ExitCode}
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-xs rounded-full bg-ok-soft text-ok px-2 py-0.5">@T["Succeeded"]</span>
                                    }
                                </div>
                            </div>
                            @if (r.Error is not null)
                            {
                                <div class="mt-2 text-xs text-danger">@r.Error</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(r.Output))
                            {
                                @* The tail is where the reason for a failure actually lives, so it is
                                   on the page rather than behind another click. *@
                                <pre dir="ltr" class="mt-2 max-h-40 overflow-auto rounded-lg bg-canvas p-2 text-[11px] leading-relaxed text-ink-muted whitespace-pre-wrap">@r.Output</pre>
                            }
                        </div>
                    }
                </div>
            </section>
        }

        @* ---- Environment variables ---- *@
        <details class="advanced-panel" open="@advancedOpen">
            <summary><span><i data-lucide="file-code-2" class="h-4 w-4"></i>@T["Environment Variables"]</span><i data-lucide="chevron-down" class="h-4 w-4"></i></summary>
            <div class="divide-y divide-line">
                @if (!app.EnvironmentVariables.Any()){<div class="p-4 text-ink-muted text-sm">—</div>}
                @foreach (var e in app.EnvironmentVariables.OrderBy(x => x.Key))
                {
                    <div class="flex items-center justify-between p-3 text-sm font-mono">
                        <span class="text-ink">@e.Key @if (e.IsSecret){<span class="text-[10px] not-italic rounded bg-surface-2 px-1 text-warn font-sans">secret</span>}@if (e.AvailableAtBuild){<span class="text-[10px] rounded bg-surface-2 px-1 text-info font-sans">build</span>}</span>
                        <div class="flex items-center gap-2">
                            <span class="text-ink-faint">@(e.IsSecret ? "••••••" : e.Value)</span>
                            <form asp-controller="Apps" asp-action="DeleteEnv" asp-route-id="@app.Id" asp-route-envId="@e.Id" method="post">@Html.AntiForgeryToken()<button class="text-xs text-danger" aria-label="@(isFa ? $"حذف متغیر {e.Key}" : $"Delete variable {e.Key}")">✕</button></form>
                        </div>
                    </div>
                }
            </div>
            <form asp-controller="Apps" asp-action="AddEnv" asp-route-id="@app.Id" method="post" class="p-3 border-t border-line grid grid-cols-1 sm:grid-cols-6 gap-2">
                @Html.AntiForgeryToken()
                <input name="key" placeholder="KEY" class="sm:col-span-2 rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm font-mono" />
                <input name="value" placeholder="value" class="sm:col-span-2 rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm font-mono" />
                <label class="flex items-center gap-1 text-xs"><input type="checkbox" name="isSecret" value="true"> secret</label>
                <button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-3 py-1.5 text-sm font-semibold">+ @T["Save"]</button>
            </form>
        </details>
    </div>

    <div class="space-y-6">
        @{
            var sizes = ViewBag.Sizes as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? [];
        }
        @* ---- databases ----
           The page said nothing about them at all: the only way to attach one was to know to open
           each database in turn, and nothing here listed what this application was already using.
           So "one app, several databases" was supported by everything except the screen somebody
           would try it on. *@
        @{
            var links = ViewBag.Databases as List<AppDatabaseLinkViewModel> ?? [];
            var attached = links.Where(l => l.Attached).ToList();
            var available = links.Where(l => !l.Attached).ToList();
            var here = Context.Request.Path + Context.Request.QueryString;
        }
        <section class="rounded-xl border border-line bg-surface p-4">
            <div class="mb-3 font-semibold">@(isFa ? "دیتابیس‌ها" : "Databases")</div>

            @if (attached.Count == 0)
            {
                <p class="text-xs text-ink-faint">@(isFa ? "به هیچ دیتابیسی وصل نیست." : "Not connected to any database.")</p>
            }
            else
            {
                <div class="space-y-2">
                    @foreach (var link in attached)
                    {
                        <div class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-line bg-surface-2 p-2.5">
                            <span class="min-w-0">
                                <a href="/databases/@link.Id" class="block truncate text-sm text-ink hover:text-accent-text" dir="ltr">@link.Name</a>
                                <small class="text-[11px] text-ink-faint">@link.Type</small>
                            </span>
                            <form asp-controller="Databases" asp-action="Detach" asp-route-id="@link.Id" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="appId" value="@app.Id" />
                                <input type="hidden" name="returnUrl" value="@here" />
                                <button class="text-[11px] text-ink-faint hover:text-danger">@(isFa ? "جدا کن" : "Detach")</button>
                            </form>
                        </div>
                    }
                </div>

                @if (attached.Count > 1)
                {
                    @* Which variable holds which. Every database also writes a prefixed copy of its
                       own names; the plain ones go to whichever database asked for them first, so
                       two of the same engine share nothing. The prefix is shown rather than a whole
                       variable name, because the names differ per engine — writing
                       "PREFIX_DATABASE_URL" beside a Redis would name a variable it never sets. *@
                    <p class="mt-2 text-[11px] leading-5 text-ink-faint">
                        @(isFa
                            ? "هر دیتابیس یک نسخهٔ پیشونددار از متغیرهای خودش هم می‌نویسد. نام‌های ساده به اولی می‌رسد که آن‌ها را خواسته باشد:"
                            : "Each database also writes a prefixed copy of its own variables. The plain names go to whichever asked for them first:")
                        @foreach (var link in attached)
                        {
                            <code dir="ltr" class="ms-1">@(link.Prefix)*</code>
                        }
                    </p>
                }
            }

            @if (available.Count > 0)
            {
                <form asp-controller="Databases" asp-action="Attach" method="post" class="mt-3 space-y-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="appId" value="@app.Id" />
                    <input type="hidden" name="returnUrl" value="@here" />
                    <select name="id" class="form-control text-sm">
                        @foreach (var link in available)
                        {
                            <option value="@link.Id">@link.Name · @link.Type</option>
                        }
                    </select>
                    <button class="btn-secondary w-full justify-center text-sm">@(isFa ? "اتصال دیتابیس" : "Attach a database")</button>
                </form>
                <p class="mt-1 text-[11px] text-ink-faint">
                    @(isFa
                        ? "بعد از اتصال، اپ را دوباره دیپلوی کنید تا متغیرها اعمال شوند."
                        : "Redeploy the application afterwards to apply the variables.")
                </p>
            }
            else if (attached.Count == 0)
            {
                <p class="mt-2 text-[11px] text-ink-faint">
                    @(isFa
                        ? "در این محیط دیتابیسی نیست. دیتابیس فقط داخل شبکهٔ خصوصی همان محیط وصل می‌شود."
                        : "There is no database in this environment. One can only attach inside its own private network.")
                </p>
            }

            @* ---- the ones it cannot reach ----
               An environment is a private network, so a database in another one cannot be attached:
               the hostname would not resolve. That was explained and left there — the person could
               see the refusal and had nowhere to go with it, while the move sat on a page in
               Advanced mode that most people never open. *@
            @{ var elsewhere = ViewBag.Elsewhere as List<AppDatabaseElsewhereViewModel> ?? []; }
            @if (elsewhere.Count > 0)
            {
                <details class="mt-3 rounded-lg border border-line bg-surface-2 p-2.5">
                    <summary class="cursor-pointer text-[11px] text-ink-muted">
                        @(isFa
                            ? $"{elsewhere.Count} دیتابیس در محیط‌های دیگر"
                            : $"{elsewhere.Count} database(s) in other environments")
                    </summary>
                    <p class="mt-2 text-[11px] leading-5 text-ink-faint">
                        @(isFa
                            ? "هر محیط یک شبکهٔ خصوصی جداست، پس این‌ها را نمی‌شود از اینجا وصل کرد — نام میزبانشان از این شبکه پیدا نمی‌شود. یا این اپ را به آن محیط ببرید، یا دیتابیس تازه‌ای در همین محیط بسازید."
                            : "Each environment is its own private network, so these cannot be attached from here — their hostname does not resolve on this one. Either move this application there, or create a database in this environment.")
                    </p>
                    <div class="mt-2 space-y-1.5">
                        @foreach (var other in elsewhere)
                        {
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <span class="min-w-0 text-[11px]">
                                    <span class="text-ink" dir="ltr">@other.Name</span>
                                    <span class="text-ink-faint">· @other.Where</span>
                                </span>
                                @* Straight to the screen that says what the move would break. It is
                                   a confirmation rather than a button because moving a service to
                                   another network severs every connection it already has. *@
                                <a href="/networks/move?appId=@app.Id&amp;targetEnvironmentId=@other.EnvironmentId"
                                   class="whitespace-nowrap text-[11px] text-accent-text hover:underline">
                                    @(isFa ? "بردن اپ به آنجا" : "Move the app there")
                                </a>
                            </div>
                        }
                    </div>
                </details>
            }
        </section>

        @* ---- instance size ----
           What this app is actually consuming against these limits now lives on the Usage tab; this
           is only the control that changes them. *@
        @if (sizes.Count > 0)
        {
            <section class="rounded-xl border border-line bg-surface p-4">
                <div class="mb-3 font-semibold">@(isFa ? "اندازهٔ نمونه" : "Instance size")</div>
                <form asp-controller="Apps" asp-action="Resize" asp-route-id="@app.Id" method="post" class="space-y-2">
                    @Html.AntiForgeryToken()
                    <select name="instanceSizeKey" class="form-control text-sm">
                        <option value="">@(isFa ? "بدون سقف" : "No limit")</option>
                        @foreach (var size in sizes)
                        {
                            <option value="@size.Value" selected="@size.Selected">@size.Text</option>
                        }
                    </select>
                    <button class="btn-secondary w-full justify-center py-2 text-sm">@(isFa ? "تغییر اندازه" : "Change size")</button>
                    <p class="text-[11px] leading-4 text-ink-faint">
                        @(isFa
                            ? "سقف روی کانتینر است، پس با استقرار بعدی اعمال می‌شود."
                            : "The ceiling belongs to the container, so it applies on the next deployment.")
                    </p>
                </form>
            </section>
        }

        @* ---- The version this came from, and where it can go ----
           An app installed from a ready-made template had its version pinned at creation and
           nothing offered another, so "update n8n" meant deleting it and starting again. *@
        @{
            var currentVersion = ViewBag.CurrentVersion as Harbora.Domain.Templates.AppTemplateVersion;
            var updates = ViewBag.UpdateVersions as List<Harbora.Domain.Templates.AppTemplateVersion> ?? [];
        }
        @if (app.TemplateId is not null)
        {
            <section class="rounded-xl border border-line bg-surface p-4">
                <div class="mb-2 font-semibold">@(isFa ? "نسخه" : "Version")</div>

                <div class="text-xs text-ink-muted">
                    @(currentVersion is null
                        ? (isFa ? "نسخهٔ این نصب ثبت نشده است." : "This installation's version was not recorded.")
                        : (isFa ? $"در حال اجرا: {currentVersion.Version}" : $"Running {currentVersion.Version}"))
                </div>

                @if (!string.IsNullOrWhiteSpace(app.PrebuiltImage))
                {
                    @* The exact reference, so somebody who would rather run it themselves can take
                       it. It is what actually gets pulled, digest and all. *@
                    <code dir="ltr" class="mt-2 block break-all rounded bg-code text-code-ink px-2 py-1 text-[11px]"
                          data-copy-text>@app.PrebuiltImage</code>
                }

                @if (updates.Count > 0)
                {
                    <form asp-controller="Apps" asp-action="UpdateVersion" asp-route-id="@app.Id" method="post" class="mt-3 space-y-2">
                        @Html.AntiForgeryToken()
                        <select name="versionId" class="form-control text-sm" data-version-choice>
                            @foreach (var version in updates)
                            {
                                <option value="@version.Id"
                                        data-warning="@(isFa && !string.IsNullOrWhiteSpace(version.MigrationWarningsFa) ? version.MigrationWarningsFa : version.MigrationWarnings)">
                                    @version.Version
                                </option>
                            }
                        </select>

                        @* Shown before the button is pressed, not after. A migration warning that
                           arrives with the result is a warning about something already done. *@
                        <p class="hidden text-[11px] leading-4 text-warn" data-version-warning></p>

                        <button class="btn-secondary w-full justify-center py-2 text-sm">
                            <i data-lucide="arrow-up-right" class="h-4 w-4"></i>@(isFa ? "به‌روزرسانی" : "Update")
                        </button>
                        <p class="text-[11px] leading-4 text-ink-faint">
                            @(isFa
                                ? "مثل هر استقرار دیگری اجرا می‌شود: سلامت‌سنجی و امکان بازگشت."
                                : "Runs as a normal deployment: health gate and rollback.")
                        </p>
                    </form>
                }
                else
                {
                    <p class="mt-2 text-[11px] text-ink-faint">
                        @(isFa ? "نسخهٔ تازه‌تری ارائه نشده است." : "No newer version is offered.")
                    </p>
                }
            </section>
        }

        @* ---- A release tag of your own ----
           The curated list is what Harbora vouches for. This is for the release somebody has read the
           project's changelog about and wants today. *@
        @{
            var repository = ViewBag.Repository as string;
            var currentTag = ViewBag.CurrentTag as string;
        }
        @if (!string.IsNullOrWhiteSpace(repository))
        {
            <section class="rounded-xl border border-line bg-surface p-4">
                <div class="mb-2 font-semibold">@(isFa ? "تگ دلخواه" : "A release tag of your own")</div>
                <p class="text-[11px] leading-4 text-ink-faint">
                    @(isFa
                        ? "هر تگی از همین مخزن. پیش از ذخیره به digest تبدیل می‌شود، پس اگر تگ وجود نداشته باشد چیزی تغییر نمی‌کند."
                        : "Any tag from this repository. It is resolved to a digest before anything is stored, so a tag that does not exist changes nothing.")
                </p>
                <code dir="ltr" class="mt-2 block break-all rounded bg-code text-code-ink px-2 py-1 text-[11px]" data-copy-text>@repository</code>

                <form asp-controller="Apps" asp-action="UpdateTag" asp-route-id="@app.Id" method="post" class="mt-3 space-y-2">
                    @Html.AntiForgeryToken()
                    <input name="tag" value="@currentTag" dir="ltr" class="form-control text-sm"
                           placeholder="@(isFa ? "مثلاً 1.70.1" : "e.g. 1.70.1")" />
                    <button class="btn-secondary w-full justify-center py-2 text-sm">
                        <i data-lucide="rocket" class="h-4 w-4"></i>@(isFa ? "استقرار این تگ" : "Deploy this tag")
                    </button>
                </form>
            </section>
        }

        @* ---- Release task ----
           Shown because it runs on every deploy and can fail one. Set at create time and then
           invisible, it is a command nobody remembers is there until it breaks a release. *@
        @if (!string.IsNullOrWhiteSpace(app.ReleaseCommand))
        {
            <section class="rounded-xl border border-line bg-surface p-4">
                <div class="font-semibold mb-2">@(isFa ? "دستور پیش از انتشار" : "Release task")</div>
                <code dir="ltr" class="block break-all rounded bg-code text-code-ink px-2 py-1 text-xs">@app.ReleaseCommand</code>
                <p class="text-[11px] text-ink-faint mt-2">
                    @(isFa
                        ? "پیش از راه‌اندازی نسخهٔ جدید اجرا می‌شود. اگر شکست بخورد، نسخهٔ فعلی همچنان سرویس می‌دهد."
                        : "Runs before the new version starts. If it fails, the current version keeps serving.")
                </p>
            </section>
        }

        @* ---- Git auto-deploy ---- *@
        @if (app.GitRepository is not null)
        {
            <section class="rounded-xl border border-line bg-surface p-4">
                <div class="font-semibold mb-2">@(isFa ? "استقرار خودکار (Git)" : "Auto-deploy (Git)")</div>
                <div class="text-xs text-ink-muted mb-2">
                    @(isFa ? "با هر push به" : "On push to") <code class="text-ink">@(app.GitRef ?? app.GitRepository.DefaultBranch)</code>
                    @(app.AutoDeployOnPush
                        ? (isFa ? "خودکار دیپلوی می‌شود ✓" : "auto-deploys ✓")
                        : (isFa ? "غیرفعال است" : "is off"))
                </div>
                <div class="text-xs text-ink-muted">@(isFa ? "آدرس Webhook (در تنظیمات مخزن قرار دهید):" : "Webhook URL (add it in your repo settings):")</div>
                <code class="block break-all rounded bg-code text-code-ink px-2 py-1 text-xs mt-1">@Context.Request.Scheme://@Context.Request.Host/webhooks/git/@app.GitRepository.Id</code>
                <div class="text-xs text-ink-muted mt-2">
                    @(isFa ? "سکرت:" : "Secret:")
                    @if (ViewBag.RevealWebhookSecret == true)
                    {
                        <code class="text-ink break-all">@app.GitRepository.WebhookSecret</code>
                    }
                    else
                    {
                        @* Only on a click, like the Git page and the storage keys. *@
                        <code class="text-ink-faint">••••••••</code>
                        <a href="/apps/details/@app.Id?revealSecret=true" class="text-accent-text hover:underline">@(isFa ? "نمایش" : "Reveal")</a>
                    }
                </div>
                <p class="text-[11px] text-ink-faint mt-2">@(isFa ? "Content-Type را application/json بگذارید. GitHub/Gitea با امضای HMAC و GitLab با هدر توکن تأیید می‌شوند." : "Use Content-Type application/json. GitHub/Gitea verify by HMAC; GitLab by token header.")</p>
            </section>

            @* ---- Branch previews ----
               Shown next to auto-deploy because they are the same mechanism pointed at a different
               branch. A preview is a real service on a real address, so it is listed rather than
               left to be discovered in the app list looking like something somebody created. *@
            @if (app.PreviewOfAppId is null)
            {
                var previews = ViewBag.Previews as List<Harbora.Domain.Apps.App> ?? [];
                <section class="rounded-xl border border-line bg-surface p-4">
                    <div class="flex items-center justify-between gap-2 mb-2">
                        <div class="font-semibold">@(isFa ? "پیش‌نمایش شاخه‌ها" : "Branch previews")</div>
                        <form method="post" asp-action="TogglePreviews" asp-route-id="@app.Id">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="text-xs rounded-lg px-3 py-1 border @(app.PreviewsEnabled ? "border-ok text-ok" : "border-line-strong text-ink-muted")">
                                @(app.PreviewsEnabled ? (isFa ? "روشن ✓" : "On ✓") : (isFa ? "خاموش" : "Off"))
                            </button>
                        </form>
                    </div>

                    <p class="text-xs text-ink-muted">
                        @(isFa
                            ? "هر push روی شاخه‌ای غیر از شاخهٔ اصلی، محیط و آدرس مخصوص خودش را می‌گیرد. سکرت‌ها کپی نمی‌شوند — برای هر پیش‌نمایش جداگانه تنظیم کنید."
                            : "A push to any branch other than the tracked one gets an environment and address of its own. Secrets are not copied — set them per preview.")
                    </p>
                    <p class="text-[11px] text-ink-faint mt-1">
                        @(isFa
                            ? $"پیش‌نمایشی که {PreviewPolicy.IdleLifetime.TotalDays:0} روز push نگیرد یا شاخه‌اش حذف شود، خودش برداشته می‌شود."
                            : $"A preview whose branch is deleted, or which goes {PreviewPolicy.IdleLifetime.TotalDays:0} days without a push, is removed on its own.")
                    </p>

                    @if (previews.Count > 0)
                    {
                        <div class="mt-3 divide-y divide-line border-t border-line">
                            @foreach (var preview in previews)
                            {
                                <div class="py-2 flex items-center justify-between gap-2 text-sm">
                                    <a asp-action="Details" asp-route-id="@preview.Id" class="text-accent-text truncate">@preview.PreviewBranch</a>
                                    <span class="text-xs text-ink-faint shrink-0">
                                        @(preview.PreviewLastPushedAt is { } pushed
                                            ? (isFa ? $"آخرین push: {pushed.LocalDateTime:yyyy-MM-dd}" : $"last push {pushed.LocalDateTime:yyyy-MM-dd}")
                                            : "—")
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </section>
            }
        }

        @* A preview says so, and says what of. Otherwise it looks like an ordinary service that
           somebody will be surprised to find gone in a week. *@
        @if (app.PreviewOfAppId is { } parentId)
        {
            <section class="rounded-xl border border-warn bg-amber-950/20 p-4">
                <div class="font-semibold mb-1">@(isFa ? "این یک پیش‌نمایش است" : "This is a preview")</div>
                <div class="text-xs text-ink-muted">
                    @(isFa ? "شاخهٔ" : "Branch") <code class="text-ink">@app.PreviewBranch</code>
                    @(isFa ? "از" : "of") <a asp-action="Details" asp-route-id="@parentId" class="text-accent-text">@(isFa ? "سرویس اصلی" : "the parent service")</a>.
                </div>
                <div class="text-[11px] text-ink-faint mt-2">
                    @(isFa
                        ? $"سکرت‌ها از سرویس اصلی کپی نشده‌اند. اگر شاخه حذف شود یا {PreviewPolicy.IdleLifetime.TotalDays:0} روز push نگیرد، این سرویس و داده‌هایش برداشته می‌شوند."
                        : $"Secrets were not copied from the parent. If the branch is deleted, or goes {PreviewPolicy.IdleLifetime.TotalDays:0} days without a push, this service and its data are removed.")
                </div>
            </section>
        }

        @* ---- Domains ----
           The status shown here is probed, not configured: DNS is resolved and a real TLS handshake
           is made. The old "SSL" badge only meant a checkbox was ticked, so a domain that had never
           been pointed at this server still advertised SSL while browsers showed a certificate error. *@
        <section class="rounded-xl border border-line bg-surface">
            <div class="px-4 py-3 border-b border-line font-semibold">@T["Domains"]</div>
            <div class="divide-y divide-line">
                @if (!app.Domains.Any()){<div class="p-4 text-ink-muted text-sm">—</div>}
                @foreach (var dom in app.Domains)
                {
                    @* The failure message travels as an attribute, not inside the script: Razor
                       HTML-encodes it either way, and entities are decoded in attributes but not in
                       a <script> body, where they would render as literal &#x…; escapes. *@
                    <div class="p-3 text-sm" data-domain-row data-check-url="/apps/@app.Id/domains/@dom.Id/check"
                         data-check-failed="@(isFa ? "بررسی دامنه انجام نشد." : "The domain check could not run.")">
                        <div class="flex items-center justify-between gap-2">
                            <a href="@(dom.SslEnabled ? "https" : "http")://@dom.Host" target="_blank" rel="noopener" class="text-accent-text truncate">@dom.Host</a>
                            <div class="flex items-center gap-2 shrink-0">
                                @if (!dom.SslEnabled){<span class="text-[10px] rounded bg-surface-2 px-1 text-ink-muted">HTTP</span>}
                                <span data-domain-state class="text-xs text-ink-faint" title="@(isFa ? "در حال بررسی" : "Checking")">…</span>
                                <button type="button" data-domain-recheck class="text-xs text-ink-faint hover:text-ink"
                                        title="@(isFa ? "بررسی مجدد" : "Re-check")">↻</button>
                                <form asp-controller="Apps" asp-action="DeleteDomain" asp-route-id="@app.Id" asp-route-domainId="@dom.Id" method="post">@Html.AntiForgeryToken()<button class="text-xs text-danger" aria-label="@(isFa ? $"حذف دامنهٔ {dom.Host}" : $"Delete domain {dom.Host}")">✕</button></form>
                            </div>
                        </div>
                        @* Filled in by the check: the verdict, and the single action that fixes it. *@
                        <p data-domain-summary class="mt-1 text-xs text-ink-muted hidden"></p>
                        <p data-domain-action class="mt-1 text-xs text-warn/90 hidden"></p>
                    </div>
                }
            </div>
            <form asp-controller="Apps" asp-action="AddDomain" asp-route-id="@app.Id" method="post" class="p-3 border-t border-line space-y-2">
                @Html.AntiForgeryToken()
                <input name="host" placeholder="app.example.com" class="w-full rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm" />
                <div class="flex items-center justify-between">
                    <label class="flex items-center gap-1 text-xs"><input type="checkbox" name="ssl" value="true" checked> @(isFa ? "SSL خودکار" : "Auto SSL")</label>
                    <button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-3 py-1.5 text-sm font-semibold">+ @(isFa ? "افزودن" : "Add")</button>
                </div>
            </form>
        </section>

        @* ---- Protection ----
           The routing engine has had basic-auth since the designer shipped; what was missing was a
           way to reach it without opening the designer and understanding Traefik middlewares. It
           applies to every domain this app answers on, because protecting one of three is not
           protection. *@
        <section class="rounded-xl border border-line bg-surface">
            <div class="px-4 py-3 border-b border-line font-semibold">@(isFa ? "محافظت از دسترسی" : "Access protection")</div>
            @if (ViewBag.HasRoutes != true)
            {
                <div class="p-4 text-sm text-ink-muted">@(isFa ? "وقتی این اپ دامنه بگیرد، اینجا می‌توانید رمز یا محدودیت IP بگذارید." : "Once this app has a domain, you can put a password or an IP restriction in front of it.")</div>
            }
            else
            {
                <form asp-controller="Apps" asp-action="SetProtection" asp-route-id="@app.Id" method="post" class="p-4 space-y-3">
                    @Html.AntiForgeryToken()
                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" name="basicAuthEnabled" value="true" @(ViewBag.ProtectionAuth == true ? "checked" : "") />
                        <span>@(isFa ? "محافظت با رمز (Basic auth)" : "Password protection (basic auth)")</span>
                    </label>
                    <div class="grid grid-cols-2 gap-2">
                        <input name="user" placeholder="@(isFa ? "نام کاربری (پیش‌فرض admin)" : "username (defaults to admin)")" dir="ltr"
                               class="rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm" />
                        <input name="password" type="password" autocomplete="new-password" dir="ltr"
                               placeholder="@(ViewBag.ProtectionAuth == true ? (isFa ? "ذخیره شده — برای تغییر بنویسید" : "stored — type to change") : (isFa ? "رمز" : "password"))"
                               class="rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm" />
                    </div>
                    <div>
                        <label class="mb-1 block text-xs text-ink-muted">@(isFa ? "فقط این IP‌ها (خالی = همه)" : "Only these IPs (empty = everyone)")</label>
                        <input name="ipAllowlist" value="@ViewBag.ProtectionIps" dir="ltr" placeholder="203.0.113.5, 10.0.0.0/8"
                               class="w-full rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm" />
                    </div>
                    <button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm font-semibold">@(isFa ? "اعمال" : "Apply")</button>
                </form>
            }
        </section>

        @* ---- Danger zone ---- *@
        <section class="rounded-xl border border-danger bg-red-950/10 p-4">
            <div class="font-semibold text-danger mb-1">@(isFa ? "منطقه‌ی خطر" : "Danger zone")</div>
            <p class="text-xs text-ink-muted mb-3">@(isFa ? "حذف اپ، کانتینر و مسیرهایش را پاک می‌کند." : "Deleting removes the container and its routes.")</p>
            <form asp-controller="Apps" asp-action="Delete" asp-route-id="@app.Id" method="post"
                  onsubmit="return confirm('@(isFa ? "این اپ حذف شود؟ این عمل برگشت‌ناپذیر است." : "Delete this app? This cannot be undone.")')">
                @Html.AntiForgeryToken()
                <label class="flex items-center gap-1 text-xs mb-2"><input type="checkbox" name="removeVolumes" value="true"> @(isFa ? "حذف داده‌ها (volumes)" : "Also delete data volumes")</label>
                <button class="rounded-lg bg-danger-soft hover:bg-danger-soft text-danger px-4 py-2 text-sm font-semibold">🗑 @(isFa ? "حذف اپ" : "Delete app")</button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
<script>
    // The migration warning for whichever version is selected, before the button is pressed.
    (function () {
        var choice = document.querySelector('[data-version-choice]');
        var note = document.querySelector('[data-version-warning]');
        if (!choice || !note) return;

        function sync() {
            var option = choice.options[choice.selectedIndex];
            var warning = option && option.getAttribute('data-warning');
            note.textContent = warning || '';
            note.classList.toggle('hidden', !warning);
        }
        choice.addEventListener('change', sync);
        sync();
    })();

    // Copying the image reference. One handler for every element that opts in.
    document.querySelectorAll('[data-copy-text]').forEach(function (el) {
        el.style.cursor = 'copy';
        el.addEventListener('click', function () {
            navigator.clipboard?.writeText(el.textContent.trim());
        });
    });
</script>

<script>
// Domain readiness. Each check makes a live DNS lookup and TLS handshake, so it runs here after the
// page has rendered instead of blocking Details on the slowest domain.
(function () {
    const dot = {
        Ready:               ['●', 'text-ok'],
        AwaitingCertificate: ['●', 'text-warn'],
        DnsMissing:          ['●', 'text-danger'],
        DnsNotPointingHere:  ['●', 'text-danger'],
        Unreachable:         ['●', 'text-danger'],
        Unknown:             ['●', 'text-ink-faint']
    };

    async function check(row) {
        const state = row.querySelector('[data-domain-state]');
        const summary = row.querySelector('[data-domain-summary]');
        const action = row.querySelector('[data-domain-action]');
        state.className = 'text-xs text-ink-faint';
        state.textContent = '…';

        try {
            const res = await fetch(row.dataset.checkUrl, { headers: { 'Accept': 'application/json' } });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const s = await res.json();

            const [glyph, colour] = dot[s.readiness] || dot.Unknown;
            state.textContent = glyph;
            state.className = 'text-xs ' + colour;
            state.title = s.readiness;

            summary.textContent = s.summary;
            summary.classList.remove('hidden');
            if (s.action) { action.textContent = s.action; action.classList.remove('hidden'); }
            else { action.textContent = ''; action.classList.add('hidden'); }
        } catch (e) {
            // Say the check failed rather than implying the domain is broken.
            state.textContent = '?';
            state.className = 'text-xs text-ink-faint';
            state.title = e.message;
            summary.textContent = row.dataset.checkFailed;
            summary.classList.remove('hidden');
        }
    }

    const rows = document.querySelectorAll('[data-domain-row]');
    rows.forEach(row => {
        row.querySelector('[data-domain-recheck]').addEventListener('click', () => check(row));
        check(row);
    });
})();
</script>
}
