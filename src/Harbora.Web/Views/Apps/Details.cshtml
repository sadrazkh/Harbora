@model Harbora.Web.ViewModels.AppOverviewViewModel
@using Harbora.Infrastructure.Projects
@inject Harbora.Web.Infrastructure.PanelModeProvider PanelModes
@{
    // The header and tab strip now live in _Shell.cshtml, which is typed to AppTabViewModel rather
    // than to the raw App entity — this local alias is what lets the rest of this file go on reading
    // "app.Whatever" exactly as it read "Model.Whatever" before the split.
    Layout = "_Shell";
    var app = Model.App;

    ViewData["Title"] = app.Name;

    // Simple mode folds the specialist parts of this page; Advanced leaves them open, so the page
    // is unchanged for anyone who was already using it. Folded, never dropped — the settings are
    // one click away and the summary says what is inside.
    var advancedOpen = Harbora.Infrastructure.Navigation.PanelSections.StartsOpen(await PanelModes.GetAsync());
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    // The Message/Error banner now renders once in _Shell.cshtml, above every tab — not here.
    // TempData is consumed on read, so a second read site here would just find it already gone.

    // ---- specifics card helpers ----
    // Zero means "no ceiling" on every InstanceSize limit column, the same convention the resize
    // form's "No limit" option already reads.
    string SpecBytes(long value) => value <= 0
        ? (isFa ? "بدون سقف" : "no limit")
        : value < 1024L * 1024 * 1024
            ? $"{value / 1024.0 / 1024:0.#} MB"
            : $"{value / 1024.0 / 1024 / 1024:0.##} GB";

    // What "the live version" means depends on how the deployment got its bits: a Git-tracked app
    // has a commit, an image-tagged one only has the tag. Deployment #N is the last resort — every
    // deployment has a number, so this never falls through to nothing at all.
    var specVersion = Model.LatestDeployment switch
    {
        null => "none",
        { CommitSha.Length: > 0 } d => d.CommitSha![..Math.Min(7, d.CommitSha.Length)],
        { ImageTag.Length: > 0 } d => d.ImageTag!,
        { GitRef.Length: > 0 } d => d.GitRef!,
        var d => $"#{d.Number}"
    };
}

@* A preview says so, and says what of. Otherwise it looks like an ordinary service that somebody
   will be surprised to find gone in a week. Above the grid rather than in a column: it is about the
   whole app, which is where the database page puts its version-drift warnings too. *@
@if (app.PreviewOfAppId is { } parentId)
{
    <section class="rounded-xl border border-warn bg-amber-950/20 p-4 mb-6">
        <div class="font-semibold mb-1">@(isFa ? "این یک پیش‌نمایش است" : "This is a preview")</div>
        <div class="text-xs text-ink-muted">
            @(isFa ? "شاخهٔ" : "Branch") <code class="text-ink">@app.PreviewBranch</code>
            @(isFa ? "از" : "of") <a asp-action="Details" asp-route-id="@parentId" class="text-accent-text">@(isFa ? "سرویس اصلی" : "the parent service")</a>.
        </div>
        <div class="text-[11px] text-ink-faint mt-2">
            @(isFa
                ? $"سکرت‌ها از سرویس اصلی کپی نشده‌اند. اگر شاخه حذف شود یا {PreviewPolicy.IdleLifetime.TotalDays:0} روز push نگیرد، این سرویس و داده‌هایش برداشته می‌شوند."
                : $"Secrets were not copied from the parent. If the branch is deleted, or goes {PreviewPolicy.IdleLifetime.TotalDays:0} days without a push, this service and its data are removed.")
        </div>
    </section>
}

@* The wide column carries what needs width — the addresses, the specifics, the tier cards,
   the domain list, the variables — and the aside carries the controls and the summaries. It
   was the other way round: thirteen panels were stacked in the narrow third of a
   lg:grid-cols-3 while the two wide columns held a cron list and an environment table, so
   every table on the page wrapped and most of the screen was empty. The shape is the one
   Databases/Details.cshtml already uses. *@
<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="min-w-0 space-y-6">
        @* ---- Scheduled runs ----
           For a cron service this is the app: there is no container to look at between runs, so
           "did it run, did it work, what did it say" can only be answered from history. It leads,
           because a deployment list answers none of those questions. *@
        @if (app.Kind == ServiceKind.Cron)
        {
            var runs = ViewBag.CronRuns as List<Harbora.Domain.Apps.CronRun> ?? new();
            <section class="rounded-xl border border-line bg-surface">
                <div class="px-4 py-3 border-b border-line flex flex-wrap items-baseline justify-between gap-2">
                    <span class="font-semibold">@T["Scheduled runs"]</span>
                    @if (!string.IsNullOrWhiteSpace(app.Command))
                    {
                        @* What it runs, on the page where its results are — the two are meaningless apart. *@
                        <code dir="ltr" class="rounded bg-code text-code-ink px-2 py-0.5 text-xs text-ink">@app.Command</code>
                    }
                    <span class="text-xs text-ink-muted">
                        <span class="font-mono">@app.CronExpression</span>
                        @{ var described = Harbora.Infrastructure.Deployments.CronSchedule.Describe(app.CronExpression ?? ""); }
                        @if (described.Length > 0){<span>· @described</span>}
                        @if (app.NextRunAt is { } next){<span>· @T["Next"]: @next.UtcDateTime.ToString(Dates.Stamp) UTC</span>}
                    </span>
                </div>
                <div class="divide-y divide-line">
                    @if (runs.Count == 0)
                    {
                        @* Deliberately not "—": a job that has never run looks identical to a broken
                           one unless the screen says which it is. *@
                        <div class="p-4 text-ink-muted text-sm">@T["This job has not run yet."]</div>
                    }
                    @foreach (var r in runs)
                    {
                        var failed = r.Error is not null || (r.ExitCode is not null && r.ExitCode != 0);
                        var stillRunning = r.FinishedAt is null;
                        <div class="p-3">
                            <div class="flex items-center justify-between gap-3 text-sm">
                                <span class="text-ink">
                                    @r.StartedAt.UtcDateTime.ToString(Dates.Precise) UTC
                                    @if (r.IsManual)
                                    {
                                        @* Otherwise a run at 14:32 on an 03:00 schedule looks like a bug. *@
                                        <span class="text-[10px] rounded bg-surface-2 px-1 text-ink-muted">@T["run by hand"]</span>
                                    }
                                </span>
                                <div class="flex items-center gap-3">
                                    @if (r.FinishedAt is { } done)
                                    {
                                        <span class="text-xs text-ink-faint">@((done - r.StartedAt).TotalSeconds.ToString("0.0"))s</span>
                                    }
                                    @if (stillRunning)
                                    {
                                        <span class="text-xs rounded-full bg-info-soft text-info px-2 py-0.5">@T["Running"]</span>
                                    }
                                    else if (failed)
                                    {
                                        <span class="text-xs rounded-full bg-danger-soft text-danger px-2 py-0.5">
                                            @if (r.Error is not null){@T["Could not run"]}else{@T["Exit"]<text> </text>@r.ExitCode}
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-xs rounded-full bg-ok-soft text-ok px-2 py-0.5">@T["Succeeded"]</span>
                                    }
                                </div>
                            </div>
                            @if (r.Error is not null)
                            {
                                <div class="mt-2 text-xs text-danger">@r.Error</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(r.Output))
                            {
                                @* The tail is where the reason for a failure actually lives, so it is
                                   on the page rather than behind another click. *@
                                <pre dir="ltr" class="mt-2 max-h-40 overflow-auto rounded-lg bg-canvas p-2 text-[11px] leading-relaxed text-ink-muted whitespace-pre-wrap">@r.Output</pre>
                            }
                        </div>
                    }
                </div>
            </section>
        }

        @* ---- Address ----
           Sub-project A left this deliberately empty: a blank labelled space is a promise without a
           feature. The feature exists now, so the space is earned. Three states, and the middle one
           is the one that matters — a service that takes no inbound traffic must say so, or the gap
           reads exactly like the placeholder this project has spent two sub-projects removing. *@
        @{ var primaryDomain = app.Domains.FirstOrDefault(d => d.IsPrimary); }
        <section class="rounded-xl border border-line bg-surface p-4">
            <div class="mb-2 font-semibold">@(isFa ? "آدرس" : "Address")</div>
            @if (primaryDomain is not null)
            {
                @* The scheme follows SslEnabled, exactly as the Domains table below does. Hard-coding
                   https here would let one page show two schemes for one hostname the moment somebody
                   turns SSL off — and the link at the top, the one people actually click, would be
                   the wrong one. *@
                var primaryScheme = primaryDomain.SslEnabled ? "https" : "http";
                <div class="flex flex-wrap items-center gap-2">
                    <a href="@primaryScheme://@primaryDomain.Host" target="_blank" rel="noopener" dir="ltr"
                       class="text-accent-text truncate">@primaryDomain.Host</a>
                    @* Same mechanism as the prebuilt-image reference above: the element's own text is
                       what gets copied, so the control shows the full URL rather than a bare host. *@
                    <code dir="ltr" data-copy-text
                          class="rounded bg-code text-code-ink px-2 py-0.5 text-[11px]"
                          title="@(isFa ? "برای کپی کلیک کنید" : "Click to copy")">@primaryScheme://@primaryDomain.Host</code>
                </div>
            }
            else if (!Harbora.Infrastructure.Deployments.ServicePlan.CanHaveDomains(app.Kind))
            {
                <p data-address-state="no-traffic" class="text-xs text-ink-faint">
                    @(isFa
                        ? "این سرویس ترافیک ورودی نمی‌گیرد، پس آدرسی ندارد."
                        : "This service takes no inbound traffic, so it has no address.")
                </p>
            }
            else
            {
                <p data-address-state="none" class="text-xs text-ink-faint">
                    @(isFa ? "این اپ هنوز آدرسی نگرفته است. " : "This app has not been given an address yet. ")<a
                        href="/apps/addresses" class="text-accent-text hover:underline">@(isFa ? "دادن آدرس" : "Give it one")</a>
                </p>
            }

            @* ---- Private address ----
               The name this app's neighbours — other containers on the same environment network —
               can reach it by. Never a link: it resolves only inside that network, so a click from a
               browser outside it would just fail. The null state is the one that matters: an app
               that has not deployed since this shipped has no alias registered yet, and showing one
               anyway would be the same placeholder-address mistake the public block above exists to
               avoid. *@
            <div class="mt-3 pt-3 border-t border-line">
                <div class="text-[11px] text-ink-faint mb-1">
                    @(isFa ? "نام داخلی (بین سرویس‌ها)" : "Private address (service-to-service)")
                </div>
                @if (app.PrivateAddressState == PrivateAddressOutcome.Registered && !string.IsNullOrWhiteSpace(app.Slug))
                {
                    @* Same copy mechanism as the public address and the prebuilt-image reference
                       above: the element's own text is what gets copied. *@
                    <code dir="ltr" data-copy-text
                          class="rounded bg-code text-code-ink px-2 py-0.5 text-[11px]"
                          title="@(isFa ? "برای کپی کلیک کنید" : "Click to copy")">@Harbora.Infrastructure.Networking.PrivateAddress.Url(app.Slug, app.ContainerPort)</code>
                    <p class="mt-1 text-[11px] text-ink-faint">
                        @(isFa
                            ? "فقط از داخل شبکهٔ همین محیط در دسترس است."
                            : "Reachable only from inside this environment's network.")
                    </p>
                }
                else if (app.PrivateAddressState == PrivateAddressOutcome.Ambiguous)
                {
                    <p data-private-address-state="ambiguous" class="text-xs text-ink-faint">
                        @(isFa
                            ? "سرویس دیگری در همین محیط از قبل به این نام پاسخ می‌دهد، پس این نام به این اپ داده نشد."
                            : "Another service in this environment already answers to that name, so it was withheld from this app.")
                    </p>
                }
                else if (app.PrivateAddressState == PrivateAddressOutcome.KindDoesNotJoin)
                {
                    <p data-private-address-state="no-join" class="text-xs text-ink-faint">
                        @(isFa
                            ? "این نوع سرویس به شبکهٔ داخلی نمی‌پیوندد، پس نام داخلی ندارد."
                            : "This kind of service does not join the internal network, so it has no private address.")
                    </p>
                }
                else if (app.PrivateAddressState == PrivateAddressOutcome.ComposeManaged)
                {
                    <p data-private-address-state="compose" class="text-xs text-ink-faint">
                        @(isFa
                            ? "این اپ به‌صورت پشتهٔ Compose اجرا می‌شود؛ هر سرویس از قبل نام داخلی خودش را دارد."
                            : "This app runs as a Compose stack — each service already has its own private name.")
                    </p>
                }
                else
                {
                    @* Covers both PrivateAddressState == null (has not deployed since this shipped)
                       and the defensive PrivateAddressOutcome.NoSlug case — Slug is a required field
                       on App, so NoSlug should not occur in practice. Either way, no alias was ever
                       registered, so none is shown. *@
                    <p data-private-address-state="unknown" class="text-xs text-ink-faint">
                        @(isFa
                            ? "این نام در دیپلوی بعدی تعیین می‌شود."
                            : "This name will be assigned on the next deploy.")
                    </p>
                }
            </div>
        </section>

        @* ---- Specifics ----
           What the panel already stored about this app, read out loud instead of left for someone
           to piece together from the resize form, the deployment list and the domains table: its
           size and limits, how many replicas, which port, where it runs, the container it runs as,
           and the version currently live. A sibling of Address, not a new visual language. *@
        <section class="rounded-xl border border-line bg-surface p-4"
                 data-spec-size="@(app.InstanceSizeKey ?? "none")" data-spec-replicas="@Model.Replicas"
                 data-spec-port="@Model.ContainerPort" data-spec-container="@Model.ContainerName"
                 data-spec-version="@specVersion">
            <div class="mb-2 font-semibold">@(isFa ? "مشخصات" : "Specifics")</div>
            <dl class="grid grid-cols-2 gap-x-3 gap-y-2.5 text-xs">
                <div class="col-span-2">
                    <dt class="text-ink-faint">@(isFa ? "اندازهٔ نمونه" : "Instance size")</dt>
                    @if (app.InstanceSizeKey is null)
                    {
                        <dd class="text-ink" data-instance-size-state="no-limit">@(isFa ? "بدون سقف" : "No limit")</dd>
                    }
                    else if (Model.InstanceSize is { } size)
                    {
                        <dd class="text-ink" data-instance-size-state="known">
                            @(isFa ? size.NameFa : size.Name)
                            <span class="text-ink-faint">
                                · @size.CpuCores.ToString("0.##") @(isFa ? "هسته" : "vCPU")
                                · @SpecBytes(size.MemoryBytes) @(isFa ? "حافظه" : "memory")
                                · @SpecBytes(size.DiskBytes) @(isFa ? "دیسک" : "disk")
                            </span>
                        </dd>
                    }
                    else
                    {
                        @* The key on this app matches no InstanceSize row — its limits are unknown,
                           not zero. Rendering a row of zeroes here would say something false. *@
                        <dd class="text-ink-faint" data-instance-size-state="unknown">@(isFa ? "نامشخص" : "Unknown")</dd>
                    }
                </div>
                <div>
                    <dt class="text-ink-faint">@(isFa ? "تکرار" : "Replicas")</dt>
                    @if (Model.RunningReplicas is { } running)
                    {
                        // "If 2 of 3 are up, the panel must say that rather than showing green" — the
                        // running count is asked from the engine live (AppsController.
                        // TryRunningReplicaCountAsync), never assumed from the deploy that started them.
                        <dd class="text-ink @(running < Model.Replicas ? "text-amber-500" : "")"
                            data-replicas-desired="@Model.Replicas" data-replicas-running="@running">
                            @running@(isFa ? " از " : " of ")@Model.Replicas
                            @(running < Model.Replicas ? (isFa ? "در حال اجرا" : "running") : "")
                        </dd>
                    }
                    else
                    {
                        <dd class="text-ink" data-replicas-desired="@Model.Replicas">@Model.Replicas</dd>
                    }
                </div>
                <div>
                    <dt class="text-ink-faint">@(isFa ? "پورت" : "Port")</dt>
                    <dd class="text-ink font-mono" dir="ltr">@Model.ContainerPort</dd>
                </div>
                <div class="col-span-2">
                    <dt class="text-ink-faint">@(isFa ? "سرور" : "Server")</dt>
                    <dd class="text-ink truncate" data-spec-server="@(Model.Server?.Name ?? "unknown")">@(Model.Server?.Name ?? (isFa ? "نامشخص" : "Unknown"))</dd>
                </div>
                <div class="col-span-2">
                    <dt class="text-ink-faint">@(isFa ? "نام کانتینر" : "Container name")</dt>
                    <dd class="text-ink font-mono truncate" dir="ltr">@Model.ContainerName</dd>
                </div>
                <div class="col-span-2">
                    <dt class="text-ink-faint">@(isFa ? "نسخهٔ در حال اجرا" : "Live version")</dt>
                    <dd class="text-ink font-mono truncate" dir="ltr">
                        @(specVersion == "none" ? (isFa ? "هنوز دیپلوی نشده" : "Never deployed") : specVersion)
                    </dd>
                </div>
                @* ---- live status ----
                   B3 Task 3. What the engine says the container is doing right now: how long it has
                   been up, how often it has restarted, whether its health check passes. A null
                   LiveContainer means nobody could ask — a throw, a timeout, or (today, always) a
                   remote node, whose agent has no inspect verb yet. For that whole class of apps
                   this is the ordinary, permanent state, so the copy says "unknown", never a zero
                   and never a hint to just try again. *@
                <div class="col-span-2">
                    <dt class="text-ink-faint">@(isFa ? "وضعیت زندهٔ کانتینر" : "Live status")</dt>
                    @if (app.Kind == ServiceKind.Cron)
                    {
                        @* A cron service has no long-running container between runs, so there is
                           nothing here to inspect — that is not the same reason a remote node gives,
                           and blaming the engine for it would be honest about the symptom and wrong
                           about the cause. Scheduled runs, above, is where this kind of app's status
                           actually lives. *@
                        <dd class="text-ink-faint" data-spec-health="not-applicable">
                            @(isFa
                                ? "این اپ یک کار زمان‌بندی‌شده است؛ بین اجراها کانتینر درازمدتی برای بررسی وضعیت وجود ندارد."
                                : "This app is a scheduled job — there is no long-running container between runs to check the status of.")
                        </dd>
                    }
                    else if (Model.LiveContainer is { } live)
                    {
                        var health = live.Healthy switch { true => "healthy", false => "unhealthy", null => "not-checked" };
                        var healthLabel = (live.Healthy, isFa) switch
                        {
                            (true, true) => "سالم",
                            (true, false) => "Healthy",
                            (false, true) => "ناسالم",
                            (false, false) => "Unhealthy",
                            // Not the same as unhealthy: no health check was configured, so the
                            // engine was never asked to judge this container.
                            (null, true) => "بدون بررسی سلامت",
                            (null, false) => "Not checked"
                        };
                        var restartsValue = live.RestartCount?.ToString() ?? "unknown";
                        var restartsLabel = live.RestartCount is { } n
                            ? (isFa ? $"{n} بار ری‌استارت" : n == 1 ? "1 restart" : $"{n} restarts")
                            : (isFa ? "تعداد ری‌استارت نامشخص" : "restart count unknown");
                        var uptimeLabel = live.StartedAt is { } startedAt
                            ? (isFa
                                ? $"شروع {Harbora.Web.Infrastructure.Dates.Ago(startedAt, DateTimeOffset.UtcNow, true)}"
                                : $"started {Harbora.Web.Infrastructure.Dates.Ago(startedAt, DateTimeOffset.UtcNow, false)}")
                            : (isFa ? "زمان شروع نامشخص" : "start time unknown");
                        <dd class="text-ink" data-spec-health="@health" data-spec-restarts="@restartsValue">
                            @healthLabel
                            <span class="text-ink-faint">· @uptimeLabel · @restartsLabel</span>
                        </dd>
                    }
                    else
                    {
                        <dd class="text-ink-faint" data-spec-health="unknown">
                            @(isFa
                                ? "موتور کانتینر پاسخی نداد. برای برخی اپ‌ها — مثلاً آن‌هایی که روی یک نود دیگر اجرا می‌شوند — این وضعیت همیشگی است، نه یک اتفاق موقت."
                                : "The container engine did not answer. For some apps — for example ones running on a remote node — that is the permanent state, not a one-off glitch.")
                        </dd>
                    }
                </div>
                @* ---- uptime + restart history (Phase 6 M3) ----
                   Unlike the live status card above, this is a real window: how much of the last 30
                   days this container was actually observed running, from the app.up/app.restarts
                   series LifecycleHistory maintains, not a figure read from the engine this instant.
                   An app with nothing collected reports unknown, never a fabricated 100%. *@
                <div class="col-span-2">
                    <dt class="text-ink-faint">@(isFa ? "پایداری (۳۰ روز اخیر)" : "Uptime (last 30 days)")</dt>
                    @{
                        var uptimeView = Harbora.Infrastructure.Monitoring.MetricDisplay.For(Model.UptimePercent30d, "%");
                    }
                    @if (app.Kind == ServiceKind.Cron)
                    {
                        <dd class="text-ink-faint" data-spec-uptime-percent="not-applicable">
                            @(isFa
                                ? "این اپ یک کار زمان‌بندی‌شده است؛ پایداری کانتینر برای آن معنا ندارد."
                                : "This app is a scheduled job — container uptime does not apply to it.")
                        </dd>
                    }
                    else if (uptimeView.HasData)
                    {
                        var restartsLabel = Model.RestartCount30d is { } r
                            ? (isFa ? $"{r} بار ری‌استارت" : r == 1 ? "1 restart" : $"{r} restarts")
                            : (isFa ? "تعداد ری‌استارت نامشخص" : "restart count unknown");
                        <dd class="text-ink"
                            data-spec-uptime-percent="@Model.UptimePercent30d?.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                            data-spec-restart-count-30d="@(Model.RestartCount30d?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "unknown")">
                            @uptimeView.Text
                            <span class="text-ink-faint">· @restartsLabel @(isFa ? "در ۳۰ روز اخیر" : "in the last 30 days")</span>
                        </dd>
                    }
                    else
                    {
                        <dd class="text-ink-faint" data-spec-uptime-percent="unknown">
                            @(isFa
                                ? "هنوز داده‌ای برای این کانتینر جمع‌آوری نشده است."
                                : "Nothing has been collected for this container yet.")
                        </dd>
                    }
                </div>
                <div class="col-span-2">
                    <dt class="text-ink-faint">@(isFa ? "دایجست ایمیج در حال اجرا" : "Running image digest")</dt>
                    @if (Model.LiveContainer?.ImageDigest is { } digest)
                    {
                        <dd class="text-ink font-mono truncate" dir="ltr" data-copy-text
                            data-spec-digest="@digest"
                            title="@(isFa ? "برای کپی کلیک کنید" : "Click to copy")">@digest</dd>
                    }
                    else
                    {
                        <dd class="text-ink-faint" data-spec-digest="none">@(isFa ? "نامشخص" : "Unknown")</dd>
                    }
                </div>
            </dl>
        </section>

        @* ---- instance size ----
           What this app is actually consuming against these limits now lives on the Usage tab; this
           is only the control that changes them. *@
        <section class="rounded-xl border border-line bg-surface p-4">
            <div class="mb-3 font-semibold">@(isFa ? "اندازهٔ نمونه" : "Instance size")</div>
            <form asp-controller="Apps" asp-action="Resize" asp-route-id="@app.Id" method="post" class="space-y-3">
                @Html.AntiForgeryToken()
                @* Cards rather than a dropdown, so what a tier costs is visible before the choice
                   rather than after the bill — and pinned to the host this app already runs on,
                   because a resize does not move a workload. "No limit" IS offered here, unlike on
                   creation: it is the state an app made before tiers existed is already in, so
                   leaving it out would make saving this form impose a ceiling nobody asked for. *@
                @await Component.InvokeAsync("SizePicker", new
                {
                    sizeField = "instanceSizeKey",
                    selectedSize = app.InstanceSizeKey,
                    selectedServer = app.ServerId,
                    pinnedServer = app.ServerId,
                    allowNoLimit = true
                })
                <button class="btn-secondary w-full justify-center py-2 text-sm">@(isFa ? "تغییر اندازه" : "Change size")</button>
                <p class="text-[11px] leading-4 text-ink-faint">
                    @(isFa
                        ? "سقف روی کانتینر است، پس با استقرار بعدی اعمال می‌شود."
                        : "The ceiling belongs to the container, so it applies on the next deployment.")
                </p>
            </form>
        </section>

        @* ---- replicas ----
           How many containers the NEXT deployment starts — the same "write the row, apply on the
           next release" shape as the size control just above. Nothing here touches a running
           container directly; DeploymentPipeline is the only thing that does. Withheld for a
           scheduled job: Cron never starts a long-running container at all (ServicePlan.IsLongRunning),
           so a replica count on one has nothing to describe. *@
        @if (app.Kind != ServiceKind.Cron)
        {
            <section class="rounded-xl border border-line bg-surface p-4">
                <div class="mb-3 font-semibold">@(isFa ? "تکرار" : "Replicas")</div>
                <form asp-controller="Apps" asp-action="SetReplicas" asp-route-id="@app.Id" method="post" class="flex items-center gap-2">
                    @Html.AntiForgeryToken()
                    <input type="number" name="replicas" min="1" value="@Model.Replicas"
                           class="input w-20" data-replicas-input aria-label="@(isFa ? "تعداد تکرار" : "Replica count")" />
                    <button class="btn-secondary py-2 px-3 text-sm">@(isFa ? "اعمال" : "Apply")</button>
                </form>
                <p class="mt-2 text-[11px] leading-4 text-ink-faint">
                    @(isFa
                        ? "تعداد کانتینرهای در حال اجرا؛ با استقرار بعدی اعمال می‌شود."
                        : "How many containers stay running; applies on the next deployment.")
                </p>
            </section>
        }

        @* ---- Domains ----
           The status shown here is probed, not configured: DNS is resolved and a real TLS handshake
           is made. The old "SSL" badge only meant a checkbox was ticked, so a domain that had never
           been pointed at this server still advertised SSL while browsers showed a certificate error. *@
        <section class="rounded-xl border border-line bg-surface">
            <div class="px-4 py-3 border-b border-line font-semibold">@T["Domains"]</div>
            <div class="divide-y divide-line">
                @if (!app.Domains.Any()){<div class="p-4 text-ink-muted text-sm">—</div>}
                @foreach (var dom in app.Domains)
                {
                    @* The failure message travels as an attribute, not inside the script: Razor
                       HTML-encodes it either way, and entities are decoded in attributes but not in
                       a <script> body, where they would render as literal &#x…; escapes. *@
                    <div class="p-3 text-sm" data-domain-row data-check-url="/apps/@app.Id/domains/@dom.Id/check"
                         data-check-failed="@(isFa ? "بررسی دامنه انجام نشد." : "The domain check could not run.")">
                        <div class="flex items-center justify-between gap-2">
                            <a href="@(dom.SslEnabled ? "https" : "http")://@dom.Host" target="_blank" rel="noopener" class="text-accent-text truncate">@dom.Host</a>
                            <div class="flex items-center gap-2 shrink-0">
                                @if (!dom.SslEnabled){<span class="text-[10px] rounded bg-surface-2 px-1 text-ink-muted">HTTP</span>}
                                <span data-domain-state class="text-xs text-ink-faint" title="@(isFa ? "در حال بررسی" : "Checking")">…</span>
                                <button type="button" data-domain-recheck class="text-xs text-ink-faint hover:text-ink"
                                        title="@(isFa ? "بررسی مجدد" : "Re-check")">↻</button>
                                <form asp-controller="Apps" asp-action="DeleteDomain" asp-route-id="@app.Id" asp-route-domainId="@dom.Id" method="post">@Html.AntiForgeryToken()<button class="text-xs text-danger" aria-label="@(isFa ? $"حذف دامنهٔ {dom.Host}" : $"Delete domain {dom.Host}")">✕</button></form>
                            </div>
                        </div>
                        @* Filled in by the check: the verdict, and the single action that fixes it. *@
                        <p data-domain-summary class="mt-1 text-xs text-ink-muted hidden"></p>
                        <p data-domain-action class="mt-1 text-xs text-warn/90 hidden"></p>
                    </div>
                }
            </div>
            <form asp-controller="Apps" asp-action="AddDomain" asp-route-id="@app.Id" method="post" class="p-3 border-t border-line space-y-2">
                @Html.AntiForgeryToken()
                <input name="host" placeholder="app.example.com" class="w-full rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm" />
                <div class="flex items-center justify-between">
                    <label class="flex items-center gap-1 text-xs"><input type="checkbox" name="ssl" value="true" checked> @(isFa ? "SSL خودکار" : "Auto SSL")</label>
                    <button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-3 py-1.5 text-sm font-semibold">+ @(isFa ? "افزودن" : "Add")</button>
                </div>
            </form>
        </section>

        @* ---- Protection ----
           The routing engine has had basic-auth since the designer shipped; what was missing was a
           way to reach it without opening the designer and understanding Traefik middlewares. It
           applies to every domain this app answers on, because protecting one of three is not
           protection. *@
        <section class="rounded-xl border border-line bg-surface">
            <div class="px-4 py-3 border-b border-line font-semibold">@(isFa ? "محافظت از دسترسی" : "Access protection")</div>
            @if (ViewBag.HasRoutes != true)
            {
                <div class="p-4 text-sm text-ink-muted">@(isFa ? "وقتی این اپ دامنه بگیرد، اینجا می‌توانید رمز یا محدودیت IP بگذارید." : "Once this app has a domain, you can put a password or an IP restriction in front of it.")</div>
            }
            else
            {
                <form asp-controller="Apps" asp-action="SetProtection" asp-route-id="@app.Id" method="post" class="p-4 space-y-3">
                    @Html.AntiForgeryToken()
                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" name="basicAuthEnabled" value="true" @(ViewBag.ProtectionAuth == true ? "checked" : "") />
                        <span>@(isFa ? "محافظت با رمز (Basic auth)" : "Password protection (basic auth)")</span>
                    </label>
                    <div class="grid grid-cols-2 gap-2">
                        <input name="user" placeholder="@(isFa ? "نام کاربری (پیش‌فرض admin)" : "username (defaults to admin)")" dir="ltr"
                               class="rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm" />
                        <input name="password" type="password" autocomplete="new-password" dir="ltr"
                               placeholder="@(ViewBag.ProtectionAuth == true ? (isFa ? "ذخیره شده — برای تغییر بنویسید" : "stored — type to change") : (isFa ? "رمز" : "password"))"
                               class="rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm" />
                    </div>
                    <div>
                        <label class="mb-1 block text-xs text-ink-muted">@(isFa ? "فقط این IP‌ها (خالی = همه)" : "Only these IPs (empty = everyone)")</label>
                        <input name="ipAllowlist" value="@ViewBag.ProtectionIps" dir="ltr" placeholder="203.0.113.5, 10.0.0.0/8"
                               class="w-full rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm" />
                    </div>
                    <button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm font-semibold">@(isFa ? "اعمال" : "Apply")</button>
                </form>
            }
        </section>

        @* ---- Maintenance mode (P5, 2026-08-20 platform-options plan) ----
           The containers keep running; only what the proxy routes visitors to changes. Stopping the
           app is a separate, existing action — this section never touches it. *@
        <section class="rounded-xl border border-line bg-surface">
            <div class="px-4 py-3 border-b border-line font-semibold flex items-center gap-2">
                @(isFa ? "حالت تعمیر" : "Maintenance mode")
                @if (app.MaintenanceMode)
                {
                    <partial name="Design/_StatusPill" model="@(new StatusPillModel(isFa ? "روشن" : "On", "warn"))" />
                }
            </div>
            <div class="p-4 space-y-3">
                @if (app.MaintenanceMode)
                {
                    <p class="text-sm text-ink-muted">
                        @(isFa ? "بازدیدکنندگان به‌جای این اپ صفحه‌ی تعمیر را می‌بینند." : "Visitors see the maintenance page instead of this app.")
                        @if (app.MaintenanceSince is { } since)
                        {
                            <span>@(isFa ? "از" : "since") <span class="font-mono" dir="ltr">@since.UtcDateTime.ToString(Dates.Stamp) UTC</span></span>
                        }
                    </p>
                    @if (!string.IsNullOrWhiteSpace(app.MaintenanceMessage) || !string.IsNullOrWhiteSpace(app.MaintenanceMessageFa))
                    {
                        <div class="rounded-lg bg-surface-2 border border-line px-3 py-2 text-sm text-ink-muted space-y-1">
                            @if (!string.IsNullOrWhiteSpace(app.MaintenanceMessageFa))
                            {
                                <p>@app.MaintenanceMessageFa</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(app.MaintenanceMessage))
                            {
                                <p dir="ltr">@app.MaintenanceMessage</p>
                            }
                        </div>
                    }
                    <form asp-controller="Apps" asp-action="DisableMaintenance" asp-route-id="@app.Id" method="post"
                          onsubmit="return confirm('@(isFa ? "حالت تعمیر خاموش شود؟ اپ دوباره برای بازدیدکنندگان در دسترس خواهد بود." : "Turn maintenance mode off? The app will be reachable by visitors again.")')">
                        @Html.AntiForgeryToken()
                        <button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm font-semibold">@(isFa ? "خاموش کردن حالت تعمیر" : "Turn off maintenance")</button>
                    </form>
                }
                else
                {
                    <p class="text-sm text-ink-muted">@(isFa ? "بازدیدکنندگان اپ را می‌بینند؛ کانتینر همچنان اجرا می‌شود. با روشن کردن، به‌جای اپ صفحه‌ی تعمیر نمایش داده می‌شود." : "Visitors currently reach the app; the container keeps running either way. Turning this on shows them a maintenance page instead.")</p>
                    <form asp-controller="Apps" asp-action="EnableMaintenance" asp-route-id="@app.Id" method="post" class="space-y-2"
                          onsubmit="return confirm('@(isFa ? "حالت تعمیر روشن شود؟ بازدیدکنندگان صفحه‌ی تعمیر را می‌بینند؛ اپ همچنان اجرا می‌شود." : "Turn maintenance mode on? Visitors will see a maintenance page; the app keeps running.")')">
                        @Html.AntiForgeryToken()
                        <div>
                            <label class="mb-1 block text-xs text-ink-muted">@(isFa ? "پیام برای بازدیدکنندگان — فارسی (اختیاری)" : "Message for visitors — Persian (optional)")</label>
                            <textarea name="maintenanceMessageFa" rows="2" maxlength="500"
                                      class="w-full rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm"></textarea>
                        </div>
                        <div>
                            <label class="mb-1 block text-xs text-ink-muted">@(isFa ? "پیام برای بازدیدکنندگان — انگلیسی (اختیاری)" : "Message for visitors — English (optional)")</label>
                            <textarea name="maintenanceMessage" rows="2" maxlength="500" dir="ltr"
                                      class="w-full rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm"></textarea>
                        </div>
                        <button class="rounded-lg bg-surface-2 hover:bg-surface-2 px-4 py-2 text-sm font-semibold">@(isFa ? "روشن کردن حالت تعمیر" : "Turn on maintenance")</button>
                    </form>
                }
            </div>
        </section>

        @* ---- Git auto-deploy ---- *@
        @if (app.GitRepository is not null)
        {
            <section class="rounded-xl border border-line bg-surface p-4">
                <div class="font-semibold mb-2">@(isFa ? "استقرار خودکار (Git)" : "Auto-deploy (Git)")</div>
                <div class="text-xs text-ink-muted mb-2">
                    @(isFa ? "با هر push به" : "On push to") <code class="text-ink">@(app.GitRef ?? app.GitRepository.DefaultBranch)</code>
                    @(app.AutoDeployOnPush
                        ? (isFa ? "خودکار دیپلوی می‌شود ✓" : "auto-deploys ✓")
                        : (isFa ? "غیرفعال است" : "is off"))
                </div>
                <div class="text-xs text-ink-muted">@(isFa ? "آدرس Webhook (در تنظیمات مخزن قرار دهید):" : "Webhook URL (add it in your repo settings):")</div>
                <code class="block break-all rounded bg-code text-code-ink px-2 py-1 text-xs mt-1">@Context.Request.Scheme://@Context.Request.Host/webhooks/git/@app.GitRepository.Id</code>
                <div class="text-xs text-ink-muted mt-2">
                    @(isFa ? "سکرت:" : "Secret:")
                    @if (ViewBag.RevealWebhookSecret == true)
                    {
                        <code class="text-ink break-all">@app.GitRepository.WebhookSecret</code>
                    }
                    else
                    {
                        @* Only on a click, like the Git page and the storage keys. *@
                        <code class="text-ink-faint">••••••••</code>
                        <a href="/apps/details/@app.Id?revealSecret=true" class="text-accent-text hover:underline">@(isFa ? "نمایش" : "Reveal")</a>
                    }
                </div>
                <p class="text-[11px] text-ink-faint mt-2">@(isFa ? "Content-Type را application/json بگذارید. GitHub/Gitea با امضای HMAC و GitLab با هدر توکن تأیید می‌شوند." : "Use Content-Type application/json. GitHub/Gitea verify by HMAC; GitLab by token header.")</p>
            </section>

            @* ---- Branch previews ----
               Shown next to auto-deploy because they are the same mechanism pointed at a different
               branch. A preview is a real service on a real address, so it is listed rather than
               left to be discovered in the app list looking like something somebody created. *@
            @if (app.PreviewOfAppId is null)
            {
                var previews = ViewBag.Previews as List<Harbora.Domain.Apps.App> ?? [];
                <section class="rounded-xl border border-line bg-surface p-4">
                    <div class="flex items-center justify-between gap-2 mb-2">
                        <div class="font-semibold">@(isFa ? "پیش‌نمایش شاخه‌ها" : "Branch previews")</div>
                        <form method="post" asp-action="TogglePreviews" asp-route-id="@app.Id">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="text-xs rounded-lg px-3 py-1 border @(app.PreviewsEnabled ? "border-ok text-ok" : "border-line-strong text-ink-muted")">
                                @(app.PreviewsEnabled ? (isFa ? "روشن ✓" : "On ✓") : (isFa ? "خاموش" : "Off"))
                            </button>
                        </form>
                    </div>

                    <p class="text-xs text-ink-muted">
                        @(isFa
                            ? "هر push روی شاخه‌ای غیر از شاخهٔ اصلی، محیط و آدرس مخصوص خودش را می‌گیرد. سکرت‌ها کپی نمی‌شوند — برای هر پیش‌نمایش جداگانه تنظیم کنید."
                            : "A push to any branch other than the tracked one gets an environment and address of its own. Secrets are not copied — set them per preview.")
                    </p>
                    <p class="text-[11px] text-ink-faint mt-1">
                        @(isFa
                            ? $"پیش‌نمایشی که {PreviewPolicy.IdleLifetime.TotalDays:0} روز push نگیرد یا شاخه‌اش حذف شود، خودش برداشته می‌شود."
                            : $"A preview whose branch is deleted, or which goes {PreviewPolicy.IdleLifetime.TotalDays:0} days without a push, is removed on its own.")
                    </p>

                    @if (previews.Count > 0)
                    {
                        <div class="mt-3 divide-y divide-line border-t border-line">
                            @foreach (var preview in previews)
                            {
                                <div class="py-2 flex items-center justify-between gap-2 text-sm">
                                    <a asp-action="Details" asp-route-id="@preview.Id" class="text-accent-text truncate">@preview.PreviewBranch</a>
                                    <span class="text-xs text-ink-faint shrink-0">
                                        @(preview.PreviewLastPushedAt is { } pushed
                                            ? (isFa ? $"آخرین push: {pushed.LocalDateTime:yyyy-MM-dd}" : $"last push {pushed.LocalDateTime:yyyy-MM-dd}")
                                            : "—")
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </section>
            }
        }

        @* ---- Environment variables ---- *@
        @{
            var effectiveEnv = (IReadOnlyList<Harbora.Domain.Apps.EffectiveEnvironmentEntry>)(ViewBag.EffectiveEnv
                ?? Array.Empty<Harbora.Domain.Apps.EffectiveEnvironmentEntry>());
        }
        <details class="advanced-panel" open="@advancedOpen">
            <summary><span><i data-lucide="file-code-2" class="h-4 w-4"></i>@T["Environment Variables"]</span><i data-lucide="chevron-down" class="h-4 w-4"></i></summary>

            @* Sub-project 9 (2026-08-20 platform-options plan; buckets added by F5, 2026-08-21
               functions-and-services plan): the EFFECTIVE set — the app's own variables merged with
               every attached group's and every attached bucket's current entries, exactly the way
               BuildEnv assembles a container's environment — with where each row came from always
               visible. A merged value whose origin is invisible is a debugging trap. *@
            <div class="divide-y divide-line" data-effective-env>
                @if (!effectiveEnv.Any()){<div class="p-4 text-ink-muted text-sm">—</div>}
                @foreach (var e in effectiveEnv)
                {
                    var own = e.Source == Harbora.Domain.Apps.ConfigSource.App;
                    var fromBucket = e.Source == Harbora.Domain.Apps.ConfigSource.Bucket;
                    var sourceAttr = own ? "app" : (fromBucket ? "bucket" : "group");
                    <div class="flex items-center justify-between p-3 text-sm font-mono" data-env-row data-env-key="@e.Key" data-env-source="@sourceAttr">
                        <span class="text-ink">
                            @e.Key
                            @if (e.IsSecret){<span class="text-[10px] not-italic rounded bg-surface-2 px-1 text-warn font-sans">secret</span>}
                            @if (own)
                            {
                                <span class="text-[10px] not-italic rounded bg-surface-2 px-1 text-ink-faint font-sans">@(isFa ? "خودِ اپ" : "own")</span>
                            }
                            else if (fromBucket)
                            {
                                <span class="text-[10px] not-italic rounded bg-info-soft px-1 text-info font-sans" data-env-provenance="@e.SourceBucketName">
                                    @(isFa ? $"از باکت «{e.SourceBucketName}»" : $"from bucket '{e.SourceBucketName}'")
                                </span>
                            }
                            else
                            {
                                <span class="text-[10px] not-italic rounded bg-info-soft px-1 text-info font-sans" data-env-provenance="@e.SourceGroupName">
                                    @(isFa ? $"از گروه «{e.SourceGroupName}»" : $"from group '{e.SourceGroupName}'")
                                </span>
                            }
                        </span>
                        <div class="flex items-center gap-2">
                            <span class="text-ink-faint">@(e.IsSecret ? "••••••" : e.Value)</span>
                            @if (own)
                            {
                                var ownRow = app.EnvironmentVariables.First(v => v.Key == e.Key);
                                <form asp-controller="Apps" asp-action="DeleteEnv" asp-route-id="@app.Id" asp-route-envId="@ownRow.Id" method="post">@Html.AntiForgeryToken()<button class="text-xs text-danger" aria-label="@(isFa ? $"حذف متغیر {e.Key}" : $"Delete variable {e.Key}")">✕</button></form>
                            }
                            else if (fromBucket)
                            {
                                <span class="text-xs text-ink-faint" title="@(isFa ? "برای مدیریت، به صفحهٔ فضای ذخیره‌سازی بروید" : "Manage this from the Storage page")">
                                    <i data-lucide="lock" class="h-3 w-3"></i>
                                </span>
                            }
                            else
                            {
                                <span class="text-xs text-ink-faint" title="@(isFa ? "برای تغییر، گروه را ویرایش کنید" : "Edit the group to change this")">
                                    <i data-lucide="lock" class="h-3 w-3"></i>
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
            <form asp-controller="Apps" asp-action="AddEnv" asp-route-id="@app.Id" method="post" class="p-3 border-t border-line grid grid-cols-1 sm:grid-cols-7 gap-2">
                @Html.AntiForgeryToken()
                <input name="key" placeholder="KEY" class="sm:col-span-2 rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm font-mono" />
                <input name="value" placeholder="value" class="sm:col-span-2 rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm font-mono" />
                <label class="flex items-center gap-1 text-xs"><input type="checkbox" name="isSecret" value="true"> secret</label>
                @* P6 (2026-08-17 app-environment-management design): the pipeline has read
                   AvailableAtBuild since it was added — DeploymentPipeline.cs's build stage already
                   filters on it — this form just never had a way to set it. *@
                <label class="flex items-center gap-1 text-xs" data-build-arg-checkbox>
                    <input type="checkbox" name="availableAtBuild" value="true"> @(isFa ? "زمان ساخت" : "build")
                </label>
                <button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-3 py-1.5 text-sm font-semibold">+ @T["Save"]</button>
            </form>

            @* ---- Config groups: which shared groups feed this app, and in what order ---- *@
            @{
                var attachedGroups = (IReadOnlyList<AppConfigGroupRow>)(ViewBag.AttachedConfigGroups ?? Array.Empty<AppConfigGroupRow>());
                var availableGroups = (IReadOnlyList<Harbora.Domain.Apps.ConfigGroup>)(ViewBag.AvailableConfigGroups ?? Array.Empty<Harbora.Domain.Apps.ConfigGroup>());
            }
            <div class="p-3 border-t border-line" data-config-groups-panel>
                <div class="flex items-center justify-between gap-2 mb-2">
                    <span class="text-xs font-semibold text-ink-muted">@(isFa ? "گروه‌های متصل" : "Attached config groups")</span>
                    <a href="/config-groups" class="text-xs text-accent-text">@(isFa ? "مدیریت گروه‌ها" : "Manage groups")</a>
                </div>

                @if (attachedGroups.Count == 0)
                {
                    <p class="text-xs text-ink-faint">@(isFa ? "به هیچ گروهی متصل نیست." : "Not attached to any group.")</p>
                }
                else
                {
                    <div class="space-y-1.5">
                        @foreach (var g in attachedGroups)
                        {
                            <div class="flex items-center justify-between gap-2 rounded-lg bg-surface-2 px-3 py-1.5 text-xs" data-attached-config-group="@g.Name" data-attached-config-group-order="@g.AttachOrder">
                                <span>
                                    <span class="font-medium">@g.Name</span>
                                    <span class="text-ink-faint">· @(isFa ? $"ترتیب {g.AttachOrder}" : $"order {g.AttachOrder}") · @(isFa ? $"{g.EntryCount} متغیر" : $"{g.EntryCount} variable(s)")</span>
                                    @if (g.HasUnpublishedChanges)
                                    {
                                        @* The Functions unpublished-chip idiom, reused: editing a group never restarts
                                           anything — it just marks this attachment stale until the app's own next deploy. *@
                                        <span data-config-group-state="unpublished" class="ms-1 rounded-md bg-warn-soft px-1.5 py-0.5 text-warn">@(isFa ? "با استقرار بعدی اعمال می‌شود" : "applies on next deploy")</span>
                                    }
                                    else
                                    {
                                        <span data-config-group-state="live" class="ms-1 rounded-md bg-ok-soft px-1.5 py-0.5 text-ok">@(isFa ? "به‌روز" : "live")</span>
                                    }
                                </span>
                                <form asp-controller="Apps" asp-action="DetachConfigGroup" asp-route-id="@app.Id" asp-route-configGroupId="@g.ConfigGroupId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button class="text-danger" aria-label="@(isFa ? $"جدا کردن {g.Name}" : $"Detach {g.Name}")">✕</button>
                                </form>
                            </div>
                        }
                    </div>
                }

                @if (availableGroups.Count > 0)
                {
                    <form asp-controller="Apps" asp-action="AttachConfigGroup" asp-route-id="@app.Id" method="post" class="mt-2 flex gap-2">
                        @Html.AntiForgeryToken()
                        <select name="configGroupId" class="flex-1 rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-xs">
                            @foreach (var g in availableGroups)
                            {
                                <option value="@g.Id">@g.Name</option>
                            }
                        </select>
                        <button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-3 py-1.5 text-xs font-semibold">
                            @(isFa ? "اتصال" : "Attach")
                        </button>
                    </form>
                }
            </div>

            @* ---- Storage buckets: which buckets feed this app's env, and in what order (F5,
               2026-08-21 functions-and-services plan) — the bucket-side mirror of the config-groups
               panel above. Attach/detach lives on the bucket's own page (Views/Storage/Index.cshtml),
               the same split DatabasesController draws between a service and the apps wired to it;
               this is read-only, so "where did this come from" never needs a second navigation. *@
            @{
                var attachedBuckets2 = (IReadOnlyList<AppStorageBucketRow>)(ViewBag.AttachedStorageBuckets ?? Array.Empty<AppStorageBucketRow>());
            }
            <div class="p-3 border-t border-line" data-storage-buckets-panel>
                <div class="flex items-center justify-between gap-2 mb-2">
                    <span class="text-xs font-semibold text-ink-muted">@(isFa ? "باکت‌های متصل" : "Attached buckets")</span>
                    <a href="/storage" class="text-xs text-accent-text">@(isFa ? "مدیریت باکت‌ها" : "Manage buckets")</a>
                </div>

                @if (attachedBuckets2.Count == 0)
                {
                    <p class="text-xs text-ink-faint">@(isFa ? "به هیچ باکتی متصل نیست." : "Not attached to any bucket.")</p>
                }
                else
                {
                    <div class="space-y-1.5">
                        @foreach (var b in attachedBuckets2)
                        {
                            <div class="flex items-center justify-between gap-2 rounded-lg bg-surface-2 px-3 py-1.5 text-xs" data-attached-storage-bucket="@b.Name" data-attached-storage-bucket-order="@b.AttachOrder">
                                <span>
                                    <span class="font-medium">@b.Name</span>
                                    <span class="text-ink-faint">· @(isFa ? $"ترتیب {b.AttachOrder}" : $"order {b.AttachOrder}")</span>
                                    @if (b.HasUnpublishedChanges)
                                    {
                                        <span data-storage-bucket-state="unpublished" class="ms-1 rounded-md bg-warn-soft px-1.5 py-0.5 text-warn">@(isFa ? "با استقرار بعدی اعمال می‌شود" : "applies on next deploy")</span>
                                    }
                                    else
                                    {
                                        <span data-storage-bucket-state="live" class="ms-1 rounded-md bg-ok-soft px-1.5 py-0.5 text-ok">@(isFa ? "به‌روز" : "live")</span>
                                    }
                                </span>
                                <form asp-controller="Storage" asp-action="DetachBucket" asp-route-id="@b.StorageBucketId" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="appId" value="@app.Id" />
                                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                    <button class="text-danger" aria-label="@(isFa ? $"جدا کردن {b.Name}" : $"Detach {b.Name}")">✕</button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        </details>
    </div>

    <aside class="space-y-6">
        @* ---- databases ----
           The page said nothing about them at all: the only way to attach one was to know to open
           each database in turn, and nothing here listed what this application was already using.
           So "one app, several databases" was supported by everything except the screen somebody
           would try it on. *@
        @{
            var links = ViewBag.Databases as List<AppDatabaseLinkViewModel> ?? [];
            var attached = links.Where(l => l.Attached).ToList();
            var available = links.Where(l => !l.Attached).ToList();
            var here = Context.Request.Path + Context.Request.QueryString;
        }
        <section class="rounded-xl border border-line bg-surface p-4">
            <div class="mb-3 font-semibold">@(isFa ? "دیتابیس‌ها" : "Databases")</div>

            @if (attached.Count == 0)
            {
                <p class="text-xs text-ink-faint">@(isFa ? "به هیچ دیتابیسی وصل نیست." : "Not connected to any database.")</p>
            }
            else
            {
                <div class="space-y-2">
                    @foreach (var link in attached)
                    {
                        <div class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-line bg-surface-2 p-2.5">
                            <span class="min-w-0">
                                <a href="/databases/@link.Id" class="block truncate text-sm text-ink hover:text-accent-text" dir="ltr">@link.Name</a>
                                <small class="text-[11px] text-ink-faint">@link.Type</small>
                            </span>
                            <form asp-controller="Databases" asp-action="Detach" asp-route-id="@link.Id" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="appId" value="@app.Id" />
                                <input type="hidden" name="returnUrl" value="@here" />
                                <button class="text-[11px] text-ink-faint hover:text-danger">@(isFa ? "جدا کن" : "Detach")</button>
                            </form>
                        </div>
                    }
                </div>

                @if (attached.Count > 1)
                {
                    @* Which variable holds which. Every database also writes a prefixed copy of its
                       own names; the plain ones go to whichever database asked for them first, so
                       two of the same engine share nothing. The prefix is shown rather than a whole
                       variable name, because the names differ per engine — writing
                       "PREFIX_DATABASE_URL" beside a Redis would name a variable it never sets. *@
                    <p class="mt-2 text-[11px] leading-5 text-ink-faint">
                        @(isFa
                            ? "هر دیتابیس یک نسخهٔ پیشونددار از متغیرهای خودش هم می‌نویسد. نام‌های ساده به اولی می‌رسد که آن‌ها را خواسته باشد:"
                            : "Each database also writes a prefixed copy of its own variables. The plain names go to whichever asked for them first:")
                        @foreach (var link in attached)
                        {
                            <code dir="ltr" class="ms-1">@(link.Prefix)*</code>
                        }
                    </p>
                }

                @* ---- what to read from the application ----
                   Attaching is one click, and then the developer was on their own: nothing said
                   which variables had appeared, so the answer was "read the source, or guess". A
                   .NET application guessed wrong in the expensive way — it read
                   ConnectionStrings:Default, the attach wrote PGHOST, and the deployment died at
                   the health check with a stack trace naming neither the database nor the attach.

                   Names only. This page is visible to anybody with read access to the application;
                   the values live behind the database's own page. *@
                <details class="mt-3 rounded-lg border border-line bg-surface-2 p-2.5">
                    <summary class="cursor-pointer text-xs font-medium text-ink">
                        @(isFa ? "اپ چطور این‌ها را می‌خواند؟" : "How your app reads these")
                    </summary>

                    @foreach (var link in attached)
                    {
                        var keys = Harbora.Infrastructure.Services.AttachGuidance.KeysFor(link.Type);
                        var dotNet = Harbora.Infrastructure.Services.AttachGuidance.WritesConnectionString(link.Type);

                        <div class="mt-2.5 border-t border-line pt-2.5 first:border-0 first:pt-0">
                            <div class="text-xs font-medium text-ink" dir="ltr">@link.Name <span class="text-ink-faint">· @link.Type</span></div>

                            @if (dotNet)
                            {
                                <p class="mt-1 text-[11px] leading-5 text-ink-faint">
                                    @(isFa
                                        ? "برای .NET کاری لازم نیست — کانفیگ متغیرهای محیطی را می‌خواند و «__» را به «:» تبدیل می‌کند، پس این یکی مقدار appsettings.json را override می‌کند:"
                                        : "On .NET there is nothing to do — configuration reads environment variables and maps “__” to “:”, so this one overrides appsettings.json:")
                                    <code dir="ltr" class="ms-1">@Harbora.Infrastructure.Services.AttachGuidance.DotNetKey</code>
                                </p>
                                <p class="mt-1 text-[11px] leading-5 text-ink-faint">
                                    @(isFa
                                        ? "اگر کلید اپ شما اسم دیگری دارد (مثلاً ConnectionStrings:Default)، یک متغیر با همان اسم بسازید و مقدار این را در آن بگذارید:"
                                        : "If your app spells the key differently (say ConnectionStrings:Default), add a variable with that name holding the value of:")
                                    <code dir="ltr" class="ms-1">@Harbora.Infrastructure.Services.AttachGuidance.DsnKey</code>
                                </p>
                                <p class="mt-1 text-[11px] leading-5 text-ink-faint">
                                    @(isFa
                                        ? "DATABASE_URL را مستقیم به .NET ندهید — آن URI است و درایورهای ADO.NET فقط keyword=value می‌فهمند."
                                        : "Don’t hand DATABASE_URL to .NET — it is a URI, and ADO.NET providers only parse keyword=value.")
                                </p>
                            }
                            else
                            {
                                <p class="mt-1 text-[11px] leading-5 text-ink-faint">
                                    @(isFa
                                        ? "این سرویس با URL خوانده می‌شود، نه با connection string."
                                        : "This service is reached by URL rather than a connection string.")
                                </p>
                            }

                            <p class="mt-1.5 flex flex-wrap gap-1">
                                @foreach (var key in keys)
                                {
                                    <code dir="ltr" class="rounded bg-surface px-1 py-0.5 text-[10px] text-ink-faint">@key</code>
                                }
                            </p>
                        </div>
                    }

                    <p class="mt-2.5 border-t border-line pt-2 text-[11px] leading-5 text-ink-faint">
                        @(isFa
                            ? "مقادیر اینجا نشان داده نمی‌شوند؛ صفحهٔ خود دیتابیس آن‌ها را دارد. بعد از هر تغییر، اپ را دوباره دیپلوی کنید."
                            : "Values are not shown here — the database’s own page has them. Redeploy the application after any change.")
                    </p>
                </details>
            }

            @if (available.Count > 0)
            {
                <form asp-controller="Databases" asp-action="Attach" method="post" class="mt-3 space-y-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="appId" value="@app.Id" />
                    <input type="hidden" name="returnUrl" value="@here" />
                    <select name="id" class="form-control text-sm">
                        @foreach (var link in available)
                        {
                            <option value="@link.Id">@link.Name · @link.Type</option>
                        }
                    </select>
                    <button class="btn-secondary w-full justify-center text-sm">@(isFa ? "اتصال دیتابیس" : "Attach a database")</button>
                </form>
                <p class="mt-1 text-[11px] text-ink-faint">
                    @(isFa
                        ? "بعد از اتصال، اپ را دوباره دیپلوی کنید تا متغیرها اعمال شوند."
                        : "Redeploy the application afterwards to apply the variables.")
                </p>
            }
            else if (attached.Count == 0)
            {
                <p class="mt-2 text-[11px] text-ink-faint">
                    @(isFa
                        ? "در این محیط دیتابیسی نیست. دیتابیس فقط داخل شبکهٔ خصوصی همان محیط وصل می‌شود."
                        : "There is no database in this environment. One can only attach inside its own private network.")
                </p>
            }

            @* ---- the ones it cannot reach ----
               An environment is a private network, so a database in another one cannot be attached:
               the hostname would not resolve. That was explained and left there — the person could
               see the refusal and had nowhere to go with it, while the move sat on a page in
               Advanced mode that most people never open. *@
            @{ var elsewhere = ViewBag.Elsewhere as List<AppDatabaseElsewhereViewModel> ?? []; }
            @if (elsewhere.Count > 0)
            {
                <details class="mt-3 rounded-lg border border-line bg-surface-2 p-2.5">
                    <summary class="cursor-pointer text-[11px] text-ink-muted">
                        @(isFa
                            ? $"{elsewhere.Count} دیتابیس در محیط‌های دیگر"
                            : $"{elsewhere.Count} database(s) in other environments")
                    </summary>
                    <p class="mt-2 text-[11px] leading-5 text-ink-faint">
                        @(isFa
                            ? "هر محیط یک شبکهٔ خصوصی جداست، پس این‌ها را نمی‌شود از اینجا وصل کرد — نام میزبانشان از این شبکه پیدا نمی‌شود. یا این اپ را به آن محیط ببرید، یا دیتابیس تازه‌ای در همین محیط بسازید."
                            : "Each environment is its own private network, so these cannot be attached from here — their hostname does not resolve on this one. Either move this application there, or create a database in this environment.")
                    </p>
                    <div class="mt-2 space-y-1.5">
                        @foreach (var other in elsewhere)
                        {
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <span class="min-w-0 text-[11px]">
                                    <span class="text-ink" dir="ltr">@other.Name</span>
                                    <span class="text-ink-faint">· @other.Where</span>
                                </span>
                                @* Straight to the screen that says what the move would break. It is
                                   a confirmation rather than a button because moving a service to
                                   another network severs every connection it already has. *@
                                <a href="/networks/move?appId=@app.Id&amp;targetEnvironmentId=@other.EnvironmentId"
                                   class="whitespace-nowrap text-[11px] text-accent-text hover:underline">
                                    @(isFa ? "بردن اپ به آنجا" : "Move the app there")
                                </a>
                            </div>
                        }
                    </div>
                </details>
            }
        </section>

        @* ---- The version this came from, and where it can go ----
           An app installed from a ready-made template had its version pinned at creation and
           nothing offered another, so "update n8n" meant deleting it and starting again. *@
        @{
            var currentVersion = ViewBag.CurrentVersion as Harbora.Domain.Templates.AppTemplateVersion;
            var updates = ViewBag.UpdateVersions as List<Harbora.Domain.Templates.AppTemplateVersion> ?? [];
        }
        @if (app.TemplateId is not null)
        {
            <section class="rounded-xl border border-line bg-surface p-4">
                <div class="mb-2 font-semibold">@(isFa ? "نسخه" : "Version")</div>

                <div class="text-xs text-ink-muted">
                    @(currentVersion is null
                        ? (isFa ? "نسخهٔ این نصب ثبت نشده است." : "This installation's version was not recorded.")
                        : (isFa ? $"در حال اجرا: {currentVersion.Version}" : $"Running {currentVersion.Version}"))
                </div>

                @if (!string.IsNullOrWhiteSpace(app.PrebuiltImage))
                {
                    @* The exact reference, so somebody who would rather run it themselves can take
                       it. It is what actually gets pulled, digest and all. *@
                    <code dir="ltr" class="mt-2 block break-all rounded bg-code text-code-ink px-2 py-1 text-[11px]"
                          data-copy-text>@app.PrebuiltImage</code>
                }

                @if (updates.Count > 0)
                {
                    <form asp-controller="Apps" asp-action="UpdateVersion" asp-route-id="@app.Id" method="post" class="mt-3 space-y-2">
                        @Html.AntiForgeryToken()
                        <select name="versionId" class="form-control text-sm" data-version-choice>
                            @foreach (var version in updates)
                            {
                                <option value="@version.Id"
                                        data-warning="@(isFa && !string.IsNullOrWhiteSpace(version.MigrationWarningsFa) ? version.MigrationWarningsFa : version.MigrationWarnings)">
                                    @version.Version
                                </option>
                            }
                        </select>

                        @* Shown before the button is pressed, not after. A migration warning that
                           arrives with the result is a warning about something already done. *@
                        <p class="hidden text-[11px] leading-4 text-warn" data-version-warning></p>

                        <button class="btn-secondary w-full justify-center py-2 text-sm">
                            <i data-lucide="arrow-up-right" class="h-4 w-4"></i>@(isFa ? "به‌روزرسانی" : "Update")
                        </button>
                        <p class="text-[11px] leading-4 text-ink-faint">
                            @(isFa
                                ? "مثل هر استقرار دیگری اجرا می‌شود: سلامت‌سنجی و امکان بازگشت."
                                : "Runs as a normal deployment: health gate and rollback.")
                        </p>
                    </form>
                }
                else
                {
                    <p class="mt-2 text-[11px] text-ink-faint">
                        @(isFa ? "نسخهٔ تازه‌تری ارائه نشده است." : "No newer version is offered.")
                    </p>
                }
            </section>
        }

        @* ---- A release tag of your own ----
           The curated list is what Harbora vouches for. This is for the release somebody has read the
           project's changelog about and wants today. *@
        @{
            var repository = ViewBag.Repository as string;
            var currentTag = ViewBag.CurrentTag as string;
        }
        @if (!string.IsNullOrWhiteSpace(repository))
        {
            <section class="rounded-xl border border-line bg-surface p-4">
                <div class="mb-2 font-semibold">@(isFa ? "تگ دلخواه" : "A release tag of your own")</div>
                <p class="text-[11px] leading-4 text-ink-faint">
                    @(isFa
                        ? "هر تگی از همین مخزن. پیش از ذخیره به digest تبدیل می‌شود، پس اگر تگ وجود نداشته باشد چیزی تغییر نمی‌کند."
                        : "Any tag from this repository. It is resolved to a digest before anything is stored, so a tag that does not exist changes nothing.")
                </p>
                <code dir="ltr" class="mt-2 block break-all rounded bg-code text-code-ink px-2 py-1 text-[11px]" data-copy-text>@repository</code>

                <form asp-controller="Apps" asp-action="UpdateTag" asp-route-id="@app.Id" method="post" class="mt-3 space-y-2">
                    @Html.AntiForgeryToken()
                    <input name="tag" value="@currentTag" dir="ltr" class="form-control text-sm"
                           placeholder="@(isFa ? "مثلاً 1.70.1" : "e.g. 1.70.1")" />
                    <button class="btn-secondary w-full justify-center py-2 text-sm">
                        <i data-lucide="rocket" class="h-4 w-4"></i>@(isFa ? "استقرار این تگ" : "Deploy this tag")
                    </button>
                </form>
            </section>
        }

        @* ---- Release task ----
           Shown because it runs on every deploy and can fail one. Set at create time and then
           invisible, it is a command nobody remembers is there until it breaks a release. *@
        @if (!string.IsNullOrWhiteSpace(app.ReleaseCommand))
        {
            <section class="rounded-xl border border-line bg-surface p-4">
                <div class="font-semibold mb-2">@(isFa ? "دستور پیش از انتشار" : "Release task")</div>
                <code dir="ltr" class="block break-all rounded bg-code text-code-ink px-2 py-1 text-xs">@app.ReleaseCommand</code>
                <p class="text-[11px] text-ink-faint mt-2">
                    @(isFa
                        ? "پیش از راه‌اندازی نسخهٔ جدید اجرا می‌شود. اگر شکست بخورد، نسخهٔ فعلی همچنان سرویس می‌دهد."
                        : "Runs before the new version starts. If it fails, the current version keeps serving.")
                </p>
            </section>
        }

        @* ---- Instant backup (sub-project E, Task 2) ----
           "Back up now" beside the address and specifics blocks B1, B2 and B3 built here. It states
           what it would capture before it does anything — an archive of nothing presented as a
           success is exactly what this must not be — and a Cron or ReleaseTask app with no running
           container and no volumes still gets an honest description of what a backup would contain,
           the same rule B3 settled for health and uptime, rather than a hidden or disabled control. *@
        <section class="rounded-xl border border-line bg-surface p-4"
                 data-instant-backup-state="@(Model.HasBackupRepository ? "ready" : "no-repository")"
                 data-instant-backup-volume-count="@Model.BackupVolumes.Count"
                 data-instant-backup-env-count="@app.EnvironmentVariables.Count">
            <div class="mb-2 font-semibold">@(isFa ? "پشتیبان‌گیری فوری" : "Back up now")</div>
            <p class="text-xs text-ink-faint mb-2">
                @(isFa ? "این پشتیبان شامل موارد زیر خواهد بود:" : "This backup would include:")
            </p>
            <ul class="text-xs text-ink space-y-1 mb-3">
                @if (Model.BackupVolumes.Count > 0)
                {
                    <li>
                        @(isFa ? "والیوم‌های داده: " : "Data volumes: ")
                        @for (var i = 0; i < Model.BackupVolumes.Count; i++)
                        {
                            var volume = Model.BackupVolumes[i];
                            <span data-instant-backup-volume="@volume.Name">@volume.Name (@volume.MountPath)</span>@(i < Model.BackupVolumes.Count - 1 ? ", " : "")
                        }
                    </li>
                }
                else
                {
                    @* B3's rule for an empty state, applied here: say what is known, and say when
                       there is nothing — never hide the control or offer an empty archive as if it
                       were a real one. A Cron or ReleaseTask app has no running container and
                       typically no volumes at all, so this is the ordinary case for it, not an error. *@
                    <li>
                        @(isFa
                            ? "بدون والیوم داده — فقط تعریف اپ (و در صورت وجود، ارجاع ایمیج آن) ذخیره می‌شود."
                            : "No data volumes — only the app's own definition (and its image reference, if it has deployed) would be captured.")
                    </li>
                }
                <li>
                    @(isFa
                        ? $"{app.EnvironmentVariables.Count} متغیر محیطی ({app.EnvironmentVariables.Count(e => e.IsSecret)} مورد رمز است و مقدارش وارد پشتیبان نمی‌شود)."
                        : $"{app.EnvironmentVariables.Count} environment variable(s) ({app.EnvironmentVariables.Count(e => e.IsSecret)} secret, whose value is never included).")
                </li>
                <li data-instant-backup-image="@(app.ActiveDeploymentId is null ? "none" : "captured")">
                    @(app.ActiveDeploymentId is null
                        ? (isFa
                            ? "این اپ هنوز دیپلوی نشده، پس ارجاع ایمیجی برای ثبت وجود ندارد."
                            : "This app has never deployed, so there is no image reference to capture yet.")
                        : (isFa
                            ? "ارجاع ایمیج نسخهٔ در حال اجرا"
                            : "The image reference of the version currently running."))
                </li>
            </ul>
            @if (Model.HasBackupRepository)
            {
                <form asp-controller="Apps" asp-action="BackupNow" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-3 py-1.5 text-sm font-semibold">
                        @(isFa ? "پشتیبان‌گیری فوری" : "Back up now")
                    </button>
                </form>
            }
            else
            {
                <p class="text-xs text-ink-faint">
                    @(isFa ? "هنوز مخزن پشتیبانی تنظیم نشده است. " : "No backup repository is set up yet. ")<a
                        href="/backup-center" class="text-accent-text hover:underline">@(isFa ? "ساخت یکی" : "Set one up")</a>
                </p>
            }
        </section>

        @* ---- Danger zone ---- *@
        <section class="rounded-xl border border-danger bg-red-950/10 p-4">
            <div class="font-semibold text-danger mb-1">@(isFa ? "منطقه‌ی خطر" : "Danger zone")</div>
            <p class="text-xs text-ink-muted mb-3">@(isFa ? "حذف اپ، کانتینر و مسیرهایش را پاک می‌کند." : "Deleting removes the container and its routes.")</p>
            <form asp-controller="Apps" asp-action="Delete" asp-route-id="@app.Id" method="post"
                  onsubmit="return confirm('@(isFa ? "این اپ حذف شود؟ این عمل برگشت‌ناپذیر است." : "Delete this app? This cannot be undone.")')">
                @Html.AntiForgeryToken()
                <label class="flex items-center gap-1 text-xs mb-2"><input type="checkbox" name="removeVolumes" value="true"> @(isFa ? "حذف داده‌ها (volumes)" : "Also delete data volumes")</label>
                <button class="rounded-lg bg-danger-soft hover:bg-danger-soft text-danger px-4 py-2 text-sm font-semibold">🗑 @(isFa ? "حذف اپ" : "Delete app")</button>
            </form>
        </section>
    </aside>
</div>


@section Scripts {
<script>
    // The migration warning for whichever version is selected, before the button is pressed.
    (function () {
        var choice = document.querySelector('[data-version-choice]');
        var note = document.querySelector('[data-version-warning]');
        if (!choice || !note) return;

        function sync() {
            var option = choice.options[choice.selectedIndex];
            var warning = option && option.getAttribute('data-warning');
            note.textContent = warning || '';
            note.classList.toggle('hidden', !warning);
        }
        choice.addEventListener('change', sync);
        sync();
    })();

    // Copying the image reference. One handler for every element that opts in.
    document.querySelectorAll('[data-copy-text]').forEach(function (el) {
        el.style.cursor = 'copy';
        el.addEventListener('click', function () {
            navigator.clipboard?.writeText(el.textContent.trim());
        });
    });
</script>

<script>
// Domain readiness. Each check makes a live DNS lookup and TLS handshake, so it runs here after the
// page has rendered instead of blocking Details on the slowest domain.
(function () {
    const dot = {
        Ready:               ['●', 'text-ok'],
        AwaitingCertificate: ['●', 'text-warn'],
        DnsMissing:          ['●', 'text-danger'],
        DnsNotPointingHere:  ['●', 'text-danger'],
        Unreachable:         ['●', 'text-danger'],
        Unknown:             ['●', 'text-ink-faint']
    };

    async function check(row) {
        const state = row.querySelector('[data-domain-state]');
        const summary = row.querySelector('[data-domain-summary]');
        const action = row.querySelector('[data-domain-action]');
        state.className = 'text-xs text-ink-faint';
        state.textContent = '…';

        try {
            const res = await fetch(row.dataset.checkUrl, { headers: { 'Accept': 'application/json' } });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const s = await res.json();

            const [glyph, colour] = dot[s.readiness] || dot.Unknown;
            state.textContent = glyph;
            state.className = 'text-xs ' + colour;
            state.title = s.readiness;

            summary.textContent = s.summary;
            summary.classList.remove('hidden');
            if (s.action) { action.textContent = s.action; action.classList.remove('hidden'); }
            else { action.textContent = ''; action.classList.add('hidden'); }
        } catch (e) {
            // Say the check failed rather than implying the domain is broken.
            state.textContent = '?';
            state.className = 'text-xs text-ink-faint';
            state.title = e.message;
            summary.textContent = row.dataset.checkFailed;
            summary.classList.remove('hidden');
        }
    }

    const rows = document.querySelectorAll('[data-domain-row]');
    rows.forEach(row => {
        row.querySelector('[data-domain-recheck]').addEventListener('click', () => check(row));
        check(row);
    });
})();
</script>
}
