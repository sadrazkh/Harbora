@model CreateAppViewModel
@{
    ViewData["Title"] = "Create Application";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var sizes = ViewBag.Sizes as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? [];
    var servers = ViewBag.Servers as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? [];
    var environments = ViewBag.Environments as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? [];
    var quickStarts = ViewBag.QuickStarts as IReadOnlyList<TemplateCatalogItemViewModel> ?? [];

    string Glyph(TemplateCatalogItemViewModel item) => item.Template.Key switch
    {
        "wordpress" => "W", "ghost" => "G", "node" => "JS", "aspnet" => ".N",
        "laravel" => "L", "redis-commander" => "R", "uptime-kuma" => "U",
        "postgres" => "PG", "mysql" => "MY", "mariadb" => "MA", "redis" => "R", "mongodb" => "MO",
        _ => item.Name.Trim().Length > 1 ? item.Name.Trim()[..2].ToUpperInvariant() : item.Name.ToUpperInvariant()
    };
}

<nav class="breadcrumb mb-4" aria-label="breadcrumb">
    <a href="/apps">@T["Applications"]</a><i data-lucide="chevron-right" class="h-3.5 w-3.5 rtl:rotate-180"></i><span>@(isFa ? "منبع جدید" : "New resource")</span>
</nav>

<div class="page-heading">
    <div>
        <div class="eyebrow"><i data-lucide="rocket" class="h-3.5 w-3.5"></i>@(isFa ? "استقرار جدید" : "New deployment")</div>
        <h1>@(isFa ? "چه چیزی می‌خواهید اجرا کنید؟" : "What do you want to deploy?")</h1>
        <p>@(isFa ? "با یک پروژه آماده شروع کنید یا سورس خودتان را متصل کنید؛ شبکه، SSL و استقرار خودکار ساخته می‌شود." : "Start from a ready project or connect your own source. Harbora handles networking, SSL and deployment.")</p>
    </div>
</div>

@if (quickStarts.Count > 0)
{
    <section id="quick-start" class="create-section mb-6">
        <div class="section-heading">
            <div><h2><i data-lucide="sparkles" class="h-4 w-4 text-accent-text"></i>@(isFa ? "شروع سریع با قالب آماده" : "Quick start with a template")</h2><p>@(isFa ? "منابع واقعی قالب را پیش از ایجاد مرور می‌کنید." : "Review the real resource plan before anything is created.")</p></div>
            <a href="/templates">@(isFa ? "همه قالب‌ها" : "All templates")<i data-lucide="arrow-right" class="h-3.5 w-3.5 rtl:rotate-180"></i></a>
        </div>
        <div class="create-template-grid">
            @foreach (var item in quickStarts)
            {
                <a href="/templates/@item.Template.Id/deploy" class="create-template-card">
                    <span class="template-logo" data-template-key="@item.Template.Key">@Glyph(item)</span>
                    <span class="min-w-0 flex-1"><strong>@item.Name</strong><small>@(item.IsManagedService ? (isFa ? "دیتابیس مدیریت‌شده" : "Managed database") : item.IsStack ? $"{item.ResourceCount} resources" : item.Template.Category)</small></span>
                    @if (item.Manifest.Featured) { <span class="featured-dot" title="Featured"><i data-lucide="star" class="h-3 w-3"></i></span> }
                    <i data-lucide="chevron-right" class="h-4 w-4 text-ink-faint rtl:rotate-180"></i>
                </a>
            }
        </div>
    </section>
}

<div class="create-divider"><span>@(isFa ? "یا سورس خودتان را متصل کنید" : "or connect your own source")</span></div>

<form asp-controller="Apps" asp-action="Create" method="post" class="create-layout">
    @Html.AntiForgeryToken()
    <div class="min-w-0 space-y-5">
        <div asp-validation-summary="All" class="alert-danger"></div>

        <section class="create-section">
            <div class="section-heading"><div><h2><span>1</span>@(isFa ? "روش استقرار" : "Deployment source")</h2><p>@(isFa ? "Harbora بر اساس این انتخاب فقط تنظیمات مرتبط را نشان می‌دهد." : "Only the settings relevant to this source are shown.")</p></div></div>
            <div class="source-card-grid">
                <label class="source-card">
                    <input class="sr-only" type="radio" asp-for="SourceType" value="GitRepository" data-src />
                    <span class="source-icon"><i data-lucide="git-branch" class="h-5 w-5"></i></span>
                    <strong>@(isFa ? "مخزن Git" : "Git repository")</strong>
                    <small>@(isFa ? "تشخیص خودکار استک" : "Automatic stack detection")</small>
                    <i data-lucide="circle-check" class="source-check h-4 w-4"></i>
                </label>
                <label class="source-card">
                    <input class="sr-only" type="radio" asp-for="SourceType" value="PrebuiltImage" data-src />
                    <span class="source-icon"><i data-lucide="container" class="h-5 w-5"></i></span>
                    <strong>@(isFa ? "ایمیج Docker" : "Docker image")</strong>
                    <small>@(isFa ? "اجرا از registry" : "Pull from a registry")</small>
                    <i data-lucide="circle-check" class="source-check h-4 w-4"></i>
                </label>
                <label class="source-card">
                    <input class="sr-only" type="radio" asp-for="SourceType" value="DockerCompose" data-src />
                    <span class="source-icon"><i data-lucide="boxes" class="h-5 w-5"></i></span>
                    <strong>Docker Compose</strong>
                    <small>@(isFa ? "استک چندسرویسی" : "Multi-service stack")</small>
                    <i data-lucide="circle-check" class="source-check h-4 w-4"></i>
                </label>
                <label class="source-card">
                    <input class="sr-only" type="radio" asp-for="SourceType" value="StaticSite" data-src />
                    <span class="source-icon"><i data-lucide="file-code-2" class="h-5 w-5"></i></span>
                    <strong>@(isFa ? "سایت استاتیک" : "Static site")</strong>
                    <small>@(isFa ? "Build و سرو با Nginx" : "Build and serve with Nginx")</small>
                    <i data-lucide="circle-check" class="source-check h-4 w-4"></i>
                </label>
                <label class="source-card">
                    <input class="sr-only" type="radio" asp-for="SourceType" value="Upload" data-src />
                    <span class="source-icon"><i data-lucide="terminal" class="h-5 w-5"></i></span>
                    <strong>@(isFa ? "Harbora CLI" : "Harbora CLI")</strong>
                    <small>@(isFa ? "ارسال از سیستم شما" : "Push from your machine")</small>
                    <i data-lucide="circle-check" class="source-check h-4 w-4"></i>
                </label>
            </div>
        </section>

        <section class="create-section">
            <div class="section-heading"><div><h2><span>2</span>@(isFa ? "سورس و مشخصات" : "Source and identity")</h2><p>@(isFa ? "نام، محیط و آدرس سرویس را مشخص کنید." : "Choose the service name, environment and source location.")</p></div></div>
            <div class="grid gap-4 md:grid-cols-2">
                <label class="form-field md:col-span-2"><span>@T["Name"]</span><input asp-for="Name" required autofocus placeholder="@(isFa ? "مثلاً api-production" : "e.g. production-api")" class="form-control" /><small>@(isFa ? "Slug و نام container به‌صورت امن از این نام ساخته می‌شود." : "A safe slug and container name are generated automatically.")</small></label>

                <label data-panel="GitRepository,StaticSite,DockerCompose,Dockerfile" class="form-field md:col-span-2">
                    <span>@(isFa ? "آدرس مخزن Git" : "Git repository URL")</span>
                    <div class="input-with-icon"><i data-lucide="git-branch" class="h-4 w-4"></i><input asp-for="CloneUrl" placeholder="https://github.com/acme/service.git" class="form-control" dir="ltr" /></div>
                </label>

                <label data-panel="PrebuiltImage" class="form-field md:col-span-2">
                    <span>@(isFa ? "نام ایمیج" : "Container image")</span>
                    <div class="input-with-icon"><i data-lucide="container" class="h-4 w-4"></i><input asp-for="PrebuiltImage" placeholder="ghcr.io/acme/service:1.4.2" class="form-control" dir="ltr" /></div>
                </label>

                <div data-panel="Upload" class="md:col-span-2 cli-callout">
                    <i data-lucide="terminal-square" class="h-5 w-5"></i>
                    <div><strong>@(isFa ? "بعد از ایجاد، سورس را از ترمینال بفرستید" : "Push the source after creating the app")</strong>
                    <code dir="ltr">harbora deploy &lt;slug&gt;</code><small>@(isFa ? ".git، node_modules و .env آپلود نمی‌شوند." : ".git, node_modules and .env are excluded.")</small></div>
                </div>

                @if (environments.Count > 0)
                {
                    <label class="form-field"><span>@(isFa ? "پروژه و محیط" : "Project environment")</span><select asp-for="EnvironmentId" asp-items="environments" class="form-control"></select><small>@(isFa ? "مرز شبکه خصوصی سرویس" : "The service's private-network boundary")</small></label>
                }
                <label class="form-field"><span>@T["Domain"]</span><input asp-for="Domain" placeholder="@(isFa ? "خودکار یا app.example.com" : "automatic or app.example.com")" class="form-control" dir="ltr" /><small>@(isFa ? "SSL و HTTPS به‌صورت خودکار" : "Automatic SSL and HTTPS")</small></label>
            </div>
        </section>

        <details class="advanced-panel">
            <summary><span><i data-lucide="sliders-horizontal" class="h-4 w-4"></i>@(isFa ? "تنظیمات Runtime و Build" : "Runtime and build settings")</span><i data-lucide="chevron-down" class="h-4 w-4"></i></summary>
            <div class="grid gap-4 border-t border-line p-5 md:grid-cols-2">
                <label class="form-field"><span>Slug</span><input asp-for="Slug" placeholder="auto-from-name" class="form-control" dir="ltr" /></label>
                <label data-panel="GitRepository,StaticSite,DockerCompose,Dockerfile" class="form-field"><span>@T["Branch or Tag"]</span><input asp-for="GitRef" class="form-control" dir="ltr" /></label>
                <label data-panel="GitRepository,StaticSite,DockerCompose,Dockerfile" class="form-field"><span>@(isFa ? "توکن مخزن خصوصی" : "Private repository token")</span><input asp-for="GitToken" type="password" class="form-control" autocomplete="off" /></label>
                <label data-panel="GitRepository,Dockerfile" class="form-field"><span>Dockerfile path</span><input asp-for="DockerfilePath" class="form-control" dir="ltr" /></label>
                <label data-panel="DockerCompose" class="form-field"><span>Compose file path</span><input asp-for="ComposeFilePath" placeholder="compose.yml (auto-detected)" class="form-control" dir="ltr" /><small>@(isFa ? "خالی بگذارید تا نام‌های استاندارد پیدا شوند." : "Leave blank to detect standard file names.")</small></label>
                <label class="form-field"><span>@(isFa ? "نوع سرویس" : "Service type")</span><select asp-for="Kind" data-service-kind class="form-control">@foreach (var k in Enum.GetValues<Harbora.Domain.Common.ServiceKind>()){<option value="@k" data-help="@Harbora.Infrastructure.Deployments.ServicePlan.Describe(k)">@k</option>}</select><small data-kind-help></small></label>
                <label class="form-field"><span>@(isFa ? "پورت داخلی" : "Container port")</span><input asp-for="ContainerPort" type="number" min="1" max="65535" class="form-control" /></label>
                @if (sizes.Count > 0) { <label class="form-field"><span>@(isFa ? "اندازه منبع" : "Instance size")</span><select asp-for="InstanceSizeKey" asp-items="sizes" class="form-control"></select></label> }
                @if (servers.Count > 1) { <label class="form-field"><span>@T["Servers"]</span><select asp-for="ServerId" asp-items="servers" class="form-control"></select></label> }
                <label class="form-field md:col-span-2"><span>@(isFa ? "دستور پیش از انتشار" : "Release command")</span><input asp-for="ReleaseCommand" placeholder="dotnet ef database update" class="form-control" dir="ltr" /><small>@(isFa ? "اگر شکست بخورد، ترافیک روی نسخه فعلی می‌ماند." : "If it fails, traffic stays on the current version.")</small></label>
                <label data-cron-only class="form-field hidden"><span>@(isFa ? "دستور اجرا" : "Command to run")</span><input asp-for="Command" placeholder="php artisan schedule:run" class="form-control" dir="ltr" /></label>
                <label data-cron-only class="form-field hidden"><span>@(isFa ? "زمان‌بندی Cron" : "Cron schedule")</span><input asp-for="CronExpression" placeholder="0 3 * * *" class="form-control" dir="ltr" /></label>
                <label data-git-only class="option-row md:col-span-2"><input asp-for="PreviewsEnabled" type="checkbox" /><span><strong>@(isFa ? "محیط Preview برای branchها" : "Preview environments for branches")</strong><small>@(isFa ? "سکرت‌ها به Preview کپی نمی‌شوند." : "Secrets are never copied to previews.")</small></span></label>
            </div>
        </details>
    </div>

    <aside class="create-review">
        <div class="sticky top-4">
            <div class="review-heading"><span class="source-icon"><i data-lucide="rocket" class="h-5 w-5"></i></span><div><strong>@(isFa ? "خلاصه استقرار" : "Deployment summary")</strong><small>@(isFa ? "پیش از ساخت بررسی کنید" : "Review before creating")</small></div></div>
            <dl class="review-list">
                <div><dt>@(isFa ? "منبع" : "Source")</dt><dd data-review-source>Git repository</dd></div>
                <div><dt>@(isFa ? "شبکه" : "Network")</dt><dd><i data-lucide="shield-check" class="h-3.5 w-3.5 text-ok"></i>@(isFa ? "خصوصی" : "Private")</dd></div>
                <div><dt>HTTPS</dt><dd><i data-lucide="lock-keyhole" class="h-3.5 w-3.5 text-ok"></i>@(isFa ? "خودکار" : "Automatic")</dd></div>
                <div><dt>@(isFa ? "استقرار" : "Deployment")</dt><dd data-review-deployment>@(isFa ? "سلامت‌سنجی + rollback" : "Health gate + rollback")</dd></div>
            </dl>
            <label class="deploy-toggle" data-deploy-toggle><input asp-for="DeployNow" type="checkbox" data-deploy-now /><span><strong>@(isFa ? "همین حالا استقرار بده" : "Deploy immediately")</strong><small>@(isFa ? "بعد از ایجاد به لاگ زنده می‌روید." : "Open live deployment logs after creation.")</small></span></label>
            <button type="submit" class="btn-primary w-full justify-center py-3"><i data-lucide="rocket" class="h-4 w-4"></i><span data-submit-label>@(isFa ? "ایجاد و استقرار برنامه" : "Create and deploy application")</span></button>
            <a href="/apps" class="mt-2 flex justify-center py-2 text-sm text-ink-muted hover:text-ink">@T["Cancel"]</a>
            <p class="review-note"><i data-lucide="info" class="h-3.5 w-3.5"></i>@(isFa ? "Quota، ظرفیت سرور و دسترسی پروژه پیش از ایجاد بررسی می‌شود." : "Quota, server capacity and project access are checked before creation.")</p>
        </div>
    </aside>
</form>

@section Scripts {
<script>
(() => {
    const createAndDeployLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isFa ? "ایجاد و استقرار برنامه" : "Create and deploy application"));
    const createOnlyLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isFa ? "ایجاد برنامه" : "Create application"));
    const healthGateLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isFa ? "سلامت‌سنجی + rollback" : "Health gate + rollback"));
    const cliWaitingLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isFa ? "منتظر push از CLI" : "Waiting for CLI push"));
    const sourceNames = {
        GitRepository: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isFa ? "مخزن Git" : "Git repository")),
        PrebuiltImage: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isFa ? "ایمیج Docker" : "Docker image")),
        DockerCompose: 'Docker Compose',
        StaticSite: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isFa ? "سایت استاتیک" : "Static site")),
        Upload: 'Harbora CLI'
    };
    const kind = document.querySelector('[data-service-kind]');
    const deployNow = document.querySelector('[data-deploy-now]');
    const deployToggle = document.querySelector('[data-deploy-toggle]');
    const submitLabel = document.querySelector('[data-submit-label]');
    const deploymentSummary = document.querySelector('[data-review-deployment]');
    function syncDeploy(source) {
        const canDeployNow = source !== 'Upload';
        deployToggle?.classList.toggle('hidden', !canDeployNow);
        if (!canDeployNow && deployNow) deployNow.checked = false;
        const deploying = canDeployNow && deployNow?.checked;
        if (submitLabel) submitLabel.textContent = deploying
            ? createAndDeployLabel
            : createOnlyLabel;
        if (deploymentSummary) deploymentSummary.textContent = canDeployNow
            ? healthGateLabel
            : cliWaitingLabel;
    }
    function sync() {
        const value = document.querySelector('[data-src]:checked')?.value || 'GitRepository';
        document.querySelectorAll('[data-panel]').forEach(element => {
            const sources = element.dataset.panel.split(',').map(x => x.trim());
            element.classList.toggle('hidden', !sources.includes(value));
        });
        document.querySelectorAll('[data-git-only]').forEach(element =>
            element.classList.toggle('hidden', !['GitRepository', 'DockerCompose'].includes(value)));
        const review = document.querySelector('[data-review-source]');
        if (review) review.textContent = sourceNames[value] || value;
        syncDeploy(value);
    }
    function syncKind() {
        const value = kind?.value || 'Web';
        document.querySelectorAll('[data-cron-only]').forEach(element => element.classList.toggle('hidden', value !== 'Cron'));
        const help = document.querySelector('[data-kind-help]');
        if (help && kind) help.textContent = kind.options[kind.selectedIndex]?.dataset.help || '';
    }
    document.querySelectorAll('[data-src]').forEach(input => input.addEventListener('change', sync));
    deployNow?.addEventListener('change', () => syncDeploy(document.querySelector('[data-src]:checked')?.value || 'GitRepository'));
    kind?.addEventListener('change', syncKind);
    sync();
    syncKind();
})();
</script>
}
