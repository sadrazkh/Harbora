@model ApplicationsPageViewModel
@using Harbora.Web.ViewModels
@inject Harbora.Web.Infrastructure.RailPreferences Rails
@{
    ViewData["Title"] = "Applications";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var here = Context.Request.Path + Context.Request.QueryString;
    // The rail is only drawn when a panel is actually open (Task 7) — this is also the toolbar
    // control's cue that a way back needs to be on the page instead.
    var anyRailOpen = await Rails.AnyOpenAsync();
    var environments = Model.Apps.Select(a => a.Environment).Where(e => e != "—").Distinct().Order().ToList();
    string Bytes(long? bytes) => bytes switch
    {
        null => "—",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        < 1024L * 1024 * 1024 => $"{bytes / 1024.0 / 1024:0.#} MB",
        _ => $"{bytes / 1024.0 / 1024 / 1024:0.##} GB"
    };
    string CssPercent(double? value) => Math.Clamp(value ?? 0, 0, 100)
        .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    string SourceLabel(AppSourceType source) => source switch
    {
        AppSourceType.GitRepository => "Git / Buildpack",
        AppSourceType.Dockerfile => "Dockerfile",
        AppSourceType.DockerCompose => "Docker Compose",
        AppSourceType.PrebuiltImage => "Docker image",
        AppSourceType.StaticSite => "Static site",
        AppSourceType.Template => "Template",
        AppSourceType.Upload => "CLI upload",
        _ => source.ToString()
    };
    string SourceIcon(AppSourceType source) => source switch
    {
        AppSourceType.GitRepository => "git-branch",
        AppSourceType.Dockerfile or AppSourceType.PrebuiltImage => "container",
        AppSourceType.DockerCompose => "boxes",
        AppSourceType.StaticSite => "file-code-2",
        AppSourceType.Template => "sparkles",
        AppSourceType.Upload => "terminal",
        _ => "box"
    };
    string Tone(AppStatus status) => status switch
    {
        AppStatus.Running => "is-ok",
        AppStatus.Deploying => "is-info",
        AppStatus.Failed or AppStatus.Crashed => "is-danger",
        AppStatus.Stopped => "is-idle",
        _ => "is-warn"
    };
}

<div class="page-heading">
    <div>
        <div class="eyebrow"><i data-lucide="boxes" class="h-3.5 w-3.5"></i>@(isFa ? "سرویس‌های قابل استقرار" : "Deployable services")</div>
        <h1>@T["Applications"]</h1>
        <p>@(isFa ? "برنامه‌ها را بسازید، استقرارها را دنبال کنید و وضعیت هر محیط را ببینید." : "Build, deploy and operate every service across your environments.")</p>
    </div>
    <div class="flex flex-wrap gap-2">
        <a href="/git" class="btn-secondary"><i data-lucide="git-branch" class="h-4 w-4"></i>@(isFa ? "ورود از Git" : "Import from Git")</a>
        <a href="/apps/create" class="btn-primary"><i data-lucide="plus" class="h-4 w-4"></i>@T["New App"]</a>
    </div>
</div>

<section class="resource-shell">
    <div class="resource-toolbar">
        <div id="statusFilter" class="segmented-control" role="group" aria-label="@(isFa ? "فیلتر وضعیت" : "Status filter")">
            <button type="button" data-status="all" class="is-active">@(isFa ? "همه" : "All") <span>@Model.Apps.Count</span></button>
            <button type="button" data-status="Running">@T["Running"] <span>@Model.Running</span></button>
            <button type="button" data-status="Deploying">@(isFa ? "در حال ساخت" : "Building") <span>@Model.Building</span></button>
            <button type="button" data-status="Stopped">@T["Stopped"] <span>@Model.Stopped</span></button>
            <button type="button" data-status="Failed">@T["Failed"] <span>@Model.Failed</span></button>
        </div>
        <div class="flex min-w-0 flex-1 flex-wrap justify-end gap-2">
            <label class="resource-search">
                <i data-lucide="search" class="h-4 w-4"></i>
                <input id="appSearch" type="search" placeholder="@(isFa ? "جست‌وجوی برنامه…" : "Search applications…")" />
            </label>
            @if (environments.Count > 1)
            {
                <select id="environmentFilter" class="compact-select" aria-label="@(isFa ? "محیط" : "Environment")">
                    <option value="all">@(isFa ? "همه محیط‌ها" : "All environments")</option>
                    @foreach (var environment in environments) { <option value="@environment">@environment</option> }
                </select>
            }
            @if (!anyRailOpen)
            {
                @* Do-not-change item 23: closing every panel folds the rail away entirely (Task 7),
                   so this is the only way back once it is gone — it must stay in the toolbar, outside
                   the rail it reopens. Reopens Overview: "the count of what they already have, which
                   is the reason the page exists" (RailPreferences). Quick start keeps its own toggle,
                   reachable again once the rail is back. *@
                <form asp-controller="Account" asp-action="SetRail" method="post" class="inline" data-rail-action="SetRail">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="panel" value="Overview" />
                    <input type="hidden" name="open" value="true" />
                    <input type="hidden" name="returnUrl" value="@here" />
                    <button type="submit" class="btn-secondary" title="@(isFa ? "نمایش پنل کناری" : "Show side panel")">
                        <i data-lucide="panel-right" class="h-4 w-4"></i>@(isFa ? "پنل کناری" : "Side panel")
                    </button>
                </form>
            }
        </div>
    </div>

    @if (Model.Apps.Count == 0)
    {
        <div class="empty-state min-h-[28rem]">
            <span class="empty-state-icon"><i data-lucide="rocket" class="h-6 w-6"></i></span>
            <h2>@T["No applications yet"]</h2>
            <p>@(isFa ? "از یک قالب آماده شروع کنید یا مخزن خودتان را متصل کنید." : "Start from a production-ready template or connect your own repository.")</p>
            <a href="/apps/create" class="btn-primary">@T["Create Application"]</a>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="resource-table min-w-[1120px]">
                <thead><tr>
                    <th>@(isFa ? "برنامه" : "Application")</th>
                    <th>@(isFa ? "سورس" : "Source")</th>
                    <th>@(isFa ? "پروژه / محیط" : "Project / environment")</th>
                    <th>@T["Domain"]</th>
                    <th>@T["Status"]</th>
                    <th>CPU</th>
                    <th>@T["Memory"]</th>
                    <th>@(isFa ? "آخرین استقرار" : "Last deployment")</th>
                    <th class="text-end">@(isFa ? "عملیات" : "Actions")</th>
                </tr></thead>
                <tbody id="appRows">
                @foreach (var app in Model.Apps)
                {
                    var filterStatus = app.Status is AppStatus.Failed or AppStatus.Crashed ? "Failed" : app.Status.ToString();
                    <tr class="app-row" data-name="@($"{app.Name} {app.Slug} {app.Domain} {app.Project} {app.Environment}".ToLowerInvariant())" data-status="@filterStatus" data-environment="@app.Environment">
                        <td>
                            <a href="/apps/details/@app.Id" class="resource-identity">
                                <span class="resource-avatar bg-accent-soft text-accent-text"><i data-lucide="@SourceIcon(app.SourceType)" class="h-4 w-4"></i></span>
                                <span><strong>@app.Name</strong><small>@app.Slug · @app.Kind</small></span>
                            </a>
                        </td>
                        <td><span class="runtime-chip">@SourceLabel(app.SourceType)</span></td>
                        <td><div class="table-primary">@app.Project</div><div class="table-secondary">@app.Environment</div></td>
                        <td>
                            @if (app.Domain is { Length: > 0 } host)
                            { <a href="https://@host" target="_blank" rel="noopener" class="domain-link"><i data-lucide="lock-keyhole" class="h-3.5 w-3.5"></i>@host<i data-lucide="external-link" class="h-3 w-3"></i></a> }
                            else
                            { <span class="table-secondary">@(isFa ? "بدون دامنه" : "No domain")</span> }
                        </td>
                        <td><span class="resource-status @Tone(app.Status)"><i></i>@app.Status</span></td>
                        <td>
                            <div class="metric-reading">@(app.CpuPercent is null ? "—" : $"{app.CpuPercent:0.#}%")</div>
                            @* No track when nothing was measured: an empty bar and an idle app look
                               identical and mean opposite things. *@
                            @if (app.CpuPercent is not null)
                            {
                                <span class="metric-track"><i style="width:@CssPercent(app.CpuPercent)%"></i></span>
                            }
                        </td>
                        <td>
                            @* The sample used to stand alone, and on its own it answers nothing —
                               whether 512 MB is full or empty depends entirely on what the app was
                               given. Now it is read against its allocation. *@
                            @{ var memory = Harbora.Infrastructure.Monitoring.AllocationReading.Of(app.MemoryBytes, app.MemoryLimitBytes); }
                            <div class="metric-reading" dir="ltr">
                                @Bytes(app.MemoryBytes)@(app.MemoryLimitBytes > 0 ? $" / {Bytes(app.MemoryLimitBytes)}" : "")
                            </div>
                            @if (memory.HasShare)
                            {
                                <span class="metric-track"><i style="width:@memory.Percent%"></i></span>
                                <span class="table-secondary">
                                    @(memory.IsOver
                                        ? (isFa ? "بالاتر از سقف — تا استقرار بعدی" : "over its limit until redeployed")
                                        : (isFa ? $"٪{memory.Percent} از تخصیص" : $"{memory.Percent}% of allocation"))
                                </span>
                            }
                            else
                            {
                                <span class="table-secondary">
                                    @(app.MemoryBytes is null
                                        ? (isFa ? "هنوز اندازه‌گیری نشده" : "Not measured yet")
                                        : (isFa ? "بدون سقف حافظه" : "No memory ceiling"))
                                </span>
                            }
                        </td>
                        <td>
                            @if (app.LastDeploymentNumber is { } number)
                            {
                                <div class="table-primary">#@number · @(app.LastDeploymentStatus?.ToString() ?? "—")</div>
                                <div class="table-secondary">@(app.LastCommit ?? "—") · @app.LastDeploymentAt?.LocalDateTime.ToString(Dates.Stamp)</div>
                            }
                            else { <span class="table-secondary">@(isFa ? "هنوز استقرار ندارد" : "Never deployed")</span> }
                        </td>
                        <td>
                            <div class="row-actions">
                                <a href="/apps/details/@app.Id" title="@(isFa ? "بازکردن" : "Open")"><i data-lucide="square-arrow-out-up-right" class="h-4 w-4"></i></a>
                                @if (app.CanOperate && app.Status == AppStatus.Running)
                                {
                                    <form asp-controller="Apps" asp-action="Restart" asp-route-id="@app.Id" method="post">@Html.AntiForgeryToken()<button title="@(T["Restart"].Value)"><i data-lucide="rotate-cw" class="h-4 w-4"></i></button></form>
                                }
                                else if (app.CanOperate)
                                {
                                    <form asp-controller="Apps" asp-action="Start" asp-route-id="@app.Id" method="post">@Html.AntiForgeryToken()<button title="@(T["Start"].Value)"><i data-lucide="play" class="h-4 w-4"></i></button></form>
                                }
                                <a href="/apps/@app.Id/logs" title="@(T["Logs"].Value)"><i data-lucide="scroll-text" class="h-4 w-4"></i></a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="resource-footer"><span id="appResultCount">@Model.Apps.Count</span> @(isFa ? "برنامه" : "applications")</div>
        <div id="noAppMatch" class="hidden p-10 text-center text-sm text-ink-faint">@(isFa ? "برنامه‌ای با این فیلتر پیدا نشد." : "No applications match these filters.")</div>
    }
</section>

@section RightRail {
    @* Each panel that IS drawn folds to its heading and its toggle rather than disappearing — the
       discipline PanelSections holds inside a form, applied to the rail. That is a different question
       from whether the rail is drawn at all: with every panel closed there is nothing here to fold to,
       so the section renders nothing and _Layout draws no column for it (Task 7) — the toolbar's own
       reopen control, above, is do-not-change item 23's way back for that case. *@
    @if (anyRailOpen)
    {
        var quickStartOpen = await Rails.IsOpenAsync(Harbora.Infrastructure.Navigation.RailPanel.QuickStart);
        var overviewOpen = await Rails.IsOpenAsync(Harbora.Infrastructure.Navigation.RailPanel.Overview);

    <section class="rail-panel">
        <div class="rail-heading">
            <div><span>@(isFa ? "شروع سریع" : "Quick start")</span><small>@(isFa ? "پروژه آماده و واقعی" : "Deployable templates")</small></div>
            <form asp-controller="Account" asp-action="SetRail" method="post" class="inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="panel" value="QuickStart" />
                <input type="hidden" name="open" value="@((!quickStartOpen).ToString().ToLowerInvariant())" />
                <input type="hidden" name="returnUrl" value="@here" />
                <button type="submit" class="rail-toggle" title="@(quickStartOpen ? (isFa ? "بستن" : "Hide") : (isFa ? "بازکردن" : "Show"))"
                        aria-expanded="@quickStartOpen.ToString().ToLowerInvariant()">
                    <i data-lucide="@(quickStartOpen ? "chevron-up" : "chevron-down")" class="h-4 w-4"></i>
                </button>
            </form>
        </div>
        @if (quickStartOpen)
        {
            <div class="quick-start-grid mt-3">
                @foreach (var item in Model.QuickStarts)
                {
                    <a href="/templates/@item.Template.Id/deploy" class="quick-start-item">
                        <partial name="Design/_TemplateLogo" model="@(new TemplateLogoModel(item.Template.Key, item.Name))" />
                        <span><strong>@item.Name</strong><small>@(item.IsStack ? $"{item.ResourceCount} resources" : item.Template.Category)</small></span>
                    </a>
                }
            </div>
            <a href="/apps/create#quick-start" class="rail-action">@(isFa ? "مرور همه روش‌های ساخت" : "Browse all create options")<i data-lucide="arrow-right" class="h-4 w-4 rtl:rotate-180"></i></a>
        }
        else
        {
            @* Closed, and still a way in: the marks alone, which is what "only the icons" means. *@
            <div class="rail-icons mt-2">
                @foreach (var item in Model.QuickStarts)
                {
                    <a href="/templates/@item.Template.Id/deploy" title="@item.Name">
                        <partial name="Design/_TemplateLogo" model="@(new TemplateLogoModel(item.Template.Key, item.Name))" />
                    </a>
                }
            </div>
        }
    </section>

    <section class="rail-panel">
        <div class="rail-heading">
            <div><span>@(isFa ? "نمای کلی" : "Applications overview")</span><small>@(isFa ? "وضعیت فعلی" : "Current state")</small></div>
            <form asp-controller="Account" asp-action="SetRail" method="post" class="inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="panel" value="Overview" />
                <input type="hidden" name="open" value="@((!overviewOpen).ToString().ToLowerInvariant())" />
                <input type="hidden" name="returnUrl" value="@here" />
                <button type="submit" class="rail-toggle" title="@(overviewOpen ? (isFa ? "بستن" : "Hide") : (isFa ? "بازکردن" : "Show"))"
                        aria-expanded="@overviewOpen.ToString().ToLowerInvariant()">
                    <i data-lucide="@(overviewOpen ? "chevron-up" : "chevron-down")" class="h-4 w-4"></i>
                </button>
            </form>
        </div>
        @if (!overviewOpen)
        {
            @* Folded to the four counts on one line — the numbers are the whole point of the panel,
               so hiding them entirely would be removing it rather than folding it. *@
            <div class="rail-icons mt-2 text-xs">
                <span class="text-ok">@Model.Running</span>
                <span class="text-info">@Model.Building</span>
                <span class="text-ink-muted">@Model.Stopped</span>
                <span class="text-danger">@Model.Failed</span>
            </div>
        }
        else
        {
        <div class="overview-total"><strong>@Model.Apps.Count</strong><span>@(isFa ? "کل برنامه‌ها" : "total applications")</span></div>
        <div class="status-distribution">
            @if (Model.Apps.Count > 0)
            {
                <i class="bg-ok" style="width:@(Model.Running * 100.0 / Model.Apps.Count)%"></i>
                <i class="bg-info" style="width:@(Model.Building * 100.0 / Model.Apps.Count)%"></i>
                <i class="bg-ink-faint" style="width:@(Model.Stopped * 100.0 / Model.Apps.Count)%"></i>
                <i class="bg-danger" style="width:@(Model.Failed * 100.0 / Model.Apps.Count)%"></i>
            }
        </div>
        <div class="mt-4 grid grid-cols-2 gap-2 text-xs">
            <div class="summary-cell"><span class="text-ok">@Model.Running</span>@T["Running"]</div>
            <div class="summary-cell"><span class="text-info">@Model.Building</span>@(isFa ? "در حال ساخت" : "Building")</div>
            <div class="summary-cell"><span class="text-ink-muted">@Model.Stopped</span>@T["Stopped"]</div>
            <div class="summary-cell"><span class="text-danger">@Model.Failed</span>@T["Failed"]</div>
        </div>
        }
    </section>
    }
}

@section Scripts {
<script>
(() => {
    const rows = Array.from(document.querySelectorAll('.app-row'));
    const search = document.getElementById('appSearch');
    const environment = document.getElementById('environmentFilter');
    const count = document.getElementById('appResultCount');
    const empty = document.getElementById('noAppMatch');
    let status = 'all';
    function apply() {
        const query = (search?.value || '').trim().toLowerCase();
        const env = environment?.value || 'all';
        let shown = 0;
        rows.forEach(row => {
            const visible = (!query || row.dataset.name.includes(query))
                && (status === 'all' || row.dataset.status === status)
                && (env === 'all' || row.dataset.environment === env);
            row.classList.toggle('hidden', !visible);
            if (visible) shown++;
        });
        if (count) count.textContent = String(shown);
        empty?.classList.toggle('hidden', shown !== 0);
    }
    search?.addEventListener('input', apply);
    environment?.addEventListener('change', apply);
    document.querySelectorAll('#statusFilter [data-status]').forEach(button => button.addEventListener('click', () => {
        status = button.dataset.status;
        document.querySelectorAll('#statusFilter [data-status]').forEach(x => x.classList.remove('is-active'));
        button.classList.add('is-active');
        apply();
    }));
})();
</script>
}
