@model ApplicationsPageViewModel
@using Harbora.Web.ViewModels
@inject Harbora.Web.Infrastructure.RailPreferences Rails
@{
    ViewData["Title"] = "Applications";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var here = Context.Request.Path + Context.Request.QueryString;
    // The rail is only drawn when a panel is actually open (Task 7) — this is also the toolbar
    // control's cue that a way back needs to be on the page instead.
    var anyRailOpen = await Rails.AnyOpenAsync();
    var environments = Model.Apps.Select(a => a.Environment).Where(e => e != "—").Distinct().Order().ToList();

    // ---- formatting helpers -------------------------------------------------------------------
    // Every one of these returns an already-formatted string rather than a raw number, so the
    // markup can print it with a plain @-expression: CurrentCulture (Persian by default in this
    // panel) would otherwise reshape the digits themselves, and a technical reading is exactly the
    // token the redesign spec says must stay legible — invariant — even under fa.
    string Mb(double bytes) => Math.Round(bytes / 1024 / 1024, 0).ToString("0", inv);
    string Pct(double value) => value.ToString("0.#", inv);

    string? DeployDuration(TimeSpan? span) => span switch
    {
        null => null,
        { TotalSeconds: < 60 } s => $"{((int)s.TotalSeconds).ToString(inv)}s",
        { } s => $"{((int)s.TotalMinutes).ToString(inv)}m {((int)s.TotalSeconds % 60).ToString(inv)}s"
    };

    string SourceLabel(AppSourceType source) => source switch
    {
        AppSourceType.GitRepository => "Git / Buildpack",
        AppSourceType.Dockerfile => "Dockerfile",
        AppSourceType.DockerCompose => "Docker Compose",
        AppSourceType.PrebuiltImage => "Docker image",
        AppSourceType.StaticSite => "Static site",
        AppSourceType.Template => "Template",
        AppSourceType.Upload => "CLI upload",
        _ => source.ToString()
    };
    string SourceIcon(AppSourceType source) => source switch
    {
        AppSourceType.GitRepository => "git-branch",
        AppSourceType.Dockerfile or AppSourceType.PrebuiltImage => "container",
        AppSourceType.DockerCompose => "boxes",
        AppSourceType.StaticSite => "file-code-2",
        AppSourceType.Template => "sparkles",
        AppSourceType.Upload => "terminal",
        _ => "box"
    };
    // The HEALTH dot's colour when there is a reading to show tone for — the old STATUS column's
    // job, folded into this one, rather than dropped (نگاشت رنگ / قواعد مشترک: nothing is deleted).
    string HealthDotClass(AppStatus status) => status switch
    {
        AppStatus.Running => "bg-ok",
        AppStatus.Deploying => "bg-info",
        AppStatus.Failed or AppStatus.Crashed => "bg-danger",
        AppStatus.Stopped => "bg-idle",
        _ => "bg-warn"
    };
}

<div class="page-heading">
    <div>
        <div class="eyebrow"><i data-lucide="boxes" class="h-3.5 w-3.5"></i>@(isFa ? "سرویس‌های قابل استقرار" : "Deployable services")</div>
        <h1>@T["Applications"]</h1>
        <p>@(isFa ? "برنامه‌ها را بسازید، استقرارها را دنبال کنید و وضعیت هر محیط را ببینید." : "Build, deploy and operate every service across your environments.")</p>
    </div>
    <div class="flex flex-wrap gap-2">
        <a href="/git" class="btn-secondary"><i data-lucide="git-branch" class="h-4 w-4"></i>@(isFa ? "ورود از Git" : "Import from Git")</a>
        <a href="/apps/create" class="btn-primary"><i data-lucide="plus" class="h-4 w-4"></i>@T["New App"]</a>
    </div>
</div>

<section class="resource-shell">
    <div class="resource-toolbar">
        <div id="statusFilter" class="segmented-control" role="group" aria-label="@(isFa ? "فیلتر وضعیت" : "Status filter")">
            <button type="button" data-status="all" class="is-active">@(isFa ? "همه" : "All") <span dir="ltr" class="font-mono">@Model.Apps.Count.ToString(inv)</span></button>
            <button type="button" data-status="Running" disabled="@(Model.Running == 0)">@T["Running"] <span dir="ltr" class="font-mono">@Model.Running.ToString(inv)</span></button>
            <button type="button" data-status="Deploying" disabled="@(Model.Building == 0)">@(isFa ? "در حال ساخت" : "Building") <span dir="ltr" class="font-mono">@Model.Building.ToString(inv)</span></button>
            <button type="button" data-status="Stopped" disabled="@(Model.Stopped == 0)">@T["Stopped"] <span dir="ltr" class="font-mono">@Model.Stopped.ToString(inv)</span></button>
            <button type="button" data-status="Failed" disabled="@(Model.Failed == 0)">@T["Failed"] <span dir="ltr" class="font-mono">@Model.Failed.ToString(inv)</span></button>
        </div>
        <div class="flex min-w-0 flex-1 flex-wrap justify-end gap-2">
            @if (environments.Count > 1)
            {
                <select id="environmentFilter" class="compact-select" aria-label="@(isFa ? "محیط" : "Environment")">
                    <option value="all">@(isFa ? "همه محیط‌ها" : "All environments")</option>
                    @foreach (var environment in environments) { <option value="@environment">@environment</option> }
                </select>
            }
            <label class="resource-search">
                <i data-lucide="search" class="h-4 w-4"></i>
                <input id="appSearch" type="search" placeholder="@(isFa ? "فیلتر بر اساس نام، دامنه، منبع…" : "Filter by name, domain, source…")" />
            </label>
            @if (!anyRailOpen)
            {
                @* Do-not-change item 23: closing every panel folds the rail away entirely (Task 7),
                   so this is the only way back once it is gone — it must stay in the toolbar, outside
                   the rail it reopens. Reopens Overview: "the count of what they already have, which
                   is the reason the page exists" (RailPreferences). Quick start keeps its own toggle,
                   reachable again once the rail is back.
                   Same label and icon as the "Side panel" button on Databases/Index.cshtml, but that
                   one reopens QuickStart instead — deliberate, not a copy/paste slip. Each list reopens
                   whichever shelf it actually has; see the note on RailPanel.QuickStart for why the two
                   pages share one panel underneath. *@
                <form asp-controller="Account" asp-action="SetRail" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="panel" value="Overview" />
                    <input type="hidden" name="open" value="true" />
                    <input type="hidden" name="returnUrl" value="@here" />
                    <button type="submit" class="btn-secondary" title="@(isFa ? "نمایش پنل کناری" : "Show side panel")">
                        <i data-lucide="panel-right" class="h-4 w-4"></i>@(isFa ? "پنل کناری" : "Side panel")
                    </button>
                </form>
            }
        </div>
    </div>

    @if (Model.Apps.Count == 0)
    {
        <partial name="Design/_EmptyState" model="@(new EmptyStateModel("rocket",
            isFa ? "هنوز برنامه‌ای نساخته‌اید. از یک قالب آماده شروع کنید یا مخزن خودتان را متصل کنید." : "You haven't created an application yet. Start from a ready-made template or connect your own repository.",
            isFa ? "+ برنامه جدید" : "+ New app", "/apps/create"))" />
    }
    else
    {
        <div class="apps-table">
            <div class="hidden gap-3 border-b border-line bg-surface-2 px-4 py-2.5 text-[10px] font-semibold uppercase tracking-wide text-ink-faint sm:grid sm:grid-cols-[1.9fr_1.5fr_1.2fr_1.4fr_130px]" role="row">
                <span role="columnheader">@(isFa ? "برنامه" : "Application")</span>
                <span role="columnheader">@(isFa ? "سلامت · ۱ ساعت" : "Health · 1h")</span>
                <span role="columnheader">@T["Domain"]</span>
                <span role="columnheader">@(isFa ? "آخرین استقرار" : "Last deployment")</span>
                <span role="columnheader"></span>
            </div>
            <div id="appRows">
            @foreach (var app in Model.Apps)
            {
                var filterStatus = app.Status is AppStatus.Failed or AppStatus.Crashed ? "Failed" : app.Status.ToString();
                var everDeployed = app.LastDeploymentNumber is not null;
                var hasReading = app.CpuPercent is not null;
                var isIdle = hasReading && Math.Round(app.CpuPercent!.Value, 1) <= 0.0;
                var healthDotClass = !hasReading ? "bg-warn" : HealthDotClass(app.Status);
                string healthText;
                if (!hasReading)
                {
                    healthText = isFa ? "بدون متریک — هرگز مستقر نشده" : "no metrics — never deployed";
                }
                else if (isIdle)
                {
                    healthText = app.MemoryLimitBytes > 0 ? $"idle · {Mb(app.MemoryLimitBytes)}MB limit" : "idle";
                }
                else
                {
                    var used = Mb(app.MemoryBytes ?? 0);
                    healthText = app.MemoryLimitBytes > 0
                        ? $"CPU {Pct(app.CpuPercent!.Value)}% · {used}/{Mb(app.MemoryLimitBytes)}MB"
                        : $"CPU {Pct(app.CpuPercent!.Value)}% · {used}MB";
                }
                var domainKnown = app.Domain is { Length: > 0 };
                var deployNumberText = app.LastDeploymentNumber is { } n
                    ? $"#{n.ToString(inv)} · {(app.LastDeploymentStatus?.ToString().ToLowerInvariant() ?? "—")}"
                    : null;
                var deployDurationText = DeployDuration(app.LastDeploymentDuration);
                var deployStamp = app.LastDeploymentAt?.LocalDateTime.ToString(Dates.Stamp);
                <div class="apps-row grid grid-cols-[1fr_auto] items-start gap-x-3 gap-y-2 border-b border-line px-4 py-3.5 transition duration-150 last:border-b-0 hover:bg-surface-2/70 sm:grid-cols-[1.9fr_1.5fr_1.2fr_1.4fr_130px] sm:items-center sm:gap-3"
                     role="row" data-name="@($"{app.Name} {app.Slug} {app.Domain} {SourceLabel(app.SourceType)} {app.Kind}".ToLowerInvariant())" data-status="@filterStatus" data-environment="@app.Environment">
                    <div role="cell" class="flex min-w-0 items-center gap-2.5">
                        <a href="/apps/details/@app.Id" class="grid h-[26px] w-[26px] shrink-0 place-items-center rounded-lg bg-accent-soft text-accent-text">
                            <i data-lucide="@SourceIcon(app.SourceType)" class="h-3.5 w-3.5"></i>
                        </a>
                        <div class="min-w-0">
                            <a href="/apps/details/@app.Id" dir="ltr" class="block truncate font-mono text-[13px] font-medium text-ink hover:text-accent-text">@app.Name</a>
                            <div class="mt-1.5 truncate text-[10.5px] text-ink-faint">@app.Kind · @SourceLabel(app.SourceType)</div>
                        </div>
                    </div>
                    <div role="cell" class="apps-cell-health hidden min-w-0 sm:block">
                        <div class="flex items-center gap-2">
                            <span class="apps-health-dot inline-block h-1.5 w-1.5 shrink-0 rounded-full @healthDotClass"></span>
                            @if (hasReading)
                            {
                                <span dir="ltr" class="truncate font-mono text-[11.5px] text-ink-muted">@healthText</span>
                            }
                            else
                            {
                                <span class="truncate text-[11.5px] text-ink-faint">@healthText</span>
                            }
                        </div>
                        @if (hasReading)
                        {
                            <div class="mt-2 h-4 w-full text-accent">
                                <partial name="Design/_Sparkline" model="@(new MetricModel(Harbora.Infrastructure.Monitoring.MetricDisplay.ForSeries(app.CpuSeries), "CPU"))" />
                            </div>
                        }
                    </div>
                    <div role="cell" class="apps-cell-domain hidden min-w-0 sm:block">
                        @if (domainKnown && everDeployed)
                        {
                            <a href="https://@app.Domain" target="_blank" rel="noopener" dir="ltr" class="block truncate font-mono text-xs text-accent-text hover:underline">@app.Domain</a>
                        }
                        else if (domainKnown)
                        {
                            <span dir="ltr" class="block truncate font-mono text-xs text-ink-faint">@app.Domain</span>
                        }
                        else
                        {
                            <span class="table-secondary">@(isFa ? "بدون دامنه" : "No domain")</span>
                        }
                    </div>
                    <div role="cell" class="apps-cell-deploy hidden min-w-0 sm:block">
                        @if (deployNumberText is not null)
                        {
                            <div dir="ltr" class="truncate font-mono text-xs text-ink">@deployNumberText</div>
                            <div dir="ltr" class="mt-1.5 truncate font-mono text-[10.5px] text-ink-faint">@deployStamp@(deployDurationText is not null ? $" · {deployDurationText}" : "")</div>
                        }
                        else
                        {
                            <span class="table-secondary">@(isFa ? "هنوز استقرار ندارد" : "Never deployed")</span>
                        }
                    </div>
                    <div role="cell" class="apps-cell-meta col-span-2 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-[11px] text-ink-muted sm:hidden">
                        <span class="apps-health-dot inline-block h-1.5 w-1.5 shrink-0 rounded-full @healthDotClass"></span>
                        <span dir="ltr" class="@(hasReading ? "font-mono" : "")">@healthText</span>
                        <span aria-hidden="true">·</span>
                        @if (domainKnown)
                        {
                            <span dir="ltr" class="font-mono @(everDeployed ? "text-accent-text" : "text-ink-faint")">@app.Domain</span>
                        }
                        else
                        {
                            <span>@(isFa ? "بدون دامنه" : "no domain")</span>
                        }
                        @if (deployNumberText is not null)
                        {
                            <span aria-hidden="true">·</span>
                            <span dir="ltr" class="font-mono">@deployNumberText</span>
                        }
                    </div>
                    <div role="cell" class="flex items-center gap-1.5 sm:justify-end">
                        @if (!everDeployed)
                        {
                            <form asp-controller="Apps" asp-action="Deploy" asp-route-id="@app.Id" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="apps-row-btn is-dark">@T["Deploy"]</button>
                            </form>
                        }
                        else
                        {
                            <a href="/apps/@app.Id/logs" class="apps-row-btn">@(isFa ? "لاگ‌ها" : "Logs")</a>
                            <form asp-controller="Apps" asp-action="Deploy" asp-route-id="@app.Id" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="apps-row-btn">@(isFa ? "استقرار مجدد" : "Redeploy")</button>
                            </form>
                        }
                    </div>
                </div>
            }
            </div>
        </div>
        <div class="resource-footer"><span id="appResultCount">@Model.Apps.Count</span> @(isFa ? "برنامه" : "applications")</div>
        <div id="noAppMatch" class="hidden p-10 text-center text-sm text-ink-faint">@(isFa ? "برنامه‌ای با این فیلتر پیدا نشد." : "No applications match these filters.")</div>
    }
</section>

@section RightRail {
    @* Each panel that IS drawn folds to its heading and its toggle rather than disappearing — the
       discipline PanelSections holds inside a form, applied to the rail. That is a different question
       from whether the rail is drawn at all: with every panel closed there is nothing here to fold to,
       so the section renders nothing and _Layout draws no column for it (Task 7) — the toolbar's own
       reopen control, above, is do-not-change item 23's way back for that case. *@
    @if (anyRailOpen)
    {
        var quickStartOpen = await Rails.IsOpenAsync(Harbora.Infrastructure.Navigation.RailPanel.QuickStart);
        var overviewOpen = await Rails.IsOpenAsync(Harbora.Infrastructure.Navigation.RailPanel.Overview);

    <section class="rail-panel">
        <div class="rail-heading">
            <div><span>@(isFa ? "شروع سریع" : "Quick start")</span><small>@(isFa ? "پروژه آماده و واقعی" : "Deployable templates")</small></div>
            <form asp-controller="Account" asp-action="SetRail" method="post" class="inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="panel" value="QuickStart" />
                <input type="hidden" name="open" value="@((!quickStartOpen).ToString().ToLowerInvariant())" />
                <input type="hidden" name="returnUrl" value="@here" />
                <button type="submit" class="rail-toggle" title="@(quickStartOpen ? (isFa ? "بستن" : "Hide") : (isFa ? "بازکردن" : "Show"))"
                        aria-expanded="@quickStartOpen.ToString().ToLowerInvariant()">
                    <i data-lucide="@(quickStartOpen ? "chevron-up" : "chevron-down")" class="h-4 w-4"></i>
                </button>
            </form>
        </div>
        @if (quickStartOpen)
        {
            <div class="quick-start-grid mt-3">
                @foreach (var item in Model.QuickStarts)
                {
                    <a href="/templates/@item.Template.Id/deploy" class="quick-start-item">
                        <partial name="Design/_TemplateLogo" model="@(new TemplateLogoModel(item.Template.Key, item.Name))" />
                        <span><strong>@item.Name</strong><small>@(item.IsStack ? $"{item.ResourceCount} resources" : item.Template.Category)</small></span>
                    </a>
                }
            </div>
            <a href="/apps/create#quick-start" class="rail-action">@(isFa ? "مرور همه روش‌های ساخت" : "Browse all create options")<i data-lucide="arrow-right" class="h-4 w-4 rtl:rotate-180"></i></a>
        }
        else
        {
            @* Closed, and still a way in: the marks alone, which is what "only the icons" means. *@
            <div class="rail-icons mt-2">
                @foreach (var item in Model.QuickStarts)
                {
                    <a href="/templates/@item.Template.Id/deploy" title="@item.Name">
                        <partial name="Design/_TemplateLogo" model="@(new TemplateLogoModel(item.Template.Key, item.Name))" />
                    </a>
                }
            </div>
        }
    </section>

    <section class="rail-panel">
        <div class="rail-heading">
            <div><span>@(isFa ? "نمای کلی" : "Applications overview")</span><small>@(isFa ? "وضعیت فعلی" : "Current state")</small></div>
            <form asp-controller="Account" asp-action="SetRail" method="post" class="inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="panel" value="Overview" />
                <input type="hidden" name="open" value="@((!overviewOpen).ToString().ToLowerInvariant())" />
                <input type="hidden" name="returnUrl" value="@here" />
                <button type="submit" class="rail-toggle" title="@(overviewOpen ? (isFa ? "بستن" : "Hide") : (isFa ? "بازکردن" : "Show"))"
                        aria-expanded="@overviewOpen.ToString().ToLowerInvariant()">
                    <i data-lucide="@(overviewOpen ? "chevron-up" : "chevron-down")" class="h-4 w-4"></i>
                </button>
            </form>
        </div>
        @if (!overviewOpen)
        {
            @* Folded to the four counts on one line — the numbers are the whole point of the panel,
               so hiding them entirely would be removing it rather than folding it. *@
            <div class="rail-icons mt-2 text-xs">
                <span class="text-ok">@Model.Running</span>
                <span class="text-info">@Model.Building</span>
                <span class="text-ink-muted">@Model.Stopped</span>
                <span class="text-danger">@Model.Failed</span>
            </div>
        }
        else
        {
        <div class="overview-total"><strong>@Model.Apps.Count</strong><span>@(isFa ? "کل برنامه‌ها" : "total applications")</span></div>
        <div class="status-distribution">
            @if (Model.Apps.Count > 0)
            {
                <i class="bg-ok" style="width:@(Model.Running * 100.0 / Model.Apps.Count)%"></i>
                <i class="bg-info" style="width:@(Model.Building * 100.0 / Model.Apps.Count)%"></i>
                <i class="bg-ink-faint" style="width:@(Model.Stopped * 100.0 / Model.Apps.Count)%"></i>
                <i class="bg-danger" style="width:@(Model.Failed * 100.0 / Model.Apps.Count)%"></i>
            }
        </div>
        <div class="mt-4 grid grid-cols-2 gap-2 text-xs">
            <div class="summary-cell"><span class="text-ok">@Model.Running</span>@T["Running"]</div>
            <div class="summary-cell"><span class="text-info">@Model.Building</span>@(isFa ? "در حال ساخت" : "Building")</div>
            <div class="summary-cell"><span class="text-ink-muted">@Model.Stopped</span>@T["Stopped"]</div>
            <div class="summary-cell"><span class="text-danger">@Model.Failed</span>@T["Failed"]</div>
        </div>
        }
    </section>
    }
}

@section Scripts {
<script>
(() => {
    const rows = Array.from(document.querySelectorAll('.apps-row'));
    const search = document.getElementById('appSearch');
    const environment = document.getElementById('environmentFilter');
    const count = document.getElementById('appResultCount');
    const empty = document.getElementById('noAppMatch');
    let status = 'all';
    function apply() {
        const query = (search?.value || '').trim().toLowerCase();
        const env = environment?.value || 'all';
        let shown = 0;
        rows.forEach(row => {
            const visible = (!query || row.dataset.name.includes(query))
                && (status === 'all' || row.dataset.status === status)
                && (env === 'all' || row.dataset.environment === env);
            row.classList.toggle('hidden', !visible);
            if (visible) shown++;
        });
        if (count) count.textContent = String(shown);
        empty?.classList.toggle('hidden', shown !== 0);
    }
    search?.addEventListener('input', apply);
    environment?.addEventListener('change', apply);
    document.querySelectorAll('#statusFilter [data-status]').forEach(button => button.addEventListener('click', () => {
        if (button.disabled) return;
        status = button.dataset.status;
        document.querySelectorAll('#statusFilter [data-status]').forEach(x => x.classList.remove('is-active'));
        button.classList.add('is-active');
        apply();
    }));
})();
</script>
}
