@using Harbora.Web.ViewModels
@model RollbackViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer T
@{
    ViewData["Title"] = T["Roll back"].Value;
    var plan = Model.Plan;
    string Short(string? sha) => string.IsNullOrEmpty(sha) ? "—" : sha[..Math.Min(7, sha.Length)];
}

<div class="max-w-2xl">
    <a href="/apps/details/@Model.AppId" class="text-sm text-ink-muted hover:text-ink">&larr; @Model.AppName</a>
    <h1 class="text-xl font-semibold mt-2 mb-4">@T["Roll back"] · @Model.AppName</h1>

    @if (!plan.CanRollback)
    {
        <div class="rounded-xl border border-danger bg-danger-soft p-4">
            <div class="text-danger font-medium mb-1">@T["This rollback isn't possible"]</div>
            <div class="text-sm text-danger/80">@plan.Reason</div>
        </div>
        <a href="/apps/details/@Model.AppId"
           class="inline-block mt-4 rounded-lg bg-surface-2 hover:bg-surface-2 px-4 py-2 text-sm">@T["Back"]</a>
    }
    else
    {
        <div class="rounded-xl border border-line bg-surface divide-y divide-line">
            <div class="px-4 py-3 font-semibold">@T["You are about to restore"]</div>

            <div class="p-4 grid sm:grid-cols-2 gap-4 text-sm">
                <div>
                    <div class="text-xs uppercase tracking-wide text-ink-faint mb-1">@T["Currently live"]</div>
                    <div class="font-medium">@(plan.CurrentNumber is not null ? $"#{plan.CurrentNumber}" : "—")</div>
                    <div class="text-xs text-ink-faint font-mono">@Short(plan.CurrentCommitSha)</div>
                </div>
                <div>
                    <div class="text-xs uppercase tracking-wide text-ink-faint mb-1">@T["Rolling back to"]</div>
                    <div class="font-medium text-warn">#@plan.TargetNumber</div>
                    <div class="text-xs text-ink-faint font-mono">@Short(plan.CommitSha)</div>
                </div>
            </div>

            <div class="p-4 space-y-2 text-sm">
                @if (!string.IsNullOrWhiteSpace(plan.CommitMessage))
                {
                    <div class="flex gap-2">
                        <span class="text-ink-faint shrink-0">@T["Commit"]:</span>
                        <span class="truncate">@plan.CommitMessage</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(plan.CommitAuthor))
                {
                    <div class="flex gap-2">
                        <span class="text-ink-faint shrink-0">@T["Author"]:</span>
                        <span>@plan.CommitAuthor</span>
                    </div>
                }
                @if (plan.DeployedAt is not null)
                {
                    <div class="flex gap-2">
                        <span class="text-ink-faint shrink-0">@T["Deployed"]:</span>
                        <span>@plan.DeployedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                }
                <div class="flex gap-2">
                    <span class="text-ink-faint shrink-0">@T["Image"]:</span>
                    <span class="font-mono text-xs break-all">@plan.ImageTag</span>
                </div>
            </div>

            <div class="p-4 text-xs text-ink-muted">
                @T["This image is already built, so no rebuild happens. The new container starts alongside the current one and traffic only switches after it passes its health check."]
            </div>
        </div>

        <form asp-controller="Apps" asp-action="Rollback" asp-route-id="@Model.AppId" method="post" class="mt-4 flex gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="deploymentId" value="@Model.TargetDeploymentId" />
            <button class="rounded-lg bg-warn hover:bg-warn px-4 py-2 text-sm font-medium">
                @T["Roll back to"] #@plan.TargetNumber
            </button>
            <a href="/apps/details/@Model.AppId"
               class="rounded-lg bg-surface-2 hover:bg-surface-2 px-4 py-2 text-sm">@T["Cancel"]</a>
        </form>
    }
</div>
