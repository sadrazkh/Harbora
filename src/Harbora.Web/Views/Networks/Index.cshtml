@model NetworksViewModel
@using Harbora.Domain.Common
@using Harbora.Infrastructure.Deployments
@{
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var selected = Model.Selected;
}

<partial name="Design/_PageHeader" model="@(new PageHeaderModel(
    isFa ? "شبکه‌ها" : "Networks",
    isFa
        ? "هر محیط شبکهٔ خصوصی خودش را دارد. اینجا می‌بینید چه چیزی روی آن است و هر سرویس با چه نامی از داخل در دسترس است."
        : "Each environment has a private network of its own. This is what sits on it, and the name each service answers to from inside."))" />

@if (selected is null)
{
    <partial name="Design/_EmptyState" model="@(new EmptyStateModel(
        Icon: "network",
        Message: isFa
            ? "هنوز محیطی نیست. با ساختن یک پروژه، اولین شبکه هم ساخته می‌شود."
            : "No environments yet. Creating a project creates the first network too.",
        ActionText: isFa ? "پروژه‌ها" : "Projects",
        ActionUrl: "/projects"))" />
}
else
{
    @* Switching environment means switching network — they are the same boundary. *@
    @if (Model.Environments.Count > 1)
    {
        <div class="mb-5 flex flex-wrap gap-1.5">
            @foreach (var environment in Model.Environments)
            {
                var active = environment.Id == selected.Id;
                <a href="/networks?environmentId=@environment.Id"
                   class="rounded-lg border px-3 py-1.5 text-xs @(active ? "border-accent bg-accent-soft text-accent-text font-semibold" : "border-line text-ink-muted hover:text-ink")">
                    @environment.Project?.Name · @environment.Name
                </a>
            }
        </div>
    }

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_320px]">
        <div class="space-y-6">
            @if (Model.Picture is { } picture)
            {
                <partial name="_ArchitectureGraph" model="picture" />
            }

            @* The table answers the question the diagram cannot: what exactly do I type to reach
               this from another service. *@
            <section class="rounded-xl border border-line bg-surface overflow-hidden">
                <div class="border-b border-line px-4 py-3 text-sm font-semibold text-ink">
                    @(isFa ? "آدرس‌های داخلی" : "Internal addresses")
                </div>

                @if (Model.Services.Count == 0 && Model.Databases.Count == 0)
                {
                    <div class="p-6 text-center text-sm text-ink-faint">
                        @(isFa ? "این شبکه خالی است." : "Nothing is attached to this network.")
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead class="text-start text-xs uppercase tracking-wide text-ink-faint">
                                <tr class="border-b border-line">
                                    <th class="px-4 py-2 text-start font-medium">@(isFa ? "سرویس" : "Service")</th>
                                    <th class="px-4 py-2 text-start font-medium">@(isFa ? "نوع" : "Type")</th>
                                    <th class="px-4 py-2 text-start font-medium">@(isFa ? "نام داخلی" : "Internal host")</th>
                                    <th class="px-4 py-2 text-start font-medium">@(isFa ? "پورت" : "Port")</th>
                                    <th class="px-4 py-2 text-end font-medium"></th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-line">
                                @foreach (var service in Model.Services)
                                {
                                    var joins = ServicePlan.JoinsInternalNetwork(service.Kind);
                                    <tr>
                                        <td class="px-4 py-2">
                                            <a href="/apps/details/@service.Id" class="text-accent-text hover:underline">@service.Name</a>
                                        </td>
                                        <td class="px-4 py-2 text-ink-muted">@service.Kind</td>
                                        <td class="px-4 py-2" dir="ltr">
                                            @if (joins)
                                            {
                                                <code class="text-ink">@service.Slug</code>
                                            }
                                            else
                                            {
                                                @* A release task exits before anything can reach it. Printing a
                                                   hostname here would invite a connection string to nowhere. *@
                                                <span class="text-ink-faint">@(isFa ? "روی شبکه نیست" : "not on the network")</span>
                                            }
                                        </td>
                                        <td class="px-4 py-2 text-ink-muted" dir="ltr">
                                            @(joins && service.ContainerPort > 0 ? service.ContainerPort.ToString() : "—")
                                        </td>
                                        <td class="px-4 py-2 text-end">
                                            @* Moving means changing networks, so the link goes to a screen that
                                               says what breaks — never straight to the change. *@
                                            @if (Model.Environments.Count > 1)
                                            {
                                                <details class="inline-block text-start">
                                                    <summary class="cursor-pointer list-none text-xs text-ink-muted hover:text-ink">
                                                        @(isFa ? "جابه‌جایی" : "Move") ▾
                                                    </summary>
                                                    <div class="mt-1 space-y-1 rounded-lg border border-line bg-surface p-2 shadow-sm">
                                                        @foreach (var other in Model.Environments.Where(e => e.Id != selected.Id))
                                                        {
                                                            <a href="/networks/move?appId=@service.Id&targetEnvironmentId=@other.Id"
                                                               class="block whitespace-nowrap rounded px-2 py-1 text-xs text-ink hover:bg-surface-2">
                                                                → @other.Project?.Name · @other.Name
                                                            </a>
                                                        }
                                                    </div>
                                                </details>
                                            }
                                        </td>
                                    </tr>
                                }
                                @foreach (var database in Model.Databases)
                                {
                                    <tr>
                                        <td class="px-4 py-2">
                                            <a href="/databases/details/@database.Id" class="text-accent-text hover:underline">@database.Name</a>
                                        </td>
                                        <td class="px-4 py-2 text-ink-muted">@database.Type</td>
                                        <td class="px-4 py-2" dir="ltr"><code class="text-ink">@database.ContainerName</code></td>
                                        <td class="px-4 py-2 text-ink-muted" dir="ltr">
                                            @(database.InternalPort > 0 ? database.InternalPort.ToString() : "—")
                                        </td>
                                        <td class="px-4 py-2 text-end">
                                            @* Wiring is per service, so the control lives with the database and
                                               names the service. Attaching writes connection variables; detaching
                                               removes exactly those. Both need a redeploy, and both say so. *@
                                            @if (Model.Services.Count > 0)
                                            {
                                                <details class="inline-block text-start">
                                                    <summary class="cursor-pointer list-none text-xs text-ink-muted hover:text-ink">
                                                        @(isFa ? "اتصال" : "Wiring") ▾
                                                    </summary>
                                                    <div class="mt-1 min-w-52 space-y-1 rounded-lg border border-line bg-surface p-2 shadow-sm">
                                                        @foreach (var service in Model.Services)
                                                        {
                                                            var wired = Model.Connections.TryGetValue(service.Id, out var hosts)
                                                                        && hosts.Contains(database.ContainerName);
                                                            <form method="post"
                                                                  action="/databases/@database.Id/@(wired ? "detach" : "attach")"
                                                                  class="flex items-center justify-between gap-2">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="appId" value="@service.Id" />
                                                                <span class="truncate text-xs text-ink">@service.Name</span>
                                                                <button type="submit"
                                                                        class="shrink-0 rounded px-2 py-0.5 text-[11px] @(wired ? "text-danger hover:bg-danger-soft" : "text-accent-text hover:bg-accent-soft")">
                                                                    @(wired ? (isFa ? "قطع" : "detach") : (isFa ? "وصل" : "attach"))
                                                                </button>
                                                            </form>
                                                        }
                                                    </div>
                                                </details>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>

        <aside class="space-y-6">
            <section class="rounded-xl border border-line bg-surface p-4">
                <div class="text-sm font-semibold text-ink">@(isFa ? "این شبکه" : "This network")</div>
                <dl class="mt-3 space-y-2 text-sm">
                    <div class="flex items-baseline justify-between gap-3">
                        <dt class="text-ink-muted">@(isFa ? "محیط" : "Environment")</dt>
                        <dd class="text-ink">@selected.Name</dd>
                    </div>
                    <div class="flex items-baseline justify-between gap-3">
                        <dt class="text-ink-muted">@(isFa ? "سرویس‌ها" : "Services")</dt>
                        <dd class="text-ink">@Model.Services.Count</dd>
                    </div>
                    <div class="flex items-baseline justify-between gap-3">
                        <dt class="text-ink-muted">@(isFa ? "دیتابیس‌ها" : "Databases")</dt>
                        <dd class="text-ink">@Model.Databases.Count</dd>
                    </div>
                </dl>

                @if (Model.NetworkName is { } network)
                {
                    <div class="mt-3 border-t border-line pt-3">
                        <div class="text-xs text-ink-muted">@(isFa ? "نام شبکهٔ Docker" : "Docker network")</div>
                        <code class="mt-1 block break-all text-[11px] text-ink-faint" dir="ltr">@network</code>
                    </div>
                }
            </section>

            <section class="rounded-xl border border-line bg-surface p-4">
                <div class="text-sm font-semibold text-ink">@(isFa ? "چطور وصل شوم" : "How to connect")</div>
                <p class="mt-2 text-xs text-ink-muted">
                    @(isFa
                        ? "از داخل این شبکه، هر سرویس با نام داخلی‌اش در دسترس است — نه با دامنهٔ عمومی. مثلاً:"
                        : "From inside this network, reach a service by its internal host — not its public domain. For example:")
                </p>
                @{
                    var example = Model.Databases.FirstOrDefault();
                }
                @if (example is not null)
                {
                    <code class="mt-2 block break-all rounded bg-surface-2 px-2 py-1.5 text-[11px] text-ink" dir="ltr">@example.ContainerName:@example.InternalPort</code>
                }
                <p class="mt-2 text-[11px] text-ink-faint">
                    @(isFa
                        ? "سرویس‌های محیط‌های دیگر روی این شبکه نیستند و نمی‌توانند به این نام‌ها برسند."
                        : "Services in other environments are not on this network and cannot reach these names.")
                </p>
            </section>
        </aside>
    </div>
}
