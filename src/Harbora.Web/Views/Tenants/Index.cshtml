@model TenantsPageViewModel
@{
    ViewData["Title"] = "Tenants";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var msg = TempData["Message"] as string; var err = TempData["Error"] as string;
}
<div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-ink">@(isFa ? "مستأجرها" : "Tenants")</h1>
    <p class="text-ink-muted text-sm">@(isFa ? "workspaceهای مشتریان روی این پلتفرم و پلن هرکدام." : "Customer workspaces hosted on this platform and their plans.")</p>
</div>

@if (msg is not null){<div class="mb-4 rounded-lg bg-ok-soft border border-ok text-ok px-4 py-2 text-sm">@msg</div>}
@if (err is not null){<div class="mb-4 rounded-lg bg-danger-soft border border-danger text-danger px-4 py-2 text-sm">@err</div>}

<div class="grid lg:grid-cols-3 gap-6">
    <section class="lg:col-span-2 rounded-xl border border-line bg-surface overflow-hidden">
        @if (Model.Tenants.Count == 0)
        {
            <partial name="Design/_EmptyState" model="@(new EmptyStateModel("building-2",
                isFa ? "هنوز مستأجری ساخته نشده است." : "No tenants have been created yet."))" />
        }
        else
        {
        <table class="w-full text-sm">
            <thead class="text-ink-muted border-b border-line">
                <tr>
                    <th class="p-3 text-start">@(isFa ? "مستأجر" : "Tenant")</th>
                    <th class="p-3 text-start">@(isFa ? "پلن" : "Plan")</th>
                    <th class="p-3 text-start">@(isFa ? "کاربر/اپ/سرویس" : "Users/Apps/Svc")</th>
                    <th class="p-3 text-end">@(isFa ? "عملیات" : "Actions")</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-line">
                @foreach (var t in Model.Tenants)
                {
                    <tr class="@(t.Suspended ? "opacity-60" : "")">
                        <td class="p-3">
                            <a href="/tenants/@t.WorkspaceId" class="font-medium hover:text-accent-text">@t.Name</a>
                            @if (t.IsDefault){<span class="text-xs rounded bg-surface-2 px-1.5 py-0.5 text-ink">provider</span>}
                            <div class="text-xs text-ink-faint font-mono">@t.Slug</div>
                        </td>
                        <td class="p-3">
                            <form asp-controller="Tenants" asp-action="AssignPlan" asp-route-id="@t.WorkspaceId" method="post" class="flex items-center gap-1">
                                @Html.AntiForgeryToken()
                                <select name="planId" onchange="this.form.submit()" class="rounded-lg bg-surface-2 border border-line-strong px-2 py-1 text-xs">
                                    <option value="">@(isFa ? "پیش‌فرض" : "Default")</option>
                                    @foreach (var p in Model.Plans)
                                    {
                                        <option value="@p.Id" selected="@(t.PlanId == p.Id)">@p.Name</option>
                                    }
                                </select>
                            </form>
                        </td>
                        <td class="p-3 text-ink-muted">@t.Members / @t.Apps / @t.Services</td>
                        <td class="p-3">
                            <div class="flex items-center justify-end gap-2">
                                @if (t.Suspended)
                                {
                                    <span class="text-xs rounded bg-danger/15 text-danger px-2 py-0.5">@(isFa ? "معلق" : "suspended")</span>
                                }
                                @if (!t.IsDefault)
                                {
                                    <form asp-controller="Tenants" asp-action="Suspend" asp-route-id="@t.WorkspaceId" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="suspended" value="@(t.Suspended ? "false" : "true")" />
                                        <button class="text-xs rounded-lg bg-surface-2 hover:bg-surface-2 px-2 py-1">@(t.Suspended ? (isFa ? "فعال‌سازی" : "resume") : (isFa ? "تعلیق" : "suspend"))</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        }
    </section>

    <section class="rounded-xl border border-line bg-surface p-5 h-fit">
        <h2 class="text-[15px] font-semibold text-ink mb-3">@(isFa ? "مستأجر جدید" : "New tenant")</h2>
        <form asp-controller="Tenants" asp-action="Create" method="post" class="space-y-3">
            @Html.AntiForgeryToken()
            <input name="name" placeholder="@(isFa ? "نام" : "Name")" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            <input name="slug" placeholder="slug (a-z0-9-)" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            <select name="planId" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm">
                <option value="">@(isFa ? "پلن پیش‌فرض" : "Default plan")</option>
                @foreach (var p in Model.Plans)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>
            <button class="w-full rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm font-semibold">@(isFa ? "ساخت" : "Create")</button>
        </form>
        <p class="mt-2 text-xs text-ink-faint">@(isFa ? "بعد از ساخت، از صفحهٔ جزئیات مستأجر کاربر مشتری را دعوت می‌کنی." : "After creating it, invite the customer's user from the tenant's details page.")</p>
    </section>
</div>
