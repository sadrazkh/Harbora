@model TenantDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var msg = TempData["Message"] as string; var err = TempData["Error"] as string;
}
<div class="mb-6">
    <a href="/tenants" class="text-accent-text text-sm">← @(isFa ? "مستأجرها" : "Tenants")</a>
    <h1 class="text-2xl font-bold tracking-tight text-ink">@Model.Name <span class="text-sm text-ink-faint font-mono">@Model.Slug</span></h1>
</div>

@if (msg is not null){<div class="mb-4 rounded-lg bg-ok-soft border border-ok text-ok px-4 py-2 text-sm">@msg</div>}
@if (err is not null){<div class="mb-4 rounded-lg bg-danger-soft border border-danger text-danger px-4 py-2 text-sm">@err</div>}

@{
    var u = Model.Usage;
    string Mb(long b) => b <= 0
        ? (isFa ? "نامحدود" : "unlimited")
        : b >= 1024L * 1024 * 1024 ? $"{b / 1024.0 / 1024 / 1024:0.##} GB" : $"{b / 1024 / 1024} MB";
    string Gb(long b) => b <= 0 ? (isFa ? "نامحدود" : "unlimited") : $"{b / 1024.0 / 1024 / 1024:0.##} GB";
    string Num(int n) => n <= 0 ? (isFa ? "نامحدود" : "unlimited") : n.ToString();

    // Memory and CPU here are what this tenant has reserved, not what they are measured to use.
    // The label said "Memory", which reads as a measurement, and the gap between the two is most
    // of a host's capacity. Disk was not on this page at all.
    (string Label, string Note, string Text, Harbora.Infrastructure.Monitoring.AllocationReading Reading)[] usageCards =
    {
        (isFa ? "اپلیکیشن‌ها" : "Apps", "", $"{u.Apps} / {Num(u.MaxApps)}",
            Harbora.Infrastructure.Monitoring.AllocationReading.OfCount(u.Apps, u.MaxApps)),
        (isFa ? "دیتابیس‌ها" : "Databases", "", $"{u.Services} / {Num(u.MaxServices)}",
            Harbora.Infrastructure.Monitoring.AllocationReading.OfCount(u.Services, u.MaxServices)),
        (isFa ? "حافظه" : "Memory", isFa ? "رزروشده" : "reserved", $"{Mb(u.MemoryUsedBytes)} / {Mb(u.MaxMemoryBytes)}",
            Harbora.Infrastructure.Monitoring.AllocationReading.Of(u.MemoryUsedBytes, u.MaxMemoryBytes)),
        ("CPU", isFa ? "رزروشده" : "reserved", $"{u.CpuUsed:0.##} / {(u.MaxCpuCores <= 0 ? (isFa ? "نامحدود" : "unlimited") : u.MaxCpuCores.ToString("0.##"))}",
            Harbora.Infrastructure.Monitoring.AllocationReading.Of(u.CpuUsed, u.MaxCpuCores)),
        (isFa ? "دیسک" : "Disk", isFa ? "اندازه‌گیری‌شده" : "measured", $"{Gb(u.DiskUsedBytes)} / {Gb(u.MaxDiskBytes)}",
            Harbora.Infrastructure.Monitoring.AllocationReading.Of(u.DiskUsedBytes, u.MaxDiskBytes)),
    };
}
<div class="rounded-xl border border-line bg-surface p-5 mb-6">
    <div class="flex items-center justify-between mb-3">
        <h2 class="font-semibold">@(isFa ? "مصرف نسبت به پلن" : "Usage vs plan") <span class="text-ink-faint text-sm">· @u.PlanName</span></h2>
        @if (Model.Suspended){<span class="text-xs rounded bg-danger/15 text-danger px-2 py-0.5">@(isFa ? "معلق" : "suspended")</span>}
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
        @foreach (var c in usageCards)
        {
            <div>
                <div class="text-ink-muted text-sm">@c.Label</div>
                <div class="mt-1 font-bold" dir="ltr">@c.Text</div>
                @if (c.Note.Length > 0)
                {
                    <div class="mt-0.5 text-[11px] text-ink-faint">@c.Note</div>
                }
                @* No bar without a denominator: the old one drew 5% for every unlimited resource. *@
                @if (c.Reading.HasShare)
                {
                    <div class="mt-2 h-1.5 rounded-full bg-surface-2 overflow-hidden">
                        <div class="h-full @(c.Reading.IsOver ? "bg-warn" : "bg-accent-hover")" style="width:@(c.Reading.Percent)%"></div>
                    </div>
                }
            </div>
        }
    </div>
    @if (u.DiskUnmeasured > 0)
    {
        <p class="mt-3 text-xs text-warn">
            @(isFa
                ? $"{u.DiskUnmeasured} حجم هنوز اندازه‌گیری نشده، پس رقم دیسک کامل نیست."
                : $"{u.DiskUnmeasured} volume(s) have never been measured, so the disk figure is incomplete.")
        </p>
    }
</div>

@* ---- the account ----
   The balance and the way to move it, on the screen an administrator is already on when a customer
   rings up about one. Crediting goes through a confirmation page rather than a box here: it is money
   moving, and a figure typed in a row of other controls is a figure nobody re-reads. *@
<div class="rounded-xl border border-line bg-surface p-5 mb-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-[15px] font-semibold text-ink">@(isFa ? "حساب" : "Account")</h2>
            @if (Model.HasWallet)
            {
                <div class="mt-1 text-2xl font-bold @(Model.BalanceMinor > 0 ? "text-ink" : "text-danger")" dir="ltr">
                    @MinorUnits.Format(Model.BalanceMinor, Model.Currency)
                </div>
            }
            else
            {
                @* A dash, not a nought: nobody has billed this tenant yet, which is not the same
                   fact as their having nothing left. *@
                <div class="mt-1 text-2xl font-bold text-ink-faint" dir="ltr">—</div>
                <div class="mt-0.5 text-[11px] text-ink-faint">@(isFa ? "هنوز صورت‌حسابی صادر نشده" : "never billed")</div>
            }
        </div>
        <a href="/tenants/@Model.WorkspaceId/credit"
           class="rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm font-semibold">
            @(isFa ? "شارژ حساب" : "Credit the account")
        </a>
    </div>
</div>

<div class="rounded-xl border border-line bg-surface p-5 mb-6">
    <div class="mb-3 flex items-center justify-between">
        <h2 class="text-[15px] font-semibold text-ink">@(isFa ? "مصرف متری این ماه" : "Metered usage this month") <span class="text-ink-faint text-sm">· @Model.PeriodLabel</span></h2>
        <a href="/tenants/@Model.WorkspaceId/usage.csv" class="rounded-lg bg-surface-2 hover:bg-surface-2 px-3 py-1.5 text-xs">@(isFa ? "خروجی CSV همهٔ ماه‌ها" : "Export all months (CSV)")</a>
    </div>
    <div class="grid grid-cols-3 gap-4 text-sm">
        <div><div class="text-ink-muted">@(isFa ? "گیگ‌بایت-ساعت (RAM)" : "GB-hours (RAM)")</div><div class="mt-1 text-xl font-bold">@Model.MemoryGbHours.ToString("0.0")</div></div>
        <div><div class="text-ink-muted">@(isFa ? "هسته-ساعت (CPU)" : "vCPU-hours")</div><div class="mt-1 text-xl font-bold">@Model.CpuCoreHours.ToString("0.0")</div></div>
        <div><div class="text-ink-muted">@(isFa ? "اوج اپ‌ها" : "Peak apps")</div><div class="mt-1 text-xl font-bold">@Model.AppCountPeak</div></div>
    </div>
    <p class="mt-2 text-xs text-ink-faint">@(isFa ? "مبنای صورتحساب مصرفی؛ هر ۱۵ دقیقه از روی منابع متعهدِ اپ‌های در حال اجرا انباشته می‌شود." : "Billing basis; accrued every 15 min from the committed resources of running apps.")</p>
</div>

<div class="grid lg:grid-cols-3 gap-6">
    <section class="lg:col-span-2 rounded-xl border border-line bg-surface overflow-hidden">
        <div class="px-4 py-3 border-b border-line font-semibold">@(isFa ? "اعضا" : "Members")</div>
        <table class="w-full text-sm">
            <tbody class="divide-y divide-line">
                @if (Model.Members.Count == 0){<tr><td class="p-4 text-ink-muted">—</td></tr>}
                @foreach (var m in Model.Members)
                {
                    <tr>
                        <td class="p-3">
                            <div class="font-medium">@m.DisplayName</div>
                            <div class="text-xs text-ink-faint">@m.Email</div>
                        </td>
                        <td class="p-3">
                            <span class="text-xs rounded bg-surface-2 px-2 py-0.5 text-ink">@m.WorkspaceRole</span>

                            @* Which projects that role reaches. The role says what someone may do;
                               this says where — and a permission nobody can read is one nobody audits. *@
                            @if (m.ScopedToProjects)
                            {
                                <div class="mt-2 space-y-1">
                                    @if (m.Grants.Count == 0)
                                    {
                                        <div class="text-xs text-warn">
                                            @(isFa ? "به هیچ پروژه‌ای دسترسی ندارد" : "no project access yet")
                                        </div>
                                    }
                                    @foreach (var g in m.Grants)
                                    {
                                        <div class="flex items-center gap-2 text-xs text-ink-muted">
                                            <span>@g.Text</span>
                                            <form asp-controller="Tenants" asp-action="RemoveGrant" asp-route-id="@Model.WorkspaceId" asp-route-grantId="@g.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button class="text-danger" aria-label="@(isFa ? "برداشتن" : "Remove")">✕</button>
                                            </form>
                                        </div>
                                    }

                                    @{ var projects = ViewBag.Projects as List<Harbora.Domain.Projects.Project> ?? new(); }
                                    <form asp-controller="Tenants" asp-action="AddGrant" asp-route-id="@Model.WorkspaceId" asp-route-userId="@m.UserId"
                                          method="post" class="flex flex-wrap items-center gap-1 pt-1">
                                        @Html.AntiForgeryToken()
                                        <select name="projectId" class="rounded bg-canvas border border-line px-2 py-1 text-xs">
                                            @foreach (var p in projects){<option value="@p.Id">@p.Name</option>}
                                        </select>
                                        <select name="environmentId" class="rounded bg-canvas border border-line px-2 py-1 text-xs">
                                            <option value="">@(isFa ? "همهٔ محیط‌ها" : "all environments")</option>
                                            @foreach (var p in projects)
                                            {
                                                foreach (var e in p.Environments){<option value="@e.Id">@p.Name · @e.Name</option>}
                                            }
                                        </select>
                                        <select name="role" class="rounded bg-canvas border border-line px-2 py-1 text-xs">
                                            <option value="Member">Member</option>
                                            <option value="Operator">Operator</option>
                                            <option value="Viewer">Viewer</option>
                                        </select>
                                        <button class="rounded bg-surface-2 hover:bg-surface-2 px-2 py-1 text-xs">
                                            @(isFa ? "افزودن" : "grant")</button>
                                    </form>
                                </div>
                            }

                            <form asp-controller="Tenants" asp-action="SetScope" asp-route-id="@Model.WorkspaceId" asp-route-userId="@m.UserId" method="post" class="mt-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="scoped" value="@((!m.ScopedToProjects).ToString().ToLowerInvariant())" />
                                <button class="text-xs text-accent-text">
                                    @(m.ScopedToProjects
                                        ? (isFa ? "دسترسی به همهٔ پروژه‌ها" : "give access to every project")
                                        : (isFa ? "محدود به پروژه‌های مشخص" : "limit to specific projects"))
                                </button>
                            </form>
                        </td>
                        <td class="p-3 text-end">
                            <form asp-controller="Tenants" asp-action="RemoveMember" asp-route-id="@Model.WorkspaceId" asp-route-userId="@m.UserId" method="post"
                                  onsubmit="return confirm('@(isFa ? "حذف عضو؟" : "Remove member?")')">
                                @Html.AntiForgeryToken()
                                <button class="text-xs text-danger">@(isFa ? "حذف" : "remove")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section class="rounded-xl border border-line bg-surface p-5 h-fit">
        <h2 class="text-[15px] font-semibold text-ink mb-3">@(isFa ? "افزودن کاربر" : "Add a user")</h2>
        <form asp-controller="Tenants" asp-action="AddMember" asp-route-id="@Model.WorkspaceId" method="post" class="space-y-3">
            @Html.AntiForgeryToken()
            <input name="email" type="email" placeholder="@(isFa ? "ایمیل" : "Email")" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            <input name="displayName" placeholder="@(isFa ? "نام نمایشی" : "Display name")" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            <input name="password" type="password" placeholder="@(isFa ? "گذرواژه موقت (کاربر جدید)" : "Temp password (new user)")" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            <select name="role" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm">
                <option value="Admin">@(isFa ? "مدیر workspace" : "Workspace admin")</option>
                <option value="Member" selected>@(isFa ? "عضو" : "Member")</option>
                <option value="Viewer">@(isFa ? "بیننده" : "Viewer")</option>
            </select>
            <button class="w-full rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm font-semibold">@(isFa ? "افزودن" : "Add")</button>
        </form>
        <p class="mt-2 text-xs text-ink-faint">@(isFa ? "اگر ایمیل موجود باشد، فقط عضو می‌شود؛ وگرنه حساب ساخته می‌شود." : "Existing email → just added; otherwise an account is created.")</p>
    </section>
</div>
