@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_Auth";
}
<h1 class="title">@T["Welcome to Harbora"]</h1>
<p class="subtitle">@T["Sign in"]</p>

@if (TempData["Message"] is string message){<div class="success">@message</div>}
@if (TempData["Error"] is string error){<div class="error">@error</div>}
@if (ViewBag.ExternalFailed == true)
{
    <div class="error" data-external-failed>
        @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa"
            ? "ورود از آن سرویس کامل نشد. دوباره تلاش کنید."
            : "That sign-in did not complete. Try again.")
    </div>
}
@* A password refusal from a workspace's "single sign-on only" setting is worded in whichever
   language the panel renders, so tests assert on these attributes rather than the sentence. *@
@if (ViewBag.SsoRequiredWorkspaceSlug is string ssoRequiredSlug)
{
    <div data-sso-login-refused="true" data-sso-required-workspace="@ssoRequiredSlug"
         data-sso-required-providers="@ViewBag.SsoRequiredProviders" hidden></div>
}

<form asp-controller="Account" asp-action="Login" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="All" class="error"></div>

    <div class="field">
        <label>@T["Email"]</label>
        <input asp-for="Email" type="email" autocomplete="username" required autofocus />
    </div>
    <div class="field">
        <label>@T["Password"]</label>
        <input asp-for="Password" type="password" autocomplete="current-password" required />
    </div>
    <button type="submit" class="btn btn-primary">@T["Sign in"]</button>

    @if (ViewBag.CanResetPassword == true)
    {
        @* Only when the platform can actually send the email — a link that leads to "ask your
           administrator" is a support ticket with extra steps. *@
        <p class="subtitle" style="margin-top:.75rem"><a href="/account/forgot">@T["Forgot your password?"]</a></p>
    }
    <p class="subtitle" style="margin-top:.75rem"><a href="/account/register">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa" ? "ساخت حساب جدید" : "Create a new account")</a></p>
</form>

@* Outside the password form: each provider is its own POST, and a nested form would be swallowed
   silently — the defect FunctionEditorHttpTests was written to catch. *@
@{ ViewData["ExternalReturnUrl"] = Model.ReturnUrl; }
<partial name="_ExternalProviders" model="@((IReadOnlyList<ExternalProviderButton>)(ViewBag.ExternalProviders ?? new List<ExternalProviderButton>()))" />
