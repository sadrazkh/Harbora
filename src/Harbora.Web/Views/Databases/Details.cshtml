@model DatabaseOverviewViewModel
@using Harbora.Domain.Common
@using Harbora.Domain.Backups
@using Harbora.Domain.Services
@using Harbora.Infrastructure.Backups
@using Harbora.Infrastructure.Services
@{
    // The header and breadcrumb now live in _Shell.cshtml, which is typed to DatabaseTabViewModel
    // rather than to the raw row — this local alias is what lets the rest of this file go on reading
    // "db.Whatever" exactly as it read "Model.Database.Whatever" before the split.
    Layout = "_Shell";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var db = Model.Database;
    ViewData["Title"] = db.Name;

    // The Message/Error banner now renders once in _Shell.cshtml, above every tab — not here.
    // TempData is consumed on read, so a second read site here would just find it already gone.

    var drifted = Harbora.Infrastructure.Services.VersionDrift.HasDrifted(db.Version, Model.RunningImage);
    var moving = Harbora.Infrastructure.Services.VersionDrift.IsMoving(db.Version);

    string Gb(long? bytes) => bytes is null or 0
        ? "—"
        : bytes < 1024L * 1024 * 1024
            ? $"{bytes / 1024.0 / 1024:0.#} MB"
            : $"{bytes / 1024.0 / 1024 / 1024:0.##} GB";

    // Sub-project 10: minted by ExportDownloadLink, shown once on the next render — the same
    // int-unix-over-the-redirect idiom AppData/Index.cshtml uses for D4's volume download link, for
    // the same reason: CookieTempDataProvider re-infers a date-shaped string as a boxed DateTime,
    // which reads null through `as string` on this side of the redirect.
    var exportLink = TempData["ExportDownloadLink"] as string;
    var exportLinkExpiresAtUnix = TempData["ExportDownloadLinkExpiresAtUnix"] as int?;
    var exportLinkExpiresAtInstant = exportLinkExpiresAtUnix is { } exportUnix
        ? DateTimeOffset.FromUnixTimeSeconds(exportUnix)
        : (DateTimeOffset?)null;
    var exportLinkExpiresAtRaw = exportLinkExpiresAtInstant?.ToString("O") ?? string.Empty;
    var exportLinkExpiresAtDisplay = exportLinkExpiresAtInstant?.LocalDateTime.ToString(Dates.Stamp) ?? string.Empty;

    // A self-serve export is a Backup with ExpiresAt set (DatabaseExportPlan.ArtifactLifetime) —
    // ordinary scheduled/manual backups never carry one, so this is what tells the two apart in a
    // list that holds both.
    var activeExports = Model.Backups.Where(b => b.ExpiresAt is not null && b.Status == BackupStatus.Completed).ToList();
}

@if (TempData["AdminToolUrl"] is string toolUrl)
{
    @* Shown exactly once. The password is not stored anywhere in readable form, so a refresh loses
       it — which is the point, and is said plainly rather than discovered. *@
    <div class="mb-4 rounded-lg border border-warn bg-warn-soft px-4 py-3 text-sm">
        <div class="mb-2 font-medium">@(isFa ? "ابزار مدیریت باز شد — یک ساعت زنده می‌ماند." : "The admin tool is open — it lives for one hour.")</div>
        <div class="mb-2" dir="ltr"><a href="@toolUrl" target="_blank" rel="noopener" class="text-accent-text break-all">@toolUrl</a></div>
        <div dir="ltr" class="font-mono text-xs">
            @(isFa ? "کاربر" : "user"): @TempData["AdminToolUser"] &nbsp;·&nbsp;
            @(isFa ? "رمز" : "password"): @TempData["AdminToolPassword"]
        </div>
        <p class="mt-2 text-xs text-ink-muted">
            @(isFa
                ? "این رمز فقط همین یک‌بار نشان داده می‌شود. رمز خودِ دیتابیس را از بخش «اطلاعات اتصال» بردارید."
                : "This password is shown only once. Take the database's own password from the connection panel.")
        </p>
    </div>
}

@* A database running a different version from the one chosen will not start on the data directory
   it already has. It is the failure nobody recovers from quickly, so it is said at the top. *@
@if (drifted)
{
    <div class="alert-warning mb-4">
        <i data-lucide="triangle-alert" class="h-4 w-4 shrink-0"></i>
        <span>@(isFa
            ? $"نسخهٔ انتخاب‌شده «{db.Version}» است ولی کانتینر در حال اجرا «{Model.RunningImage}» است."
            : $"The chosen version is \"{db.Version}\" but the running container is \"{Model.RunningImage}\".")</span>
    </div>
}
else if (moving)
{
    <div class="alert-warning mb-4">
        <i data-lucide="triangle-alert" class="h-4 w-4 shrink-0"></i>
        <span>@(isFa
            ? "این سرویس به نسخهٔ مشخصی سنجاق نشده، پس بازسازی کانتینر ممکن است نسخهٔ اصلی‌اش را عوض کند و روی داده‌های فعلی بالا نیاید."
            : "This service is not pinned to a version, so recreating its container can move it to a new major release — which will refuse to start on the data it already has.")</span>
    </div>
}

<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="space-y-6">
        @{
            var connectionPanel = new PanelModel(
                T["Connection info"].Value,
                Model.CanManage ? (Model.Reveal ? T["Hide"].Value : T["Reveal"].Value) : null,
                Model.CanManage ? $"/databases/{db.Id}?reveal={(!Model.Reveal).ToString().ToLowerInvariant()}" : null);
        }
        <partial name="Design/_PanelStart" model="connectionPanel" />

        <p class="mb-3 text-xs leading-5 text-ink-faint">
            @(isFa
                ? "این آدرس فقط داخل شبکهٔ خصوصی پروژه کار می‌کند و از اینترنت در دسترس نیست. برای اتصال از بیرون، «دسترسی خارجی» را باز کنید."
                : "This address resolves only inside the project's private network and is not reachable from the internet. To connect from outside, open external access.")
        </p>

        <div class="connection-string"><code id="databaseConnection" dir="ltr">@Model.Connection</code><button type="button" data-copy-connection title="@(isFa ? "کپی" : "Copy")"><i data-lucide="copy" class="h-4 w-4"></i></button></div>

        <dl class="connection-grid">
            <div><dt>Host</dt><dd dir="ltr">@db.ContainerName</dd></div>
            <div><dt>Port</dt><dd>@db.InternalPort</dd></div>
            <div><dt>User</dt><dd dir="ltr">@db.Username</dd></div>
            <div><dt>Database</dt><dd dir="ltr">@(string.IsNullOrWhiteSpace(db.DatabaseName) ? "—" : db.DatabaseName)</dd></div>
            @if (Model.Network is { Length: > 0 } network)
            {
                <div class="col-span-2"><dt>Network</dt><dd class="break-all" dir="ltr">@network</dd></div>
            }
            <div class="col-span-2"><dt>Volume</dt><dd class="break-all" dir="ltr">@db.VolumeName</dd></div>
        </dl>
        <partial name="Design/_PanelEnd" />

        @{
            // D3 (2026-08-25 shared-databases plan): "a database per app, no separate instance for
            // each" only means anything once this is visible — D1 shipped the logical database as a
            // real row weeks before this panel existed to show it, per that task's own report.
            var logicalPanel = new PanelModel(isFa ? "پایگاه‌های‌دادهٔ منطقی" : "Logical databases");
        }
        <partial name="Design/_PanelStart" model="logicalPanel" />

        @if (!Model.LogicalDatabasesSupported)
        {
            @* A refused engine says why, in place of the table — an empty list and an engine that
               cannot have logical databases at all must never look identical. *@
            <p class="text-xs leading-5 text-ink-faint" data-logical-databases-unsupported="@db.Type">
                @Model.LogicalDatabasesUnsupportedReason
            </p>
        }
        else
        {
            <p class="mb-3 text-xs leading-5 text-ink-faint">
                @(isFa
                    ? "چند پایگاه‌دادهٔ مستقل داخل همین یک نمونه — هرکدام برای یک اپ، بدون نیاز به نمونهٔ جداگانه."
                    : "Several independent databases inside this one instance — one per app, without standing up a separate instance for each.")
            </p>

            @if (Model.LogicalDatabases.Count == 0)
            {
                <partial name="Design/_EmptyState" model="@(new EmptyStateModel("database",
                    isFa ? "هنوز پایگاه‌دادهٔ منطقی ساخته نشده." : "No logical database has been created yet."))" />
            }
            else
            {
                <div class="overflow-x-auto" data-logical-databases-table>
                    <table class="resource-table min-w-[720px]">
                        <thead>
                            <tr>
                                <th>@(isFa ? "نام" : "Name")</th>
                                <th>@(isFa ? "اپ‌های متصل" : "Attached apps")</th>
                                <th>@(isFa ? "آخرین پشتیبان" : "Last backup")</th>
                                <th>@(isFa ? "حجم" : "Size")</th>
                                @if (db.Type == ManagedServiceType.PostgreSql)
                                {
                                    <th>pgvector</th>
                                }
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var logical in Model.LogicalDatabases)
                            {
                                <tr data-logical-database="@logical.Id"
                                    data-logical-database-default="@logical.IsDefault.ToString().ToLowerInvariant()">
                                    <td>
                                        <div class="table-primary font-mono" dir="ltr">@logical.Name</div>
                                        <div class="table-secondary font-mono" dir="ltr">
                                            @logical.Username@(logical.IsDefault ? (isFa ? " · پیش‌فرض نمونه" : " · instance default") : "")
                                        </div>
                                    </td>
                                    <td data-logical-database-apps="@logical.AttachedApps.Count">
                                        @(logical.AttachedApps.Count == 0 ? "—" : string.Join(", ", logical.AttachedApps))
                                    </td>
                                    <td data-logical-database-backup-state="@(!logical.BackupTrackingAvailable ? "not-measured" : logical.LastBackupAt is null ? "empty" : "has-data")">
                                        @if (!logical.BackupTrackingAvailable)
                                        {
                                            <span class="text-ink-faint">@(isFa ? "هنوز پیگیری نمی‌شود" : "not tracked yet")</span>
                                        }
                                        else if (logical.LastBackupAt is { } lastBackupAt)
                                        {
                                            <span dir="ltr">@lastBackupAt.LocalDateTime.ToString(Dates.Stamp)</span>
                                        }
                                        else
                                        {
                                            <span class="text-ink-faint">@(isFa ? "هنوز گرفته نشده" : "none yet")</span>
                                        }
                                    </td>
                                    <td data-logical-database-size-state="not-measured">
                                        @* Only the whole instance's disk is measured (the "Measure storage" button
                                           above, one figure for every logical database on it combined) — never a
                                           fabricated zero for the one figure this platform cannot attribute per
                                           database yet. *@
                                        <span class="text-ink-faint">@(isFa ? "اندازه‌گیری نشده" : "not measured")</span>
                                    </td>
                                    @if (db.Type == ManagedServiceType.PostgreSql)
                                    {
                                        @* 1.7 (pgvector-as-option plan): read from the row's own last-confirmed
                                           check, never inferred — null is "not checked", not "no". *@
                                        <td data-logical-database-pgvector-state="@(logical.HasVectorExtension is null ? "not-measured" : logical.HasVectorExtension.Value ? "has-data" : "empty")">
                                            @if (logical.HasVectorExtension is null)
                                            {
                                                <span class="text-ink-faint">@(isFa ? "بررسی نشده" : "not checked")</span>
                                            }
                                            else if (logical.HasVectorExtension.Value)
                                            {
                                                <span class="resource-status is-ok"><i></i>@(isFa ? "نصب شده" : "Installed")</span>
                                            }
                                            else
                                            {
                                                <span class="text-ink-faint">@(isFa ? "نصب نشده" : "Not installed")</span>
                                            }
                                            @if (Model.CanManage && logical.HasVectorExtension != true)
                                            {
                                                <form asp-action="EnableVectorExtension" asp-route-id="@db.Id" asp-route-databaseId="@logical.Id"
                                                      method="post" class="mt-1" data-enable-pgvector-form>
                                                    @Html.AntiForgeryToken()
                                                    <button class="btn-ghost px-2 py-0.5 text-[11px]">@(isFa ? "فعال‌سازی" : "Enable")</button>
                                                </form>
                                            }
                                        </td>
                                    }
                                    <td class="text-end whitespace-nowrap">
                                        @if (Model.CanManage && logical.CanRename)
                                        {
                                            <form asp-action="RenameDatabase" asp-route-id="@db.Id" asp-route-databaseId="@logical.Id"
                                                  method="post" class="inline-flex items-center gap-1" data-rename-database-form>
                                                @Html.AntiForgeryToken()
                                                <input name="name" dir="ltr" autocomplete="off"
                                                       placeholder="@(isFa ? "نام جدید" : "new name")"
                                                       class="w-28 rounded-lg bg-canvas border border-line px-2 py-1 text-xs" />
                                                <button class="btn-ghost px-2 py-1 text-xs">@(isFa ? "تغییر نام" : "Rename")</button>
                                            </form>
                                        }
                                        else if (Model.CanManage && !logical.IsDefault)
                                        {
                                            <span class="text-[11px] text-ink-faint"
                                                  title="@Harbora.Infrastructure.Services.DatabaseGrantSql.UnsupportedRenameReason(db.Type)">
                                                @(isFa ? "تغییر نام موجود نیست" : "Rename unavailable")
                                            </span>
                                        }
                                        @if (Model.CanManage && logical.CanDelete)
                                        {
                                            <a href="/databases/@db.Id/logical-databases/@logical.Id/remove"
                                               class="btn-ghost ms-1 px-2 py-1 text-xs text-danger">@(isFa ? "حذف" : "Delete")</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (Model.CanManage)
            {
                if (Model.CanManageLogicalDatabasesLocally)
                {
                    <form asp-action="CreateDatabase" asp-route-id="@db.Id" method="post"
                          class="mt-3 flex gap-2" data-create-logical-database-form>
                        @Html.AntiForgeryToken()
                        <input name="name" dir="ltr" autocomplete="off"
                               placeholder="@(isFa ? "نام پایگاه‌داده (اختیاری)" : "database name (optional)")"
                               class="flex-1 rounded-lg bg-canvas border border-line px-3 py-2 text-sm" />
                        <button class="btn-secondary px-4 py-2 text-sm">@(isFa ? "ساخت" : "Create")</button>
                    </form>
                }
                else
                {
                    <p class="mt-3 text-[11px] leading-4 text-warn" data-logical-databases-unreachable>
                        @(isFa
                            ? "این نصب هنوز نمی‌تواند به موتور این نمونه برسد، پس ساخت پایگاه‌دادهٔ جدید اینجا در دسترس نیست."
                            : "This installation cannot reach that instance's own engine yet, so creating a new database here is not available.")
                    </p>
                }
            }
        }
        <partial name="Design/_PanelEnd" />

        @{
            // 2.3 (round-2 market-gaps plan): VACUUM/ANALYZE/REINDEX (PostgreSQL) and OPTIMIZE TABLE
            // (MySQL/MariaDB), on demand or on a schedule, per logical database — the maintenance
            // nobody remembers until the disk alert fires.
            var scheduledMaintenancePanel = new PanelModel(isFa ? "نگهداری زمان‌بندی‌شده" : "Scheduled maintenance");
        }
        <partial name="Design/_PanelStart" model="scheduledMaintenancePanel" />

        @if (!Model.MaintenanceSupported)
        {
            <p class="text-xs leading-5 text-ink-faint" data-maintenance-unsupported="@db.Type">
                @Model.MaintenanceUnsupportedReason
            </p>
        }
        else if (Model.Maintenance.Count == 0)
        {
            <partial name="Design/_EmptyState" model="@(new EmptyStateModel("settings-2",
                isFa ? "هنوز پایگاه‌دادهٔ منطقی‌ای برای نگهداری وجود ندارد." : "No logical database to maintain yet."))" />
        }
        else
        {
            <p class="mb-3 text-xs leading-5 text-ink-faint">
                @(isFa
                    ? "هر عملیات با هزینهٔ خودش نشان داده می‌شود — برخی آنلاین‌اند، برخی جدول را برای مدتی قفل می‌کنند."
                    : "Each operation shows its own cost — some run online, some lock the table for a while.")
            </p>

            <div class="overflow-x-auto" data-maintenance-table>
                <table class="resource-table min-w-[860px]">
                    <thead>
                        <tr>
                            <th>@(isFa ? "پایگاه‌داده" : "Database")</th>
                            <th>@(isFa ? "عملیات" : "Operation")</th>
                            <th>@(isFa ? "چه می‌کند و چه هزینه‌ای دارد" : "What it does, and what it costs")</th>
                            <th>@(isFa ? "آخرین اجرا" : "Last run")</th>
                            <th>@(isFa ? "زمان‌بندی" : "Schedule")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Maintenance)
                        {
                            <tr data-maintenance-row="@row.DatabaseId" data-maintenance-operation="@((int)row.Operation)">
                                <td class="table-primary font-mono" dir="ltr">@row.DatabaseName</td>
                                <td>
                                    <span class="resource-status @(row.IsOnline ? "is-ok" : "is-warn")" dir="ltr">
                                        <i></i>@row.Label
                                    </span>
                                    <div class="table-secondary">
                                        @(row.IsOnline ? (isFa ? "آنلاین و ایمن" : "Online and safe") : (isFa ? "قفل می‌کند" : "Locks the table"))
                                    </div>
                                </td>
                                <td class="text-[11px] leading-4 text-ink-faint max-w-[260px]">@row.Description</td>
                                <td data-maintenance-last-run-state="@(row.LastRunStatus is null ? "not-measured" : "has-data")">
                                    @if (row.LastRunStatus is null)
                                    {
                                        <span class="text-ink-faint">@(isFa ? "هرگز اجرا نشده" : "never run")</span>
                                    }
                                    else
                                    {
                                        <span class="resource-status @(row.LastRunStatus == DatabaseMaintenanceRunStatus.Succeeded ? "is-ok" : row.LastRunStatus == DatabaseMaintenanceRunStatus.Failed ? "is-danger" : "is-info")">
                                            <i></i>@row.LastRunStatus
                                        </span>
                                        @if (row.LastRunAt is { } lastAt)
                                        {
                                            <div class="table-secondary" dir="ltr">@lastAt.LocalDateTime.ToString(Dates.Stamp)</div>
                                        }
                                        @if (row.LastRunDuration is { } duration)
                                        {
                                            <div class="table-secondary" dir="ltr">@((int)duration.TotalSeconds)s</div>
                                        }
                                        @if (row.LastRunStatus == DatabaseMaintenanceRunStatus.Failed && row.LastRunError is not null)
                                        {
                                            <div class="mt-1 text-[11px] text-danger break-all" dir="ltr">@row.LastRunError</div>
                                        }
                                        @if (row.RecentRuns.Count > 0)
                                        {
                                            <div class="mt-1 flex gap-1" data-maintenance-history title="@(isFa ? "سه اجرای اخیر" : "Last three runs")">
                                                @foreach (var past in row.RecentRuns)
                                                {
                                                    <span class="h-1.5 w-1.5 rounded-full @(past.Status == DatabaseMaintenanceRunStatus.Succeeded ? "bg-ok" : past.Status == DatabaseMaintenanceRunStatus.Failed ? "bg-danger" : "bg-info")"
                                                          data-maintenance-history-run="@past.Status"
                                                          title="@($"{past.Status} · {past.At.LocalDateTime.ToString(Dates.Stamp)}" + (past.Error is null ? "" : $" · {past.Error}"))"></span>
                                                }
                                            </div>
                                        }
                                    }
                                </td>
                                <td data-maintenance-schedule-state="@(row.ScheduleId is null ? "empty" : "has-data")">
                                    @if (Model.CanManage)
                                    {
                                        <form asp-action="SaveMaintenanceSchedule" asp-route-id="@db.Id" asp-route-databaseId="@row.DatabaseId"
                                              method="post" class="flex items-center gap-1" data-maintenance-schedule-form>
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="operation" value="@((int)row.Operation)" />
                                            <input name="schedule" dir="ltr" autocomplete="off"
                                                   value="@row.ScheduleCron" placeholder="0 3 * * 0"
                                                   class="w-24 rounded-lg bg-canvas border border-line px-2 py-1 text-[11px] font-mono" />
                                            <label class="inline-flex items-center gap-1 text-[11px] text-ink-faint">
                                                <input type="checkbox" name="enabled" value="true" checked="@row.ScheduleEnabled" />
                                                @(isFa ? "فعال" : "On")
                                            </label>
                                            <button class="btn-ghost px-2 py-0.5 text-[11px]">@(isFa ? "ذخیره" : "Save")</button>
                                        </form>
                                        @if (row.NextRunAt is { } nextRunAt)
                                        {
                                            <div class="mt-0.5 text-[11px] text-ink-faint" dir="ltr">@(isFa ? "بعدی " : "next ")@nextRunAt.LocalDateTime.ToString(Dates.Stamp)</div>
                                        }
                                        @if (row.ScheduleId is { } scheduleId)
                                        {
                                            <form asp-action="DeleteMaintenanceSchedule" asp-route-id="@db.Id" asp-route-databaseId="@row.DatabaseId"
                                                  asp-route-scheduleId="@scheduleId" method="post" class="mt-0.5">
                                                @Html.AntiForgeryToken()
                                                <button class="btn-ghost px-2 py-0.5 text-[11px] text-danger">@(isFa ? "حذف" : "Remove")</button>
                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-ink-faint">@(row.ScheduleId is null ? "—" : row.ScheduleCron)</span>
                                    }
                                </td>
                                <td class="text-end whitespace-nowrap">
                                    @if (Model.CanManage && Model.CanRunMaintenanceLocally)
                                    {
                                        <form asp-action="RunMaintenance" asp-route-id="@db.Id" asp-route-databaseId="@row.DatabaseId"
                                              method="post" class="inline" data-maintenance-run-form
                                              data-confirm="@(row.IsOnline
                                                  ? ""
                                                  : (isFa
                                                      ? $"{row.Label} روی «{row.DatabaseName}» جدول را قفل می‌کند تا پایان اجرا. ادامه می‌دهید؟"
                                                      : $"{row.Label} on \"{row.DatabaseName}\" locks the table until it finishes. Continue?"))"
                                              onsubmit="@(row.IsOnline ? null : "return confirm(this.dataset.confirm);")">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="operation" value="@((int)row.Operation)" />
                                            <button class="btn-secondary px-2 py-1 text-xs">@(isFa ? "اجرای اکنون" : "Run now")</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.CanManage && !Model.CanRunMaintenanceLocally)
            {
                <p class="mt-3 text-[11px] leading-4 text-warn" data-maintenance-unreachable>
                    @(isFa
                        ? "این نصب هنوز نمی‌تواند به موتور این نمونه برسد، پس اجرای نگهداری اینجا در دسترس نیست."
                        : "This installation cannot reach that instance's own engine yet, so running maintenance here is not available.")
                </p>
            }
        }
        <partial name="Design/_PanelEnd" />

        @{ var backupPanel = new PanelModel(T["Backups"].Value, isFa ? "همه" : "View all", "/backups"); }
        <partial name="Design/_PanelStart" model="backupPanel" />

        <p class="mb-3 text-xs text-ink-faint">
            @(Model.BackupIntervalHours is { } hours
                ? (isFa ? $"هر {hours} ساعت" : $"Every {hours} hours")
                : (isFa ? "زمان‌بندی نشده" : "Not scheduled"))
            @if (Model.NextBackupAt is { } next)
            {
                <span> · @(isFa ? "بعدی" : "next") <span dir="ltr">@next.LocalDateTime.ToString(Dates.Stamp)</span></span>
            }
        </p>

        @if (Model.Backups.Count == 0)
        {
            <partial name="Design/_EmptyState" model="@(new EmptyStateModel("cloud-upload",
                isFa ? "هنوز پشتیبانی گرفته نشده." : "No backup has been taken yet.",
                isFa ? "زمان‌بندی پشتیبان" : "Set up backups", "/backups"))" />
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="resource-table min-w-[560px]">
                    <thead>
                        <tr>
                            <th>@(isFa ? "زمان" : "Date")</th>
                            <th>@(isFa ? "نوع" : "Type")</th>
                            <th>@(isFa ? "حجم" : "Size")</th>
                            <th>@T["Status"]</th>
                            <th>@(isFa ? "بررسی بازیابی" : "Restore verification")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var backup in Model.Backups)
                        {
                            <tr>
                                <td class="table-primary">@backup.At.LocalDateTime.ToString(Dates.Stamp)</td>
                                <td>@(backup.IsScheduled ? (isFa ? "خودکار" : "Scheduled") : (isFa ? "دستی" : "Manual"))</td>
                                <td>@Gb(backup.SizeBytes)</td>
                                <td><span class="resource-status @(backup.Status == BackupStatus.Completed ? "is-ok" : backup.Status == BackupStatus.Failed ? "is-danger" : "is-info")"><i></i>@backup.Status</span></td>
                                <td>@(backup.VerifiedRestorable switch { true => isFa ? "تأیید شده" : "Verified", false => isFa ? "نامعتبر" : "Failed", _ => isFa ? "بررسی نشده" : "Not verified" })</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <partial name="Design/_PanelEnd" />

        @if (Model.CanExport || Model.CanImport)
        {
            @* Sub-project 10: self-serve database export & import. Export needs only BackupsRun —
               the same capability "back up now" already asks for — so an Operator can export.
               Import needs the heavier BackupsRestore, the same capability the existing admin
               Restore button already requires, since it overwrites live data the same way. *@
            var exportImportPanel = new PanelModel(isFa ? "خروجی و ورودی" : "Export & import");
            <partial name="Design/_PanelStart" model="exportImportPanel" />

            @if (exportLink is not null)
            {
                <div class="alert-success mb-4" data-download-link="@exportLink" data-download-link-expires="@exportLinkExpiresAtRaw">
                    <p>@(isFa
                        ? "پیوند دانلود یک‌بارمصرف ساخته شد؛ بدون ورود به پنل هم کار می‌کند:"
                        : "A one-time download link was created; it works without signing in to the panel:")</p>
                    <code dir="ltr" class="block break-all">@exportLink</code>
                    <p class="mt-1 text-[11px] text-ink-faint">
                        @(isFa
                            ? $"تا {exportLinkExpiresAtDisplay} معتبر است و فقط یک‌بار قابل استفاده است — بار دوم دیگر کار نمی‌کند."
                            : $"Valid until {exportLinkExpiresAtDisplay}, and works exactly once — a second attempt with it will not.")
                    </p>
                </div>
            }

            @if (Model.CanExport)
            {
                <form asp-action="Export" asp-route-id="@db.Id" method="post" data-export-form class="mb-3">
                    @Html.AntiForgeryToken()
                    <button class="btn-secondary w-full justify-center py-2 text-sm">
                        <i data-lucide="download" class="h-4 w-4"></i>@(isFa ? "خروجی از دیتابیس" : "Export database")
                    </button>
                    <p class="mt-1 text-[11px] leading-4 text-ink-faint">
                        @(isFa
                            ? $"یک نسخهٔ قابل‌دانلود از داده‌های فعلی می‌سازد و تا {(int)DatabaseExportPlan.ArtifactLifetime.TotalHours} ساعت نگه داشته می‌شود."
                            : $"Produces a downloadable copy of the current data, kept for {(int)DatabaseExportPlan.ArtifactLifetime.TotalHours} hours.")
                    </p>
                </form>

                @if (activeExports.Count > 0)
                {
                    <ul class="mb-3 space-y-2" data-export-list>
                        @foreach (var export in activeExports)
                        {
                            <li class="flex items-center justify-between gap-2 text-xs">
                                <span dir="ltr" class="text-ink-faint">@export.At.LocalDateTime.ToString(Dates.Stamp)</span>
                                <form asp-action="ExportDownloadLink" asp-route-id="@db.Id" asp-route-backupId="@export.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button class="btn-ghost px-2 py-1 text-xs" data-export-link-button="@export.Id">
                                        @(isFa ? "ساخت پیوند دانلود" : "Get download link")
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                }
            }

            @if (Model.CanImport)
            {
                <form asp-action="Import" asp-route-id="@db.Id" method="post" enctype="multipart/form-data"
                      data-import-form class="space-y-2 border-t border-line pt-3">
                    @Html.AntiForgeryToken()
                    <p class="text-xs leading-5 text-warn">
                        @(isFa
                            ? $"وارد کردن، محتوای فعلی «{db.Name}» را رونویسی می‌کند. پیش از آن یک نسخهٔ ایمنی خودکار گرفته می‌شود."
                            : $"Importing overwrites \"{db.Name}\"'s current contents. A safety snapshot is taken automatically first.")
                    </p>
                    <input type="file" name="file" class="form-control text-sm" required />
                    <input type="text" name="confirmName" class="form-control text-sm" dir="ltr" autocomplete="off"
                           placeholder="@db.Name" data-import-confirm-name
                           aria-label="@(isFa ? "نام دیتابیس را برای تأیید بنویسید" : "Type the database name to confirm")" />
                    <button class="btn-danger w-full justify-center py-2 text-sm" data-import-submit>
                        <i data-lucide="upload-cloud" class="h-4 w-4"></i>@(isFa ? "وارد کردن (رونویسی)" : "Import (overwrite)")
                    </button>
                </form>
            }

            <partial name="Design/_PanelEnd" />
        }
    </div>

    <aside class="space-y-6">
        @{ var planPanel = new PanelModel(isFa ? "طرح منابع" : "Resource plan"); }
        <partial name="Design/_PanelStart" model="planPanel" />

        @if (Model.MemoryLimitBytes > 0 || Model.CpuLimit > 0)
        {
            <dl class="space-y-2 text-xs">
                <div class="flex justify-between gap-2"><dt class="text-ink-faint">@(isFa ? "اندازه" : "Size")</dt><dd class="text-ink">@(Model.InstanceSizeKey ?? "—")</dd></div>
                <div class="flex justify-between gap-2"><dt class="text-ink-faint">@(isFa ? "سقف حافظه" : "Memory limit")</dt><dd class="text-ink" dir="ltr">@Gb(Model.MemoryLimitBytes)</dd></div>
                <div class="flex justify-between gap-2"><dt class="text-ink-faint">@(isFa ? "سقف CPU" : "CPU limit")</dt><dd class="text-ink" dir="ltr">@Model.CpuLimit</dd></div>
            </dl>
        }
        else
        {
            @* Worth saying rather than showing a dash: this database predates resource plans and can
               take whatever the host has. *@
            <p class="text-xs leading-5 text-warn">
                @(isFa
                    ? "این دیتابیس سقف منابع ندارد و می‌تواند هرچقدر بخواهد از سرور بگیرد."
                    : "This database has no resource ceiling and can take whatever the host has.")
            </p>
        }

        @if (Model.CanManage)
        {
            <form asp-action="Resize" asp-route-id="@db.Id" method="post" class="mt-3 space-y-2">
                @Html.AntiForgeryToken()
                @* Cards rather than a dropdown, so what a tier costs is visible before the choice
                   rather than after the bill.

                   Pinned to the host this database already runs on, and no server field: a resize does
                   not move a workload, because moving one severs its private network and has its own
                   confirmation screen. "No limit" IS offered here, unlike on creation — it is the
                   state a database made before tiers existed is already in, so leaving it out would
                   make saving this form impose a ceiling nobody asked for. *@
                @await Component.InvokeAsync("SizePicker", new
                {
                    sizeField = "instanceSizeKey",
                    selectedSize = Model.InstanceSizeKey,
                    selectedServer = Model.ServerId,
                    pinnedServer = Model.ServerId,
                    allowNoLimit = true
                })
                <button class="btn-secondary w-full justify-center py-2 text-sm">@(isFa ? "تغییر اندازه" : "Change size")</button>
                <p class="text-[11px] leading-4 text-ink-faint">
                    @(isFa
                        ? "ذخیره می‌شود، ولی تا بازسازی کانتینر اعمال نمی‌شود — راه‌اندازی مجدد ناخواستهٔ یک دیتابیس هیچ‌وقت چیز کوچکی نیست."
                        : "Saved, but not applied until the container is rebuilt — an unrequested database restart is never a small thing.")
                </p>
            </form>
        }

        <p class="mt-3 text-[11px] leading-4 text-ink-faint">
            @(Model.TlsEnabled
                ? (isFa ? "اتصال رمزنگاری می‌شود (TLS)." : "Connections are encrypted with TLS.")
                : (isFa ? "اتصال رمزنگاری نمی‌شود." : "Connections are not encrypted."))
        </p>
        <partial name="Design/_PanelEnd" />

        @if (db.Type == ManagedServiceType.Redis)
        {
            @* 1.6 (redis-eviction): one setting whose right default is the opposite for a cache and
               for a queue, so it is offered as a choice with the consequence spelled out — never as a
               raw list of Redis's own constants. *@
            var evictionPanel = new PanelModel(isFa ? "سیاست حذف حافظه" : "Memory eviction policy");
            var ceiling = Model.MemoryLimitBytes > 0
                ? Harbora.Infrastructure.Services.RedisMemoryPolicy.Ceiling(Model.MemoryLimitBytes)
                : null;
            <partial name="Design/_PanelStart" model="evictionPanel" />

            <p class="mb-3 text-xs leading-5 text-ink-faint">
                @(isFa
                    ? "وقتی Redis پر شود، یا نوشتن را رد می‌کند یا کلیدها را حذف می‌کند. انتخاب درست بستگی دارد به این‌که این نمونه یک cache است یا یک صف/ذخیره‌گاه اصلی."
                    : "When Redis fills up it either refuses writes or deletes keys. The right choice depends on whether this instance is a cache or a queue/primary store.")
            </p>

            @if (Model.RedisEvictionPolicy is { } currentKey
                 && Harbora.Infrastructure.Services.RedisMemoryPolicy.Find(currentKey) is { } current)
            {
                <dl class="mb-3 space-y-1 text-xs" data-redis-current-policy="@current.Key">
                    <div class="flex justify-between gap-2">
                        <dt class="text-ink-faint">@(isFa ? "سیاست فعلی" : "Current policy")</dt>
                        <dd class="text-ink">@(isFa ? current.LabelFa : current.Label)</dd>
                    </div>
                    <div class="flex justify-between gap-2">
                        <dt class="text-ink-faint">@(isFa ? "سقف حافظه" : "Memory cap")</dt>
                        <dd class="text-ink" dir="ltr">
                            @(Model.RedisMaxMemoryBytes > 0
                                ? Harbora.Infrastructure.Tenancy.ByteSize.Format(Model.RedisMaxMemoryBytes)
                                : (isFa ? "بدون سقف" : "no cap"))
                        </dd>
                    </div>
                </dl>
                @if (Model.RedisMemoryPolicyUnpublished)
                {
                    <p class="mb-3 text-[11px] leading-4 text-warn" data-redis-policy-unpublished>
                        @(isFa
                            ? "این تنظیم روی نمونهٔ در حال اجرا اعمال شده، اما هنوز در دستور راه‌اندازی خودِ کانتینر ذخیره نشده — یک راه‌اندازی مجدد سادهٔ کانتینر آن را از بین می‌برد. برای ماندگاری، کانتینر را بازسازی کنید."
                            : "This reached the running instance, but is not yet baked into the container's own launch command — a plain restart would silently drop it. Rebuild the container to make it durable.")
                    </p>
                }
            }
            else
            {
                <p class="mb-3 text-[11px] leading-4 text-ink-faint" data-redis-no-policy>
                    @(isFa
                        ? "هیچ سیاستی انتخاب نشده — Redis طبق پیش‌فرض خودش «هرگز حذف نکن» عمل می‌کند."
                        : "No policy has been chosen — Redis behaves as \"never evict\" by its own default.")
                </p>
            }

            @if (Model.CanManage)
            {
                <form asp-action="RedisMemory" asp-route-id="@db.Id" method="post" class="space-y-3" data-redis-memory-form>
                    @Html.AntiForgeryToken()
                    <div class="space-y-2">
                        @foreach (var choice in Harbora.Infrastructure.Services.RedisMemoryPolicy.Choices)
                        {
                            var inputId = $"redis-policy-{choice.Key}";
                            <label for="@inputId" class="flex items-start gap-2 rounded-lg border border-line p-2.5 text-xs cursor-pointer">
                                <input type="radio" id="@inputId" name="evictionPolicy" value="@choice.Key"
                                       class="mt-0.5" data-redis-policy-option="@choice.Key"
                                       checked="@(Model.RedisEvictionPolicy == choice.Key)" />
                                <span>
                                    <span class="block font-medium text-ink">@(isFa ? choice.LabelFa : choice.Label)</span>
                                    <span class="block text-ink-faint">@(isFa ? choice.ConsequenceFa : choice.Consequence)</span>
                                    <span class="mt-0.5 block text-ink-faint">
                                        @(isFa ? "مناسب برای: " : "Suited to: ")@(isFa ? choice.SuitedToFa : choice.SuitedTo)
                                    </span>
                                </span>
                            </label>
                        }
                    </div>
                    <div>
                        <label class="form-label" for="redis-max-memory-mb">
                            @(isFa ? "سقف حافظه — مگابایت (۰ یعنی بدون سقف)" : "Memory cap — megabytes (0 for no cap)")
                        </label>
                        <input id="redis-max-memory-mb" name="maxMemoryMb" type="number" min="0" dir="ltr"
                               value="@(Model.RedisMaxMemoryBytes > 0 ? Model.RedisMaxMemoryBytes / 1024 / 1024 : 0)"
                               class="form-control text-sm" />
                        @if (ceiling is { } maxCeiling)
                        {
                            <p class="mt-1 text-[11px] leading-4 text-ink-faint">
                                @(isFa
                                    ? $"بیشترین مقدار مجاز برای این نمونه {Harbora.Infrastructure.Tenancy.ByteSize.Format(maxCeiling)} است."
                                    : $"The most this instance can be given is {Harbora.Infrastructure.Tenancy.ByteSize.Format(maxCeiling)}.")
                            </p>
                        }
                    </div>
                    <button class="btn-secondary w-full justify-center py-2 text-sm">@(isFa ? "ذخیره سیاست حذف" : "Save eviction policy")</button>
                </form>
            }

            <partial name="Design/_PanelEnd" />
        }

        @if (db.Type == ManagedServiceType.PostgreSql)
        {
            @* 1.7 (pgvector-as-option plan): the stock postgres image carries none of pgvector's
               files, so this only ever stores a request and marks the instance as needing a rebuild
               — exactly the same "applies on next rebuild" idiom the Redis panel above already uses,
               because swapping a running container's image is never something a setting alone does. *@
            var pgVectorPanel = new PanelModel(isFa ? "پشتیبانی pgvector" : "pgvector support");
            <partial name="Design/_PanelStart" model="pgVectorPanel" />

            <p class="mb-3 text-xs leading-5 text-ink-faint">
                @(isFa
                    ? "pgvector افزونه‌ای در PostgreSQL برای ذخیره و جست‌وجوی بردارهای امبدینگ است — بدون مدیریت ایندکس یا API شباهت، فقط خودِ افزونه."
                    : "pgvector is a PostgreSQL extension for storing and querying embedding vectors — no index management or similarity API here, just the extension itself.")
            </p>

            <dl class="mb-3 space-y-1 text-xs" data-pgvector-instance-state="@(Model.PgVectorEnabled ? "on" : "off")">
                <div class="flex justify-between gap-2">
                    <dt class="text-ink-faint">@(isFa ? "وضعیت درخواستی" : "Requested state")</dt>
                    <dd class="text-ink">@(Model.PgVectorEnabled ? (isFa ? "روشن" : "On") : (isFa ? "خاموش" : "Off"))</dd>
                </div>
                <div class="flex justify-between gap-2">
                    <dt class="text-ink-faint">@(isFa ? "ایمیج در حال اجرا" : "Running image")</dt>
                    <dd class="text-ink font-mono" dir="ltr">@(Model.RunningImage ?? "—")</dd>
                </div>
            </dl>

            @if (Model.PgVectorEnabled && Model.PgVectorUnpublished)
            {
                <p class="mb-3 text-[11px] leading-4 text-warn" data-pgvector-unpublished>
                    @(isFa
                        ? "روشن شد، ولی هنوز روی کانتینر در حال اجرا اعمال نشده — برای اجرای ایمیجِ دارای pgvector، کانتینر را بازسازی کنید."
                        : "Turned on, but not yet applied to the running container — rebuild it to run the pgvector-capable image.")
                </p>
            }

            @if (Model.CanManage)
            {
                <form asp-action="PgVector" asp-route-id="@db.Id" method="post" data-pgvector-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="enable" value="@(!Model.PgVectorEnabled).ToString().ToLowerInvariant()" />
                    <button class="btn-secondary w-full justify-center py-2 text-sm"
                            data-pgvector-toggle="@(Model.PgVectorEnabled ? "off" : "on")">
                        @(Model.PgVectorEnabled
                            ? (isFa ? "خاموش کردن pgvector" : "Turn pgvector support off")
                            : (isFa ? "روشن کردن pgvector" : "Turn pgvector support on"))
                    </button>
                </form>
                <p class="mt-2 text-[11px] leading-4 text-ink-faint">
                    @(isFa
                        ? "فقط اینجا ذخیره می‌شود؛ برای اجرای واقعیِ ایمیج جدید، کانتینر را بازسازی کنید."
                        : "Only saved here; rebuild the container to actually run the new image.")
                </p>
            }

            <partial name="Design/_PanelEnd" />
        }

        @if (db.Type == ManagedServiceType.PostgreSql)
        {
            @* 3.1 (round-2 market-gaps plan): WAL archiving + point-in-time recovery. Same "applies on
               next rebuild" idiom as pgvector above — wal_level/archive_mode/archive_command are only
               read at PostgreSQL startup, so this only ever stores the request until a rebuild happens.
               PitrWindow is computed fresh on every render (WalArchivingService.RecoveryWindowAsync) —
               never cached, never optimistic: a stale "window" is exactly the "green dot for a probe
               that never fired" defect this feature exists to refuse. *@
            var pitrPanel = new PanelModel(isFa ? "بازیابی در یک لحظهٔ مشخص (PITR)" : "Point-in-time recovery (PITR)");
            <partial name="Design/_PanelStart" model="pitrPanel" />

            <p class="mb-3 text-xs leading-5 text-ink-faint">
                @(isFa
                    ? "با روشن کردن این گزینه، Harbora فایل‌های WAL این نمونه را در محل ذخیرهٔ شیء آرشیو می‌کند تا بتوانید آن را به هر لحظه‌ای در گذشته بازیابی کنید، نه فقط تا آخرین پشتیبان زمان‌بندی‌شده."
                    : "Turns on WAL archiving into object storage, so this instance can be restored to any moment in the past — not only to the last scheduled backup.")
            </p>

            var pitrWindow = Model.PitrWindow;
            var pitrState = !Model.PitrEnabled ? "off"
                : Model.PitrUnpublished ? "pending-restart"
                : pitrWindow?.Status == PitrStatus.Degraded ? "degraded"
                : pitrWindow?.Status == PitrStatus.Healthy ? "healthy"
                : "not-yet-recoverable";

            <dl class="mb-3 space-y-1 text-xs" data-pitr-instance-state="@pitrState">
                <div class="flex justify-between gap-2">
                    <dt class="text-ink-faint">@(isFa ? "وضعیت درخواستی" : "Requested state")</dt>
                    <dd class="text-ink">@(Model.PitrEnabled ? (isFa ? "روشن" : "On") : (isFa ? "خاموش" : "Off"))</dd>
                </div>
                @if (Model.PitrEnabled)
                {
                    <div class="flex justify-between gap-2">
                        <dt class="text-ink-faint">@(isFa ? "بازهٔ قابل بازیابی" : "Recoverable window")</dt>
                        <dd class="text-ink"
                            data-pitr-window-state="@(pitrWindow is { HasRecoverableWindow: true } ? "has-data" : Model.PitrUnpublished ? "not-measured" : "empty")">
                            @if (pitrWindow is { HasRecoverableWindow: true })
                            {
                                <span dir="ltr" class="font-mono">
                                    @pitrWindow.EarliestPoint!.Value.LocalDateTime.ToString(Dates.Stamp) – @pitrWindow.LatestPoint!.Value.LocalDateTime.ToString(Dates.Stamp)
                                </span>
                            }
                            else
                            {
                                <span class="text-ink-faint">@(isFa ? "هنوز چیزی برای بازیابی نیست" : "nothing recoverable yet")</span>
                            }
                        </dd>
                    </div>
                }
            </dl>

            @if (Model.PitrEnabled && Model.PitrUnpublished)
            {
                <p class="mb-3 text-[11px] leading-4 text-warn" data-pitr-unpublished>
                    @(isFa
                        ? "روشن شد، ولی هنوز روی کانتینر در حال اجرا اعمال نشده — برای شروع آرشیو WAL، کانتینر را بازسازی کنید."
                        : "Turned on, but not yet applied to the running container — rebuild it to start WAL archiving.")
                </p>
            }
            else if (pitrWindow?.Status == PitrStatus.Degraded)
            {
                <p class="mb-3 text-[11px] leading-4 text-warn" data-pitr-degraded>
                    @* PitrRecoveryWindow.Compute's own sentence — the operator-facing "archiving has
                       been failing for Xh; the point you can restore to is stuck at Y" wording lives
                       there once, not re-derived here. *@
                    @pitrWindow.Message
                </p>
            }

            @if (Model.CanManage)
            {
                <form asp-action="Pitr" asp-route-id="@db.Id" method="post" data-pitr-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="enable" value="@(!Model.PitrEnabled).ToString().ToLowerInvariant()" />
                    <button class="btn-secondary w-full justify-center py-2 text-sm"
                            data-pitr-toggle="@(Model.PitrEnabled ? "off" : "on")">
                        @(Model.PitrEnabled
                            ? (isFa ? "خاموش کردن آرشیو WAL" : "Turn WAL archiving off")
                            : (isFa ? "روشن کردن آرشیو WAL" : "Turn WAL archiving on"))
                    </button>
                </form>
                <p class="mt-2 text-[11px] leading-4 text-ink-faint">
                    @(isFa
                        ? "فقط اینجا ذخیره می‌شود؛ آرشیو با بازسازی بعدیِ کانتینر آغاز می‌شود."
                        : "Only saved here; WAL archiving starts on the container's next rebuild.")
                </p>

                @if (pitrWindow is { HasRecoverableWindow: true })
                {
                    <form asp-action="PitrRestore" asp-route-id="@db.Id" method="post" class="mt-4 space-y-2" data-pitr-restore-form>
                        @Html.AntiForgeryToken()
                        <label class="block text-[11px] text-ink-faint" for="pitr-target">
                            @(isFa ? "بازیابی تا این لحظه" : "Restore to this moment")
                        </label>
                        <input type="datetime-local" id="pitr-target" class="input w-full text-xs" dir="ltr"
                               min="@Dates.LocalInputValue(pitrWindow.EarliestPoint)"
                               max="@Dates.LocalInputValue(pitrWindow.LatestPoint)"
                               value="@Dates.LocalInputValue(pitrWindow.LatestPoint)" />
                        @* Populated by the inline script in @section Scripts below, right before submit
                           — carried as a plain int unix timestamp, never a date string, across the
                           redirect this action ends with (TempData re-types a date-shaped string). *@
                        <input type="hidden" name="targetUnixSeconds" data-pitr-target-unix />
                        <button type="submit" class="btn-secondary w-full justify-center py-2 text-sm" data-pitr-restore-submit>
                            @(isFa ? "بازیابی به‌عنوان پایگاه‌دادهٔ جدید" : "Restore into a new database")
                        </button>
                        <p class="text-[11px] leading-4 text-ink-faint">
                            @(isFa
                                ? "یک پایگاه‌دادهٔ منطقی جدید می‌سازد؛ آنچه اکنون در حال اجراست دست‌نخورده می‌ماند."
                                : "Creates a brand-new logical database; nothing currently running is touched.")
                        </p>
                    </form>
                }
            }

            <partial name="Design/_PanelEnd" />
        }

        @if (db.Type == ManagedServiceType.PostgreSql)
        {
            @* 3.2 (round-2 market-gaps plan): read replicas. Lag is computed fresh on every render
               (ReplicationLagPresenter.Compute, fed by ReplicationLagMonitor's own tick) and rendered
               with the platform's three-state law — data / empty / not-measured — never a fabricated
               zero: a replica whose lag cannot be read says so, in words, never a green tick. *@
            var replicaPanel = new PanelModel(isFa ? "رپلیکاهای فقط-خواندنی" : "Read replicas");
            <partial name="Design/_PanelStart" model="replicaPanel" />

            @if (Model.PrimaryName is not null)
            {
                <p class="mb-3 text-xs leading-5 text-ink-faint" data-replica-of="@db.Id">
                    @(isFa
                        ? $"این یک رپلیکای فقط-خواندنیِ «{Model.PrimaryName}» است — همیشه به‌روزرسانی می‌شود، ولی هرگز مستقیماً پذیرای نوشتن نیست."
                        : $"This is a read-only replica of '{Model.PrimaryName}' — continuously updated, never written to directly.")
                </p>

                @if (Model.OwnLag is { } ownLag)
                {
                    <dl class="mb-3 space-y-1 text-xs" data-replica-lag-status="@ownLag.Status.ToString().ToLowerInvariant()">
                        <div class="flex justify-between gap-2">
                            <dt class="text-ink-faint">@(isFa ? "تأخیر رپلیکاسیون" : "Replication lag")</dt>
                            <dd class="@(ownLag.Status == ReplicaLagStatus.Known ? "font-mono text-ink" : "text-warn")" dir="ltr">
                                @ownLag.Message
                            </dd>
                        </div>
                    </dl>
                }

                @if (Model.CanManage)
                {
                    <form asp-action="PromoteReplica" asp-route-id="@db.Id" method="post" class="space-y-2" data-promote-form>
                        @Html.AntiForgeryToken()
                        <label class="block text-[11px] text-ink-faint" for="promote-confirm">
                            @(isFa ? $"برای ارتقا، نام «{db.Name}» را دقیقاً بنویسید" : $"Type '{db.Name}' exactly to promote")
                        </label>
                        <input type="text" id="promote-confirm" name="confirmName" class="input w-full text-xs" dir="ltr" required />
                        <button type="submit" class="btn-secondary w-full justify-center py-2 text-sm" data-promote-submit>
                            @(isFa ? "ارتقا به نمونهٔ مستقل و قابل‌نوشتن" : "Promote to a standalone, writable instance")
                        </button>
                        <p class="text-[11px] leading-4 text-ink-faint">
                            @(isFa
                                ? "دیگر هرگز از اصلیِ پیشین به‌روز نمی‌شود؛ هر اپی که REPLICA_URL آن را می‌خواند دیگر پیش نمی‌رود."
                                : "It stops receiving anything from its former primary; any app reading its REPLICA_URL stops catching up.")
                        </p>
                    </form>
                }
            }
            else
            {
                <p class="mb-3 text-xs leading-5 text-ink-faint">
                    @(isFa
                        ? "کپی‌ای فقط-خواندنی و پیوسته‌به‌روز از این نمونه. هر اپی که این پایگاه‌داده را وصل کند، به‌طور خودکار REPLICA_URL را هم دریافت می‌کند."
                        : "A continuously updated, read-only copy of this instance. Any app attached to this database automatically also receives REPLICA_URL.")
                </p>

                @if (Model.Replicas.Count == 0)
                {
                    <p class="text-xs text-ink-faint" data-replicas-state="empty">@(isFa ? "هنوز رپلیکایی ساخته نشده." : "No replicas yet.")</p>
                }
                else
                {
                    <table class="w-full text-xs" data-replicas-state="has-data">
                        <thead>
                            <tr class="text-ink-faint">
                                <th class="text-start font-normal">@(isFa ? "نام" : "Name")</th>
                                <th class="text-start font-normal">@(isFa ? "وضعیت" : "Status")</th>
                                <th class="text-start font-normal">@(isFa ? "تأخیر" : "Lag")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Replicas)
                            {
                                <tr data-replica-id="@r.Id" data-replica-lag-status="@r.Lag.Status.ToString().ToLowerInvariant()">
                                    <td><a asp-action="Details" asp-route-id="@r.Id" class="link">@r.Name</a></td>
                                    <td class="text-ink">@r.Status</td>
                                    <td>
                                        @if (r.Lag.Status == ReplicaLagStatus.Known)
                                        {
                                            <span dir="ltr" class="font-mono text-ink">@r.Lag.Message</span>
                                        }
                                        else
                                        {
                                            @* Never "0", never blank — ReplicationLagPresenter's own honest
                                               sentence for exactly why this replica's lag is unknown. *@
                                            <span class="text-warn">@r.Lag.Message</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (Model.CanManage)
                {
                    <form asp-action="CreateReplica" asp-route-id="@db.Id" method="post" class="mt-4 space-y-2" data-create-replica-form>
                        @Html.AntiForgeryToken()
                        <label class="block text-[11px] text-ink-faint" for="replica-name">@(isFa ? "نام رپلیکا" : "Replica name")</label>
                        <input type="text" id="replica-name" name="name" class="input w-full text-xs" required />
                        <button type="submit" class="btn-secondary w-full justify-center py-2 text-sm" data-create-replica-submit>
                            @(isFa ? "ساخت رپلیکا" : "Create replica")
                        </button>
                        <p class="text-[11px] leading-4 text-ink-faint">
                            @(isFa
                                ? "روی همان سرور و همان محیطِ این نمونه ساخته می‌شود."
                                : "Created on this instance's own server and environment.")
                        </p>
                    </form>
                }
            }

            <partial name="Design/_PanelEnd" />
        }

        @{ var attachPanel = new PanelModel(T["Attach to app"].Value); }
        <partial name="Design/_PanelStart" model="attachPanel" />

        <p class="mb-3 text-xs leading-5 text-ink-faint">
            @(isFa ? "متغیرهای اتصال رمزنگاری‌شده به اپ تزریق می‌شوند." : "The connection variables are injected into the app, encrypted.")
        </p>

        @if (Model.CanManage && Model.Apps.Any(a => a.Compatible))
        {
            <form asp-action="Attach" asp-route-id="@db.Id" method="post" class="space-y-2">
                @Html.AntiForgeryToken()
                <select name="appId" class="form-control text-sm">
                    @foreach (var app in Model.Apps.Where(a => a.Compatible))
                    {
                        <option value="@app.Id">@app.Name · @app.Environment</option>
                    }
                </select>
                @if (Model.LogicalDatabases.Count > 1)
                {
                    @* D3 (2026-08-25 shared-databases plan): "attach to a logical database, from
                       either side" — this is the database-page half. Omitted entirely once an
                       instance has only its own default (the overwhelming common case, and every
                       instance created before D1), so a plain attach behaves exactly as it always
                       did: the controller falls back to the default when no databaseId is posted. *@
                    <select name="databaseId" class="form-control text-sm" dir="ltr" data-attach-database-picker>
                        @foreach (var logical in Model.LogicalDatabases)
                        {
                            <option value="@logical.Id">@logical.Name@(logical.IsDefault ? (isFa ? " (پیش‌فرض)" : " (default)") : "")</option>
                        }
                    </select>
                }
                @* C1 (2026-08-22 config-delivery plan): optional — an app attached to two databases
                   needs unambiguous names, and this is how a customer picks one rather than accepting
                   the auto-generated slug (AppManagedServiceAlias.Resolve falls back to it, and makes
                   whatever is typed here unique per app if it collides with an existing attachment). *@
                <input name="alias" placeholder="@(isFa ? "نام مستعار (اختیاری) — مثلاً ORDERS" : "Alias (optional) — e.g. ORDERS")"
                       class="form-control text-sm" dir="ltr" />
                <button class="btn-primary w-full justify-center">@T["Attach"]</button>
            </form>
        }
        else if (Model.CanManage)
        {
            <p class="text-xs leading-5 text-ink-faint">
                @(isFa
                    ? "در این محیط اپی برای اتصال وجود ندارد؛ دیتابیس فقط به اپ همان شبکه متصل می‌شود."
                    : "No app exists in this environment. A database can only attach inside its private network.")
            </p>
        }

        @if (Model.UsedBy.Count > 0)
        {
            <div class="mt-3 text-xs text-ink-muted">
                @(isFa ? "در حال استفاده توسط: " : "Used by: ")<strong class="text-ink">@string.Join(", ", Model.UsedBy)</strong>
            </div>
        }
        <partial name="Design/_PanelEnd" />

        @if (Model.CanManage)
        {
            var maintenancePanel = new PanelModel(isFa ? "نگهداری" : "Maintenance");
            <partial name="Design/_PanelStart" model="maintenancePanel" />

            <div class="space-y-2">
                <form asp-action="Measure" asp-route-id="@db.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button class="btn-secondary w-full justify-center py-2 text-sm"><i data-lucide="ruler" class="h-4 w-4"></i>@(isFa ? "اندازه‌گیری فضا" : "Measure storage")</button>
                </form>

                <form asp-action="Rotate" asp-route-id="@db.Id" method="post"
                      onsubmit="return confirm('@(isFa ? "رمز عبور عوض شود؟ سرویس‌های متصل تا وقتی دوباره دیپلوی نشوند از رمز قبلی استفاده می‌کنند." : "Change the password? Attached services keep the old one until they are redeployed.")')">
                    @Html.AntiForgeryToken()
                    <button class="btn-secondary w-full justify-center py-2 text-sm"><i data-lucide="key-round" class="h-4 w-4"></i>@(isFa ? "تعویض رمز" : "Rotate password")</button>
                </form>

                @{
                    // P4 (2026-08-17 app-environment-management design): the same button that has
                    // always rebuilt the container IS the retry a Failed database needs — re-presented
                    // rather than duplicated, since a second "Retry" action would do the exact same
                    // thing this one already does.
                    var isRetry = db.Status == ServiceStatus.Failed;
                }
                @if (isRetry && !string.IsNullOrWhiteSpace(db.ErrorMessage))
                {
                    <div class="rounded-lg border border-danger bg-danger-soft px-3 py-2 text-xs text-danger"
                         data-spec-service-error="@db.ErrorMessage">
                        @(isFa ? "علت شکست راه‌اندازی: " : "Why provisioning failed: ")@db.ErrorMessage
                    </div>
                }
                <form asp-action="Reprovision" asp-route-id="@db.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button class="@(isRetry ? "btn-primary" : "btn-secondary") w-full justify-center py-2 text-sm"
                            data-spec-reprovision="@(isRetry ? "retry" : "rebuild")">
                        <i data-lucide="rotate-cw" class="h-4 w-4"></i>@(isRetry
                            ? (isFa ? "تلاش دوباره" : "Retry")
                            : (isFa ? "بازسازی کانتینر" : "Rebuild container"))
                    </button>
                </form>

                <p class="text-[11px] leading-4 text-ink-faint">
                    @(isRetry
                        ? (isFa
                            ? "راه‌اندازی را دوباره امتحان می‌کند — همان بازسازی کانتینر، برای همان دیتابیسی که بالا نیامد."
                            : "Tries provisioning again — the same container rebuild, for the database that did not come up.")
                        : (isFa
                            ? "بازسازی، کانتینر را از نو می‌سازد و سقف منابع و رمزنگاری را اعمال می‌کند. داده‌ها حفظ می‌شوند؛ اتصال‌های باز چند ثانیه قطع می‌شوند."
                            : "Rebuilding recreates the container and applies the resource ceiling and encryption. The data is kept; open connections drop for a few seconds."))
                </p>
            </div>
            <partial name="Design/_PanelEnd" />

            <section class="rounded-xl border border-danger/30 bg-surface p-5">
                <h2 class="text-sm font-semibold text-danger">@(isFa ? "منطقهٔ خطر" : "Danger zone")</h2>
                <p class="mt-1 text-xs leading-5 text-ink-muted">
                    @(isFa ? "حذف دیتابیس، و در صورت انتخاب، داده‌هایش." : "Remove the database, and its data if you choose to.")
                </p>
                <a href="/databases/@db.Id/remove" class="btn-danger mt-3 inline-flex px-4 py-2 text-sm">@T["Delete"]</a>
            </section>
        }
    </aside>
</div>

@section Scripts {
<script>
    (function () {
        var button = document.querySelector('[data-copy-connection]');
        var code = document.getElementById('databaseConnection');
        if (!button || !code) return;
        button.addEventListener('click', function () {
            navigator.clipboard?.writeText(code.textContent.trim());
        });
    })();
    (function () {
        // 3.1 (round-2 market-gaps plan): the browser is the only party that knows which timezone the
        // picked datetime-local value is actually in — converted to a plain unix-seconds integer here,
        // never a date string, so the server side never has to guess an offset and TempData never has
        // a date-shaped string to re-type on the redirect this form's action ends with.
        var form = document.querySelector('[data-pitr-restore-form]');
        if (!form) return;
        var picker = document.getElementById('pitr-target');
        var hidden = form.querySelector('[data-pitr-target-unix]');
        form.addEventListener('submit', function (e) {
            var picked = picker && picker.value ? new Date(picker.value) : null;
            if (!picked || isNaN(picked.getTime()) || !hidden) { e.preventDefault(); return; }
            hidden.value = Math.floor(picked.getTime() / 1000);
        });
    })();
</script>
}
