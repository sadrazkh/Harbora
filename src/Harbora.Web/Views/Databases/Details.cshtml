@model Harbora.Domain.Services.ManagedService
@{
    ViewData["Title"] = Model.Name;
    var conn = ViewBag.Connection as string ?? "";
    var reveal = (bool)(ViewBag.Reveal ?? false);
    var apps = ViewBag.Apps as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var msg = TempData["Message"] as string;
    var err = TempData["Error"] as string;
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var drifted = Harbora.Infrastructure.Services.VersionDrift.HasDrifted(Model.Version, Model.RunningImage);
    var moving = Harbora.Infrastructure.Services.VersionDrift.IsMoving(Model.Version);
    string StatusClass(Harbora.Domain.Common.ServiceStatus s) => s switch
    {
        Harbora.Domain.Common.ServiceStatus.Running => "bg-ok/15 text-ok",
        Harbora.Domain.Common.ServiceStatus.Failed => "bg-danger/15 text-danger",
        Harbora.Domain.Common.ServiceStatus.Provisioning => "bg-accent-hover/15 text-accent-text animate-pulse",
        _ => "bg-slate-500/15 text-ink"
    };
}
<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
        <a href="/databases" class="text-accent-text text-sm">← @T["Databases"]</a>
        <h1 class="text-2xl font-bold tracking-tight text-ink flex items-center gap-3">@Model.Name
            <span class="rounded-full px-2.5 py-0.5 text-xs font-medium @StatusClass(Model.Status)">@Model.Status</span>
        </h1>
        <p class="text-ink-muted text-sm">
            @Model.Type · @Model.Version
            @* The size, with when it was taken: a figure with no timestamp is trusted longer than it
               should be. *@
            @if (Model.StorageMeasuredAt is { } measured)
            {
                <span>· @Harbora.Infrastructure.Services.StorageMeasurement.Describe(Model.StorageBytes)</span>
                <span class="text-ink-faint">(@(isFa ? "اندازه‌گیری" : "measured") @measured.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC)</span>
            }
            else
            {
                <span class="text-ink-faint">· @(isFa ? "حجم اندازه‌گیری نشده" : "size not measured")</span>
            }
        </p>
    </div>
    <div class="flex gap-2">
        <form asp-controller="Databases" asp-action="Start" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button class="rounded-lg bg-surface-2 hover:bg-surface-2 px-3 py-1.5 text-sm">▶ @T["Start"]</button></form>
        <form asp-controller="Databases" asp-action="Stop" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button class="rounded-lg bg-surface-2 hover:bg-surface-2 px-3 py-1.5 text-sm">⏸ @T["Stop"]</button></form>
        <form asp-controller="Databases" asp-action="TestConnection" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button class="rounded-lg bg-surface-2 hover:bg-surface-2 px-3 py-1.5 text-sm">🔌 @(isFa ? "تست اتصال" : "Test connection")</button></form>
        <form asp-controller="Databases" asp-action="Measure" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button class="rounded-lg bg-surface-2 hover:bg-surface-2 px-3 py-1.5 text-sm">📏 @(isFa ? "اندازه‌گیری" : "Measure")</button></form>
        <form asp-controller="Databases" asp-action="Rotate" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('@(isFa ? "رمز عبور عوض شود؟ سرویس‌های متصل تا وقتی دوباره دیپلوی نشوند از رمز قبلی استفاده می‌کنند." : "Change the password? Attached services keep the old one until they are redeployed.")')">@Html.AntiForgeryToken()<button class="rounded-lg bg-surface-2 hover:bg-surface-2 px-3 py-1.5 text-sm">🔑 @(isFa ? "تعویض رمز" : "Rotate password")</button></form>
        <a href="/databases/@Model.Id/remove" class="rounded-lg bg-danger-soft hover:bg-danger-soft text-danger px-3 py-1.5 text-sm">🗑 @T["Remove"]</a>
    </div>
</div>

@if (msg is not null)
{
    <div class="mb-4 rounded-lg bg-ok-soft border border-ok text-ok px-4 py-2 text-sm">@msg</div>
}
@if (err is not null)
{
    <div class="mb-4 rounded-lg bg-danger-soft border border-danger text-danger px-4 py-2 text-sm">@err</div>
}

@* A database running a different version than the one chosen is the failure nobody recovers from
   quickly: it will not start on the data directory it already has. *@
@if (drifted)
{
    <div class="mb-4 rounded-lg bg-warn-soft border border-warn text-warn px-4 py-3 text-sm">
        @(isFa
            ? $"نسخهٔ انتخاب‌شده «{Model.Version}» است ولی کانتینر در حال اجرا «{Model.RunningImage}» است."
            : $"The chosen version is \"{Model.Version}\" but the running container is \"{Model.RunningImage}\".")
    </div>
}
else if (moving)
{
    <div class="mb-4 rounded-lg bg-warn-soft border border-warn text-warn px-4 py-3 text-sm">
        @(isFa
            ? "این سرویس به نسخهٔ مشخصی سنجاق نشده، پس ممکن است با ساخته‌شدن دوبارهٔ کانتینر نسخهٔ اصلی‌اش عوض شود و روی داده‌های فعلی بالا نیاید."
            : "This service is not pinned to a version, so recreating its container can move it to a new major release — which will refuse to start on the data it already has.")
    </div>
}

<div class="grid lg:grid-cols-2 gap-6">
    <section class="rounded-xl border border-line bg-surface p-5">
        <div class="flex items-center justify-between mb-3">
            <h2 class="font-semibold">@T["Connection info"]</h2>
            <a href="/databases/@Model.Id?reveal=@(reveal ? "false" : "true")" class="text-xs text-accent-text">@(reveal ? T["Hide"] : T["Reveal"])</a>
        </div>
        <div class="space-y-2 text-sm font-mono">
            <div class="flex justify-between"><span class="text-ink-faint">host</span><span>@Model.ContainerName</span></div>
            <div class="flex justify-between"><span class="text-ink-faint">port</span><span>@Model.InternalPort</span></div>
            @* This address resolves on one private network and nowhere else — including from the
               internet, which is the point. *@
            @if (ViewBag.Network is string net && net.Length > 0)
            {
                <div class="flex justify-between gap-4"><span class="text-ink-faint">network</span><span class="text-end break-all">@net</span></div>
            }
            <div class="flex justify-between"><span class="text-ink-faint">user</span><span>@Model.Username</span></div>
            @if (!string.IsNullOrEmpty(Model.DatabaseName))
            {
                <div class="flex justify-between"><span class="text-ink-faint">database</span><span>@Model.DatabaseName</span></div>
            }
        </div>
        <div class="mt-4 rounded-lg bg-code text-code-ink p-3 text-xs font-mono break-all">@conn</div>
        <p class="mt-2 text-xs text-ink-faint">
            @(isFa
                ? "این آدرس فقط از داخل همین شبکهٔ خصوصی کار می‌کند و از اینترنت در دسترس نیست."
                : "This address works only from inside that private network. It is not reachable from the internet.")
        </p>

        @{ var usedBy = ViewBag.UsedBy as List<string> ?? new(); }
        <div class="mt-4 text-sm">
            <div class="text-ink-faint mb-1">@(isFa ? "سرویس‌هایی که از آن استفاده می‌کنند" : "Used by")</div>
            @if (usedBy.Count == 0)
            {
                <span class="text-ink-muted">@(isFa ? "هیچ سرویسی" : "No services yet")</span>
            }
            else
            {
                <span class="text-ink">@string.Join("، ", usedBy)</span>
            }
        </div>
        <p class="mt-2 text-xs text-ink-faint">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa" ? "این سرویس فقط از شبکه‌ی داخلی Harbora در دسترس است." : "Reachable only from the internal Harbora network.")</p>
    </section>

    <section class="rounded-xl border border-line bg-surface p-5">
        <h2 class="text-[15px] font-semibold text-ink mb-3">@T["Attach to app"]</h2>
        <p class="text-sm text-ink-muted mb-3">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa" ? "متغیرهای اتصال به‌صورت رمزنگاری‌شده به اپ اضافه می‌شوند." : "Connection variables are added to the app, encrypted.")</p>
        <form asp-controller="Databases" asp-action="Attach" asp-route-id="@Model.Id" method="post" class="flex gap-2">
            @Html.AntiForgeryToken()
            <select name="appId" class="flex-1 rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm">
                @foreach (var a in apps)
                {
                    <option value="@a.Id">@a.Name</option>
                }
            </select>
            <button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm font-semibold">@T["Attach"]</button>
        </form>
    </section>
</div>
