@model DatabaseOverviewViewModel
@using Harbora.Domain.Common
@using Harbora.Domain.Backups
@{
    // The header and breadcrumb now live in _Shell.cshtml, which is typed to DatabaseTabViewModel
    // rather than to the raw row — this local alias is what lets the rest of this file go on reading
    // "db.Whatever" exactly as it read "Model.Database.Whatever" before the split.
    Layout = "_Shell";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var db = Model.Database;
    ViewData["Title"] = db.Name;

    // The Message/Error banner now renders once in _Shell.cshtml, above every tab — not here.
    // TempData is consumed on read, so a second read site here would just find it already gone.

    var drifted = Harbora.Infrastructure.Services.VersionDrift.HasDrifted(db.Version, Model.RunningImage);
    var moving = Harbora.Infrastructure.Services.VersionDrift.IsMoving(db.Version);

    string Gb(long? bytes) => bytes is null or 0
        ? "—"
        : bytes < 1024L * 1024 * 1024
            ? $"{bytes / 1024.0 / 1024:0.#} MB"
            : $"{bytes / 1024.0 / 1024 / 1024:0.##} GB";
}

@if (TempData["AdminToolUrl"] is string toolUrl)
{
    @* Shown exactly once. The password is not stored anywhere in readable form, so a refresh loses
       it — which is the point, and is said plainly rather than discovered. *@
    <div class="mb-4 rounded-lg border border-warn bg-warn-soft px-4 py-3 text-sm">
        <div class="mb-2 font-medium">@(isFa ? "ابزار مدیریت باز شد — یک ساعت زنده می‌ماند." : "The admin tool is open — it lives for one hour.")</div>
        <div class="mb-2" dir="ltr"><a href="@toolUrl" target="_blank" rel="noopener" class="text-accent-text break-all">@toolUrl</a></div>
        <div dir="ltr" class="font-mono text-xs">
            @(isFa ? "کاربر" : "user"): @TempData["AdminToolUser"] &nbsp;·&nbsp;
            @(isFa ? "رمز" : "password"): @TempData["AdminToolPassword"]
        </div>
        <p class="mt-2 text-xs text-ink-muted">
            @(isFa
                ? "این رمز فقط همین یک‌بار نشان داده می‌شود. رمز خودِ دیتابیس را از بخش «اطلاعات اتصال» بردارید."
                : "This password is shown only once. Take the database's own password from the connection panel.")
        </p>
    </div>
}

@* A database running a different version from the one chosen will not start on the data directory
   it already has. It is the failure nobody recovers from quickly, so it is said at the top. *@
@if (drifted)
{
    <div class="alert-warning mb-4">
        <i data-lucide="triangle-alert" class="h-4 w-4 shrink-0"></i>
        <span>@(isFa
            ? $"نسخهٔ انتخاب‌شده «{db.Version}» است ولی کانتینر در حال اجرا «{Model.RunningImage}» است."
            : $"The chosen version is \"{db.Version}\" but the running container is \"{Model.RunningImage}\".")</span>
    </div>
}
else if (moving)
{
    <div class="alert-warning mb-4">
        <i data-lucide="triangle-alert" class="h-4 w-4 shrink-0"></i>
        <span>@(isFa
            ? "این سرویس به نسخهٔ مشخصی سنجاق نشده، پس بازسازی کانتینر ممکن است نسخهٔ اصلی‌اش را عوض کند و روی داده‌های فعلی بالا نیاید."
            : "This service is not pinned to a version, so recreating its container can move it to a new major release — which will refuse to start on the data it already has.")</span>
    </div>
}

<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="space-y-6">
        @{
            var connectionPanel = new PanelModel(
                T["Connection info"].Value,
                Model.CanManage ? (Model.Reveal ? T["Hide"].Value : T["Reveal"].Value) : null,
                Model.CanManage ? $"/databases/{db.Id}?reveal={(!Model.Reveal).ToString().ToLowerInvariant()}" : null);
        }
        <partial name="Design/_PanelStart" model="connectionPanel" />

        <p class="mb-3 text-xs leading-5 text-ink-faint">
            @(isFa
                ? "این آدرس فقط داخل شبکهٔ خصوصی پروژه کار می‌کند و از اینترنت در دسترس نیست. برای اتصال از بیرون، «دسترسی خارجی» را باز کنید."
                : "This address resolves only inside the project's private network and is not reachable from the internet. To connect from outside, open external access.")
        </p>

        <div class="connection-string"><code id="databaseConnection" dir="ltr">@Model.Connection</code><button type="button" data-copy-connection title="@(isFa ? "کپی" : "Copy")"><i data-lucide="copy" class="h-4 w-4"></i></button></div>

        <dl class="connection-grid">
            <div><dt>Host</dt><dd dir="ltr">@db.ContainerName</dd></div>
            <div><dt>Port</dt><dd>@db.InternalPort</dd></div>
            <div><dt>User</dt><dd dir="ltr">@db.Username</dd></div>
            <div><dt>Database</dt><dd dir="ltr">@(string.IsNullOrWhiteSpace(db.DatabaseName) ? "—" : db.DatabaseName)</dd></div>
            @if (Model.Network is { Length: > 0 } network)
            {
                <div class="col-span-2"><dt>Network</dt><dd class="break-all" dir="ltr">@network</dd></div>
            }
            <div class="col-span-2"><dt>Volume</dt><dd class="break-all" dir="ltr">@db.VolumeName</dd></div>
        </dl>
        <partial name="Design/_PanelEnd" />

        @{ var backupPanel = new PanelModel(T["Backups"].Value, isFa ? "همه" : "View all", "/backups"); }
        <partial name="Design/_PanelStart" model="backupPanel" />

        <p class="mb-3 text-xs text-ink-faint">
            @(Model.BackupIntervalHours is { } hours
                ? (isFa ? $"هر {hours} ساعت" : $"Every {hours} hours")
                : (isFa ? "زمان‌بندی نشده" : "Not scheduled"))
            @if (Model.NextBackupAt is { } next)
            {
                <span> · @(isFa ? "بعدی" : "next") <span dir="ltr">@next.LocalDateTime.ToString(Dates.Stamp)</span></span>
            }
        </p>

        @if (Model.Backups.Count == 0)
        {
            <partial name="Design/_EmptyState" model="@(new EmptyStateModel("cloud-upload",
                isFa ? "هنوز پشتیبانی گرفته نشده." : "No backup has been taken yet.",
                isFa ? "زمان‌بندی پشتیبان" : "Set up backups", "/backups"))" />
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="resource-table min-w-[560px]">
                    <thead>
                        <tr>
                            <th>@(isFa ? "زمان" : "Date")</th>
                            <th>@(isFa ? "نوع" : "Type")</th>
                            <th>@(isFa ? "حجم" : "Size")</th>
                            <th>@T["Status"]</th>
                            <th>@(isFa ? "بررسی بازیابی" : "Restore verification")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var backup in Model.Backups)
                        {
                            <tr>
                                <td class="table-primary">@backup.At.LocalDateTime.ToString(Dates.Stamp)</td>
                                <td>@(backup.IsScheduled ? (isFa ? "خودکار" : "Scheduled") : (isFa ? "دستی" : "Manual"))</td>
                                <td>@Gb(backup.SizeBytes)</td>
                                <td><span class="resource-status @(backup.Status == BackupStatus.Completed ? "is-ok" : backup.Status == BackupStatus.Failed ? "is-danger" : "is-info")"><i></i>@backup.Status</span></td>
                                <td>@(backup.VerifiedRestorable switch { true => isFa ? "تأیید شده" : "Verified", false => isFa ? "نامعتبر" : "Failed", _ => isFa ? "بررسی نشده" : "Not verified" })</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <partial name="Design/_PanelEnd" />
    </div>

    <aside class="space-y-6">
        @{ var planPanel = new PanelModel(isFa ? "طرح منابع" : "Resource plan"); }
        <partial name="Design/_PanelStart" model="planPanel" />

        @if (Model.MemoryLimitBytes > 0 || Model.CpuLimit > 0)
        {
            <dl class="space-y-2 text-xs">
                <div class="flex justify-between gap-2"><dt class="text-ink-faint">@(isFa ? "اندازه" : "Size")</dt><dd class="text-ink">@(Model.InstanceSizeKey ?? "—")</dd></div>
                <div class="flex justify-between gap-2"><dt class="text-ink-faint">@(isFa ? "سقف حافظه" : "Memory limit")</dt><dd class="text-ink" dir="ltr">@Gb(Model.MemoryLimitBytes)</dd></div>
                <div class="flex justify-between gap-2"><dt class="text-ink-faint">@(isFa ? "سقف CPU" : "CPU limit")</dt><dd class="text-ink" dir="ltr">@Model.CpuLimit</dd></div>
            </dl>
        }
        else
        {
            @* Worth saying rather than showing a dash: this database predates resource plans and can
               take whatever the host has. *@
            <p class="text-xs leading-5 text-warn">
                @(isFa
                    ? "این دیتابیس سقف منابع ندارد و می‌تواند هرچقدر بخواهد از سرور بگیرد."
                    : "This database has no resource ceiling and can take whatever the host has.")
            </p>
        }

        @if (Model.CanManage)
        {
            <form asp-action="Resize" asp-route-id="@db.Id" method="post" class="mt-3 space-y-2">
                @Html.AntiForgeryToken()
                @* Cards rather than a dropdown, so what a tier costs is visible before the choice
                   rather than after the bill.

                   Pinned to the host this database already runs on, and no server field: a resize does
                   not move a workload, because moving one severs its private network and has its own
                   confirmation screen. "No limit" IS offered here, unlike on creation — it is the
                   state a database made before tiers existed is already in, so leaving it out would
                   make saving this form impose a ceiling nobody asked for. *@
                @await Component.InvokeAsync("SizePicker", new
                {
                    sizeField = "instanceSizeKey",
                    selectedSize = Model.InstanceSizeKey,
                    selectedServer = Model.ServerId,
                    pinnedServer = Model.ServerId,
                    allowNoLimit = true
                })
                <button class="btn-secondary w-full justify-center py-2 text-sm">@(isFa ? "تغییر اندازه" : "Change size")</button>
                <p class="text-[11px] leading-4 text-ink-faint">
                    @(isFa
                        ? "ذخیره می‌شود، ولی تا بازسازی کانتینر اعمال نمی‌شود — راه‌اندازی مجدد ناخواستهٔ یک دیتابیس هیچ‌وقت چیز کوچکی نیست."
                        : "Saved, but not applied until the container is rebuilt — an unrequested database restart is never a small thing.")
                </p>
            </form>
        }

        <p class="mt-3 text-[11px] leading-4 text-ink-faint">
            @(Model.TlsEnabled
                ? (isFa ? "اتصال رمزنگاری می‌شود (TLS)." : "Connections are encrypted with TLS.")
                : (isFa ? "اتصال رمزنگاری نمی‌شود." : "Connections are not encrypted."))
        </p>
        <partial name="Design/_PanelEnd" />

        @{ var attachPanel = new PanelModel(T["Attach to app"].Value); }
        <partial name="Design/_PanelStart" model="attachPanel" />

        <p class="mb-3 text-xs leading-5 text-ink-faint">
            @(isFa ? "متغیرهای اتصال رمزنگاری‌شده به اپ تزریق می‌شوند." : "The connection variables are injected into the app, encrypted.")
        </p>

        @if (Model.CanManage && Model.Apps.Any(a => a.Compatible))
        {
            <form asp-action="Attach" asp-route-id="@db.Id" method="post" class="space-y-2">
                @Html.AntiForgeryToken()
                <select name="appId" class="form-control text-sm">
                    @foreach (var app in Model.Apps.Where(a => a.Compatible))
                    {
                        <option value="@app.Id">@app.Name · @app.Environment</option>
                    }
                </select>
                <button class="btn-primary w-full justify-center">@T["Attach"]</button>
            </form>
        }
        else if (Model.CanManage)
        {
            <p class="text-xs leading-5 text-ink-faint">
                @(isFa
                    ? "در این محیط اپی برای اتصال وجود ندارد؛ دیتابیس فقط به اپ همان شبکه متصل می‌شود."
                    : "No app exists in this environment. A database can only attach inside its private network.")
            </p>
        }

        @if (Model.UsedBy.Count > 0)
        {
            <div class="mt-3 text-xs text-ink-muted">
                @(isFa ? "در حال استفاده توسط: " : "Used by: ")<strong class="text-ink">@string.Join(", ", Model.UsedBy)</strong>
            </div>
        }
        <partial name="Design/_PanelEnd" />

        @if (Model.CanManage)
        {
            var maintenancePanel = new PanelModel(isFa ? "نگهداری" : "Maintenance");
            <partial name="Design/_PanelStart" model="maintenancePanel" />

            <div class="space-y-2">
                <form asp-action="Measure" asp-route-id="@db.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button class="btn-secondary w-full justify-center py-2 text-sm"><i data-lucide="ruler" class="h-4 w-4"></i>@(isFa ? "اندازه‌گیری فضا" : "Measure storage")</button>
                </form>

                <form asp-action="Rotate" asp-route-id="@db.Id" method="post"
                      onsubmit="return confirm('@(isFa ? "رمز عبور عوض شود؟ سرویس‌های متصل تا وقتی دوباره دیپلوی نشوند از رمز قبلی استفاده می‌کنند." : "Change the password? Attached services keep the old one until they are redeployed.")')">
                    @Html.AntiForgeryToken()
                    <button class="btn-secondary w-full justify-center py-2 text-sm"><i data-lucide="key-round" class="h-4 w-4"></i>@(isFa ? "تعویض رمز" : "Rotate password")</button>
                </form>

                <form asp-action="Reprovision" asp-route-id="@db.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button class="btn-secondary w-full justify-center py-2 text-sm"><i data-lucide="rotate-cw" class="h-4 w-4"></i>@(isFa ? "بازسازی کانتینر" : "Rebuild container")</button>
                </form>

                <p class="text-[11px] leading-4 text-ink-faint">
                    @(isFa
                        ? "بازسازی، کانتینر را از نو می‌سازد و سقف منابع و رمزنگاری را اعمال می‌کند. داده‌ها حفظ می‌شوند؛ اتصال‌های باز چند ثانیه قطع می‌شوند."
                        : "Rebuilding recreates the container and applies the resource ceiling and encryption. The data is kept; open connections drop for a few seconds.")
                </p>
            </div>
            <partial name="Design/_PanelEnd" />

            <section class="rounded-xl border border-danger/30 bg-surface p-5">
                <h2 class="text-sm font-semibold text-danger">@(isFa ? "منطقهٔ خطر" : "Danger zone")</h2>
                <p class="mt-1 text-xs leading-5 text-ink-muted">
                    @(isFa ? "حذف دیتابیس، و در صورت انتخاب، داده‌هایش." : "Remove the database, and its data if you choose to.")
                </p>
                <a href="/databases/@db.Id/remove" class="btn-danger mt-3 inline-flex px-4 py-2 text-sm">@T["Delete"]</a>
            </section>
        }
    </aside>
</div>

@section Scripts {
<script>
    (function () {
        var button = document.querySelector('[data-copy-connection]');
        var code = document.getElementById('databaseConnection');
        if (!button || !code) return;
        button.addEventListener('click', function () {
            navigator.clipboard?.writeText(code.textContent.trim());
        });
    })();
</script>
}
