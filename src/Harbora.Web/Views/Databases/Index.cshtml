@model DatabasesPageViewModel
@using Harbora.Web.ViewModels
@inject Harbora.Web.Infrastructure.RailPreferences Rails
@{
    ViewData["Title"] = "Databases";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var here = Context.Request.Path + Context.Request.QueryString;
    // Quick provision reuses RailPanel.QuickStart — the same "shelf of things to install" concept
    // Apps/Index's own Quick start panel uses, on the account rather than the page, so the choice
    // carries between the two lists the same way it carries between a laptop and a phone.
    var quickStartOpen = await Rails.IsOpenAsync(Harbora.Infrastructure.Navigation.RailPanel.QuickStart);
    var selected = Model.Selected;
    string CssPercent(double? value) => Math.Clamp(value ?? 0, 0, 100)
        .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    string Gb(long? bytes) => bytes is null ? "—" : bytes < 1024 * 1024
        ? $"{bytes / 1024.0:0.#} KB"
        : bytes < 1024L * 1024 * 1024
            ? $"{bytes / 1024.0 / 1024:0.#} MB"
            : $"{bytes / 1024.0 / 1024 / 1024:0.##} GB";
    // One rule, shared with the list/page beside this one: a service whose mark is right in one
    // place and generic in the other looks like two different things.
    string TypeKey(ManagedServiceType type) => Harbora.Infrastructure.Services.ServiceTypeKey.For(type);
    string Tone(ServiceStatus status) => status switch
    {
        ServiceStatus.Running => "is-ok", ServiceStatus.Provisioning => "is-info",
        ServiceStatus.Failed => "is-danger", _ => "is-idle"
    };
}

<div class="page-heading">
    <div>
        <div class="eyebrow"><i data-lucide="database" class="h-3.5 w-3.5"></i>@(isFa ? "سرویس‌های داده" : "Managed data services")</div>
        <h1>@T["Databases"]</h1>
        <p>@(isFa ? "دیتابیس‌ها، اتصال‌ها، مصرف منابع و پشتیبان‌ها را از یک صفحه مدیریت کنید." : "Manage databases, private connections, resource usage and backups in one place.")</p>
    </div>
    <div class="flex flex-wrap gap-2">
        <a href="/backups" class="btn-secondary"><i data-lucide="upload-cloud" class="h-4 w-4"></i>@(isFa ? "ورود پشتیبان" : "Import backup")</a>
        <a href="/databases/create" class="btn-primary"><i data-lucide="plus" class="h-4 w-4"></i>@(isFa ? "ساخت دیتابیس" : "Create database")</a>
    </div>
</div>

<section class="resource-shell">
    <div class="resource-toolbar">
        <div class="flex items-center gap-2 text-sm text-ink-muted">
            <span class="resource-status @(Model.Warnings == 0 ? "is-ok" : "is-warn")"><i></i>@Model.Healthy @(isFa ? "سالم" : "healthy")</span>
            @if (Model.Warnings > 0) { <span class="resource-status is-warn"><i></i>@Model.Warnings @(isFa ? "نیازمند توجه" : "need attention")</span> }
        </div>
        <label class="resource-search ms-auto">
            <i data-lucide="search" class="h-4 w-4"></i>
            <input id="databaseSearch" type="search" placeholder="@(isFa ? "جست‌وجوی دیتابیس…" : "Search databases…")" />
        </label>
        @if (!quickStartOpen)
        {
            @* Do-not-change item 23: closing the rail's only panel folds it away entirely (Task 7),
               so this is the way back — outside the rail, in the list's own toolbar. *@
            <form asp-controller="Account" asp-action="SetRail" method="post" class="inline" data-rail-action="SetRail">
                @Html.AntiForgeryToken()
                <input type="hidden" name="panel" value="QuickStart" />
                <input type="hidden" name="open" value="true" />
                <input type="hidden" name="returnUrl" value="@here" />
                <button type="submit" class="btn-secondary" title="@(isFa ? "نمایش پنل کناری" : "Show side panel")">
                    <i data-lucide="panel-right" class="h-4 w-4"></i>@(isFa ? "پنل کناری" : "Side panel")
                </button>
            </form>
        }
    </div>

    @if (Model.Databases.Count == 0)
    {
        <div class="empty-state min-h-[24rem]">
            <span class="empty-state-icon"><i data-lucide="database-zap" class="h-6 w-6"></i></span>
            <h2>@T["No services yet"]</h2>
            <p>@(isFa ? "یک دیتابیس مدیریت‌شده با رمز، شبکه خصوصی و فضای پایدار بسازید." : "Provision a managed database with credentials, private networking and persistent storage.")</p>
            <a href="/databases/create" class="btn-primary">@T["Create Service"]</a>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="resource-table min-w-[1000px]">
                <thead><tr>
                    <th>@T["Databases"]</th><th>@(isFa ? "پروژه / محیط" : "Project / environment")</th>
                    <th>@T["Status"]</th><th>@(isFa ? "فضای مصرفی" : "Storage")</th>
                    <th>@T["CPU"]</th><th>@T["Memory"]</th><th>@(isFa ? "اپ‌های متصل" : "Linked apps")</th>
                    <th>@T["Backups"]</th><th></th>
                </tr></thead>
                <tbody id="databaseRows">
                @foreach (var database in Model.Databases)
                {
                    <tr class="database-row @(selected?.Database.Id == database.Id ? "is-selected" : "")"
                        data-name="@($"{database.Name} {database.Type} {database.Project} {database.Environment}".ToLowerInvariant())">
                        <td><a href="/databases/@database.Id" class="resource-identity">
                            <partial name="Design/_TemplateLogo" model="@(new TemplateLogoModel(TypeKey(database.Type), database.Name))" />
                            <span><strong>@database.Name</strong><small>@database.Type · @database.Version</small></span>
                        </a></td>
                        <td><div class="table-primary">@database.Project</div><div class="table-secondary">@database.Environment</div></td>
                        <td><span class="resource-status @Tone(database.Status)"><i></i>@database.Status</span></td>
                        <td><div class="table-primary">@Gb(database.StorageBytes)</div><div class="table-secondary">@(database.StorageMeasuredAt is null ? (isFa ? "اندازه‌گیری نشده" : "not measured") : database.StorageMeasuredAt.Value.LocalDateTime.ToString(Dates.Stamp))</div></td>
                        <td>
                            <div class="metric-reading">@(database.CpuPercent is null ? "—" : $"{database.CpuPercent:0.#}%")</div>
                            @if (database.CpuPercent is not null)
                            {
                                <span class="metric-track"><i style="width:@CssPercent(database.CpuPercent)%"></i></span>
                            }
                        </td>
                        <td>
                            @* Read against what the database was allotted. The sample alone said
                               nothing about whether it is running out. *@
                            @{ var memory = Harbora.Infrastructure.Monitoring.AllocationReading.Of(database.MemoryBytes, database.MemoryLimitBytes); }
                            <div class="metric-reading" dir="ltr">
                                @Gb(database.MemoryBytes)@(database.MemoryLimitBytes > 0 ? $" / {Gb(database.MemoryLimitBytes)}" : "")
                            </div>
                            @if (memory.HasShare)
                            {
                                <span class="metric-track"><i style="width:@memory.Percent%"></i></span>
                                <span class="table-secondary">
                                    @(memory.IsOver
                                        ? (isFa ? "بالاتر از سقف" : "over its limit")
                                        : (isFa ? $"٪{memory.Percent} از تخصیص" : $"{memory.Percent}% of allocation"))
                                </span>
                            }
                            else
                            {
                                <span class="table-secondary">
                                    @(database.MemoryBytes is null
                                        ? (isFa ? "هنوز اندازه‌گیری نشده" : "Not measured yet")
                                        : (isFa ? "بدون سقف حافظه" : "No memory ceiling"))
                                </span>
                            }
                        </td>
                        <td><span class="linked-count"><i data-lucide="boxes" class="h-3.5 w-3.5"></i>@database.LinkedApps</span></td>
                        <td>
                            @if (database.LastBackupAt is { } backupAt)
                            { <div class="table-primary">@database.LastBackupStatus</div><div class="table-secondary">@backupAt.LocalDateTime.ToString(Dates.Stamp)</div> }
                            else { <span class="table-secondary">@(isFa ? "بدون پشتیبان" : "No backup")</span> }
                        </td>
                        <td><a href="/databases/@database.Id" class="icon-button" aria-label="@(isFa ? "جزئیات" : "Details")"><i data-lucide="chevron-right" class="h-4 w-4 rtl:rotate-180"></i></a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="resource-footer"><span id="databaseResultCount">@Model.Databases.Count</span> @(isFa ? "دیتابیس" : "databases")</div>
        <div id="noDatabaseMatch" class="hidden p-10 text-center text-sm text-ink-faint">@(isFa ? "دیتابیسی پیدا نشد." : "No databases match.")</div>
    }
</section>

@if (selected?.Backups.Count > 0)
{
    <section class="resource-shell mt-5">
        <div class="section-heading border-b border-line p-4"><div><h2><i data-lucide="history" class="h-4 w-4"></i>@(isFa ? "تاریخچه پشتیبان" : "Backup history")</h2><p>@selected.Database.Name</p></div><a href="/backups">@(isFa ? "همه پشتیبان‌ها" : "View all backups")</a></div>
        <div class="overflow-x-auto"><table class="resource-table min-w-[620px]"><thead><tr><th>@(isFa ? "زمان" : "Date")</th><th>@(isFa ? "نوع" : "Type")</th><th>@(isFa ? "حجم" : "Size")</th><th>@T["Status"]</th><th>@(isFa ? "بررسی بازیابی" : "Restore verification")</th></tr></thead><tbody>
        @foreach (var backup in selected.Backups)
        {
            <tr><td class="table-primary">@backup.At.LocalDateTime.ToString(Dates.Stamp)</td><td>@(backup.IsScheduled ? (isFa ? "خودکار" : "Scheduled") : (isFa ? "دستی" : "Manual"))</td><td>@Gb(backup.SizeBytes)</td><td><span class="resource-status @(backup.Status == BackupStatus.Completed ? "is-ok" : backup.Status == BackupStatus.Failed ? "is-danger" : "is-info")"><i></i>@backup.Status</span></td><td>@(backup.VerifiedRestorable switch { true => isFa ? "تأیید شده" : "Verified", false => isFa ? "نامعتبر" : "Failed", _ => isFa ? "بررسی نشده" : "Not verified" })</td></tr>
        }
        </tbody></table></div>
    </section>
}

@section RightRail {
    @* A list's rail offers the next action. A resource's own settings live on its own page — a rail
       is only ever as wide as what is left over, and that is the wrong place for the controls
       somebody came to use.

       Drawn only while its one panel is open (Task 7) — closed, the section renders nothing and
       _Layout draws no column for it. The toolbar's own reopen control, above, is do-not-change item
       23's way back for that case; the heading's own toggle below is the way to fold it again. *@
    @if (quickStartOpen)
    {
    <section class="rail-panel">
        <div class="rail-heading">
            <div><span>@(isFa ? "ساخت سریع" : "Quick provision")</span><small>@(isFa ? "موتورهای پشتیبانی‌شده" : "Supported engines")</small></div>
            <form asp-controller="Account" asp-action="SetRail" method="post" class="inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="panel" value="QuickStart" />
                <input type="hidden" name="open" value="false" />
                <input type="hidden" name="returnUrl" value="@here" />
                <button type="submit" class="rail-toggle" title="@(isFa ? "بستن" : "Hide")" aria-expanded="true">
                    <i data-lucide="chevron-up" class="h-4 w-4"></i>
                </button>
            </form>
        </div>
        <div class="quick-start-grid mt-3">
            @foreach (var item in Model.Catalog)
            {
                <a href="/databases/create?type=@item.Type" class="quick-start-item">
                    <partial name="Design/_TemplateLogo" model="@(new TemplateLogoModel(TypeKey(item.Type), isFa ? item.DisplayNameFa : item.DisplayName))" />
                    <span><strong>@(isFa ? item.DisplayNameFa : item.DisplayName)</strong><small>@item.Versions.FirstOrDefault()</small></span>
                </a>
            }
        </div>
    </section>
    }
}

@section Scripts {
<script>
(() => {
    const rows = Array.from(document.querySelectorAll('.database-row'));
    const search = document.getElementById('databaseSearch');
    const count = document.getElementById('databaseResultCount');
    const empty = document.getElementById('noDatabaseMatch');
    function apply() {
        const query = (search?.value || '').trim().toLowerCase();
        let shown = 0;
        rows.forEach(row => {
            const visible = !query || row.dataset.name.includes(query);
            row.classList.toggle('hidden', !visible);
            if (visible) shown++;
        });
        if (count) count.textContent = String(shown);
        empty?.classList.toggle('hidden', shown !== 0);
    }
    search?.addEventListener('input', apply);
    document.querySelector('[data-copy-connection]')?.addEventListener('click', async button => {
        const value = document.getElementById('databaseConnection')?.textContent || '';
        await navigator.clipboard.writeText(value);
        button.classList.add('text-ok');
        setTimeout(() => button.classList.remove('text-ok'), 900);
    });
})();
</script>
}
