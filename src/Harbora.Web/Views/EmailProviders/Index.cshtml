@model EmailProvidersPageViewModel
@{
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var message = TempData["Message"] as string;
    var error = TempData["Error"] as string;
}

<partial name="Design/_PageHeader" model="@(new PageHeaderModel(
    isFa ? "ارائه‌دهنده‌های SMTP" : "SMTP providers",
    isFa
        ? "اعتبارنامهٔ SMTP خودتان برای اپ‌های شما. Harbora رمز را رمزنگاری و ذخیره می‌کند و آن را به‌صورت متغیرهای SMTP_* به اپ متصل تزریق می‌کند — بدون رله؛ کانتینر اپ مستقیماً با میزبان شما صحبت می‌کند. برای محیط‌های غیرتولیدی، الگوی «صندوق توسعه» (Mailpit) را از فروشگاه قالب‌ها مستقر کنید تا بدون ارائه‌دهندهٔ واقعی ببینید اپ چه چیزی می‌فرستد."
        : "Your own SMTP credentials, for your apps. Harbora encrypts and stores the password and injects it into an attached app as SMTP_* env vars — no relay in front of it; the app's own container speaks directly to your host. For non-production environments, deploy the 'Dev Inbox' (Mailpit) template from the marketplace to see what an app tried to send without a real provider."))" />

@if (message is not null) { <div class="alert-success mb-4">@message</div> }
@if (error is not null) { <div class="alert-danger mb-4">@error</div> }

@if (Model.Providers.Count == 0)
{
    <partial name="Design/_EmptyState" model="@(new EmptyStateModel("mail",
        isFa ? "هنوز ارائه‌دهنده‌ای اضافه نشده." : "No email providers yet."))" />
}
else
{
    <div class="mb-6 space-y-3">
        @foreach (var provider in Model.Providers)
        {
            <section class="rounded-xl border border-line bg-surface p-5 shadow-panel" data-email-provider="@provider.Name" data-email-provider-id="@provider.Id">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2">
                            <strong class="text-sm text-ink">@provider.Name</strong>
                            <span class="text-xs text-ink-faint" dir="ltr">@provider.Host:@provider.Port</span>
                        </div>
                        <p class="mt-1 text-xs text-ink-faint" dir="ltr">
                            @(isFa ? "فرستنده:" : "From:")
                            @(string.IsNullOrWhiteSpace(provider.FromName) ? provider.FromAddress : $"{provider.FromName} <{provider.FromAddress}>")
                        </p>

                        @* Three states, never a fabricated pass: not tested / last test failed / last test worked. *@
                        @if (provider.LastTestSucceeded is null)
                        {
                            <p class="mt-1 text-[11px] text-ink-faint" data-email-provider-test-state="untested">
                                @(isFa ? "هنوز آزمایش نشده." : "Not tested yet.")
                            </p>
                        }
                        else if (provider.LastTestSucceeded == true)
                        {
                            <p class="mt-1 text-[11px] text-ok" data-email-provider-test-state="ok">
                                @(isFa ? "آخرین آزمایش موفق بود" : "Last test succeeded")
                                @if (provider.LastTestedAt is { } at) { <span class="text-ink-faint">· @at.LocalDateTime.ToString(Dates.Stamp)</span> }
                            </p>
                        }
                        else
                        {
                            <p class="mt-1 text-[11px] text-danger" data-email-provider-test-state="failed">
                                @(isFa ? "آخرین آزمایش شکست خورد: " : "Last test failed: ")<span dir="ltr">@provider.LastTestMessage</span>
                                @if (provider.LastTestedAt is { } at) { <span class="text-ink-faint">· @at.LocalDateTime.ToString(Dates.Stamp)</span> }
                            </p>
                        }
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                        <form asp-action="TestSend" asp-route-id="@provider.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button class="btn-secondary px-3 py-1.5 text-xs" data-email-provider-test-button>
                                @(isFa ? "ارسال آزمایشی" : "Send test")
                            </button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@provider.Id" method="post"
                              onsubmit="return confirm('@(isFa ? "ارائه‌دهنده حذف شود؟" : "Delete this email provider?")');">
                            @Html.AntiForgeryToken()
                            <button class="btn-secondary px-3 py-1.5 text-xs">@(isFa ? "حذف" : "Delete")</button>
                        </form>
                    </div>
                </div>

                <dl class="mt-4 grid gap-3 border-t border-line pt-3 text-xs sm:grid-cols-3">
                    <div>
                        <dt class="text-ink-faint">@(isFa ? "نام کاربری" : "Username")</dt>
                        <dd class="text-ink" dir="ltr"><code>@(string.IsNullOrEmpty(provider.Username) ? "—" : provider.Username)</code></dd>
                    </div>
                    <div>
                        <dt class="text-ink-faint">@(isFa ? "رمز" : "Password")</dt>
                        <dd class="text-ink" dir="ltr">
                            @if (provider.Password is { } secret)
                            {
                                <code>@secret</code>
                            }
                            else
                            {
                                @* One at a time, and only on a click — a page that prints every secret
                                   is a page nobody can screen-share (the StorageController rule). *@
                                <a href="/email-providers?reveal=@provider.Id" class="text-accent-text hover:underline">
                                    @(isFa ? "نمایش" : "Reveal")
                                </a>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt class="text-ink-faint">TLS</dt>
                        <dd class="text-ink">@(provider.UseSsl ? (isFa ? "بله" : "Yes") : (isFa ? "خیر" : "No"))</dd>
                    </div>
                </dl>

                @* ---- attach to app ----
                   F6 (2026-08-21 functions-and-services plan): the StorageController bucket-attach
                   shape (F5), reused — the six SMTP_* variables reach the app's environment on its
                   own next deploy. *@
                <div class="mt-4 border-t border-line pt-3" data-email-provider-attach-panel data-email-provider-id="@provider.Id">
                    <div class="flex items-center justify-between gap-2 mb-2">
                        <span class="text-xs font-semibold text-ink-muted">@(isFa ? "اپ‌های متصل" : "Attached apps")</span>
                    </div>

                    @if (provider.AttachedApps.Count == 0)
                    {
                        <p class="text-xs text-ink-faint">@(isFa ? "به هیچ اپی متصل نیست." : "Not attached to any app.")</p>
                    }
                    else
                    {
                        <div class="space-y-1.5">
                            @foreach (var a in provider.AttachedApps)
                            {
                                <div class="flex items-center justify-between gap-2 rounded-lg bg-surface-2 px-3 py-1.5 text-xs" data-attached-app="@a.AppName">
                                    <span>
                                        <span class="font-medium">@a.AppName</span>
                                        @if (a.HasUnpublishedChanges)
                                        {
                                            <span data-email-provider-attach-state="unpublished" class="ms-1 rounded-md bg-warn-soft px-1.5 py-0.5 text-warn">@(isFa ? "با استقرار بعدی اعمال می‌شود" : "applies on next deploy")</span>
                                        }
                                        else
                                        {
                                            <span data-email-provider-attach-state="live" class="ms-1 rounded-md bg-ok-soft px-1.5 py-0.5 text-ok">@(isFa ? "به‌روز" : "live")</span>
                                        }
                                    </span>
                                    <form asp-action="Detach" asp-route-id="@provider.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="appId" value="@a.AppId" />
                                        <button class="text-danger" aria-label="@(isFa ? $"جدا کردن {a.AppName}" : $"Detach {a.AppName}")">✕</button>
                                    </form>
                                </div>
                            }
                        </div>
                    }

                    @if (provider.AvailableApps.Count > 0)
                    {
                        <form asp-action="Attach" asp-route-id="@provider.Id" method="post" class="mt-2 flex gap-2">
                            @Html.AntiForgeryToken()
                            <select name="appId" class="flex-1 rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-xs">
                                @foreach (var a in provider.AvailableApps)
                                {
                                    <option value="@a.Id">@a.Name</option>
                                }
                            </select>
                            <button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-3 py-1.5 text-xs font-semibold">
                                @(isFa ? "اتصال" : "Attach")
                            </button>
                        </form>
                    }
                </div>
            </section>
        }
    </div>
}

<section class="rounded-xl border border-line bg-surface p-5">
    <h2 class="text-[15px] font-semibold text-ink mb-3">@(isFa ? "ارائه‌دهندهٔ جدید" : "New email provider")</h2>

    <form asp-action="Create" method="post" class="grid gap-4 sm:grid-cols-2">
        @Html.AntiForgeryToken()
        <div>
            <label class="form-label" for="ep-name">@(isFa ? "نام" : "Name")</label>
            <input id="ep-name" name="name" required class="form-control" placeholder="SendGrid" />
        </div>
        <div>
            <label class="form-label" for="ep-host">@(isFa ? "میزبان SMTP" : "SMTP host")</label>
            <input id="ep-host" name="host" required class="form-control font-mono" dir="ltr" placeholder="smtp.sendgrid.net" />
        </div>
        <div>
            <label class="form-label" for="ep-port">@(isFa ? "پورت" : "Port")</label>
            <input id="ep-port" name="port" type="number" min="1" max="65535" required class="form-control font-mono" dir="ltr" value="587" />
        </div>
        <div class="flex items-end gap-2 pb-2">
            <input id="ep-ssl" name="useSsl" type="checkbox" value="true" checked class="h-4 w-4" />
            <label for="ep-ssl" class="form-label !mb-0">@(isFa ? "TLS/SSL" : "TLS/SSL")</label>
        </div>
        <div>
            <label class="form-label" for="ep-user">@(isFa ? "نام کاربری" : "Username")</label>
            <input id="ep-user" name="username" class="form-control font-mono" dir="ltr" placeholder="apikey" />
        </div>
        <div>
            <label class="form-label" for="ep-pass">@(isFa ? "رمز" : "Password")</label>
            <input id="ep-pass" name="password" type="password" class="form-control font-mono" dir="ltr" autocomplete="new-password" />
        </div>
        <div>
            <label class="form-label" for="ep-from">@(isFa ? "آدرس فرستنده" : "From address")</label>
            <input id="ep-from" name="fromAddress" type="email" required class="form-control font-mono" dir="ltr" placeholder="noreply@example.com" />
        </div>
        <div>
            <label class="form-label" for="ep-fromname">@(isFa ? "نام فرستنده (اختیاری)" : "From name (optional)")</label>
            <input id="ep-fromname" name="fromName" class="form-control" placeholder="Acme" />
        </div>

        <div class="sm:col-span-2">
            <button class="btn-primary px-4 py-2">@(isFa ? "ساخت ارائه‌دهنده" : "Create provider")</button>
        </div>
    </form>
</section>
