@model List<Harbora.Domain.Servers.Server>
@{
    ViewData["Title"] = "Servers";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var msg = TempData["Message"] as string; var err = TempData["Error"] as string;
    var caps = ViewBag.Capacities as Dictionary<Guid, Harbora.Application.Abstractions.NodeCapacity> ?? new();
    string Gb(long b) => b <= 0 ? "—" : $"{b / 1024.0 / 1024 / 1024:0.0} GB";
    string Pct(double used, double alloc) => alloc <= 0 ? "0" : Math.Min(100, used / alloc * 100).ToString("0");
    string BarColor(double used, double alloc) => alloc > 0 && used / alloc >= 0.9 ? "bg-danger" : alloc > 0 && used / alloc >= 0.7 ? "bg-warn" : "bg-ok";
    string StatusClass(Harbora.Domain.Common.ServerStatus s) => s switch
    {
        Harbora.Domain.Common.ServerStatus.Online => "bg-ok/15 text-ok",
        Harbora.Domain.Common.ServerStatus.Offline => "bg-danger/15 text-danger",
        Harbora.Domain.Common.ServerStatus.Degraded => "bg-warn/15 text-warn",
        _ => "bg-slate-500/15 text-ink"
    };
}
<h1 class="text-2xl font-bold tracking-tight text-ink mb-6">@(isFa ? "سرورها" : "Servers")</h1>

@if (msg is not null){<div class="mb-4 rounded-lg bg-ok-soft border border-ok text-ok px-4 py-2 text-sm">@msg</div>}
@if (err is not null){<div class="mb-4 rounded-lg bg-danger-soft border border-danger text-danger px-4 py-2 text-sm">@err</div>}

<div class="grid lg:grid-cols-3 gap-6">
    <section class="lg:col-span-2 space-y-4">
        @if (Model.Count == 0)
        {
            <div class="rounded-xl border border-line bg-surface">
                <partial name="Design/_EmptyState" model="@(new EmptyStateModel("server",
                    isFa ? "هنوز سروری ثبت نشده. از فرم کنار همین صفحه یک سرور اضافه کنید." : "No servers registered yet. Add one from the form beside this page."))" />
            </div>
        }
        @foreach (var s in Model)
        {
            <div class="rounded-xl border border-line bg-surface p-5">
                <div class="flex items-center justify-between">
                    <div>
                        <div class="font-semibold text-lg flex items-center gap-2">
                            @s.Name
                            @if (s.IsLocal){<span class="text-xs rounded bg-surface-2 px-2 py-0.5 text-ink">local</span>}
                        </div>
                        <div class="text-sm text-ink-muted">@s.Hostname @(s.DockerVersion is not null ? "· Docker " + s.DockerVersion : "")</div>
                    </div>
                    <span class="rounded-full px-2.5 py-0.5 text-xs font-medium @StatusClass(s.Status)">@s.Status</span>
                </div>
                <div class="mt-3 grid grid-cols-3 gap-3 text-sm">
                    <div><div class="text-ink-faint text-xs">CPU</div>@(s.CpuCores > 0 ? s.CpuCores + " cores" : "—")</div>
                    <div><div class="text-ink-faint text-xs">Memory</div>@Gb(s.TotalMemoryBytes)</div>
                    <div><div class="text-ink-faint text-xs">Disk</div>@Gb(s.TotalDiskBytes)</div>
                </div>

                @{ var cap = caps.GetValueOrDefault(s.Id); }
                @if (cap is not null && (cap.AllocatableMemoryBytes > 0 || cap.AllocatableCpu > 0))
                {
                    <div class="mt-3 space-y-2">
                        <div>
                            <div class="flex justify-between text-xs text-ink-faint mb-1">
                                <span>@(isFa ? "حافظه‌ی متعهد" : "Committed memory") · @cap.AppCount @(isFa ? "اپ" : "apps")</span>
                                <span>@Gb(cap.CommittedMemoryBytes) / @Gb(cap.AllocatableMemoryBytes) · @(isFa ? "آزاد" : "free") @Gb(cap.FreeMemoryBytes)</span>
                            </div>
                            <div class="h-1.5 rounded-full bg-surface-2 overflow-hidden">
                                <div class="h-full @BarColor(cap.CommittedMemoryBytes, cap.AllocatableMemoryBytes)" style="width:@Pct(cap.CommittedMemoryBytes, cap.AllocatableMemoryBytes)%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-xs text-ink-faint mb-1">
                                <span>@(isFa ? "پردازنده‌ی متعهد" : "Committed CPU")</span>
                                <span>@cap.CommittedCpu.ToString("0.##") / @cap.AllocatableCpu.ToString("0.##") vCPU</span>
                            </div>
                            <div class="h-1.5 rounded-full bg-surface-2 overflow-hidden">
                                <div class="h-full @BarColor(cap.CommittedCpu, cap.AllocatableCpu)" style="width:@Pct(cap.CommittedCpu, cap.AllocatableCpu)%"></div>
                            </div>
                        </div>
                    </div>
                }
                <div class="mt-3 flex items-center gap-2">
                    <a href="/servers/@s.Id/test" class="text-xs rounded-lg bg-surface-2 hover:bg-surface-2 px-3 py-1.5">@(isFa ? "تست اتصال" : "Test")</a>
                    @if (!s.IsLocal)
                    {
                        <form asp-controller="Servers" asp-action="Remove" asp-route-id="@s.Id" method="post" onsubmit="return confirm('@(isFa ? "حذف سرور؟" : "Remove server?")')">
                            @Html.AntiForgeryToken()
                            <button class="text-xs rounded-lg bg-danger-soft hover:bg-danger-soft text-danger px-3 py-1.5">@(isFa ? "حذف" : "Remove")</button>
                        </form>
                    }
                    @if (s.LastHeartbeatAt is not null){<span class="text-xs text-ink-faint">@(isFa ? "آخرین ضربان:" : "last seen") @s.LastHeartbeatAt.Value.LocalDateTime.ToString(Dates.Stamp)</span>}
                </div>
            </div>
        }
    </section>

    <section class="rounded-xl border border-line bg-surface p-5 h-fit">
        <h2 class="text-[15px] font-semibold text-ink mb-3">@(isFa ? "افزودن سرور" : "Add a server")</h2>
        <form asp-controller="Servers" asp-action="Add" method="post" class="space-y-3">
            @Html.AntiForgeryToken()
            <input name="name" placeholder="Name (e.g. node-2)" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            <input name="agentEndpoint" placeholder="http://node-2:9700" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            <input name="token" type="password" placeholder="Agent token" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="useMtls" value="true" data-mtls> @(isFa ? "استفاده از mTLS" : "Use mTLS")</label>
            <textarea name="clientCertPfxBase64" data-mtls-field placeholder="@(isFa ? "گواهی کلاینت (PFX با base64)" : "Client cert (PFX, base64)")" rows="3" style="display:none" class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-xs font-mono"></textarea>
            <button class="w-full rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm font-semibold">@(isFa ? "افزودن و تست" : "Add & test")</button>
        </form>
        <script>
            (function(){ var cb=document.querySelector('[data-mtls]'); var f=document.querySelector('[data-mtls-field]');
                if(cb&&f) cb.addEventListener('change',function(){ f.style.display=cb.checked?'':'none'; }); })();
        </script>
        <p class="mt-3 text-xs text-ink-faint">
            @(isFa
                ? "روی نود مقصد، Harbora Agent را با همین توکن اجرا کنید (پورت پیش‌فرض ۹۷۰۰)."
                : "Run the Harbora Agent on the target node with this token (default port 9700).")
        </p>
    </section>
</div>
