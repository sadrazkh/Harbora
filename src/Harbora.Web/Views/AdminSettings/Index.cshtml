@model AdminSettingsViewModel
@{
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var message = TempData["Message"] as string;

    // Chosen first and in order, then the rest. The form reads top to bottom the way the dashboard
    // will read left to right.
    var ordered = Model.Featured
        .Select(key => Model.Templates.First(t => t.Key == key))
        .Concat(Model.Templates.Where(t => !Model.Featured.Contains(t.Key)))
        .ToList();
}

<partial name="Design/_PageHeader" model="@(new PageHeaderModel(
    isFa ? "تنظیمات پلتفرم" : "Platform settings",
    isFa
        ? "چیزهایی که برای همه تغییر می‌کنند. تنظیمات شخصی هر کاربر جای دیگری است."
        : "The settings that change the platform for everybody. Personal preferences live elsewhere."))" />

@if (message is not null)
{
    <div class="alert-success mb-4">@message</div>
}

<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="space-y-6">
        @{ var featuredPanel = new PanelModel(isFa ? "اپ‌های آماده روی داشبورد" : "Ready apps on the dashboard"); }
        <partial name="Design/_PanelStart" model="featuredPanel" />

        <p class="mb-4 text-sm leading-6 text-ink-muted">
            @(isFa
                ? $"کدام اپ‌ها اول دیده شوند و به چه ترتیبی. حداکثر {Model.FeaturedSlots} تا. اگر هیچ‌کدام را تیک نزنید، همان ترتیب الفبایی قبلی می‌ماند."
                : $"Which applications people see first, and in what order. Up to {Model.FeaturedSlots}. Tick none and the previous alphabetical order stays.")
        </p>

        <form asp-action="SaveFeatured" method="post">
            @Html.AntiForgeryToken()

            @* The order is the order these post in, which is the order they are listed. Dragging
               would be nicer and is not worth a dependency for a list of this size. *@
            <div class="grid gap-2 sm:grid-cols-2">
                @foreach (var template in ordered)
                {
                    var chosen = Model.Featured.Contains(template.Key);
                    <label class="flex items-center gap-3 rounded-xl border @(chosen ? "border-accent/40 bg-accent-soft" : "border-line bg-surface-2") p-3">
                        <input type="checkbox" name="keys" value="@template.Key" checked="@chosen"
                               class="h-4 w-4 rounded border-line-strong text-accent" />
                        <partial name="Design/_TemplateLogo" model="@(new TemplateLogoModel(template.Key, isFa && !string.IsNullOrWhiteSpace(template.NameFa) ? template.NameFa : template.Name))" />
                        <span class="min-w-0">
                            <strong class="block truncate text-sm text-ink">@(isFa && !string.IsNullOrWhiteSpace(template.NameFa) ? template.NameFa : template.Name)</strong>
                            <small class="text-[11px] text-ink-faint">@template.Category</small>
                        </span>
                    </label>
                }
            </div>

            <button class="btn-primary mt-4">@(isFa ? "ذخیره" : "Save")</button>
        </form>
        <partial name="Design/_PanelEnd" />

        @{ var defaultsPanel = new PanelModel(isFa ? "پیش‌فرض‌های پنل" : "Panel defaults"); }
        <partial name="Design/_PanelStart" model="defaultsPanel" />

        <form asp-action="SavePanel" method="post" class="grid gap-4 sm:grid-cols-2">
            @Html.AntiForgeryToken()

            <div>
                <label class="form-label" for="default-mode">@(isFa ? "حالت پیش‌فرض پنل" : "Default panel mode")</label>
                <select id="default-mode" name="defaultMode" class="form-control">
                    <option value="">@(isFa ? "بر اساس نقش کاربر" : "Decided by the person's role")</option>
                    <option value="Simple" selected="@(Model.DefaultPanelMode == "Simple")">@(isFa ? "ساده" : "Simple")</option>
                    <option value="Advanced" selected="@(Model.DefaultPanelMode == "Advanced")">@(isFa ? "پیشرفته" : "Advanced")</option>
                </select>
                <p class="mt-1 text-xs text-ink-faint">
                    @(isFa
                        ? "فقط برای کسانی که خودشان انتخابی نکرده‌اند. انتخاب شخصی همیشه بر این مقدم است."
                        : "Only for people who have not chosen. A personal choice always wins over this.")
                </p>
            </div>

            <div>
                <label class="form-label" for="default-culture">@(isFa ? "زبان پیش‌فرض" : "Default language")</label>
                <select id="default-culture" name="defaultCulture" class="form-control">
                    <option value="">@(isFa ? "فارسی (پیش‌فرض سیستم)" : "Persian (system default)")</option>
                    <option value="fa" selected="@(Model.DefaultCulture == "fa")">فارسی</option>
                    <option value="en" selected="@(Model.DefaultCulture == "en")">English</option>
                </select>
            </div>

            @* The side panels on the applications page. Only for people who have not chosen — a
               person's own toggle always wins, and stays with them across devices. *@
            <div>
                <label class="form-label" for="quickstart-default">@(isFa ? "«شروع سریع» به‌صورت پیش‌فرض" : "Quick start panel by default")</label>
                <select id="quickstart-default" name="quickStartDefault" class="form-control">
                    <option value="">@(isFa ? "بسته (پیش‌فرض Harbora)" : "Closed (Harbora's default)")</option>
                    <option value="true" selected="@(Model.QuickStartDefault == true)">@(isFa ? "باز" : "Open")</option>
                    <option value="false" selected="@(Model.QuickStartDefault == false)">@(isFa ? "بسته" : "Closed")</option>
                </select>
                <p class="mt-1 text-xs text-ink-faint">
                    @(isFa
                        ? "قفسهٔ اپ‌های آماده. وقتی بسته باشد فقط لوگوها دیده می‌شوند، نه اینکه ناپدید شود."
                        : "The ready-made apps shelf. Closed shows the marks only — it is folded, never removed.")
                </p>
            </div>

            <div>
                <label class="form-label" for="overview-default">@(isFa ? "«نمای کلی» به‌صورت پیش‌فرض" : "Overview panel by default")</label>
                <select id="overview-default" name="overviewDefault" class="form-control">
                    <option value="">@(isFa ? "باز (پیش‌فرض Harbora)" : "Open (Harbora's default)")</option>
                    <option value="true" selected="@(Model.OverviewDefault == true)">@(isFa ? "باز" : "Open")</option>
                    <option value="false" selected="@(Model.OverviewDefault == false)">@(isFa ? "بسته" : "Closed")</option>
                </select>
            </div>

            <div class="sm:col-span-2">
                <button class="btn-primary">@(isFa ? "ذخیره" : "Save")</button>
            </div>
        </form>
        <partial name="Design/_PanelEnd" />

        @{ var resourcePanel = new PanelModel(isFa ? "پیش‌فرض منابع" : "Resource defaults"); }
        <partial name="Design/_PanelStart" model="resourcePanel" />

        <form asp-action="SaveResources" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label class="form-label" for="default-size">@(isFa ? "اندازهٔ پیش‌فرض" : "Default instance size")</label>
                <select id="default-size" name="defaultSize" class="form-control">
                    <option value="">@(isFa ? "هیچ‌کدام (بدون سقف)" : "None (no ceiling)")</option>
                    @foreach (var size in Model.Sizes)
                    {
                        <option value="@size.Key" selected="@(size.Key == Model.DefaultInstanceSize)">
                            @Harbora.Infrastructure.Tenancy.InstanceSizeLabel.For(size.Name, size.CpuCores, size.MemoryBytes, size.DiskBytes)
                        </option>
                    }
                </select>
                <p class="mt-1 text-xs text-ink-faint">
                    @(isFa
                        ? "روی فرم ساخت اپ و دیتابیس از پیش انتخاب می‌شود. تا الان هیچ پیش‌فرضی نبود و همه‌چیز از «بدون سقف» شروع می‌کرد."
                        : "Preselected on the application and database create forms. There was no default, so everything started at \"no ceiling\".")
                </p>
            </div>

            <label class="flex items-start gap-3 rounded-xl border border-line bg-surface-2 p-3">
                <input type="checkbox" name="previewsDefault" value="true" checked="@Model.PreviewsDefault"
                       class="mt-0.5 h-4 w-4 rounded border-line-strong text-accent" />
                <span>
                    <span class="block text-sm font-medium text-ink">@(isFa ? "محیط Preview به‌صورت پیش‌فرض روشن" : "Branch previews on by default")</span>
                    <span class="mt-1 block text-xs leading-5 text-ink-faint">
                        @(isFa
                            ? "فقط برای اپ‌هایی که از Git می‌آیند. سکرت‌ها هیچ‌وقت به Preview کپی نمی‌شوند."
                            : "Only for Git-backed applications. Secrets are never copied into a preview.")
                    </span>
                </span>
            </label>

            <button class="btn-primary">@(isFa ? "ذخیره" : "Save")</button>
        </form>
        <partial name="Design/_PanelEnd" />

        @{ var platformPanel = new PanelModel(isFa ? "هویت پلتفرم" : "Platform identity"); }
        <partial name="Design/_PanelStart" model="platformPanel" />

        <form asp-action="SavePlatform" method="post" class="space-y-3">
            @Html.AntiForgeryToken()
            <div>
                <label class="form-label" for="platform-name">@(isFa ? "نام پلتفرم" : "Platform name")</label>
                <input id="platform-name" name="platformName" value="@Model.PlatformName" class="form-control" />
            </div>
            <button class="btn-primary">@(isFa ? "ذخیره" : "Save")</button>
        </form>
        <partial name="Design/_PanelEnd" />

        @{ var smtpPanel = new PanelModel(isFa ? "ایمیل خروجی (SMTP)" : "Outgoing email (SMTP)"); }
        <partial name="Design/_PanelStart" model="smtpPanel" />

        @* The account the panel itself sends from: password resets, invitations, and the fallback
           for alert channels that name no server of their own. *@
        <form asp-action="SaveSmtp" method="post" class="space-y-3">
            @Html.AntiForgeryToken()
            <div class="grid gap-3 sm:grid-cols-2">
                <div>
                    <label class="form-label" for="smtp-host">@(isFa ? "میزبان" : "Host")</label>
                    <input id="smtp-host" name="host" value="@Model.SmtpHost" placeholder="smtp.example.com" class="form-control" dir="ltr" />
                </div>
                <div>
                    <label class="form-label" for="smtp-port">@(isFa ? "پورت" : "Port")</label>
                    <input id="smtp-port" name="port" type="number" min="1" max="65535" value="@Model.SmtpPort" class="form-control" dir="ltr" />
                </div>
                <div>
                    <label class="form-label" for="smtp-user">@(isFa ? "نام کاربری" : "Username")</label>
                    <input id="smtp-user" name="user" value="@Model.SmtpUser" autocomplete="off" class="form-control" dir="ltr" />
                </div>
                <div>
                    <label class="form-label" for="smtp-pass">@(isFa ? "رمز" : "Password")</label>
                    <input id="smtp-pass" name="password" type="password" autocomplete="new-password"
                           placeholder="@(Model.SmtpHasPassword ? (isFa ? "ذخیره شده — برای تغییر بنویسید" : "stored — type to change") : "")"
                           class="form-control" dir="ltr" />
                </div>
                <div>
                    <label class="form-label" for="smtp-from">@(isFa ? "فرستنده (From)" : "From address")</label>
                    <input id="smtp-from" name="from" value="@Model.SmtpFrom" placeholder="harbora@example.com" class="form-control" dir="ltr" />
                </div>
                <label class="flex items-center gap-2 self-end pb-2 text-sm">
                    <input type="checkbox" name="useSsl" value="true" @(Model.SmtpUseSsl ? "checked" : "") />
                    <span>TLS/SSL</span>
                </label>
            </div>
            <button class="btn-primary">@(isFa ? "ذخیره" : "Save")</button>
        </form>

        @* Through exactly the path every real email takes — a test that cannot say no is not a test. *@
        <form asp-action="TestSmtp" method="post" class="mt-2">
            @Html.AntiForgeryToken()
            <button class="rounded-lg bg-surface-2 hover:bg-surface-2 px-4 py-2 text-sm">@(isFa ? "ارسال ایمیل آزمایشی" : "Send a test email")</button>
        </form>
        <partial name="Design/_PanelEnd" />

        @{ var ssoPanel = new PanelModel(isFa ? "ورود با سرویس‌های دیگر" : "External sign-in"); }
        <partial name="Design/_PanelStart" model="ssoPanel" />

        <p class="mb-4 text-sm leading-6 text-ink-muted">
            @(isFa
                ? "تا وقتی شناسه و کلید یک سرویس پر نشده باشد، دکمه‌اش در صفحهٔ ورود دیده نمی‌شود. نشانی بازگشت را در پنل خود آن سرویس ثبت کنید."
                : "A provider shows no button on the sign-in page until its client id and secret are both filled in. Register the redirect address below in the provider's own console.")
        </p>

        <div class="space-y-4">
            @foreach (var sso in Model.Sso)
            {
                var isOidc = sso.Provider == Harbora.Domain.Identity.ExternalLoginProviders.Oidc;
                <form asp-action="SaveSso" method="post" class="rounded-xl border border-line bg-surface-2 p-4 space-y-3"
                      data-sso-provider="@sso.Provider">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="provider" value="@sso.Provider" />

                    <div class="flex items-center justify-between gap-3">
                        <strong class="text-sm text-ink">@sso.Name</strong>
                        @* Three states, not two: off, on-and-working, and on-but-incomplete. The
                           third is the one a single "enabled" pill would report as working. *@
                        @if (!sso.Enabled)
                        {
                            <span class="text-[11px] text-ink-faint">@(isFa ? "خاموش" : "off")</span>
                        }
                        else if (sso.IsConfigured)
                        {
                            <span class="text-[11px] text-ok">@(isFa ? "روشن" : "on")</span>
                        }
                        else
                        {
                            <span class="text-[11px] text-warn">@(isFa ? "ناقص — دکمه‌ای نشان داده نمی‌شود" : "incomplete — no button is shown")</span>
                        }
                    </div>

                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" name="enabled" value="true" @(sso.Enabled ? "checked" : "") />
                        <span>@(isFa ? "فعال" : "Enabled")</span>
                    </label>

                    <div class="grid gap-3 sm:grid-cols-2">
                        <div>
                            <label class="form-label" for="sso-@(sso.Provider)-id">@(isFa ? "شناسهٔ کلاینت" : "Client id")</label>
                            <input id="sso-@(sso.Provider)-id" name="clientId" value="@sso.ClientId"
                                   autocomplete="off" class="form-control font-mono" dir="ltr" />
                        </div>
                        <div>
                            <label class="form-label" for="sso-@(sso.Provider)-secret">@(isFa ? "کلید کلاینت" : "Client secret")</label>
                            @* Never rendered back, only reported as stored — the same rule the SMTP
                               password follows. Blank keeps whatever is already there. *@
                            <input id="sso-@(sso.Provider)-secret" name="clientSecret" type="password"
                                   autocomplete="new-password" class="form-control" dir="ltr"
                                   data-sso-has-secret="@(sso.HasSecret ? "true" : "false")"
                                   placeholder="@(sso.HasSecret ? (isFa ? "ذخیره شده — برای تغییر بنویسید" : "stored — type to change") : "")" />
                        </div>

                        @if (isOidc)
                        {
                            <div>
                                <label class="form-label" for="sso-oidc-authority">@(isFa ? "نشانی صادرکننده (Authority)" : "Authority")</label>
                                <input id="sso-oidc-authority" name="authority" value="@sso.Authority"
                                       placeholder="https://sso.example.com" class="form-control font-mono" dir="ltr" />
                                <small class="mt-1 block text-[11px] text-ink-faint">
                                    @(isFa
                                        ? "باید https باشد؛ سند discovery از همین نشانی خوانده می‌شود."
                                        : "Must be https; the discovery document is read from it.")
                                </small>
                            </div>
                            <div>
                                <label class="form-label" for="sso-oidc-name">@(isFa ? "نامی که روی دکمه بیاید" : "Name on the button")</label>
                                <input id="sso-oidc-name" name="displayName" value="@sso.DisplayName"
                                       placeholder="@(isFa ? "ورود یکپارچه" : "Single sign-on")" class="form-control" />
                            </div>
                        }
                    </div>

                    <div>
                        <span class="form-label">@(isFa ? "نشانی بازگشت" : "Redirect address")</span>
                        <code class="block break-all rounded bg-code text-code-ink px-3 py-2 text-xs" dir="ltr">@sso.RedirectUri</code>
                    </div>

                    <button class="btn-primary">@(isFa ? "ذخیره" : "Save")</button>
                </form>
            }
        </div>
        <partial name="Design/_PanelEnd" />

        @{ var updatePanel = new PanelModel(isFa ? "به‌روزرسانی Harbora" : "Harbora updates"); }
        <partial name="Design/_PanelStart" model="updatePanel" />

        <form asp-action="SaveUpdateCheck" method="post" class="space-y-3">
            @Html.AntiForgeryToken()
            <label class="flex items-start gap-2 text-sm">
                <input type="checkbox" name="updateCheck" value="true" @(Model.UpdateCheckEnabled ? "checked" : "") class="mt-1" />
                <span>
                    @(isFa ? "روزی یک‌بار بپرس نسخهٔ تازه‌تری منتشر شده یا نه" : "Ask once a day whether a newer release exists")
                    <span class="mt-1 block text-xs leading-5 text-ink-faint">
                        @* Off by default and stated plainly: this is a request that leaves the server. *@
                        @(isFa
                            ? "یک درخواست خروجی به GitHub. چیزی خودکار نصب نمی‌شود — فقط روی داشبورد خبر می‌دهد."
                            : "One outbound request to GitHub. Nothing is installed automatically — it only puts a note on the dashboard.")
                    </span>
                </span>
            </label>
            <div class="text-xs text-ink-faint" dir="ltr">
                @(isFa ? "نسخهٔ در حال اجرا:" : "Running:") @(Model.RunningVersion ?? "—")
                @if (Model.LatestReleaseTag is { Length: > 0 } tag)
                {
                    <span>· @(isFa ? "آخرین منتشرشده:" : "latest seen:") @tag</span>
                }
            </div>
            <button class="btn-primary">@(isFa ? "ذخیره" : "Save")</button>
        </form>
        <partial name="Design/_PanelEnd" />
    </div>

    <aside class="space-y-6">
        @{ var elsewherePanel = new PanelModel(isFa ? "جاهای دیگر" : "Elsewhere"); }
        <partial name="Design/_PanelStart" model="elsewherePanel" />

        @* Linked rather than duplicated. A second control for the same setting is a second place it
           can disagree with itself. *@
        <div class="space-y-3 text-sm">
            <a href="/admin/templates" class="flex items-center justify-between gap-2 rounded-lg border border-line bg-surface-2 p-3 hover:border-accent/40">
                <span>
                    <strong class="block text-ink">@(isFa ? "نسخه‌های قالب" : "Template versions")</strong>
                    <small class="text-[11px] text-ink-faint">
                        @(isFa ? "انتشار نسخه‌ها و بررسی رجیستری" : "Publishing versions and registry checks")
                    </small>
                </span>
                <span class="status-pill @(Model.RegistryDiscoveryEnabled ? "bg-ok-soft text-ok" : "bg-surface-2 text-ink-faint")">
                    @(Model.RegistryDiscoveryEnabled ? (isFa ? "روشن" : "on") : (isFa ? "خاموش" : "off"))
                </span>
            </a>

            <a href="/admin/ai" class="block rounded-lg border border-line bg-surface-2 p-3 hover:border-accent/40">
                <strong class="block text-ink">@(isFa ? "مدیریت هوش مصنوعی" : "AI administration")</strong>
                <small class="text-[11px] text-ink-faint">
                    @(isFa ? "ارائه‌دهنده‌ها، توکن‌ها، مدل‌ها و پلن‌ها" : "Providers, tokens, models and plans")
                </small>
            </a>

            <a href="/plans" class="block rounded-lg border border-line bg-surface-2 p-3 hover:border-accent/40">
                <strong class="block text-ink">@(isFa ? "پلن‌ها و سهمیه‌ها" : "Plans and quotas")</strong>
                <small class="text-[11px] text-ink-faint">
                    @(isFa ? "حافظه، CPU، دیسک و اندازه‌های مجاز" : "Memory, CPU, disk and allowed sizes")
                </small>
            </a>

            <a href="/admin/cloudflare" class="block rounded-lg border border-line bg-surface-2 p-3 hover:border-accent/40">
                <strong class="block text-ink">Cloudflare</strong>
                <small class="text-[11px] text-ink-faint">
                    @(isFa ? "توکن، DNS Proxied، Full (strict) و تمدید DNS-01" : "Token, proxied DNS, Full (strict), and DNS-01 renewal")
                </small>
            </a>

            <a href="/users" class="block rounded-lg border border-line bg-surface-2 p-3 hover:border-accent/40">
                <strong class="block text-ink">@(isFa ? "کاربران و تیم" : "Users & Team")</strong>
                <small class="text-[11px] text-ink-faint">
                    @(isFa ? "دعوت، نقش‌ها، تعلیق و بازیابی دسترسی" : "Invites, roles, suspension, and account recovery")
                </small>
            </a>

            <a href="/settings" class="block rounded-lg border border-line bg-surface-2 p-3 hover:border-accent/40">
                <strong class="block text-ink">@(isFa ? "دامنه، SSL و توکن‌ها" : "Domain, SSL and tokens")</strong>
                <small class="text-[11px] text-ink-faint">
                    @(isFa ? "تنظیماتی که همان‌جا مانده‌اند" : "The settings that stayed there")
                </small>
            </a>
        </div>
        <partial name="Design/_PanelEnd" />

        @* ---- the optional modules ----
           Both are complete and both are off unless configuration says otherwise, and an off module
           contributes no sidebar entry at all. From inside the panel there is no way to tell that
           apart from a feature that was never built, so it is said here. *@
        @{ var modulePanel = new PanelModel(isFa ? "ماژول‌های اختیاری" : "Optional modules"); }
        <partial name="Design/_PanelStart" model="modulePanel" />

        <div class="space-y-3 text-sm">
            @foreach (var module in new[]
            {
                (Name: isFa ? "همگام‌سازی فایل" : "File sync",
                 On: Model.SyncEnabled,
                 Key: "Features:Sync",
                 Needs: isFa
                    ? "به یک موتور Syncthing روی همین میزبان و فهرست مسیرهای مجاز نیاز دارد. تا وقتی روشن نشده، بخش استوریج در منو ظاهر نمی‌شود."
                    : "Needs a Syncthing engine on this host and an allow-list of directories. Until it is on, the storage section is absent from the menu.",
                 Href: "/sync"),
                (Name: isFa ? "پشتیبان‌گیری" : "Backups",
                 On: Model.BackupEnabled,
                 Key: "Features:Backup",
                 Needs: isFa
                    ? "به مقصد پشتیبان و موتور آن نیاز دارد."
                    : "Needs a backup destination and its engine.",
                 Href: "/backups")
            })
            {
                <div class="rounded-lg border border-line bg-surface-2 p-3">
                    <div class="flex items-center justify-between gap-2">
                        <strong class="text-ink">@module.Name</strong>
                        <span class="status-pill @(module.On ? "bg-ok-soft text-ok" : "bg-surface-2 text-ink-faint")">
                            @(module.On ? (isFa ? "روشن" : "on") : (isFa ? "خاموش" : "off"))
                        </span>
                    </div>
                    @if (module.On)
                    {
                        <a href="@module.Href" class="mt-1 block text-[11px] text-accent-text hover:underline">
                            @(isFa ? "بازکردن" : "Open") @module.Href
                        </a>
                    }
                    else
                    {
                        <p class="mt-1 text-[11px] leading-5 text-ink-faint">@module.Needs</p>
                        <code dir="ltr" class="mt-1 block text-[11px] text-ink-muted">@module.Key = true</code>
                    }
                </div>
            }
        </div>
        <partial name="Design/_PanelEnd" />
    </aside>
</div>
