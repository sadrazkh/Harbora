@model WorkspaceHubViewModel
@using Harbora.Domain.Common
@using Harbora.Web.ViewModels
@{
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var message = TempData["Message"] as string;
    var error = TempData["Error"] as string;
    var invitationLink = TempData["InvitationLink"] as string;
    var currentMember = Model.Members.FirstOrDefault(m => m.IsCurrentUser);
}

<partial name="Design/_PageHeader" model="@(new PageHeaderModel(
    isFa ? "ورک‌اسپیس‌ها و اعضا" : "Workspaces & members",
    isFa ? "فضای شخصی خودتان را نگه دارید، تیم بسازید و بین همهٔ فضاهایی که عضو هستید جابه‌جا شوید." : "Keep a personal space, create teams, and switch between every workspace you belong to."))" />

@* Where a customer goes to check whether anybody from the platform has been inside this workspace.
   Beside the members list on purpose: it answers the same question — who can reach this — about the
   one set of people who never appear on that list. *@
<p class="mb-1 text-sm">
    <a class="text-accent-text" href="/workspaces/support-access">
        @(isFa ? "دسترسی پشتیبانی به این فضای کاری" : "Support access to this workspace")
    </a>
</p>

@* HARBORA-0056: this workspace's own slice of the audit trail — separate from support access above,
   which only ever shows a support session's own acts. *@
<p class="mb-4 text-sm">
    <a class="text-accent-text" href="/workspaces/audit-log">
        @(isFa ? "لاگ رویدادهای این فضای کاری" : "Audit log for this workspace")
    </a>
</p>

@if (message is not null) { <div class="alert-success mb-4">@message</div> }
@if (error is not null) { <div class="alert-danger mb-4">@error</div> }
@if (invitationLink is not null)
{
    <div class="mb-4 rounded-xl border border-warn/30 bg-warn-soft p-4 text-sm text-warn">
        <strong class="block">@(isFa ? "لینک دعوت؛ فقط همین بار کپی کنید" : "Invitation link — copy it now")</strong>
        <div class="mt-2 flex gap-2" dir="ltr">
            <input value="@invitationLink" readonly class="form-control font-mono text-xs" onclick="this.select()" />
            <button type="button" class="btn-secondary" onclick="navigator.clipboard.writeText(this.previousElementSibling.value)">@(isFa ? "کپی" : "Copy")</button>
        </div>
    </div>
}

<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="space-y-6">
        <partial name="Design/_PanelStart" model="@(new PanelModel(isFa ? "فضاهای من" : "My workspaces"))" />
        <div class="grid gap-3 md:grid-cols-2">
            @foreach (var workspace in Model.Workspaces)
            {
                <div class="rounded-xl border @(workspace.ArchivedAt is not null ? "border-warn/40 bg-warn-soft" : workspace.IsCurrent ? "border-accent bg-accent-soft" : "border-line bg-surface-2") p-4">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <strong class="block truncate text-ink">@workspace.Name</strong>
                            <small class="font-mono text-ink-faint" dir="ltr">@workspace.Slug</small>
                            @if (workspace.ArchivedAt is not null)
                            {
                                <small class="mt-1 block text-warning">@(isFa ? "بایگانی‌شده" : "Archived")</small>
                            }
                        </div>
                        <span class="status-pill bg-surface text-ink-muted">@(workspace.IsPersonal ? (isFa ? "شخصی" : "personal") : workspace.Role.ToString())</span>
                    </div>
                    <div class="mt-3 flex items-end justify-between gap-3">
                        <div>
                            <small class="block text-ink-faint">@(isFa ? "موجودی" : "Balance")</small>
                            <strong dir="ltr" class="text-sm">@(workspace.BalanceMinor is { } balance ? MinorUnits.Format(balance, workspace.Currency) : "—")</strong>
                        </div>
                        @if (!workspace.IsCurrent && workspace.ArchivedAt is null)
                        {
                            <form asp-action="Switch" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="workspaceId" value="@workspace.Id" />
                                <input type="hidden" name="returnUrl" value="/workspaces" />
                                <button class="btn-secondary">@(isFa ? "ورود" : "Switch")</button>
                            </form>
                        }
                        else if (workspace.IsCurrent)
                        {
                            <span class="text-xs font-medium text-accent-text">@(isFa ? "فعال" : "current")</span>
                        }
                    </div>
                    @if (workspace.IsOwner && !workspace.IsPersonal)
                    {
                        <div class="mt-3 border-t border-line pt-3">
                            @if (workspace.ArchivedAt is null)
                            {
                                <form asp-action="Archive" asp-route-id="@workspace.Id" method="post" class="flex gap-2"
                                      onsubmit="return confirm('@(isFa ? "فضای کاری و منابع در حال اجرا بایگانی و متوقف شوند؟" : "Archive this workspace and stop its running resources?")');">
                                    @Html.AntiForgeryToken()
                                    <input name="confirmation" required class="form-control py-1 text-xs" dir="ltr" placeholder="@workspace.Slug" />
                                    <button class="btn-secondary py-1 text-warning">@(isFa ? "بایگانی" : "Archive")</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Recover" asp-route-id="@workspace.Id" method="post" class="mb-2">
                                    @Html.AntiForgeryToken()
                                    <button class="btn-secondary w-full py-1 text-ok">@(isFa ? "بازیابی و راه‌اندازی مجدد" : "Recover and restart")</button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@workspace.Id" method="post" class="flex gap-2"
                                      onsubmit="return confirm('@(isFa ? "این حذف از پنل قابل بازگشت نیست. ادامه می‌دهید؟" : "This deletion cannot be undone from the panel. Continue?")');">
                                    @Html.AntiForgeryToken()
                                    <input name="confirmation" required class="form-control py-1 text-xs" dir="ltr" placeholder="@workspace.Slug" />
                                    <button class="rounded-lg border border-danger/30 px-2 py-1 text-xs text-danger">@(isFa ? "حذف نهایی" : "Delete")</button>
                                </form>
                                <p class="mt-1 text-[10px] text-ink-faint">@(isFa ? "حذف نهایی ۲۴ ساعت پس از بایگانی فعال می‌شود." : "Final deletion unlocks 24 hours after archive.")</p>
                            }
                        </div>
                    }
                </div>
            }
        </div>
        <partial name="Design/_PanelEnd" />

        <partial name="Design/_PanelStart" model="@(new PanelModel(isFa ? $"اعضای {Model.CurrentWorkspaceName}" : $"Members of {Model.CurrentWorkspaceName}"))" />
        <div class="divide-y divide-line">
            @foreach (var member in Model.Members)
            {
                <div class="flex flex-wrap items-center justify-between gap-3 py-3 first:pt-0 last:pb-0">
                    <div>
                        <strong class="block text-sm text-ink">@member.DisplayName @(member.IsCurrentUser ? (isFa ? "(شما)" : "(you)") : "")</strong>
                        <small class="text-ink-faint" dir="ltr">@member.Email</small>
                    </div>
                    <div class="flex items-center gap-2">
                        @if (Model.CanManageCurrent && !member.IsOwner)
                        {
                            <form asp-action="ChangeMemberRole" asp-route-userId="@member.UserId" method="post" class="flex gap-1">
                                @Html.AntiForgeryToken()
                                <select name="role" class="form-control py-1 text-xs">
                                    @foreach (var role in Enum.GetValues<WorkspaceRole>())
                                    { <option value="@role" selected="@(role == member.Role)">@role</option> }
                                </select>
                                <button class="btn-secondary py-1">@(isFa ? "ذخیره" : "Save")</button>
                            </form>
                            <form asp-action="RemoveMember" asp-route-userId="@member.UserId" method="post" onsubmit="return confirm('@(isFa ? "این عضو حذف شود؟" : "Remove this member?")');">
                                @Html.AntiForgeryToken()
                                <button class="rounded-lg border border-danger/30 px-2 py-1 text-xs text-danger">@(isFa ? "حذف" : "Remove")</button>
                            </form>
                        }
                        else
                        {
                            <span class="status-pill bg-surface-2 text-ink-muted">@(member.IsOwner ? (isFa ? "مالک" : "owner") : member.Role.ToString())</span>
                        }
                    </div>
                    @if (Model.CanManageCurrent && !member.IsOwner && member.Role != WorkspaceRole.Admin)
                    {
                        <div class="w-full rounded-lg border border-line bg-surface-2 p-3 text-xs">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <span class="text-ink-muted">@(isFa ? "دامنه دسترسی پروژه" : "Project access scope")</span>
                                <form asp-action="SetMemberScope" asp-route-userId="@member.UserId" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="scoped" value="@((!member.ScopedToProjects).ToString().ToLowerInvariant())" />
                                    <button class="btn-secondary py-1">
                                        @(member.ScopedToProjects
                                            ? (isFa ? "دسترسی به همه پروژه‌ها" : "Allow every project")
                                            : (isFa ? "محدود به پروژه‌های انتخابی" : "Limit to selected projects"))
                                    </button>
                                </form>
                            </div>
                            @if (member.ScopedToProjects)
                            {
                                <div class="mt-2 space-y-1">
                                    @foreach (var grant in Model.Grants.Where(g => g.UserId == member.UserId))
                                    {
                                        <div class="flex items-center justify-between gap-2">
                                            <span>@grant.Description</span>
                                            <form asp-action="RemoveProjectGrant" asp-route-grantId="@grant.Id" method="post">
                                                @Html.AntiForgeryToken()<button class="text-danger">@(isFa ? "حذف" : "Remove")</button>
                                            </form>
                                        </div>
                                    }
                                </div>
                                <form asp-action="AddProjectGrant" asp-route-userId="@member.UserId" method="post" class="mt-3 grid gap-2 md:grid-cols-4">
                                    @Html.AntiForgeryToken()
                                    <select name="projectId" class="form-control py-1" required>
                                        @foreach (var project in Model.Projects) { <option value="@project.Id">@project.Name</option> }
                                    </select>
                                    <select name="environmentId" class="form-control py-1">
                                        <option value="">@(isFa ? "کل پروژه" : "Whole project")</option>
                                        @foreach (var project in Model.Projects)
                                        {
                                            <optgroup label="@project.Name">
                                                @foreach (var environment in project.Environments) { <option value="@environment.Id">@environment.Name</option> }
                                            </optgroup>
                                        }
                                    </select>
                                    <select name="role" class="form-control py-1"><option value="Member">Member</option><option value="Operator">Operator</option><option value="Viewer">Viewer</option></select>
                                    <button class="btn-secondary py-1">@(isFa ? "افزودن مجوز" : "Add grant")</button>
                                </form>
                            }
                        </div>
                    }
                </div>
            }
        </div>
        <partial name="Design/_PanelEnd" />

        @if (Model.CanManageCurrent && Model.Invitations.Count > 0)
        {
            <partial name="Design/_PanelStart" model="@(new PanelModel(isFa ? "دعوت‌های در انتظار" : "Pending invitations"))" />
            <div class="divide-y divide-line text-sm">
                @foreach (var invitation in Model.Invitations)
                {
                    <div class="flex items-center justify-between gap-3 py-2 first:pt-0 last:pb-0">
                        <div><span dir="ltr">@invitation.Email</span><small class="ms-2 text-ink-faint">@invitation.Role · @invitation.ExpiresAt.LocalDateTime.ToString(Dates.Day)</small></div>
                        <form asp-action="RevokeInvitation" asp-route-id="@invitation.Id" method="post">
                            @Html.AntiForgeryToken()<button class="text-xs text-danger">@(isFa ? "لغو" : "Revoke")</button>
                        </form>
                    </div>
                }
            </div>
            <partial name="Design/_PanelEnd" />
        }
    </div>

    <aside class="space-y-6">
        <partial name="Design/_PanelStart" model="@(new PanelModel(isFa ? "ورک‌اسپیس تازه" : "New workspace"))" />
        <form asp-action="Create" method="post" class="space-y-3">
            @Html.AntiForgeryToken()
            <div><label class="form-label">@(isFa ? "نام تیم یا پروژه" : "Team or project name")</label><input name="name" required maxlength="128" class="form-control" /></div>
            <button class="btn-primary w-full">@(isFa ? "ساخت ورک‌اسپیس" : "Create workspace")</button>
        </form>
        <partial name="Design/_PanelEnd" />

        @if (Model.CanManageCurrent)
        {
            <partial name="Design/_PanelStart" model="@(new PanelModel(isFa ? "دعوت عضو" : "Invite member"))" />
            <form asp-action="Invite" method="post" class="space-y-3">
                @Html.AntiForgeryToken()
                <div><label class="form-label">Email</label><input name="email" type="email" required class="form-control" dir="ltr" /></div>
                <div><label class="form-label">@(isFa ? "نقش" : "Role")</label><select name="role" class="form-control"><option value="Member">Member</option><option value="Operator">Operator</option><option value="Admin">Admin</option><option value="Viewer">Viewer</option></select></div>
                <button class="btn-primary w-full">@(isFa ? "ساخت و ارسال دعوت" : "Create & send invitation")</button>
                <p class="text-xs leading-5 text-ink-faint">@(isFa ? "اگر SMTP تنظیم نباشد، لینک یک‌بار نمایش داده می‌شود تا خودتان بفرستید." : "Without SMTP, a one-time link is shown for you to send manually.")</p>
            </form>
            <partial name="Design/_PanelEnd" />

            @if (!Model.CurrentIsPersonal && currentMember?.IsOwner == true)
            {
                <partial name="Design/_PanelStart" model="@(new PanelModel(isFa ? "انتقال مالکیت" : "Transfer ownership"))" />
                <form asp-action="TransferOwnership" method="post" class="space-y-3" onsubmit="return confirm('@(isFa ? "مالکیت منتقل شود؟" : "Transfer workspace ownership?")');">
                    @Html.AntiForgeryToken()
                    <select name="userId" class="form-control" required>
                        @foreach (var member in Model.Members.Where(m => !m.IsOwner)) { <option value="@member.UserId">@member.DisplayName (@member.Email)</option> }
                    </select>
                    <button class="btn-secondary w-full">@(isFa ? "انتقال مالکیت" : "Transfer ownership")</button>
                </form>
                <partial name="Design/_PanelEnd" />

                @* Owner-only: an admin who is not the owner is never exempt from this setting, so
                   letting them flip it on could lock themselves and every other admin out at once —
                   see WorkspacesController.SetRequiresSingleSignOn. *@
                <partial name="Design/_PanelStart" model="@(new PanelModel(isFa ? "الزام ورود یکپارچه" : "Require single sign-on"))" />
                <div class="space-y-3 text-sm" data-sso-required="@Model.RequiresSingleSignOn.ToString().ToLowerInvariant()">
                    <p class="text-ink-muted">
                        @(isFa
                            ? "وقتی روشن باشد، اعضای این فضای کاری فقط با سرویس ورود یکپارچه وارد می‌شوند؛ ورود با رمز برای آن‌ها رد می‌شود."
                            : "When on, members of this workspace sign in only through single sign-on; a password sign-in is refused for them.")
                    </p>
                    <p class="rounded-lg border border-line bg-surface-2 p-2 text-xs text-ink-faint" data-sso-owner-exempt="true">
                        @(isFa
                            ? "شما به‌عنوان مالک این فضای کاری همیشه از این الزام معاف هستید — در غیر این صورت، یک سرویس ازکارافتاده می‌توانست همه را برای همیشه بیرون از پنل نگه دارد، بدون کسی که بتواند این تنظیم را دوباره خاموش کند."
                            : "As this workspace's owner, you are always exempt from this requirement — otherwise a provider that stops working could lock everyone out permanently, with nobody left able to switch it back off.")
                    </p>

                    @if (!Model.SsoProviderConfigured)
                    {
                        <p class="rounded-lg border border-warn/30 bg-warn-soft p-2 text-xs text-warn" data-sso-no-provider="true">
                            @(isFa
                                ? "هنوز هیچ سرویس ورود یکپارچه‌ای در تنظیمات پلتفرم پیکربندی نشده است؛ پیش از الزامی‌کردن، یکی را تنظیم کنید."
                                : "No single sign-on provider is configured in platform settings yet. Configure one before requiring it.")
                        </p>
                    }

                    @if (!Model.RequiresSingleSignOn && Model.UnlinkedMembers.Count > 0)
                    {
                        <div class="rounded-lg border border-warn/30 bg-warn-soft p-3 text-xs" data-sso-unlinked-count="@Model.UnlinkedMembers.Count">
                            <strong class="block text-warn">
                                @(isFa
                                    ? "این اعضا هنوز هیچ سرویسی وصل نکرده‌اند:"
                                    : "These members have not connected a provider yet:")
                            </strong>
                            <ul class="mt-1 space-y-0.5">
                                @foreach (var unlinked in Model.UnlinkedMembers)
                                {
                                    <li data-sso-unlinked-member="@unlinked.Email">@unlinked.DisplayName — <span dir="ltr">@unlinked.Email</span></li>
                                }
                            </ul>
                            <p class="mt-1 text-ink-faint">
                                @(isFa
                                    ? "آن‌ها همچنان می‌توانند وارد شوند: دکمهٔ سرویس ورود یکپارچه یک‌بار رمز فعلی‌شان را می‌پرسد و همان ورود، حساب را برای دفعات بعد وصل می‌کند."
                                    : "They can still sign in: the provider button offers to confirm their current password once, and that same sign-in connects the account for next time.")
                            </p>
                        </div>
                    }

                    <form asp-action="SetRequiresSingleSignOn" method="post"
                          onsubmit="return confirm('@(Model.RequiresSingleSignOn
                              ? (isFa ? "الزام ورود یکپارچه برداشته شود؟" : "Turn off the single sign-on requirement?")
                              : (isFa ? "ورود یکپارچه برای همهٔ اعضا (به‌جز شما) الزامی شود؟" : "Require single sign-on for every member except you?"))');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="required" value="@((!Model.RequiresSingleSignOn).ToString().ToLowerInvariant())" />
                        <button class="btn-secondary w-full" data-sso-toggle="@((!Model.RequiresSingleSignOn).ToString().ToLowerInvariant())">
                            @(Model.RequiresSingleSignOn
                                ? (isFa ? "غیرفعال‌کردن الزام" : "Turn off requirement")
                                : (isFa ? "الزامی‌کردن ورود یکپارچه" : "Require single sign-on"))
                        </button>
                    </form>
                </div>
                <partial name="Design/_PanelEnd" />
            }
        }

        @if (!Model.CurrentIsPersonal && currentMember?.IsOwner != true)
        {
            <form asp-action="Leave" method="post" onsubmit="return confirm('@(isFa ? "از فضای کاری خارج شوید؟" : "Leave this workspace?")');">
                @Html.AntiForgeryToken()
                <button class="w-full rounded-lg border border-danger/30 px-3 py-2 text-sm text-danger">@(isFa ? "خروج از فضای کاری" : "Leave workspace")</button>
            </form>
        }
    </aside>
</div>
