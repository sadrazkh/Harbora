@model TemplateCatalogPageViewModel
@using Harbora.Domain.Templates
@using Harbora.Infrastructure.Templates
@using Harbora.Web.ViewModels
@{
    ViewData["Title"] = "Templates";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var msg = TempData["Message"] as string;
    var err = TempData["Error"] as string;

    string Category(string value) => (value.ToLowerInvariant(), isFa) switch
    {
        ("cms", true) => "مدیریت محتوا", ("cms", false) => "Content",
        ("observability", true) => "پایش", ("observability", false) => "Observability",
        ("developer-tools", true) => "ابزار توسعه", ("developer-tools", false) => "Developer tools",
        ("data", true) => "داده و جست‌وجو", ("data", false) => "Data & search",
        ("starter", true) => "شروع با کد", ("starter", false) => "Code starters",
        ("database", true) => "دیتابیس", ("database", false) => "Databases",
        (_, _) => value
    };

    string Glyph(string key) => key switch
    {
        "wordpress" => "W", "ghost" => "G", "uptime-kuma" => "U", "meilisearch" => "M",
        "redis-commander" => "R", "nginx-static" => "N", "node" => "JS", "aspnet" => ".N",
        "laravel" => "L", "postgres" => "PG", "mariadb" => "M", "mysql" => "MY",
        "redis" => "R", "mongodb" => "MO", _ => (key.Length > 1 ? key[..2] : key).ToUpperInvariant()
    };
}

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div class="max-w-2xl">
        <div class="mb-2 inline-flex items-center gap-2 rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent-text">
            <i data-lucide="sparkles" class="h-3.5 w-3.5"></i>
            @(isFa ? "کاتالوگ راه‌حل‌های آماده" : "Solution marketplace")
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-ink">@(isFa ? "از ایده تا پروژهٔ در حال اجرا" : "From idea to running project")</h1>
        <p class="mt-1 text-sm leading-6 text-ink-muted">
            @(isFa
                ? "هر قالب دقیقاً نشان می‌دهد چه برنامه، دیتابیس، فضای ذخیره‌سازی و متغیرهایی می‌سازد؛ Harbora همه را در یک شبکهٔ خصوصی راه‌اندازی می‌کند."
                : "Every template shows the applications, databases, storage and variables it creates. Harbora provisions the complete stack on one private network.")
        </p>
    </div>
    <a href="#create-template" class="btn-secondary inline-flex items-center gap-2">
        <i data-lucide="plus" class="h-4 w-4"></i>
        @(isFa ? "قالب شخصی" : "Private template")
    </a>
</div>

@if (msg is not null) { <div class="alert-success mb-4">@msg</div> }
@if (err is not null) { <div class="alert-danger mb-4">@err</div> }

<section class="mb-5 rounded-2xl border border-line bg-surface p-4 shadow-panel">
    <form method="get" action="/templates" class="flex flex-col gap-3 lg:flex-row lg:items-center">
        <label class="relative min-w-0 flex-1">
            <i data-lucide="search" class="pointer-events-none absolute inset-y-0 start-3 my-auto h-4 w-4 text-ink-faint"></i>
            <input name="q" value="@Model.Query" type="search"
                   placeholder="@(isFa ? "جست‌وجوی WordPress، دیتابیس، پایش…" : "Search WordPress, database, monitoring…")"
                   class="form-control ps-9" />
        </label>
        <div class="flex gap-2 overflow-x-auto pb-1 lg:pb-0">
            <a href="/templates@(string.IsNullOrWhiteSpace(Model.Query) ? "" : $"?q={Uri.EscapeDataString(Model.Query)}")"
               class="filter-chip @(string.IsNullOrWhiteSpace(Model.Category) && string.IsNullOrWhiteSpace(Model.Scope) ? "is-active" : "")">
                @(isFa ? "همه" : "All")
            </a>
            <a href="/templates?scope=featured" class="filter-chip @(Model.Scope == "featured" ? "is-active" : "")">
                <i data-lucide="star" class="h-3.5 w-3.5"></i> @(isFa ? "پیشنهادی" : "Featured")
            </a>
            @foreach (var category in Model.Categories)
            {
                <a href="/templates?category=@Uri.EscapeDataString(category)" class="filter-chip @(Model.Category == category ? "is-active" : "")">
                    @Category(category)
                </a>
            }
        </div>
    </form>
</section>

@if (Model.Items.Count == 0)
{
    <div class="empty-state rounded-2xl border border-dashed border-line-strong bg-surface">
        <span class="empty-state-icon"><i data-lucide="search-x" class="h-6 w-6"></i></span>
        <h2>@(isFa ? "قالبی پیدا نشد" : "No templates found")</h2>
        <p>@(isFa ? "عبارت یا دسته‌بندی را تغییر دهید." : "Try a different search or category.")</p>
        <a href="/templates" class="btn-secondary">@(isFa ? "پاک‌کردن فیلترها" : "Clear filters")</a>
    </div>
}
else
{
    <div class="grid gap-4 md:grid-cols-2 2xl:grid-cols-3">
        @foreach (var item in Model.Items)
        {
            var template = item.Template;
            <article class="template-card group">
                <div class="flex items-start justify-between gap-3">
                    <div class="flex min-w-0 items-center gap-3">
                        <span class="template-logo" data-template-key="@template.Key">@Glyph(template.Key)</span>
                        <div class="min-w-0">
                            <h2 class="truncate text-[15px] font-semibold text-ink">@item.Name</h2>
                            <div class="mt-0.5 flex flex-wrap items-center gap-1.5 text-[11px] text-ink-faint">
                                <span>@Category(template.Category)</span>
                                <span aria-hidden="true">·</span>
                                <span>@(item.ResourceCount) @(isFa ? "منبع" : item.ResourceCount == 1 ? "resource" : "resources")</span>
                            </div>
                        </div>
                    </div>
                    @if (item.Manifest.Featured)
                    {
                        <span class="status-pill bg-warn-soft text-warn"><i data-lucide="star" class="h-3 w-3"></i>@(isFa ? "پیشنهادی" : "Featured")</span>
                    }
                </div>

                <p class="mt-4 line-clamp-2 min-h-10 text-sm leading-5 text-ink-muted">@item.Description</p>

                <div class="mt-4 flex min-h-6 flex-wrap gap-1.5">
                    @foreach (var tag in item.Manifest.Tags.Take(4))
                    {
                        <span class="template-tag">@tag</span>
                    }
                </div>

                <div class="mt-5 rounded-xl border border-line bg-surface-2 p-3">
                    <div class="flex items-center justify-between gap-3 text-xs">
                        <span class="flex items-center gap-1.5 text-ink-muted">
                            <i data-lucide="@((item.IsManagedService ? "database" : item.NeedsRepository ? "git-branch" : "box"))" class="h-3.5 w-3.5 text-accent-text"></i>
                            @(item.IsManagedService
                                ? (isFa ? "سرویس مدیریت‌شده" : "Managed service")
                                : item.NeedsRepository
                                    ? (isFa ? "ساخت از مخزن شما" : "Builds your repository")
                                    : (isFa ? "ایمیج آماده" : "Prebuilt image"))
                        </span>
                        <span class="flex items-center gap-1.5 font-medium text-ok">
                            <i data-lucide="shield-check" class="h-3.5 w-3.5"></i>
                            @(template.IsBuiltIn ? (isFa ? "بررسی‌شده" : "Reviewed") : TemplateCatalog.Describe(template))
                        </span>
                    </div>
                    @if (item.Manifest.Requires.Count > 0)
                    {
                        <div class="mt-2 flex items-center gap-1.5 border-t border-line pt-2 text-xs text-ink-muted">
                            <i data-lucide="network" class="h-3.5 w-3.5 text-accent-text"></i>
                            @(isFa ? "همراه با" : "Includes") @string.Join(" + ", item.Manifest.Requires.Select(x => x.ToUpperInvariant()))
                        </div>
                    }
                </div>

                <div class="mt-4 flex items-center gap-2">
                    <a href="/templates/@template.Id" class="btn-secondary flex-1 text-center">@(isFa ? "جزئیات" : "Details")</a>
                    <a href="/templates/@template.Id/deploy" class="btn-primary flex-1 text-center">
                        @(item.IsManagedService ? (isFa ? "ساخت دیتابیس" : "Provision") : (isFa ? "استقرار" : "Deploy"))
                    </a>
                </div>
            </article>
        }
    </div>
}

@if (Model.Reviewing.Count > 0)
{
    <section class="mt-8 rounded-2xl border border-warn/30 bg-warn-soft p-5">
        <div class="mb-4 flex items-center gap-2 text-warn">
            <i data-lucide="shield-alert" class="h-5 w-5"></i>
            <h2 class="font-semibold">@(isFa ? "صف بررسی امنیتی" : "Security review queue")</h2>
        </div>
        <div class="space-y-3">
            @foreach (var template in Model.Reviewing)
            {
                <details class="rounded-xl border border-line bg-surface p-4">
                    <summary class="cursor-pointer font-medium text-ink">@template.Name <span class="text-xs text-ink-faint">· @template.Category</span></summary>
                    <pre dir="ltr" class="mt-3 max-h-48 overflow-auto rounded-xl bg-code p-3 text-[11px] text-code-ink whitespace-pre-wrap">@template.ManifestJson</pre>
                    <form asp-controller="Templates" asp-action="Review" asp-route-id="@template.Id" method="post" class="mt-3 flex flex-wrap gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@template.Id" />
                        <input name="note" placeholder="@(isFa ? "دلیل رد یا یادداشت بررسی" : "Rejection reason or review note")" class="form-control min-w-64 flex-1" />
                        <button name="approve" value="true" class="btn-primary">@(isFa ? "تأیید" : "Approve")</button>
                        <button name="approve" value="false" class="btn-danger">@(isFa ? "برگرداندن" : "Send back")</button>
                    </form>
                </details>
            }
        </div>
    </section>
}

@section RightRail {
    <section class="rail-panel">
        <div class="rail-panel-header">
            <span class="rail-icon bg-accent-soft text-accent-text"><i data-lucide="layers-3" class="h-4 w-4"></i></span>
            <h2>@(isFa ? "قبل از اجرا می‌بینید" : "Review before deploy")</h2>
        </div>
        <ul class="space-y-3 text-sm text-ink-muted">
            <li class="flex gap-2"><i data-lucide="check" class="mt-0.5 h-4 w-4 shrink-0 text-ok"></i>@(isFa ? "تمام سرویس‌ها و وابستگی‌ها" : "Every service and dependency")</li>
            <li class="flex gap-2"><i data-lucide="check" class="mt-0.5 h-4 w-4 shrink-0 text-ok"></i>@(isFa ? "متغیرها، secretها و volumeها" : "Variables, secrets and volumes")</li>
            <li class="flex gap-2"><i data-lucide="check" class="mt-0.5 h-4 w-4 shrink-0 text-ok"></i>@(isFa ? "شبکهٔ خصوصی و health check" : "Private network and health check")</li>
        </ul>
    </section>

    <details id="create-template" class="rail-panel group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-2">
            <span class="flex items-center gap-2 font-semibold text-ink"><i data-lucide="file-json-2" class="h-4 w-4 text-accent-text"></i>@(isFa ? "قالب شخصی" : "Private template")</span>
            <i data-lucide="chevron-down" class="h-4 w-4 text-ink-faint transition group-open:rotate-180"></i>
        </summary>
        <form asp-controller="Templates" asp-action="Save" method="post" class="mt-4 space-y-3">
            @Html.AntiForgeryToken()
            <div><label class="form-label">@T["Name"]</label><input name="name" class="form-control" required /></div>
            <div><label class="form-label">@(isFa ? "دسته" : "Category")</label><input name="category" value="app" class="form-control" /></div>
            <div>
                <label class="form-label">@(isFa ? "مانیفست JSON" : "JSON manifest")</label>
                <textarea name="manifestJson" dir="ltr" rows="8" class="form-control font-mono text-xs" required
                          placeholder='{"image":"nginx:1.27-alpine","port":80}'></textarea>
            </div>
            <p class="text-xs leading-5 text-ink-faint">@(isFa ? "قبل از ذخیره اعتبارسنجی می‌شود و فقط برای همین فضای کاری قابل مشاهده است." : "Validated before save and visible only to this workspace until reviewed.")</p>
            <button class="btn-primary w-full">@T["Save"]</button>
        </form>
    </details>
}
