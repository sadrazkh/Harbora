@model List<Harbora.Domain.Templates.AppTemplate>
@using Harbora.Domain.Templates
@using Harbora.Infrastructure.Templates
@{
    ViewData["Title"] = "Templates";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var msg = TempData["Message"] as string;
    var err = TempData["Error"] as string;
    var reviewing = ViewBag.Reviewing as List<AppTemplate> ?? new();
    var workspaceId = ViewBag.WorkspaceId is Guid ws ? ws : Guid.Empty;
    var input = "w-full rounded-lg bg-canvas border border-line px-3 py-2 text-sm";
}
<h1 class="text-2xl font-bold mb-6">@T["Templates"]</h1>

@if (msg is not null){<div class="mb-4 rounded-lg bg-ok-soft border border-ok text-ok px-4 py-2 text-sm">@msg</div>}
@if (err is not null){<div class="mb-4 rounded-lg bg-danger-soft border border-danger text-danger px-4 py-2 text-sm">@err</div>}

@* ---- review queue ----
   Shown only to an admin. A template runs someone else's image inside a tenant's private network,
   so it reaches the shared catalog because a person decided, not because a form was saved. *@
@if (reviewing.Count > 0)
{
    <section class="mb-6 rounded-xl border border-warn bg-warn-soft p-5">
        <h2 class="font-semibold text-warn mb-3">@(isFa ? "در انتظار بررسی" : "Waiting for review")</h2>
        <div class="space-y-4">
            @foreach (var t in reviewing)
            {
                <div class="rounded-lg border border-line bg-surface p-4">
                    <div class="font-medium">@t.Name <span class="text-xs text-ink-faint">· @t.Category</span></div>
                    <pre dir="ltr" class="mt-2 max-h-40 overflow-auto rounded bg-code text-code-ink p-2 text-[11px] text-ink-muted whitespace-pre-wrap">@t.ManifestJson</pre>
                    <form asp-controller="Templates" asp-action="Review" method="post" class="mt-3 flex flex-wrap items-center gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@t.Id" />
                        <input name="note" placeholder="@(isFa ? "دلیل (برای برگرداندن لازم است)" : "Reason (required to send back)")" class="@input flex-1 min-w-[16rem]" />
                        <button name="approve" value="true" class="rounded-lg bg-ok hover:bg-ok px-3 py-2 text-sm font-semibold">@(isFa ? "تأیید" : "Approve")</button>
                        <button name="approve" value="false" class="rounded-lg bg-surface-2 hover:bg-surface-2 px-3 py-2 text-sm">@(isFa ? "برگرداندن" : "Send back")</button>
                    </form>
                </div>
            }
        </div>
    </section>
}

<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
    @foreach (var t in Model)
    {
        <div class="rounded-xl border border-line bg-surface p-5 flex flex-col">
            <div class="flex items-center justify-between gap-2">
                <span class="font-semibold">@(isFa && !string.IsNullOrEmpty(t.NameFa) ? t.NameFa : t.Name)</span>
                <span class="text-xs rounded-full bg-surface-2 px-2 py-0.5 text-ink">@t.Category</span>
            </div>
            <p class="mt-2 text-sm text-ink-muted flex-1">@(isFa && !string.IsNullOrEmpty(t.DescriptionFa) ? t.DescriptionFa : t.Description)</p>

            @* Where it stands: "yours only" and "in the shared catalog" are different things, and
               the card is the only place that can say which. *@
            <div class="mt-3 text-xs text-ink-faint">@TemplateCatalog.Describe(t)</div>

            @if (t.Status == TemplateStatus.Rejected && !string.IsNullOrWhiteSpace(t.ReviewNote))
            {
                <div class="mt-2 rounded-lg bg-danger-soft border border-danger px-3 py-2 text-xs text-danger">@t.ReviewNote</div>
            }

            <div class="mt-4 flex flex-wrap gap-2">
                <a href="/apps/create?templateId=@t.Id" class="rounded-lg bg-accent hover:bg-accent-hover px-3 py-1.5 text-sm font-semibold">@T["Deploy"]</a>
                @if (TemplateCatalog.CanSubmit(t, workspaceId))
                {
                    <form asp-controller="Templates" asp-action="Submit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@t.Id" />
                        <button class="rounded-lg bg-surface-2 hover:bg-surface-2 px-3 py-1.5 text-sm">@(isFa ? "ارسال برای بررسی" : "Send for review")</button>
                    </form>
                }
            </div>
        </div>
    }
</div>

@* ---- add your own ----
   The manifest is checked here, where it is written. A deploy failing on it an hour later is the
   expensive moment to find a typo. *@
<section class="mt-8 rounded-xl border border-line bg-surface p-5 max-w-3xl">
    <h2 class="font-semibold mb-3">@(isFa ? "قالب خودت را بساز" : "Add your own template")</h2>
    <form asp-controller="Templates" asp-action="Save" method="post" class="space-y-3">
        @Html.AntiForgeryToken()
        <div class="grid sm:grid-cols-2 gap-3">
            <div>
                <label class="block text-sm text-ink-muted mb-1">@T["Name"]</label>
                <input name="name" class="@input" />
            </div>
            <div>
                <label class="block text-sm text-ink-muted mb-1">@(isFa ? "دسته" : "Category")</label>
                <input name="category" value="app" class="@input" />
            </div>
        </div>
        <div>
            <label class="block text-sm text-ink-muted mb-1">@(isFa ? "مانیفست (JSON)" : "Manifest (JSON)")</label>
            <textarea name="manifestJson" dir="ltr" rows="6" class="@input font-mono text-xs"
                      placeholder='{"image":"nginx:alpine","port":80,"volumes":[{"mount":"/usr/share/nginx/html"}]}'></textarea>
            <p class="mt-1 text-xs text-ink-faint">
                @(isFa
                    ? "«image» یا «source»: «git» لازم است. ولیوم‌ها و متغیرهایی که اینجا تعریف کنی واقعاً روی اپ ساخته می‌شوند."
                    : "Needs either \"image\" or \"source\": \"git\". The volumes and variables declared here are really created on the app.")
            </p>
        </div>
        <button class="rounded-lg bg-accent hover:bg-accent-hover px-4 py-2 text-sm font-semibold">@T["Save"]</button>
    </form>
</section>
