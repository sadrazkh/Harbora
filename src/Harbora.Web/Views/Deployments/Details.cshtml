@model Deployment
@{ ViewData["Title"] = $"Deployment #{Model.Number}"; }
<div class="mb-4 flex items-center justify-between">
    <div>
        <a href="/apps/details/@Model.AppId" class="text-brand-400 text-sm">← @Model.App?.Name</a>
        <h1 class="text-2xl font-bold flex items-center gap-3">
            @T["Deployments"] #@Model.Number
            <span data-status><partial name="_DeployStatusBadge" model="Model.Status" /></span>
        </h1>
    </div>
</div>

@* Staged progress (server-rendered; the Vue island updates it live in production). *@
<partial name="_DeployProgress" model="Model.Status" />

@{
    var changes = ViewBag.ConfigChanges as IReadOnlyList<Harbora.Infrastructure.Deployments.ConfigChange> ?? [];
    var comparedWith = ViewBag.ComparedWith as int?;
    var identical = ViewBag.ConfigIdentical is true;
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
}

@* ---- what changed since the previous release ----
   The question people ask after a bad deploy. Until deployments recorded their configuration, a
   settings change and a code change looked identical in this list. *@
@if (comparedWith is { } previousNumber)
{
    <section class="mb-6 rounded-xl border border-slate-800 bg-slate-900/60">
        <div class="px-4 py-3 border-b border-slate-800 font-semibold">
            @(isFa ? $"تغییرات نسبت به #{previousNumber}" : $"Changed since #{previousNumber}")
        </div>
        @if (identical)
        {
            @* Worth stating outright: it narrows the search to the code. *@
            <div class="p-4 text-sm text-slate-400">
                @(isFa ? "پیکربندی دقیقاً همان بود — تفاوت در کد است." : "The configuration was identical — the difference is in the code.")
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-800">
                @foreach (var change in changes)
                {
                    <div class="flex flex-wrap items-baseline justify-between gap-3 p-3 text-sm">
                        <span class="text-slate-300">@change.What</span>
                        <span dir="ltr" class="font-mono text-xs text-slate-400">@change.Detail</span>
                    </div>
                }
            </div>
        }
    </section>
}

@* Vue island: connects to SignalR and renders live logs. Mount point carries its config. *@
<div id="deployment-logs"
     data-deployment-id="@Model.Id"
     data-status="@Model.Status"
     class="rounded-xl border border-slate-800 bg-black/60 font-mono text-xs leading-relaxed">
    <div class="flex items-center justify-between px-4 py-2 border-b border-slate-800 text-slate-400">
        <span>build &amp; deploy logs</span>
        <a href="/deployments/@Model.Id/logs" class="hover:text-white">download</a>
    </div>
    <pre data-log-output class="p-4 max-h-[60vh] overflow-auto whitespace-pre-wrap"></pre>
</div>

@section Scripts {
<script>
    // No-bundle fallback: if the Vue island hasn't taken over within 800ms, poll the log API.
    (function () {
        var el = document.getElementById('deployment-logs');
        var out = el.querySelector('[data-log-output]');
        var last = -1, done = false;
        var terminal = ['Succeeded','Failed','Cancelled','RolledBack'];
        function poll() {
            if (window.__harboraLogsMounted) return; // Vue island active
            fetch('/deployments/@Model.Id/logs?after=' + last)
                .then(function (r) { return r.json(); })
                .then(function (lines) {
                    lines.forEach(function (l) { out.textContent += l.message + '\n'; last = l.seq; });
                    out.scrollTop = out.scrollHeight;
                })
                .finally(function () { if (!done) setTimeout(poll, 1500); });
        }
        if (terminal.indexOf('@Model.Status') === -1) setTimeout(poll, 800);
        else setTimeout(function(){ if(!window.__harboraLogsMounted) poll(); }, 800);
    })();
</script>
}
