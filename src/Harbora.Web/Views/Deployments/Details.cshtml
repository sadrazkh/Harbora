@model Deployment
@{ ViewData["Title"] = $"Deployment #{Model.Number}"; }
<div class="mb-4 flex items-center justify-between">
    <div>
        <a href="/apps/details/@Model.AppId" class="text-accent-text text-sm">← @Model.App?.Name</a>
        <h1 class="text-2xl font-bold tracking-tight text-ink flex items-center gap-3">
            @T["Deployments"] #@Model.Number
            <span data-status><partial name="_DeployStatusBadge" model="Model.Status" /></span>
        </h1>
    </div>
</div>

@* Staged progress. Server-rendered so a page opened mid-deploy is right on arrival; moved live by
   Scripts/deployProgress.ts from the status the socket (or the polling fallback) reports. *@
<partial name="_DeployProgress" model="Model.Status" />

@{
    var deployIsFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var appUrl = $"/apps/details/{Model.AppId}";
    var appLabel = Model.App?.Name ?? (deployIsFa ? "برنامه" : "the application");
    var queueExplanation = ViewBag.QueueExplanation as string;
    var canCancel = ViewBag.CanCancel is true;
    var queued = Model.Status == Harbora.Domain.Common.DeploymentStatus.Queued;
    var deployMsg = TempData["Message"] as string;
    var deployErr = TempData["Error"] as string;

    // Two tiers, as everywhere else in the panel. Cancelling a deployment that has not started costs
    // nothing and asks nothing; cancelling one mid-flight stops a build that is part-way through and
    // is worth a moment's pause. A null attribute is not rendered, which is what makes that one form.
    string? cancelConfirm = queued
        ? null
        : "return confirm('" + (deployIsFa
            ? "این استقرار همین حالا متوقف شود؟ نسخه فعلی روی همان چیزی می‌ماند که هست."
            : "Stop this deployment now? The release currently serving traffic stays as it is.") + "')";
}

@if (deployMsg is not null){<div class="mb-4 rounded-lg bg-ok-soft border border-ok text-ok px-4 py-2 text-sm">@deployMsg</div>}
@if (deployErr is not null){<div class="mb-4 rounded-lg bg-danger-soft border border-danger text-danger px-4 py-2 text-sm">@deployErr</div>}

@* ---- why it is waiting, and the way out ----
   A queued deployment used to say nothing at all about what it was behind, and there was no way to
   stop it from anywhere in the product. The sentence comes from QueuePosition, which reads the same
   rules the worker's claim does — so what is shown here is what the queue will actually do. *@
@if (queueExplanation is not null || canCancel)
{
    <section class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-line bg-surface p-4">
        @* Empty rather than invented. A queued deployment whose job row a reconciler has already
           settled is in no queue, and "it is running" would be the friendly kind of wrong. *@
        <p class="text-sm text-ink-muted">
            @(queueExplanation
              ?? (queued ? "" : deployIsFa ? "این استقرار در حال اجراست." : "This deployment is running."))
        </p>
        @if (canCancel)
        {
            <form asp-controller="Deployments" asp-action="Cancel" asp-route-id="@Model.Id" method="post"
                  onsubmit="@cancelConfirm">
                @Html.AntiForgeryToken()
                <button class="rounded-lg border border-line-strong px-3 py-1.5 text-sm font-medium hover:border-danger hover:text-danger">
                    @(deployIsFa ? "لغو استقرار" : "Cancel deployment")
                </button>
            </form>
        }
    </section>
}

@* The two endings. Both rendered here and revealed by the script, so somebody who watched the
   deployment and somebody who opened the page afterwards see the same thing — and so the wording
   stays translated in one place instead of being built in JavaScript. *@
<div class="mb-4 rounded-xl border border-ok/30 bg-ok-soft p-5" data-deploy-outcome="Succeeded"
     hidden="@(Model.Status is not Harbora.Domain.Common.DeploymentStatus.Succeeded)">
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-start gap-3">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-ok text-white">
                <i data-lucide="check" class="h-5 w-5"></i>
            </span>
            <div>
                <strong class="block text-sm font-semibold text-ok">
                    @(deployIsFa ? "استقرار با موفقیت انجام شد" : "Deployed successfully")
                </strong>
                <span class="mt-0.5 block text-xs leading-5 text-ok">
                    @(deployIsFa
                        ? $"«{appLabel}» زنده است و ترافیک را می‌گیرد."
                        : $"{appLabel} is live and taking traffic.")
                </span>
            </div>
        </div>
        <a href="@appUrl" class="rounded-lg bg-ok px-4 py-2 text-sm font-semibold text-white hover:opacity-90">
            @(deployIsFa ? "رفتن به برنامه" : "Open the application")
        </a>
    </div>
</div>

<div class="mb-4 rounded-xl border border-line bg-surface p-5" data-deploy-outcome="Ended"
     hidden="@(Model.Status is not (Harbora.Domain.Common.DeploymentStatus.Failed
                                    or Harbora.Domain.Common.DeploymentStatus.Cancelled
                                    or Harbora.Domain.Common.DeploymentStatus.RolledBack))">
    <div class="flex flex-wrap items-center justify-between gap-4">
        <p class="text-sm text-ink-muted">
            @(deployIsFa
                ? "این استقرار به پایان رسید. لاگ کامل پایین همین صفحه است."
                : "This deployment has ended. The full log is below.")
        </p>
        <a href="@appUrl" class="btn-secondary px-4 py-2 text-sm">
            @(deployIsFa ? "رفتن به برنامه" : "Open the application")
        </a>
    </div>
</div>

@{
    var changes = ViewBag.ConfigChanges as IReadOnlyList<Harbora.Infrastructure.Deployments.ConfigChange> ?? [];
    var comparedWith = ViewBag.ComparedWith as int?;
    var identical = ViewBag.ConfigIdentical is true;
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var targets = ViewBag.PromotionTargets as IReadOnlyList<(Guid Id, string Name, string Environment)> ?? [];
}

@* ---- promote ----
   The same artifact, released elsewhere. Building twice from one commit does not reliably produce
   the same image, so "we tested this in staging" only means something if the bytes that reach
   production are the bytes that passed. *@
@if (targets.Count > 0 && !string.IsNullOrWhiteSpace(Model.ImageTag))
{
    <section class="mb-6 rounded-xl border border-line bg-surface p-4">
        <div class="flex flex-wrap items-center gap-3">
            <span class="font-semibold">@(isFa ? "ترفیع این نسخه" : "Promote this release")</span>
            <form asp-controller="Deployments" asp-action="Promote" asp-route-id="@Model.Id" method="post"
                  class="flex flex-wrap items-center gap-2">
                @Html.AntiForgeryToken()
                <select name="targetAppId" class="rounded-lg bg-canvas border border-line px-3 py-1.5 text-sm">
                    @foreach (var t in targets)
                    {
                        <option value="@t.Id">@t.Name · @t.Environment</option>
                    }
                </select>
                <button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-3 py-1.5 text-sm font-semibold">
                    @(isFa ? "ترفیع بده" : "Promote")</button>
            </form>
        </div>
        @* The half people get wrong: a promotion moves the code, not the settings. *@
        <p class="mt-2 text-xs text-ink-faint">
            @(isFa
                ? $"دقیقاً همین ایمیج منتشر می‌شود: {Model.ImageTag} — چیزی دوباره ساخته نمی‌شود، و مقصد متغیرها، دیتابیس و دامنه‌های خودش را نگه می‌دارد."
                : Harbora.Infrastructure.Deployments.PromotionPlan.Describe(Model.ImageTag!, "the target"))
        </p>
    </section>
}

@* ---- what changed since the previous release ----
   The question people ask after a bad deploy. Until deployments recorded their configuration, a
   settings change and a code change looked identical in this list. *@
@if (comparedWith is { } previousNumber)
{
    <section class="mb-6 rounded-xl border border-line bg-surface">
        <div class="px-4 py-3 border-b border-line font-semibold">
            @(isFa ? $"تغییرات نسبت به #{previousNumber}" : $"Changed since #{previousNumber}")
        </div>
        @if (identical)
        {
            @* Worth stating outright: it narrows the search to the code. *@
            <div class="p-4 text-sm text-ink-muted">
                @(isFa ? "پیکربندی دقیقاً همان بود — تفاوت در کد است." : "The configuration was identical — the difference is in the code.")
            </div>
        }
        else
        {
            <div class="divide-y divide-line">
                @foreach (var change in changes)
                {
                    <div class="flex flex-wrap items-baseline justify-between gap-3 p-3 text-sm">
                        <span class="text-ink">@change.What</span>
                        <span dir="ltr" class="font-mono text-xs text-ink-muted">@change.Detail</span>
                    </div>
                }
            </div>
        }
    </section>
}

@* ---- explain this failure ----
   Two steps on purpose. The first shows the exact text that would leave this server, with the
   count of what was removed from it; nothing is sent until somebody has read it and pressed send.
   A one-click version would be friendlier and would ship somebody's logs to a third party before
   they knew there was a third party. *@
@if (ViewBag.AssistantAvailable == true)
{
    <section class="mb-6 rounded-xl border border-line bg-surface" data-assistant data-id="@Model.Id">
        @* Its own token. The promote form above also renders one, but only when a promotion is
           possible — relying on that would make sending work or fail depending on an unrelated
           feature's visibility. *@
        @Html.AntiForgeryToken()
        <div class="flex items-center justify-between gap-2 px-4 py-3 border-b border-line">
            <span class="font-semibold">@(isFa ? "توضیح این خطا" : "Explain this failure")</span>
            <button type="button" data-assistant-preview
                    class="text-xs rounded-lg border border-line-strong px-3 py-1 hover:border-accent">
                @(isFa ? "ببین چه چیزی ارسال می‌شود" : "See what would be sent")
            </button>
        </div>

        <div class="p-4 text-xs text-ink-muted" data-assistant-intro>
            @(isFa
                ? "لاگ پیش از ارسال پاکسازی می‌شود، ولی پیش از ارسال خودتان هم آن را می‌بینید. هیچ چیزی بدون تأیید شما از این سرور خارج نمی‌شود."
                : "The log is redacted first, and you see it before it goes. Nothing leaves this server until you send it.")
        </div>

        <div class="hidden p-4 space-y-3" data-assistant-panel>
            <div class="text-xs text-ink-muted" data-assistant-summary></div>
            <pre dir="ltr" class="max-h-64 overflow-auto rounded bg-terminal text-terminal-ink p-3 font-mono text-[11px] whitespace-pre-wrap" data-assistant-text></pre>
            <div class="flex items-center gap-2">
                <button type="button" data-assistant-send
                        class="rounded-lg bg-accent hover:bg-accent-hover text-white px-3 py-1.5 text-sm font-semibold">
                    @(isFa ? "همین را بفرست" : "Send this")
                </button>
                <span class="text-xs text-ink-faint" data-assistant-status></span>
            </div>
        </div>

        <div class="hidden border-t border-line p-4 text-sm whitespace-pre-wrap" data-assistant-answer></div>
    </section>
}

@* Vue island: connects to SignalR and renders live logs. Mount point carries its config. *@
<div id="deployment-logs"
     data-deployment-id="@Model.Id"
     data-status="@Model.Status"
     class="rounded-xl border border-line bg-terminal text-terminal-ink font-mono text-xs leading-relaxed">
    <div class="flex items-center justify-between px-4 py-2 border-b border-line text-ink-muted">
        <span>build &amp; deploy logs</span>
        <a href="/deployments/@Model.Id/logs" class="hover:text-white">download</a>
    </div>
    <pre data-log-output class="p-4 max-h-[60vh] overflow-auto whitespace-pre-wrap"></pre>
</div>

@section Scripts {
<script>
    // No-bundle fallback: if the Vue island hasn't taken over within 800ms, poll the log API.
    (function () {
        var el = document.getElementById('deployment-logs');
        var out = el.querySelector('[data-log-output]');
        var last = -1, done = false;
        var terminal = ['Succeeded','Failed','Cancelled','RolledBack'];
        function poll() {
            if (window.__harboraLogsMounted) return; // Vue island active
            fetch('/deployments/@Model.Id/logs?after=' + last)
                .then(function (r) { return r.json(); })
                .then(function (payload) {
                    (payload.lines || []).forEach(function (l) { out.textContent += l.message + '\n'; last = l.seq; });
                    out.scrollTop = out.scrollHeight;

                    // Moves the progress bar on this path too, and stops the poll once the
                    // deployment has ended. Without it `done` was never set and this ran for ever.
                    if (payload.status) {
                        window.dispatchEvent(new CustomEvent('harbora:deployment-status',
                            { detail: { status: payload.status } }));
                        if (terminal.indexOf(payload.status) !== -1) done = true;
                    }
                })
                .finally(function () { if (!done) setTimeout(poll, 1500); });
        }
        if (terminal.indexOf('@Model.Status') === -1) setTimeout(poll, 800);
        else setTimeout(function(){ if(!window.__harboraLogsMounted) poll(); }, 800);
    })();

    // The assistant: preview, then send. Two requests, because the first one deliberately sends
    // nothing anywhere — it only shows what the second one would.
    (function () {
        var root = document.querySelector('[data-assistant]');
        if (!root) return;

        var id = root.getAttribute('data-id');
        var panel = root.querySelector('[data-assistant-panel]');
        var text = root.querySelector('[data-assistant-text]');
        var summary = root.querySelector('[data-assistant-summary]');
        var status = root.querySelector('[data-assistant-status]');
        var answer = root.querySelector('[data-assistant-answer]');
        var previewButton = root.querySelector('[data-assistant-preview]');
        var sendButton = root.querySelector('[data-assistant-send]');
        var fa = @(isFa ? "true" : "false");

        previewButton.addEventListener('click', function () {
            previewButton.disabled = true;
            fetch('/deployments/' + id + '/assistant/preview')
                .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, body: b }; }); })
                .then(function (r) {
                    if (!r.ok) { summary.textContent = r.body.message || ''; panel.classList.remove('hidden'); return; }
                    text.textContent = r.body.text;
                    // The count is the evidence that redaction ran at all.
                    var parts = [fa ? (r.body.removed + ' مورد حساس حذف شد') : (r.body.removed + ' sensitive item(s) removed')];
                    if (r.body.truncated) parts.push(fa ? 'فقط انتهای لاگ' : 'only the end of the log');
                    summary.textContent = parts.join(' · ');
                    panel.classList.remove('hidden');
                })
                .catch(function () { summary.textContent = fa ? 'آماده‌سازی انجام نشد.' : 'The preview could not be built.'; })
                .finally(function () { previewButton.disabled = false; });
        });

        sendButton.addEventListener('click', function () {
            sendButton.disabled = true;
            status.textContent = fa ? 'در حال پرسیدن…' : 'asking…';
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            var body = new FormData();
            if (token) body.append('__RequestVerificationToken', token.value);

            fetch('/deployments/' + id + '/assistant/ask', { method: 'POST', body: body })
                .then(function (r) { return r.json(); })
                .then(function (b) {
                    answer.textContent = b.text || '';
                    answer.classList.remove('hidden');
                    status.textContent = '';
                })
                .catch(function () { status.textContent = fa ? 'پاسخی نرسید.' : 'No answer came back.'; })
                .finally(function () { sendButton.disabled = false; });
        });
    })();
</script>
}
