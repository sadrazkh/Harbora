@model BillingPageViewModel
@using Harbora.Domain.Billing
@using Harbora.Infrastructure.Billing
@{
    ViewData["Title"] = "Billing";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var msg = TempData["Message"] as string;
    var err = TempData["Error"] as string;

    // The bill answers "this app was on for ten hours and stopped for fourteen" — so an hour count
    // is only printed where hours are a thing the resource has. A disk is neither up nor down; it is
    // held, and "0 hours running" against it reads as a disk switched off all month and charged for.
    // That rule now lives on each card, which says "not charged by the hour" in words rather than
    // printing a dash where two numbers used to be.

    string Kind(BilledResourceType type) => (type, isFa) switch
    {
        (BilledResourceType.App, true) => "اپلیکیشن",       (BilledResourceType.App, false) => "App",
        (BilledResourceType.Service, true) => "دیتابیس",     (BilledResourceType.Service, false) => "Database",
        (BilledResourceType.Volume, true) => "دیسک",         (BilledResourceType.Volume, false) => "Disk",
        (BilledResourceType.PlanBase, true) => "حداقل پلن",  (BilledResourceType.PlanBase, false) => "Plan minimum",

        // A database's disk is a line of its own because it is charged by its own key — the managed
        // service's id, not a Volume row's — and the whole point of that key was that a customer can
        // tell "my database's disk" from "my app's disk". Dropped into the arm below, both would read
        // as one word naming neither, and the split would have bought nothing they can see.
        (BilledResourceType.ServiceVolume, true) => "دیسک دیتابیس",
        (BilledResourceType.ServiceVolume, false) => "Database disk",

        // Appending to BilledResourceType and forgetting this switch is a silent loss: the line is
        // still charged and still totalled, and only its label goes vague. `A_bill_calls_a_databases_
        // disk_a_databases_disk_rather_than_other` is the test that goes red when it happens.
        _ => isFa ? "سایر" : "Other"
    };
}

@if (msg is not null){<div class="mb-4 rounded-lg bg-ok-soft border border-ok text-ok px-4 py-2 text-sm">@msg</div>}
@if (err is not null){<div class="mb-4 rounded-lg bg-danger-soft border border-danger text-danger px-4 py-2 text-sm">@err</div>}

<div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-ink">@(isFa ? "صورت‌حساب" : "Billing")</h1>
    <p class="text-ink-muted text-sm">@Model.WorkspaceName</p>
</div>

@* ---- the balance ---------------------------------------------------------------------------- *@
<div class="grid sm:grid-cols-2 gap-4 mb-6">
    <div class="rounded-xl border border-line bg-surface p-4">
        <div class="text-ink-muted text-sm">@(isFa ? "موجودی" : "Balance")</div>
        @if (Model.HasWallet)
        {
            <div class="mt-1 text-2xl font-bold @(Model.BalanceMinor > 0 ? "text-ink" : "text-danger")" dir="ltr">
                @MinorUnits.Format(Model.BalanceMinor, Model.Currency)
            </div>
            @if (Model.BalanceMinor <= 0)
            {
                @* Zero is not a balance: the gate refuses to start anything on one. Saying "you have
                   0" without saying what that means leaves somebody waiting for an app that will
                   never come back. *@
                <div class="mt-1 text-xs text-danger">
                    @(isFa
                        ? "چیز جدیدی تا شارژ شدن حساب اجرا نمی‌شود."
                        : "Nothing new will start until the account is topped up.")
                </div>
            }
        }
        else
        {
            @* Not zero. No wallet means no hourly pass has ever reached this workspace, which is a
               different fact from having nothing left — and the panel's own rule is that an unread
               figure is never printed as a nought. *@
            <div class="mt-1 text-2xl font-bold text-ink-faint" dir="ltr">—</div>
            <div class="mt-1 text-xs text-ink-faint">
                @(isFa ? "هنوز صورت‌حسابی صادر نشده است." : "Nothing has been billed yet.")
            </div>
        }
    </div>

    @if (Model.Suspended)
    {
        <div class="rounded-xl border border-danger bg-danger-soft p-4">
            <div class="text-danger text-sm font-semibold mb-1">@(isFa ? "معلق" : "Suspended")</div>
            <p class="text-danger text-sm">
                @if (Model.SuspendedForNoBalance)
                {
                    @(isFa
                        ? "به‌دلیل تمام‌شدن اعتبار. با شارژ حساب، همان چیزهایی که این تعلیق متوقفشان کرده بود دوباره اجرا می‌شوند."
                        : "Because the balance ran out. Topping the account up starts back exactly what this suspension stopped.")
                }
                else if (Model.SuspendedForSpendLimit)
                {
                    @(isFa
                        ? "به سقف هزینهٔ ماهانه رسیده‌اید. سقف را افزایش دهید یا تا شروع ماه بعد به وقت UTC صبر کنید."
                        : "The monthly spend limit was reached. Raise it or wait for the next UTC month.")
                }
                else
                {
                    @* Said plainly rather than hidden behind a generic "contact support": telling
                       somebody to pay for a suspension a payment does not lift is sending them to
                       spend money on nothing. *@
                    @(isFa
                        ? "این تعلیق به‌دلیل اعتبار نیست و با پرداخت برداشته نمی‌شود. با پشتیبانی تماس بگیرید."
                        : "This suspension is not about money and paying does not lift it. Please contact support.")
                }
            </p>
        </div>
    }
</div>

<div class="rounded-xl border border-line bg-surface p-4 mb-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
            <h2 class="font-semibold text-ink">@(isFa ? "کنترل هزینهٔ ماهانه" : "Monthly cost controls")</h2>
            <p class="text-sm text-ink-muted mt-1">
                @(isFa ? "بودجه هشدار می‌دهد؛ سقف هزینه جلوی ساخت و اجرای بیشتر را می‌گیرد." : "The budget warns; the spend limit blocks further creation and runtime.")
            </p>
        </div>
        <div class="text-end">
            <div class="text-xs text-ink-muted">@(isFa ? "هزینهٔ ماه جاری" : "Current month spend")</div>
            <div class="font-semibold @(Model.BudgetExceeded ? "text-warning" : "text-ink")" dir="ltr">@MinorUnits.Format(Model.CurrentMonthSpendMinor, Model.Currency)</div>
            @if (Model.SpendLimitRemainingMinor is { } remaining)
            {
                <div class="text-xs text-ink-faint" dir="ltr">@(isFa ? "باقی‌مانده: " : "Remaining: ")@MinorUnits.Format(remaining, Model.Currency)</div>
            }
        </div>
    </div>
    @if (Model.CanManageBudget)
    {
        <form method="post" action="/billing/budget" class="grid sm:grid-cols-2 gap-3 mt-4">
            @Html.AntiForgeryToken()
            <label class="form-field"><span>@(isFa ? "بودجهٔ هشدار" : "Warning budget")</span>
                <input name="monthlyBudget" value="@MinorUnits.Box(Model.MonthlyBudgetMinor)" inputmode="decimal" class="form-control" dir="ltr" placeholder="@(isFa ? "خالی = غیرفعال" : "empty = disabled")" /></label>
            <label class="form-field"><span>@(isFa ? "سقف سخت هزینه" : "Hard spend limit")</span>
                <input name="monthlySpendLimit" value="@MinorUnits.Box(Model.MonthlySpendLimitMinor)" inputmode="decimal" class="form-control" dir="ltr" placeholder="@(isFa ? "خالی = غیرفعال" : "empty = disabled")" /></label>
            <button class="btn-primary sm:col-span-2 justify-center">@(isFa ? "ذخیرهٔ کنترل هزینه" : "Save cost controls")</button>
        </form>
    }
</div>

<div class="rounded-xl border border-line bg-surface p-4 mb-6">
    <h2 class="font-semibold text-ink mb-2">@(isFa ? "شارژ با ووچر" : "Redeem a voucher")</h2>
    <p class="text-sm text-ink-muted mb-3">@(isFa ? "کدی را که از ارائه‌دهنده گرفته‌اید وارد کنید؛ هر کد فقط یک‌بار قابل استفاده است." : "Enter the code supplied by your provider. Each code can be used once.")</p>
    <form method="post" action="/billing/voucher" class="flex flex-col sm:flex-row gap-2">
        @Html.AntiForgeryToken()
        <input name="code" required autocomplete="off" dir="ltr" class="form-control flex-1 font-mono" placeholder="XXXXX-XXXXX-XXXXX-XXXXX" />
        <button type="submit" class="btn-primary">@(isFa ? "اعمال ووچر" : "Redeem")</button>
    </form>
</div>

@* ---- the month ------------------------------------------------------------------------------ *@
<div class="flex items-center gap-3 mb-3">
    <h2 class="font-semibold text-ink">@(isFa ? "این ماه چه چیزی چقدر شد" : "What each thing cost")</h2>
    <span class="text-sm text-ink-faint" dir="ltr">@Model.Period</span>
    <span class="flex-1"></span>
    @* rtl:rotate-180 on the arrows: "previous" is to the reader's left in one script and to their
       right in the other, and an arrow that does not follow is an arrow pointing at the wrong month. *@
    <a href="/billing?month=@Model.PreviousPeriod" class="text-sm text-accent-text">
        <span class="inline-block rtl:rotate-180">←</span> @Model.PreviousPeriod
    </a>
    @if (Model.NextPeriod is { } next)
    {
        <a href="/billing?month=@next" class="text-sm text-accent-text">
            @next <span class="inline-block rtl:rotate-180">→</span>
        </a>
    }
</div>

@* ---- a card per thing, not a row per thing ----
   The name and what the thing is come first, then how long it was held, then what it came to and the
   month that rate implies. A four-column table put the two figures a customer actually reads — what
   it cost, and roughly what it will keep costing — at opposite ends of a row, with the monthly one
   nowhere on the page at all.

   The name is the copy taken onto the ledger line when the charge was made and is never joined back
   to the row, so an app deleted last week still reads here under the name it had at the time. *@
@if (Model.Costs.Count == 0)
{
    <div class="mb-6 rounded-xl border border-line bg-surface p-4 text-ink-faint">
        @(isFa ? "در این ماه چیزی برای این فضای کاری ثبت نشده است." : "Nothing was charged to this workspace in this month.")
    </div>
}
else
{
    <div class="mb-4 space-y-2">
        @foreach (var c in Model.Costs)
        {
            @* The figures carried as attributes as well as in the copy, the same way the app page's
               specifics block does it. The words in this card are interpolated C# strings, which
               Razor's encoder writes out as numeric character references — so Persian copy is not
               something a test can search the page for, and pinning this card to English would pin it
               to a language this panel does not render by default. *@
            <article class="rounded-xl border border-line bg-surface p-4"
                     data-cost-kind="@c.Type"
                     data-cost-running-hours="@c.RunningHours"
                     data-cost-stopped-hours="@c.StoppedHours"
                     data-cost-monthly="@(c.AverageHourlyMinor is { } m ? Harbora.Infrastructure.Billing.MonthlyEstimate.FromHourly(m)?.ToString() : null)">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0">
                        <h3 class="truncate font-semibold text-ink">
                            @(c.Name.Length > 0 ? c.Name : (isFa ? "(بی‌نام)" : "(unnamed)"))
                        </h3>
                        <p class="mt-0.5 text-xs text-ink-muted">
                            <span class="status-pill bg-surface-2 text-ink-muted">@Kind(c.Type)</span>
                            @if (c.Hours > 0)
                            {
                                @* The unit is the whole word rather than an initial. "3س" is not how
                                   anybody writes three hours in Persian, and "3h" beside a Persian
                                   sentence is not either. *@
                                <span class="ms-2">
                                    @(isFa ? "روشن" : "running")
                                    <span dir="ltr">@c.RunningHours @(isFa ? "ساعت" : c.RunningHours == 1 ? "hour" : "hours")</span>
                                    ·
                                    @(isFa ? "خاموش" : "stopped")
                                    <span dir="ltr">@c.StoppedHours @(isFa ? "ساعت" : c.StoppedHours == 1 ? "hour" : "hours")</span>
                                </span>
                            }
                            else
                            {
                                @* A disk is neither up nor down; it is held. "0 hours running" against
                                   one reads as a disk switched off all month and charged for anyway. *@
                                <span class="ms-2">@(isFa ? "بر اساس ساعت حساب نمی‌شود" : "not charged by the hour")</span>
                            }
                        </p>
                    </div>

                    <div class="text-end">
                        @* ResourceCost.TotalMinor is signed the way the ledger stores it — negative is
                           money out — and that sign is right for the reconciliation at the foot of this
                           page. It is wrong under a heading that says "cost": the customer asked "it
                           costs this much", not "minus this much", so the flip happens here, once, at
                           render, and nowhere the arithmetic can see it. *@
                        <div class="text-lg font-bold text-ink" dir="ltr">@MinorUnits.Format(Math.Abs(c.TotalMinor))</div>
                        <div class="text-[11px] text-ink-faint">@(isFa ? "در این ماه" : "this month")</div>
                    </div>
                </div>

                @if (c.AverageHourlyMinor is { } average)
                {
                    @* What an hour of this resource averaged, and the month that implies. An average
                       rather than the newest rate on its lines: a rate can change mid-month, and a
                       resource can spend part of one running and part stopped, so the newest line
                       would describe a single hour and be presented as the month. *@
                    <div class="mt-3 flex flex-wrap items-baseline gap-x-4 gap-y-1 border-t border-line pt-3 text-xs">
                        <span class="text-ink-muted" dir="ltr">
                            @MinorUnits.Format(average) @(isFa ? "میانگین هر ساعت" : "average per hour")
                        </span>
                        @if (Harbora.Web.Infrastructure.RateDisplay.Monthly(average, isFa) is { } projected)
                        {
                            <span class="text-accent-text" dir="ltr">
                                @projected @(isFa ? "در ماه با همین نرخ (تخمینی)" : "/month at that rate (estimated)")
                            </span>
                        }
                    </div>
                }
            </article>
        }
    </div>

    <div class="mb-2 flex flex-wrap items-baseline justify-between gap-3 rounded-xl border border-line-strong bg-surface-2 p-4">
        <span class="font-semibold text-ink">@(isFa ? "جمع" : "In total")</span>
        <span class="text-lg font-bold text-ink" dir="ltr">@MinorUnits.Format(Math.Abs(Model.CostTotalMinor), Model.Currency)</span>
    </div>

    <p class="mb-6 text-xs text-ink-faint">
        @(isFa
            ? $"رقم ماهانه تخمینی است: میانگین ساعتی همین ماه × {Harbora.Infrastructure.Billing.MonthlyEstimate.HoursPerMonth} ساعت. متوقف یا حذف کردن یک منبع، یا تغییر قیمت، عدد واقعی را جابه‌جا می‌کند."
            : $"The monthly figure is an estimate: this month's average hour × {Harbora.Infrastructure.Billing.MonthlyEstimate.HoursPerMonth} hours. Stopping or removing a resource, or a change of price, moves the real one.")
    </p>
}

@* ---- what was paid in ------------------------------------------------------------------------
   Kept out of the table above rather than netted off against it. Folded in, three separate top-ups
   become one figure — and a top-up applied twice would be invisible in it, which is the one mistake
   on this page that the person who benefits from it will not report. *@
<h2 class="font-semibold text-ink mb-3">@(isFa ? "پرداخت‌های این ماه" : "Paid in this month")</h2>
<div class="rounded-xl border border-line bg-surface overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-surface-2 text-ink-muted">
            <tr>
                <th class="p-3 text-start font-medium">@(isFa ? "تاریخ" : "When")</th>
                <th class="p-3 text-start font-medium">@(isFa ? "بابت" : "For")</th>
                <th class="p-3 text-end font-medium">@(isFa ? "مبلغ" : "Amount")</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Credits.Count == 0)
        {
            <tr>
                <td colspan="3" class="p-4 text-ink-faint">
                    @(isFa ? "در این ماه پرداختی ثبت نشده است." : "No payment was recorded in this month.")
                </td>
            </tr>
        }
        else
        {
            @foreach (var credit in Model.Credits)
            {
                <tr class="border-t border-line">
                    @* The billing hour, in UTC and said so: a payment's slot on the bill is the hour
                       the ledger filed it under, and a customer reconciling against a bank statement
                       in their own zone needs to know which clock this one is. *@
                    <td class="p-3 text-ink-muted" dir="ltr">@credit.Hour.ToString(Dates.Stamp) UTC</td>
                    <td class="p-3 text-ink">@credit.Note</td>
                    <td class="p-3 text-end text-ok" dir="ltr">@MinorUnits.Format(credit.AmountMinor)</td>
                </tr>
            }
            <tr class="border-t border-line-strong bg-surface-2 font-semibold">
                <td class="p-3 text-ink" colspan="2">@(isFa ? "جمع" : "In total")</td>
                <td class="p-3 text-end text-ink" dir="ltr">@MinorUnits.Format(Model.CreditTotalMinor, Model.Currency)</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@* ---- append-only corrections --------------------------------------------------------------- *@
<h2 class="font-semibold text-ink mb-3 mt-6">@(isFa ? "اصلاحات موجودی این ماه" : "Balance adjustments this month")</h2>
<div class="rounded-xl border border-line bg-surface overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-surface-2 text-ink-muted">
            <tr>
                <th class="p-3 text-start font-medium">@(isFa ? "تاریخ" : "When")</th>
                <th class="p-3 text-start font-medium">@(isFa ? "دلیل" : "Reason")</th>
                <th class="p-3 text-end font-medium">@(isFa ? "تغییر موجودی" : "Balance movement")</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Adjustments.Count == 0)
        {
            <tr>
                <td colspan="3" class="p-4 text-ink-faint">
                    @(isFa ? "در این ماه اصلاح موجودی ثبت نشده است." : "No balance adjustment was recorded in this month.")
                </td>
            </tr>
        }
        else
        {
            @foreach (var adjustment in Model.Adjustments)
            {
                <tr class="border-t border-line">
                    <td class="p-3 text-ink-muted" dir="ltr">@adjustment.Hour.ToString(Dates.Stamp) UTC</td>
                    <td class="p-3 text-ink">@adjustment.Note</td>
                    <td class="p-3 text-end @(adjustment.AmountMinor >= 0 ? "text-ok" : "text-danger")" dir="ltr">
                        @(adjustment.AmountMinor > 0 ? "+" : "")@MinorUnits.Format(adjustment.AmountMinor)
                    </td>
                </tr>
            }
            <tr class="border-t border-line-strong bg-surface-2 font-semibold">
                <td class="p-3 text-ink" colspan="2">@(isFa ? "جمع خالص" : "Net total")</td>
                <td class="p-3 text-end text-ink" dir="ltr">@(Model.AdjustmentTotalMinor > 0 ? "+" : "")@MinorUnits.Format(Model.AdjustmentTotalMinor, Model.Currency)</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@* Costs are rendered as positive figures; credits are positive money in; adjustments retain their
   ledger sign. That gives the reconciliation sentence below without hiding any movement. *@
<p class="mt-3 text-xs text-ink-faint">
    @(isFa
        ? "پرداخت‌ها، به‌علاوهٔ اصلاحات دارای علامت، منهای هزینه‌ها؛ برابر با تغییر موجودی شما در این بازه است."
        : "Payments, plus signed adjustments, minus costs equals your balance movement over this period.")
</p>
