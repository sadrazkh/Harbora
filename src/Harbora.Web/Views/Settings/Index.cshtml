@{
    ViewData["Title"] = "Settings";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var isProvider = (bool)(ViewBag.IsProvider ?? false);
    var tokens = ViewBag.Tokens as List<Harbora.Domain.Identity.ApiToken> ?? new();
    var newToken = TempData["NewToken"] as string;
    var msg = TempData["Message"] as string;
    var sessions = ViewBag.Sessions as List<Harbora.Domain.Identity.UserSession> ?? new();
    var currentSession = ViewBag.CurrentSessionId as string;
}
<h1 class="text-2xl font-bold tracking-tight text-ink mb-6">@T["Settings"]</h1>

@if (msg is not null){<div class="mb-4 rounded-lg bg-ok-soft border border-ok text-ok px-4 py-2 text-sm">@msg</div>}

<div class="grid lg:grid-cols-2 gap-6">
    @* ---- Platform ---- *@
    <section class="rounded-xl border border-line bg-surface p-5">
        <h2 class="text-[15px] font-semibold text-ink mb-3">@(isFa ? "پلتفرم" : "Platform")</h2>
        <form asp-controller="Settings" asp-action="UpdatePlatform" method="post" class="space-y-3">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-sm text-ink-muted mb-1">@(isFa ? "نام پلتفرم" : "Platform name")</label>
                <input name="platformName" value="@ViewBag.PlatformName" @(isProvider ? "" : "disabled")
                       class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm disabled:opacity-60" />
            </div>
            <div>
                <label class="block text-sm text-ink-muted mb-1">@(isFa ? "دامنه‌ی اصلی اپ‌ها" : "Apps root domain")</label>
                <input name="rootDomain" value="@ViewBag.RootDomain" placeholder="apps.example.com" @(isProvider ? "" : "disabled")
                       class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm disabled:opacity-60" />
            </div>
            <div>
                <label class="block text-sm text-ink-muted mb-1">ACME email (Let's Encrypt)</label>
                <input name="acmeEmail" type="email" value="@ViewBag.AcmeEmail" @(isProvider ? "" : "disabled")
                       class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm disabled:opacity-60" />
            </div>
            @if (isProvider)
            {
                <button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm font-semibold">@T["Save"]</button>
            }
            else
            {
                <p class="text-xs text-ink-faint">@(isFa ? "فقط اپراتور می‌تواند این‌ها را تغییر دهد." : "Only the provider can change these.")</p>
            }
        </form>
        <p class="mt-3 text-xs text-ink-faint">@(isFa ? "دامنه‌ی پنل در نصب تنظیم می‌شود و نیاز به بازراه‌اندازی دارد." : "The panel domain is set at install time and requires a restart to change.")</p>
    </section>

    @* ---- AI assistant ----
       Off, with nothing configured, is the shipped state. It stays off until an operator brings
       their own key, because turning it on means deployment logs start leaving this server. *@
    @* Administration, so it is not rendered for a member at all. Rendering it disabled would still
       tell them which provider and model this installation is wired to. *@
    @if (isProvider)
    {
        var assistant = ViewBag.Assistant as Harbora.Infrastructure.Assistant.AssistantConfig;
        var hasKey = (bool)(ViewBag.AssistantHasKey ?? false);
        var unavailable = ViewBag.AssistantUnavailable as string;
    <section class="rounded-xl border border-line bg-surface p-5">
        <h2 class="font-semibold mb-1">@(isFa ? "دستیار هوش مصنوعی" : "AI assistant")</h2>
        <p class="text-xs text-ink-muted mb-3">
            @(isFa
                ? "خطای یک استقرار را توضیح می‌دهد. لاگ پیش از ارسال پاکسازی می‌شود و کاربر دقیقاً همان متن را پیش از ارسال می‌بیند."
                : "Explains a failed deployment. The log is redacted first, and whoever asks sees the exact text before it is sent.")
        </p>

        <form asp-controller="Settings" asp-action="UpdateAssistant" method="post" class="space-y-3">
            @Html.AntiForgeryToken()
            <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" name="enabled" value="true" @(assistant?.Enabled == true ? "checked" : "") @(isProvider ? "" : "disabled") />
                <span>@(isFa ? "روشن" : "Enabled")</span>
            </label>

            <div>
                <label class="block text-sm text-ink-muted mb-1">@(isFa ? "ارائه‌دهنده" : "Provider")</label>
                <select name="provider" @(isProvider ? "" : "disabled")
                        class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm disabled:opacity-60">
                    <option value="">—</option>
                    <option value="anthropic" selected="@(assistant?.Provider == "anthropic")">Anthropic (Claude)</option>
                    <option value="openai" selected="@(assistant?.Provider == "openai")">OpenAI-compatible</option>
                </select>
            </div>

            <div>
                <label class="block text-sm text-ink-muted mb-1">@(isFa ? "مدل" : "Model")</label>
                <input name="model" value="@assistant?.Model" placeholder="claude-sonnet-5" @(isProvider ? "" : "disabled")
                       class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm disabled:opacity-60" />
            </div>

            <div>
                <label class="block text-sm text-ink-muted mb-1">
                    @(isFa ? "کلید API" : "API key")
                    <span class="text-xs text-ink-faint">@(hasKey ? (isFa ? "· ذخیره شده" : "· stored") : (isFa ? "· تنظیم نشده" : "· not set"))</span>
                </label>
                @* Never rendered back, only replaced. Blank leaves the stored key alone. *@
                <input name="apiKey" type="password" autocomplete="off"
                       placeholder="@(hasKey ? (isFa ? "برای تغییر، کلید تازه را بنویسید" : "type a new key to replace it") : "sk-…")"
                       @(isProvider ? "" : "disabled")
                       class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm disabled:opacity-60" />
            </div>

            <div>
                <label class="block text-sm text-ink-muted mb-1">
                    @(isFa ? "آدرس سرویس (اختیاری)" : "Base URL (optional)")
                </label>
                <input name="baseUrl" value="@assistant?.BaseUrl" placeholder="http://localhost:11434" @(isProvider ? "" : "disabled")
                       class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm disabled:opacity-60" />
                <p class="mt-1 text-[11px] text-ink-faint">
                    @(isFa
                        ? "برای مدل محلی روی همین ماشین، کلید لازم نیست."
                        : "A model running on this machine needs no key.")
                </p>
            </div>

            @if (isProvider)
            {
                <button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm font-semibold">@T["Save"]</button>
            }
        </form>

        @* Proving it works is one click, and the answer shown is the provider's own words. *@
        <form asp-controller="Settings" asp-action="TestAssistant" method="post" class="mt-2">
            @Html.AntiForgeryToken()
            <button class="rounded-lg border border-line px-3 py-1.5 text-xs text-ink hover:border-accent">
                @(isFa ? "تست اتصال" : "Test connection")
            </button>
        </form>

        @if (isProvider && hasKey)
        {
            <form asp-controller="Settings" asp-action="ClearAssistantKey" method="post" class="mt-2">
                @Html.AntiForgeryToken()
                <button class="text-xs text-danger hover:text-danger">@(isFa ? "کلید ذخیره‌شده را حذف کن" : "Remove the stored key")</button>
            </form>
        }

        @* Says why it is not available, rather than leaving a switch that appears on and does nothing. *@
        @if (unavailable is not null)
        {
            <p class="mt-3 text-xs text-warn/80">@unavailable</p>
        }
    </section>
    }

    @* ---- Appearance & language ---- *@
    <section class="rounded-xl border border-line bg-surface p-5">
        <h2 class="text-[15px] font-semibold text-ink mb-3">@(isFa ? "ظاهر و زبان" : "Appearance & language")</h2>

        <label class="block text-sm text-ink-muted mb-2">@T["Dark mode"]</label>
        <div class="inline-flex rounded-lg bg-surface-2 p-1 text-sm mb-5" id="themeCtl">
            <button type="button" data-theme="light" class="rounded-md px-3 py-1">☀ @(isFa ? "روشن" : "Light")</button>
            <button type="button" data-theme="dark" class="rounded-md px-3 py-1">🌙 @(isFa ? "تیره" : "Dark")</button>
            <button type="button" data-theme="system" class="rounded-md px-3 py-1">💻 @(isFa ? "سیستم" : "System")</button>
        </div>

        <label class="block text-sm text-ink-muted mb-2">@T["Language"]</label>
        <form asp-controller="Account" asp-action="SetLanguage" method="post" class="flex gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="/settings" />
            <select name="culture" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm">
                <option value="fa" selected="@(ViewBag.Culture as string == "fa")">فارسی</option>
                <option value="en" selected="@(ViewBag.Culture as string == "en")">English</option>
            </select>
            <button class="rounded-lg bg-surface-2 hover:bg-surface-2 px-4 py-2 text-sm">@T["Save"]</button>
        </form>
    </section>

    @* ---- Two-factor sign-in ---- *@
    <section class="rounded-xl border border-line bg-surface p-5">
        <h2 class="text-[15px] font-semibold text-ink mb-3">@(isFa ? "ورود دومرحله‌ای" : "Two-factor sign-in")</h2>

        @if (TempData["RecoveryCodes"] is string recovery)
        {
            @* The one and only render — only hashes exist from here on. *@
            <div class="mb-4 rounded-lg bg-warn-soft border border-warn px-4 py-3 text-sm">
                <div class="mb-2 font-medium">@(isFa ? "کدهای بازیابی — همین حالا جایی امن نگه دارید:" : "Recovery codes — save them somewhere safe now:")</div>
                <pre dir="ltr" class="rounded bg-code text-code-ink p-3 text-xs leading-6">@recovery</pre>
            </div>
        }

        @if (TempData["TotpSecret"] is string draftSecret && TempData["TotpUri"] is string draftUri)
        {
            <div class="space-y-3 text-sm">
                <p>@(isFa ? "این کلید را در اپ احراز هویت (Google Authenticator، Aegis، 1Password و…) وارد کنید:" : "Enter this key in your authenticator app (Google Authenticator, Aegis, 1Password, …):")</p>
                <code dir="ltr" class="block break-all rounded bg-code text-code-ink px-3 py-2">@draftSecret</code>
                <p><a href="@draftUri" class="text-accent-text" dir="ltr">@(isFa ? "یا روی موبایل این لینک را باز کنید ←" : "Or open this link on your phone →")</a></p>
                <form asp-action="TotpConfirm" method="post" class="flex gap-2">
                    @Html.AntiForgeryToken()
                    <input name="code" inputmode="numeric" autocomplete="one-time-code" required dir="ltr"
                           placeholder="123456" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                    <button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm">@(isFa ? "تأیید و فعال‌سازی" : "Confirm & enable")</button>
                </form>
            </div>
        }
        else if (ViewBag.TotpEnabled == true)
        {
            <p class="mb-3 text-sm text-ok">✓ @(isFa ? "فعال است. ورود، علاوه بر رمز، کد اپ احراز هویت را می‌خواهد." : "On. Signing in asks for your authenticator code as well as your password.")</p>
            @* Turning it off costs a code — an unlocked laptop must not be enough. *@
            <form asp-action="TotpDisable" method="post" class="flex gap-2">
                @Html.AntiForgeryToken()
                <input name="code" inputmode="numeric" autocomplete="one-time-code" required dir="ltr"
                       placeholder="@(isFa ? "کد یا کد بازیابی" : "code or recovery code")" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
                <button class="rounded-lg bg-surface-2 hover:bg-surface-2 px-4 py-2 text-sm text-danger">@(isFa ? "خاموش کردن" : "Turn off")</button>
            </form>
        }
        else
        {
            <p class="mb-3 text-sm text-ink-muted">@(isFa ? "با هر ورود، علاوه بر رمز، یک کد شش‌رقمی از اپ احراز هویت خواسته می‌شود." : "Each sign-in asks for a six-digit code from your authenticator app, on top of your password.")</p>
            @if (ViewBag.TotpDraft == true)
            {
                <form asp-action="TotpDisable" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <button class="me-2 rounded-lg bg-surface-2 hover:bg-surface-2 px-4 py-2 text-sm">@(isFa ? "لغو ثبت نیمه‌کاره" : "Discard the unfinished set-up")</button>
                </form>
            }
            <form asp-action="TotpBegin" method="post" class="inline">
                @Html.AntiForgeryToken()
                <button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm">@(isFa ? "فعال‌سازی" : "Turn on")</button>
            </form>
        }
    </section>

    @* ---- Account sessions ---- *@
    <section class="rounded-xl border border-line bg-surface p-5 lg:col-span-2">
        <div class="flex items-start justify-between gap-4 mb-3">
            <div>
                <h2 class="text-[15px] font-semibold text-ink">@(isFa ? "امنیت حساب و دستگاه‌ها" : "Account security & devices")</h2>
                <p class="text-xs text-ink-muted mt-1">
                    @(ViewBag.EmailVerified == true
                        ? (isFa ? $"ایمیل تأییدشده: {ViewBag.AccountEmail}" : $"Verified email: {ViewBag.AccountEmail}")
                        : (isFa ? "ایمیل هنوز تأیید نشده است." : "Email is not verified yet."))
                </p>
            </div>
            <form method="post" action="/settings/sessions/revoke-others">
                @Html.AntiForgeryToken()
                <button class="btn-secondary text-sm">@(isFa ? "خروج از دستگاه‌های دیگر" : "Sign out other devices")</button>
            </form>
        </div>
        <div class="divide-y divide-line">
            @foreach (var session in sessions)
            {
                var current = session.Id.ToString().Equals(currentSession, StringComparison.OrdinalIgnoreCase);
                <div class="flex items-center justify-between gap-4 py-3 text-sm">
                    <div class="min-w-0">
                        <div class="font-medium text-ink truncate">
                            @(string.IsNullOrWhiteSpace(session.UserAgent) ? (isFa ? "دستگاه ناشناس" : "Unknown device") : session.UserAgent)
                            @if (current){<span class="ms-2 text-xs text-ok">@(isFa ? "این دستگاه" : "this device")</span>}
                        </div>
                        <div class="text-xs text-ink-faint" dir="ltr">@session.IpAddress · @session.LastSeenAt.LocalDateTime.ToString(Dates.Stamp)</div>
                    </div>
                    <form method="post" action="/settings/sessions/@session.Id/revoke">
                        @Html.AntiForgeryToken()
                        <button class="text-danger text-xs">@(isFa ? "بستن نشست" : "Revoke")</button>
                    </form>
                </div>
            }
        </div>
    </section>

    @* ---- API tokens ---- *@
    <section class="rounded-xl border border-line bg-surface p-5 lg:col-span-2">
        <h2 class="text-[15px] font-semibold text-ink mb-3">@T["API Tokens"]</h2>
        @if (newToken is not null)
        {
            <div class="rounded-lg bg-ok-soft border border-ok p-3 text-sm mb-3">
                <div class="text-ok mb-1">@(isFa ? "این توکن را همین حالا کپی کنید؛ دوباره نمایش داده نمی‌شود." : "Copy this token now — it won't be shown again.")</div>
                <code class="block break-all text-ok">@newToken</code>
            </div>
        }
        <form asp-controller="Settings" asp-action="CreateToken" method="post" class="flex gap-2 mb-3 max-w-md">
            @Html.AntiForgeryToken()
            <input name="name" placeholder="@(isFa ? "نام توکن" : "Token name")" class="flex-1 rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            <button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm font-semibold">@(isFa ? "ساخت" : "Create")</button>
        </form>
        <div class="divide-y divide-line max-w-md">
            @foreach (var t in tokens)
            {
                <div class="flex items-center justify-between py-2 text-sm">
                    <span>@t.Name <span class="text-ink-faint font-mono">@t.Prefix…</span></span>
                    <span class="text-xs text-ink-faint">@t.CreatedAt.LocalDateTime.ToString(Dates.Day)</span>
                </div>
            }
        </div>
    </section>
</div>

@section Scripts {
<script>
    (function () {
        const cur = localStorage.getItem('harbora-theme') || 'system';
        const ctl = document.getElementById('themeCtl');
        function mark() {
            const v = localStorage.getItem('harbora-theme') || 'system';
            ctl.querySelectorAll('button').forEach(b => b.classList.toggle('bg-surface-2', b.dataset.theme === v));
        }
        function apply(v) {
            localStorage.setItem('harbora-theme', v);
            const dark = v === 'dark' || (v === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.classList.toggle('dark', dark);
            mark();
        }
        ctl.querySelectorAll('button').forEach(b => b.addEventListener('click', () => apply(b.dataset.theme)));
        mark();
    })();
</script>
}
