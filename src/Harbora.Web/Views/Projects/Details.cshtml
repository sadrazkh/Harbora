@model ProjectDetailsViewModel
@{
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var msg = TempData["Message"] as string; var err = TempData["Error"] as string;
    var selected = Model.Selected;
}

<div class="mb-6">
    <a href="/projects" class="text-accent-text text-sm">← @(isFa ? "پروژه‌ها" : "Projects")</a>
    <div class="mt-1 flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-ink">@Model.Project.Name</h1>
            <p class="text-ink-muted text-sm">@Model.Project.Slug</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a href="/projects/@Model.Project.Id/architecture@(Model.Selected is null ? "" : $"?environmentId={Model.Selected.Id}")"
               class="rounded-lg bg-surface-2 hover:bg-surface-2 px-3 py-2 text-sm">@(isFa ? "معماری" : "Architecture")</a>
            <a href="/projects/@Model.Project.Id/logs@(Model.Selected is null ? "" : $"?environmentId={Model.Selected.Id}")"
               class="rounded-lg bg-surface-2 hover:bg-surface-2 px-3 py-2 text-sm">@(isFa ? "جست‌وجوی لاگ‌ها" : "Search logs")</a>
            <a href="/apps/create@(Model.Selected is null ? "" : $"?environmentId={Model.Selected.Id}")" class="rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm font-semibold">
                + @(isFa ? "سرویس" : "Service")
            </a>
            @* Carrying the environment through is what puts the new resource on the same private
               network as everything else here. Without it a database created from this page landed
               in the default environment, and attaching it afterwards was refused for being on
               another network — after it had already been provisioned. *@
            <a href="/databases/create@(Model.Selected is null ? "" : $"?environmentId={Model.Selected.Id}")"
               class="rounded-lg bg-surface-2 hover:bg-surface-2 px-3 py-2 text-sm">
                + @(isFa ? "دیتابیس" : "Database")
            </a>
            <a href="/databases/create?type=RabbitMq@(Model.Selected is null ? "" : $"&environmentId={Model.Selected.Id}")"
               class="rounded-lg bg-surface-2 hover:bg-surface-2 px-3 py-2 text-sm">
                + @(isFa ? "بروکر" : "Broker")
            </a>
        </div>
    </div>
</div>

@if (msg is not null){<div class="mb-4 rounded-lg bg-ok-soft border border-ok text-ok px-4 py-2 text-sm">@msg</div>}
@if (err is not null){<div class="mb-4 rounded-lg bg-danger-soft border border-danger text-danger px-4 py-2 text-sm">@err</div>}

@* Environments as tabs: the same project, a different independent copy. *@
<div class="mb-6 flex flex-wrap items-center gap-2 border-b border-line pb-2">
    @foreach (var e in Model.Environments)
    {
        var active = selected is not null && e.Id == selected.Id;
        <a href="/projects/@Model.Project.Id?environmentId=@e.Id"
           class="rounded-lg px-3 py-1.5 text-sm @(active ? "bg-surface-2 text-ink" : "text-ink-muted hover:text-ink")">
            @e.Name
            @if (e.IsDefault){<span class="text-[10px] text-ink-faint">@(isFa ? "پیش‌فرض" : "default")</span>}
            @* 5.2 (2026-09 market-gaps round two): visible on the tab itself, not only after
               clicking in — the whole point is that a protected environment reads differently
               everywhere it appears, the same reasoning PendingApproval's own badge follows. *@
            @if (e.IsProtected){<span class="text-[10px] text-warn" title="@(isFa ? "محافظت‌شده" : "Protected")">🔒</span>}
        </a>
    }
    <details class="relative ms-auto">
        <summary class="cursor-pointer text-sm text-accent-text list-none">+ @(isFa ? "محیط" : "Environment")</summary>
        <form asp-controller="Projects" asp-action="AddEnvironment" asp-route-id="@Model.Project.Id" method="post"
              class="absolute end-0 mt-2 w-64 rounded-xl border border-line bg-surface p-3 shadow-xl z-10 space-y-2">
            @Html.AntiForgeryToken()
            <input name="name" required placeholder="Staging"
                   class="w-full rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            <p class="text-xs text-ink-faint">
                @(isFa
                    ? "یک نسخه‌ی مستقل با متغیرها، دامنه‌ها و دیتابیس خودش."
                    : "An independent copy with its own variables, domains and databases.")
            </p>
            <button class="w-full rounded-lg bg-surface-2 hover:bg-surface-2 px-3 py-2 text-sm">@(isFa ? "افزودن" : "Add")</button>
        </form>
    </details>
    @if (selected is not null)
    {
        <a href="/projects/@Model.Project.Id/environments/@selected.Id/clone" class="text-sm text-accent-text">
            @(isFa ? "کپی این محیط" : "Copy this one")
        </a>
    }
</div>

@* ---- protected-environment toggle (5.2, 2026-09 market-gaps round two) ----
   Off by default on every environment — turning it on for a customer's production is their own
   decision, made here, not assumed anywhere upstream. *@
@if (selected is not null && ViewBag.CanManageEnvironments == true)
{
    // A plain if-cast rather than an `is { } env` pattern: Razor's tag-helper attribute codegen for
    // the section element below does not reliably see a pattern variable introduced by the @if
    // condition, and reported it as unassigned even though the null check plainly guards it.
    var env = selected!;
    <section class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-line bg-surface p-4"
              data-environment-protection data-protected="@env.IsProtected.ToString().ToLowerInvariant()">
        <div class="text-sm">
            <strong class="block text-ink">@(isFa ? "استقرار محافظت‌شده" : "Protected deploys")</strong>
            <span class="mt-0.5 block text-ink-muted">
                @(env.IsProtected
                    ? (isFa
                        ? $"استقرار به «{env.Name}» تا زمانی که یک فرد دیگر آن را تأیید نکند اجرا نمی‌شود."
                        : $"A deploy to \"{env.Name}\" does not run until a second person approves it.")
                    : (isFa
                        ? $"استقرار به «{env.Name}» بی‌درنگ اجرا می‌شود."
                        : $"A deploy to \"{env.Name}\" runs immediately."))
            </span>
        </div>
        <form asp-controller="Projects" asp-action="SetProtection"
              asp-route-id="@Model.Project.Id" asp-route-environmentId="@env.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="isProtected" value="@(!env.IsProtected)" />
            <button class="rounded-lg px-4 py-2 text-sm font-semibold @(env.IsProtected ? "border border-line-strong hover:border-danger hover:text-danger" : "bg-accent hover:bg-accent-hover text-white")">
                @(env.IsProtected
                    ? (isFa ? "خاموش کردن محافظت" : "Turn off protection")
                    : (isFa ? "محافظت از این محیط" : "Protect this environment"))
            </button>
        </form>
    </section>
}

<div class="grid lg:grid-cols-2 gap-6">
    <section class="rounded-xl border border-line bg-surface">
        <div class="px-4 py-3 border-b border-line font-semibold">@(isFa ? "سرویس‌ها" : "Services")</div>
        <div class="divide-y divide-line">
            @if (Model.Services.Count == 0)
            {
                <div class="p-6 text-center text-sm text-ink-faint">
                    @(isFa ? "هنوز سرویسی در این محیط نیست." : "No services in this environment yet.")
                </div>
            }
            @foreach (var s in Model.Services)
            {
                <a href="/apps/details/@s.Id" class="flex items-center justify-between p-3 hover:bg-surface-2">
                    <div class="min-w-0">
                        <div class="text-sm font-medium truncate">@s.Name</div>
                        <div class="text-xs text-ink-faint truncate">@s.Kind · @s.SourceType</div>
                    </div>
                    <partial name="_StatusBadge" model="s.Status" />
                </a>
            }
        </div>
    </section>

    <section class="rounded-xl border border-line bg-surface">
        <div class="px-4 py-3 border-b border-line font-semibold">@(isFa ? "دیتابیس‌ها" : "Databases")</div>
        <div class="divide-y divide-line">
            @if (Model.Databases.Count == 0)
            {
                <div class="p-6 text-center text-sm text-ink-faint">
                    @(isFa ? "دیتابیسی در این محیط نیست." : "No databases in this environment.")
                </div>
            }
            @foreach (var d in Model.Databases)
            {
                <a href="/databases/@d.Id" class="flex items-center justify-between p-3 hover:bg-surface-2">
                    <div class="min-w-0">
                        <div class="text-sm font-medium truncate">@d.Name</div>
                        <div class="text-xs text-ink-faint truncate">@d.Type · @d.Version</div>
                    </div>
                    <span class="text-xs @(d.Status == Harbora.Domain.Common.ServiceStatus.Running ? "text-ok" : "text-ink-faint")">
                        @(d.Status == Harbora.Domain.Common.ServiceStatus.Running ? "● " : "○ ")@d.Status
                    </span>
                </a>
            }
        </div>
    </section>
</div>

@* Always shown — not only when the selected environment is empty. A project can hold apps and
   databases in an environment that is not the one currently selected, and the confirm page this
   links to lists the whole project, not just this tab. *@
<section class="mt-6 rounded-xl border border-danger bg-red-950/10 p-4">
    <div class="font-semibold text-danger mb-1">@(isFa ? "منطقه‌ی خطر" : "Danger zone")</div>
    <p class="text-xs text-ink-muted mb-3">
        @(isFa
            ? "حذف پروژه، همه‌ی محیط‌ها، اپ‌ها و دیتابیس‌های آن را نیز حذف می‌کند."
            : "Deleting a project also deletes every environment, app and database inside it.")
    </p>
    <a href="/projects/@Model.Project.Id/delete"
       class="inline-block rounded-lg bg-danger-soft hover:bg-danger-soft text-danger px-4 py-2 text-sm font-semibold">
        🗑 @(isFa ? "حذف پروژه" : "Delete project")
    </a>
</section>
