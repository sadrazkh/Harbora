@model List<ProjectSummary>
@{
    ViewData["Title"] = "Projects";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var msg = TempData["Message"] as string; var err = TempData["Error"] as string;
}

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
        <h1 class="text-2xl font-bold">@(isFa ? "پروژه‌ها" : "Projects")</h1>
        <p class="text-slate-400 text-sm mt-1">
            @(isFa
                ? "هر پروژه سرویس‌ها، دیتابیس‌ها و دامنه‌هایی است که با هم یک محصول را می‌سازند."
                : "A project is the services, databases and domains that make up one product.")
        </p>
    </div>
    <details class="relative">
        <summary class="cursor-pointer rounded-lg bg-brand-600 hover:bg-brand-500 px-4 py-2 text-sm font-semibold list-none">
            + @(isFa ? "پروژه‌ی جدید" : "New project")
        </summary>
        <form asp-controller="Projects" asp-action="Create" method="post"
              class="absolute end-0 mt-2 w-72 rounded-xl border border-slate-800 bg-slate-900 p-3 shadow-xl z-10 space-y-2">
            @Html.AntiForgeryToken()
            <input name="name" required placeholder="@(isFa ? "نام پروژه" : "Project name")"
                   class="w-full rounded-lg bg-slate-800 border border-slate-700 px-3 py-2 text-sm" />
            <p class="text-xs text-slate-500">
                @(isFa ? "یک محیط Production همراهش ساخته می‌شود." : "A Production environment is created with it.")
            </p>
            <button class="w-full rounded-lg bg-brand-600 hover:bg-brand-500 px-3 py-2 text-sm font-semibold">
                @(isFa ? "بساز" : "Create")
            </button>
        </form>
    </details>
</div>

@if (msg is not null){<div class="mb-4 rounded-lg bg-emerald-900/20 border border-emerald-700 text-emerald-300 px-4 py-2 text-sm">@msg</div>}
@if (err is not null){<div class="mb-4 rounded-lg bg-red-900/20 border border-red-700 text-red-300 px-4 py-2 text-sm">@err</div>}

@if (Model.Count == 0)
{
    @* Empty state that does the one thing worth doing, rather than an empty table. *@
    <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-10 text-center">
        <p class="text-slate-300 font-medium">@(isFa ? "هنوز پروژه‌ای ندارید" : "No projects yet")</p>
        <p class="text-slate-500 text-sm mt-1">
            @(isFa ? "یک پروژه بسازید، بعد اولین سرویس را به آن اضافه کنید." : "Create a project, then add your first service to it.")
        </p>
    </div>
}
else
{
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var p in Model)
        {
            <a href="/projects/@p.Id"
               class="block rounded-xl border border-slate-800 bg-slate-900/60 p-4 hover:border-slate-700 transition">
                <div class="flex items-start justify-between gap-2">
                    <div class="min-w-0">
                        <div class="font-semibold truncate">@p.Name</div>
                        <div class="text-xs text-slate-500 truncate">@p.Slug</div>
                    </div>
                    @* Status carries an icon and a word, never colour alone. *@
                    @if (p.Unhealthy > 0)
                    {
                        <span class="shrink-0 text-xs text-red-400">✗ @p.Unhealthy @(isFa ? "خراب" : "failing")</span>
                    }
                    else if (p.Services > 0)
                    {
                        <span class="shrink-0 text-xs text-emerald-400">● @(isFa ? "سالم" : "healthy")</span>
                    }
                </div>
                <div class="mt-3 flex gap-4 text-xs text-slate-400">
                    <span>@p.Services @(isFa ? "سرویس" : "services")</span>
                    <span>@p.Databases @(isFa ? "دیتابیس" : "databases")</span>
                    <span>@p.Environments @(isFa ? "محیط" : "environments")</span>
                </div>
            </a>
        }
    </div>
}
