@model PlansPageViewModel
@using Harbora.Infrastructure.Monitoring
@using Harbora.Infrastructure.Tenancy
@{
    ViewData["Title"] = "Plans";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var u = Model.Usage;

    // Sizes are read in MB and GB, not in bytes. A plan showing "2048 MB" of memory next to
    // "21474836480" of disk is a form nobody can check their own work on.
    string Mem(long b) => b <= 0
        ? (isFa ? "نامحدود" : "unlimited")
        : b >= 1024L * 1024 * 1024 ? $"{b / 1024.0 / 1024 / 1024:0.##} GB" : $"{b / 1024 / 1024} MB";
    string Disk(long b) => b <= 0
        ? (isFa ? "نامحدود" : "unlimited")
        : $"{b / 1024.0 / 1024 / 1024:0.##} GB";
    string Count(int n) => n <= 0 ? (isFa ? "نامحدود" : "unlimited") : n.ToString();
    string Cores(double c) => c <= 0 ? (isFa ? "نامحدود" : "unlimited") : c.ToString("0.##");

    // A price, said as what it is. Blank is not zero anywhere on this screen: "not priced" is a
    // resource the hourly meter cannot charge for and an operator has to come back to, and "free"
    // is a decision somebody made. Shown in the lists as well as in the forms, because the whole
    // point of the distinction is that an unpriced tier is visible before a month of it has gone by.
    //
    // Now one shared helper rather than a local copy of the rule: the same three outcomes are printed
    // on the chooser, on both resize controls and on the bill, and a fifth copy is a fifth chance to
    // lose the distinction.
    string Rate(long? minor) => Harbora.Web.Infrastructure.RateDisplay.Hourly(minor, isFa);

    // What that rate comes to over an average month, or nothing at all when there is no honest
    // estimate. Printed only when it is there: a dash beside a real hourly figure would read as
    // "this tier costs nothing per month".
    string? Monthly(long? minor) => Harbora.Web.Infrastructure.RateDisplay.Monthly(minor, isFa);

    string RateClass(long? minor) => minor is null ? "text-warn" : "text-ink-muted";

    string FamilyLabel(string? key) => Harbora.Infrastructure.Tenancy.InstanceSizeFamily.Label(key, isFa);

    // The families the tiers on offer actually fall into, in the chooser's own order. Built from the
    // rows rather than from the constant list, so a family the provider invented gets a heading here
    // exactly as it gets a tab there.
    var familiesOnOffer = Harbora.Infrastructure.Tenancy.InstanceSizeFamily
        .Present(Model.Sizes.Select(s => s.Family));
}
<h1 class="text-2xl font-bold tracking-tight text-ink mb-1">@(isFa ? "پلن و مصرف" : "Plan &amp; Usage")</h1>
<p class="text-ink-muted text-sm mb-6">@(isFa ? "پلن فعلی:" : "Current plan:") <span class="text-ink font-medium">@u.PlanName</span>
    @if (u.Suspended){<span class="ms-2 text-xs rounded bg-danger/15 text-danger px-2 py-0.5">@(isFa ? "معلق" : "suspended")</span>}
</p>

@{
    var message = TempData["Message"] as string;
    var error = TempData["Error"] as string;
}
@if (message is not null)
{
    <div class="alert-success mb-4">@message</div>
}
@if (error is not null)
{
    <div class="alert-danger mb-4">@error</div>
}

@* ---- what this workspace is using ----
   Memory and CPU here are what has been *reserved* — the sum of the sizes given to every app and
   database — not what they are measured to be using. They were labelled plainly "Memory", which
   reads as a measurement, and the difference between the two is most of a host's capacity. Each
   card says which of the two it is. *@
<div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
    @{
        (string Label, string Note, string Text, AllocationReading Reading)[] cards =
        {
            (isFa ? "اپلیکیشن‌ها" : "Apps", isFa ? "ساخته‌شده" : "created",
                $"{u.Apps} / {Count(u.MaxApps)}", AllocationReading.OfCount(u.Apps, u.MaxApps)),
            (isFa ? "دیتابیس‌ها" : "Databases", isFa ? "ساخته‌شده" : "created",
                $"{u.Services} / {Count(u.MaxServices)}", AllocationReading.OfCount(u.Services, u.MaxServices)),
            (isFa ? "حافظه" : "Memory", isFa ? "رزروشده، نه مصرف اندازه‌گیری‌شده" : "reserved, not measured use",
                $"{Mem(u.MemoryUsedBytes)} / {Mem(u.MaxMemoryBytes)}", AllocationReading.Of(u.MemoryUsedBytes, u.MaxMemoryBytes)),
            ("CPU", isFa ? "رزروشده، نه مصرف اندازه‌گیری‌شده" : "reserved, not measured use",
                $"{u.CpuUsed:0.##} / {Cores(u.MaxCpuCores)}", AllocationReading.Of(u.CpuUsed, u.MaxCpuCores)),
            (isFa ? "دیسک" : "Disk", isFa ? "اندازه‌گیری‌شده" : "measured",
                $"{Disk(u.DiskUsedBytes)} / {Disk(u.MaxDiskBytes)}", AllocationReading.Of(u.DiskUsedBytes, u.MaxDiskBytes)),
        };
    }
    @foreach (var c in cards)
    {
        <div class="rounded-xl border border-line bg-surface p-4">
            <div class="text-ink-muted text-sm">@c.Label</div>
            <div class="mt-1 text-xl font-bold" dir="ltr">@c.Text</div>
            <div class="mt-0.5 text-[11px] text-ink-faint">@c.Note</div>
            @* No bar without a denominator. The old one drew 5% for every unlimited resource, so
               "∞" always looked very slightly full. *@
            @if (c.Reading.HasShare)
            {
                <div class="mt-2 h-1.5 rounded-full bg-surface-2 overflow-hidden">
                    <div class="h-full @(c.Reading.IsOver ? "bg-warn" : "bg-accent-hover")" style="width:@(c.Reading.Percent)%"></div>
                </div>
            }
        </div>
    }
</div>

<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
    @foreach (var item in new (string Label, int Used, int Limit)[]
    {
        (isFa ? "اعضا و دعوت‌ها" : "Members & invitations", u.Members, u.MaxMembers),
        (isFa ? "پروژه‌ها" : "Projects", u.Projects, u.MaxProjects),
        (isFa ? "محیط‌ها" : "Environments", u.Environments, u.MaxEnvironments),
        (isFa ? "دامنه‌ها" : "Domains", u.Domains, u.MaxDomains),
        (isFa ? "والیوم‌ها" : "Volumes", u.Volumes, u.MaxVolumes),
        (isFa ? "زمان‌بندی پشتیبان" : "Backup schedules", u.BackupSchedules, u.MaxBackupSchedules),
        (isFa ? "کارهای زمان‌بندی‌شده" : "Scheduled jobs", u.CronJobs, u.MaxCronJobs),
        (isFa ? "استقرارهای فعال" : "Active deployments", u.ActiveDeployments, u.MaxConcurrentDeployments)
    })
    {
        var reading = AllocationReading.OfCount(item.Used, item.Limit);
        <div class="rounded-xl border border-line bg-surface p-4">
            <div class="text-ink-muted text-sm">@item.Label</div>
            <div class="mt-1 text-xl font-bold" dir="ltr">@item.Used / @Count(item.Limit)</div>
            @if (reading.HasShare)
            {
                <div class="mt-2 h-1.5 rounded-full bg-surface-2 overflow-hidden">
                    <div class="h-full @(reading.IsOver ? "bg-warn" : "bg-accent-hover")" style="width:@(reading.Percent)%"></div>
                </div>
            }
        </div>
    }
</div>

@if (u.DiskUnmeasured > 0)
{
    @* Said rather than folded into the number. A disk figure missing half its volumes is not a
       smaller figure, it is an incomplete one. *@
    <p class="-mt-4 mb-8 text-xs text-warn">
        @(isFa
            ? $"{u.DiskUnmeasured} حجم هنوز اندازه‌گیری نشده، پس رقم دیسک کامل نیست."
            : $"{u.DiskUnmeasured} volume(s) have never been measured, so the disk figure is incomplete.")
    </p>
}

<h2 class="text-lg font-semibold text-ink mb-3">@(isFa ? "پلن‌های ارائه‌شده" : "Offered plans")</h2>
<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
    @foreach (var p in Model.Plans)
    {
        <div class="rounded-xl border border-line bg-surface p-5 @(p.IsEnabled ? "" : "opacity-60")">
            <div class="flex items-center justify-between gap-2">
                <span class="font-semibold text-lg">@(isFa ? p.NameFa : p.Name)</span>
                @if (p.MonthlyPrice > 0){<span class="text-accent-text font-semibold">$@p.MonthlyPrice<span class="text-xs text-ink-faint">/mo</span></span>}
            </div>
            @if (!p.IsEnabled)
            {
                <span class="mt-1 inline-block text-[11px] text-warn">@(isFa ? "به مشتری جدید ارائه نمی‌شود" : "not offered to new tenants")</span>
            }
            <ul class="mt-3 space-y-1 text-sm text-ink-muted">
                <li>@(isFa ? "اپلیکیشن:" : "Apps:") @Count(p.MaxApps)</li>
                <li>@(isFa ? "دیتابیس:" : "Databases:") @Count(p.MaxServices)</li>
                <li>@(isFa ? "اعضا:" : "Members:") @Count(p.MaxMembers)</li>
                <li>@(isFa ? "پروژه / محیط:" : "Projects / environments:") @Count(p.MaxProjects) / @Count(p.MaxEnvironments)</li>
                <li>@(isFa ? "دامنه / والیوم:" : "Domains / volumes:") @Count(p.MaxDomains) / @Count(p.MaxVolumes)</li>
                <li>@(isFa ? "زمان‌بندی پشتیبان:" : "Backup schedules:") @Count(p.MaxBackupSchedules)</li>
                <li>@(isFa ? "Cron / استقرار هم‌زمان:" : "Cron / concurrent deploys:") @Count(p.MaxCronJobs) / @Count(p.MaxConcurrentDeployments)</li>
                <li>@(isFa ? "نگهداری هر زمان‌بندی پشتیبان:" : "Retention per backup schedule:") @Count(p.MaxBackupRetentionCount)</li>
                <li>@(isFa ? "حافظه:" : "Memory:") @Mem(p.MaxMemoryBytes)</li>
                <li>@(isFa ? "پردازنده:" : "CPU:") @Cores(p.MaxCpuCores)</li>
                @* The plan carried a disk limit, the quota check enforced it, and the card that
                   sells the plan never mentioned it. *@
                <li>@(isFa ? "دیسک:" : "Disk:") @Disk(p.MaxDiskBytes)</li>
                @if (!string.IsNullOrWhiteSpace(p.AllowedSizeKeys)){<li>@(isFa ? "اندازه‌های مجاز:" : "Allowed sizes:") <span dir="ltr" class="font-mono text-xs">@p.AllowedSizeKeys</span></li>}
            </ul>
            @* What the hourly meter charges, next to what the caps allow. A plan can look complete
               and be unbillable, and this is the only place that difference is visible before the
               tick runs. *@
            <ul class="mt-3 space-y-1 border-t border-line pt-3 text-sm">
                <li class="@RateClass(p.BaseRatePerHourMinor)">
                    @(isFa ? "حداقل هزینهٔ هر ساعت:" : "Hourly minimum:") <span dir="ltr">@Rate(p.BaseRatePerHourMinor)</span>
                    @* The month beside the hour, because a floor per hour is not a figure anybody
                       budgets in. Absent entirely for an unpriced floor rather than shown as a
                       nought — see RateDisplay.Monthly. *@
                    @if (Monthly(p.BaseRatePerHourMinor) is { } floorMonthly)
                    {
                        <span class="block text-xs text-ink-faint" dir="ltr">@floorMonthly @(isFa ? "در ماه (تخمینی)" : "/month (estimated)")</span>
                    }
                </li>
                <li class="@RateClass(p.DiskGbHourMinor)">
                    @(isFa ? "دیسک — هر گیگابایت، هر ساعت:" : "Disk — per GB, per hour:") <span dir="ltr">@Rate(p.DiskGbHourMinor)</span>
                    @if (Monthly(p.DiskGbHourMinor) is { } diskMonthly)
                    {
                        <span class="block text-xs text-ink-faint" dir="ltr">@diskMonthly @(isFa ? "در ماه، هر گیگابایت" : "/month per GB")</span>
                    }
                </li>
                @if (p.AllowsOverage)
                {
                    <li class="text-ink-faint">
                        @(isFa ? "عبور از سقف‌های محاسباتی و دیسک مجاز است و با همان نرخ‌های بالا حساب می‌شود." : "May go past compute and disk caps, charged at the ordinary rates above.")
                    </li>
                }
            </ul>
        </div>
    }
</div>

@* ---- the tiers on offer ----
   Grouped by family rather than listed flat, so this page reads the way the chooser it describes
   does. The headings come from the rows, not from the constant list, so a family the provider
   invented gets a heading here exactly as it gets a tab there. *@
<h2 class="text-lg font-semibold text-ink mb-3">@(isFa ? "اندازه‌های منبع" : "Instance sizes")</h2>
<div class="space-y-4 mb-8">
    @foreach (var family in familiesOnOffer)
    {
        var inFamily = Model.Sizes
            .Where(s => Harbora.Infrastructure.Tenancy.InstanceSizeFamily.Normalise(s.Family) == family)
            .ToList();

        <section class="rounded-xl border border-line bg-surface overflow-hidden">
            <div class="flex items-baseline justify-between gap-2 border-b border-line bg-surface-2 px-4 py-2.5">
                <h3 class="text-sm font-semibold text-ink">@FamilyLabel(family)</h3>
                <span class="text-[11px] text-ink-faint">
                    @(isFa ? $"{inFamily.Count} اندازه" : inFamily.Count == 1 ? "1 size" : $"{inFamily.Count} sizes")
                </span>
            </div>
            <div class="divide-y divide-line">
                @foreach (var s in inFamily)
                {
                    <div class="flex flex-wrap items-center justify-between gap-3 p-3 text-sm">
                        <span class="font-medium">@(isFa ? s.NameFa : s.Name) <span class="text-ink-faint font-mono">@s.Key</span></span>
                        <span class="flex flex-wrap items-center gap-x-4 gap-y-1">
                            <span class="text-ink-muted" dir="ltr">@s.CpuCores vCPU · @Mem(s.MemoryBytes) · @Disk(s.DiskBytes)</span>
                            @* A tier with no price hosts every workload on it for nothing, and the
                               hourly tick says so to nobody. Here it is on the list an operator
                               already reads — with the month beside the hour, because an hourly
                               figure alone is not what a customer is quoted. *@
                            <span class="@RateClass(s.RunningRatePerHourMinor)">
                                @(isFa ? "در حال اجرا:" : "Running:")
                                <span dir="ltr">@Rate(s.RunningRatePerHourMinor)</span>
                                @if (Monthly(s.RunningRatePerHourMinor) is { } runMonthly)
                                {
                                    <span class="text-ink-faint" dir="ltr">(@runMonthly @(isFa ? "در ماه" : "/mo"))</span>
                                }
                            </span>
                            <span class="@RateClass(s.StoppedRatePerHourMinor)">
                                @(isFa ? "متوقف:" : "Stopped:")
                                <span dir="ltr">@Rate(s.StoppedRatePerHourMinor)</span>
                                @if (Monthly(s.StoppedRatePerHourMinor) is { } stopMonthly)
                                {
                                    <span class="text-ink-faint" dir="ltr">(@stopMonthly @(isFa ? "در ماه" : "/mo"))</span>
                                }
                            </span>
                        </span>
                    </div>
                }
            </div>
        </section>
    }
</div>

<p class="-mt-6 mb-8 text-xs text-ink-faint">
    @(isFa
        ? $"رقم ماهانه تخمینی است: نرخ ساعتی × {Harbora.Infrastructure.Billing.MonthlyEstimate.HoursPerMonth} ساعت (یک ماه میانگین). صورت‌حساب واقعی ساعت‌به‌ساعت و بر اساس همان ساعت‌هایی است که منبع روشن یا متوقف بوده."
        : $"The monthly figure is an estimate: the hourly rate × {Harbora.Infrastructure.Billing.MonthlyEstimate.HoursPerMonth} hours, an average month. The real bill is hourly, for the hours the resource was actually running or stopped.")
</p>

@if (Model.IsProvider)
{
    @* ---- editing the tiers ----
       Sizes were seeded and then read-only forever, which mattered little while a tier was CPU and
       memory and matters now that it carries a disk figure: a field nobody can set stays at
       whatever it was seeded with. *@
    <section class="mb-8 rounded-xl border border-line bg-surface p-5">
        <h2 class="text-[15px] font-semibold text-ink mb-1">@(isFa ? "ویرایش اندازه‌ها" : "Edit instance sizes")</h2>
        <p class="text-xs text-ink-faint mb-4">
            @(isFa
                ? "کلید قابل تغییر نیست: اپ‌ها و دیتابیس‌ها همان را ذخیره کرده‌اند. تغییر سقف‌ها فقط روی چیزهایی اثر دارد که بعداً روی این اندازه بروند."
                : "The key cannot change — apps and databases store it. Changing the limits affects what moves onto this tier next, not what is already on it.")
        </p>

        <div class="space-y-3">
            @foreach (var s in Model.Sizes)
            {
                <form asp-controller="Plans" asp-action="UpdateSize" asp-route-id="@s.Id" method="post"
                      class="grid gap-3 rounded-lg border border-line bg-surface-2 p-3 sm:grid-cols-4">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="form-label" for="sname-@s.Id">@(isFa ? "نام" : "Name") <code dir="ltr" class="text-[11px] font-normal text-ink-faint">@s.Key</code></label>
                        <input id="sname-@s.Id" name="name" value="@s.Name" class="form-control" />
                    </div>
                    @* Which tab of the chooser this tier appears under, and nothing else — no limit,
                       no price and no running instance is touched by moving it. A family the form does
                       not offer is kept rather than reset: it is listed as its own option below so
                       saving the row does not silently reclassify somebody's tier. *@
                    <div>
                        <label class="form-label" for="sfam-@s.Id">@(isFa ? "خانواده" : "Family")</label>
                        @{
                            var currentFamily = Harbora.Infrastructure.Tenancy.InstanceSizeFamily.Normalise(s.Family);
                            var familyOptions = Harbora.Infrastructure.Tenancy.InstanceSizeFamily.Known
                                .Contains(currentFamily)
                                ? Harbora.Infrastructure.Tenancy.InstanceSizeFamily.Known
                                : Harbora.Infrastructure.Tenancy.InstanceSizeFamily.Known.Append(currentFamily);
                        }
                        <select id="sfam-@s.Id" name="family" class="form-control">
                            @foreach (var option in familyOptions)
                            {
                                <option value="@option" selected="@(option == currentFamily)">@FamilyLabel(option)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label" for="scpu-@s.Id">@(isFa ? "هسته" : "vCPU")</label>
                        <input id="scpu-@s.Id" name="cpuCores" type="number" step="0.25" min="0" value="@s.CpuCores" class="form-control" dir="ltr" />
                    </div>
                    <div>
                        <label class="form-label" for="smem-@s.Id">@(isFa ? "حافظه (MB)" : "Memory (MB)")</label>
                        <input id="smem-@s.Id" name="memoryMb" type="number" min="0" value="@(s.MemoryBytes / 1024 / 1024)" class="form-control" dir="ltr" />
                    </div>
                    <div>
                        <label class="form-label" for="sdisk-@s.Id">@(isFa ? "دیسک (GB)" : "Disk (GB)")</label>
                        <input id="sdisk-@s.Id" name="diskGb" type="number" min="0" value="@(s.DiskBytes / 1024 / 1024 / 1024)" class="form-control" dir="ltr" />
                    </div>
                    @* Money boxes, deliberately plain text with a decimal keypad rather than
                       type="number": what is typed is read invariantly by the server, and a number
                       input hands the server whatever the browser's locale made of the keystrokes.
                       Empty is a value here — see the note under this form. *@
                    <div>
                        <label class="form-label" for="srun-@s.Id">@(isFa ? "در حال اجرا — هر ساعت" : "Running — per hour")</label>
                        <input id="srun-@s.Id" name="runningRate" value="@Harbora.Web.Infrastructure.MinorUnits.Box(s.RunningRatePerHourMinor)"
                               inputmode="decimal" autocomplete="off" class="form-control" dir="ltr"
                               placeholder="@(isFa ? "قیمت‌گذاری‌نشده" : "not priced")" />
                    </div>
                    <div>
                        <label class="form-label" for="sstop-@s.Id">@(isFa ? "متوقف — هر ساعت" : "Stopped — per hour")</label>
                        <input id="sstop-@s.Id" name="stoppedRate" value="@Harbora.Web.Infrastructure.MinorUnits.Box(s.StoppedRatePerHourMinor)"
                               inputmode="decimal" autocomplete="off" class="form-control" dir="ltr"
                               placeholder="@(isFa ? "قیمت‌گذاری‌نشده" : "not priced")" />
                    </div>
                    <div>
                        <label class="form-label" for="sorder-@s.Id">@(isFa ? "ترتیب" : "Order")</label>
                        <div class="flex items-center gap-2">
                            <input id="sorder-@s.Id" name="sortOrder" type="number" value="@s.SortOrder" class="form-control" dir="ltr" />
                            <button class="btn-primary shrink-0 px-3 py-2 text-sm">@(isFa ? "ذخیره" : "Save")</button>
                        </div>
                    </div>
                </form>
            }
        </div>

        <form asp-controller="Plans" asp-action="CreateSize" method="post"
              class="mt-4 grid gap-3 border-t border-line pt-4 sm:grid-cols-4">
            @Html.AntiForgeryToken()
            <div>
                <label class="form-label" for="new-size-key">@(isFa ? "کلید" : "Key")</label>
                <input id="new-size-key" name="key" required class="form-control font-mono" dir="ltr" placeholder="xlarge" />
            </div>
            <div>
                <label class="form-label" for="new-size-name">@(isFa ? "نام" : "Name")</label>
                <input id="new-size-name" name="name" class="form-control" placeholder="X-Large" />
            </div>
            <div>
                <label class="form-label" for="new-size-family">@(isFa ? "خانواده" : "Family")</label>
                <select id="new-size-family" name="family" class="form-control">
                    @foreach (var option in Harbora.Infrastructure.Tenancy.InstanceSizeFamily.Known)
                    {
                        <option value="@option">@FamilyLabel(option)</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label" for="new-size-cpu">@(isFa ? "هسته" : "vCPU")</label>
                <input id="new-size-cpu" name="cpuCores" type="number" step="0.25" min="0" value="8" class="form-control" dir="ltr" />
            </div>
            <div>
                <label class="form-label" for="new-size-mem">@(isFa ? "حافظه (MB)" : "Memory (MB)")</label>
                <input id="new-size-mem" name="memoryMb" type="number" min="0" value="8192" class="form-control" dir="ltr" />
            </div>
            <div>
                <label class="form-label" for="new-size-run">@(isFa ? "در حال اجرا — هر ساعت" : "Running — per hour")</label>
                <input id="new-size-run" name="runningRate" inputmode="decimal" autocomplete="off" class="form-control" dir="ltr"
                       placeholder="@(isFa ? "قیمت‌گذاری‌نشده" : "not priced")" />
            </div>
            <div>
                <label class="form-label" for="new-size-stop">@(isFa ? "متوقف — هر ساعت" : "Stopped — per hour")</label>
                <input id="new-size-stop" name="stoppedRate" inputmode="decimal" autocomplete="off" class="form-control" dir="ltr"
                       placeholder="@(isFa ? "قیمت‌گذاری‌نشده" : "not priced")" />
            </div>
            <div>
                <label class="form-label" for="new-size-disk">@(isFa ? "دیسک (GB)" : "Disk (GB)")</label>
                <div class="flex items-center gap-2">
                    <input id="new-size-disk" name="diskGb" type="number" min="0" value="160" class="form-control" dir="ltr" />
                    <input name="sortOrder" type="hidden" value="99" />
                    <button class="btn-secondary shrink-0 px-3 py-2 text-sm">@(isFa ? "افزودن" : "Add")</button>
                </div>
            </div>
        </form>
        <p class="mt-2 text-xs text-ink-faint">@(isFa ? "۰ در هر سقف یعنی بدون محدودیت." : "0 in any limit means no ceiling.")</p>
        @* Said explicitly, because it is the opposite of the line above it and the two boxes sit
           in the same row. A cap of zero is a decision not to cap; a price left blank is not a
           decision to charge nothing. *@
        <p class="mt-1 text-xs text-ink-faint">
            @(isFa
                ? "در جعبه‌های قیمت، خالی یعنی «قیمت‌گذاری‌نشده» — نه رایگان. برای رایگان بودن عمدی، ۰ بنویسید."
                : "In a price box, empty means 'not priced' — not free. Type 0 for deliberately free.")
        </p>
    </section>
}

@if (Model.IsProvider && Model.ServerPrices.Count > 0)
{
    @* ---- what each server charges ----
       A rate used to belong to a tier alone, which is right while every host is interchangeable and
       wrong the moment one of them is a memory-heavy box that cost twice as much.

       The trap on this screen, said where it bites: an empty price box means "not priced" in every
       other form above, and means "inherit the tier's rate" here. Those are opposite meanings in
       identical controls, and a note under a grid is not where somebody scanning one will read the
       difference — so each empty box prints the figure it would inherit as its own placeholder. *@
    <section class="mb-8 rounded-xl border border-line bg-surface p-5">
        <h2 class="text-[15px] font-semibold text-ink mb-1">@(isFa ? "قیمت هر سرور" : "What each server charges")</h2>
        <p class="text-xs text-ink-faint mb-1">
            @(isFa
                ? "همان اندازه می‌تواند روی سرورهای مختلف قیمت متفاوتی داشته باشد. جعبهٔ خالی یعنی «همان نرخ سراسری اندازه» — که با معنای خالی در فرم‌های بالا فرق دارد؛ نرخی که به ارث می‌رسد داخل خودِ جعبه نوشته شده است."
                : "The same tier may cost different money on different servers. An empty box here means \"inherit the tier's own rate\" — which is NOT what an empty box means in the forms above; the figure it would inherit is printed inside the box.")
        </p>
        <p class="text-xs text-ink-faint mb-4">
            @(isFa
                ? "برداشتن تیک «ارائه می‌شود» فقط جلوی کارهای جدید را می‌گیرد. چیزی که همین حالا آنجا اجرا می‌شود متوقف نمی‌شود و با همان نرخش حساب می‌شود."
                : "Clearing \"offered\" only stops new work. Nothing already running there is stopped, and it goes on being charged at its rate.")
        </p>

        <div class="space-y-5">
            @foreach (var row in Model.ServerPrices)
            {
                <div class="rounded-lg border border-line bg-surface-2 p-3">
                    <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
                        <h3 class="text-sm font-semibold text-ink">
                            @row.Name
                            <span class="font-mono text-[11px] font-normal text-ink-faint" dir="ltr">@row.Hostname</span>
                            @if (row.IsLocal)
                            {
                                <span class="status-pill bg-accent-soft text-accent-text">@(isFa ? "همین سرور" : "this server")</span>
                            }
                        </h3>
                        @* The families this box actually offers, derived rather than stored. A server
                           badged "memory-optimised" in a column of its own could contradict the tiers
                           it offers, and nothing would report the disagreement. *@
                        @{
                            var offeredFamilies = Harbora.Infrastructure.Tenancy.InstanceSizeFamily
                                .Present(row.Cells.Where(c => c.IsOffered).Select(c => c.Family));
                        }
                        <span class="flex flex-wrap gap-1">
                            @if (offeredFamilies.Count == 0)
                            {
                                <span class="status-pill bg-warn-soft text-warn">
                                    @(isFa ? "هیچ اندازه‌ای ارائه نمی‌شود" : "offers nothing")
                                </span>
                            }
                            else
                            {
                                @foreach (var family in offeredFamilies)
                                {
                                    <span class="status-pill bg-surface text-ink-muted">@FamilyLabel(family)</span>
                                }
                            }
                        </span>
                    </div>

                    <div class="space-y-2">
                        @foreach (var cell in row.Cells)
                        {
                            <form asp-controller="Plans" asp-action="SetServerPrice"
                                  asp-route-serverId="@row.ServerId" asp-route-sizeKey="@cell.SizeKey"
                                  method="post"
                                  class="grid items-end gap-2 rounded-lg border border-line bg-surface p-2.5 sm:grid-cols-[minmax(0,1fr)_auto_auto_auto]">
                                @Html.AntiForgeryToken()

                                <div class="min-w-0">
                                    <div class="truncate text-sm text-ink">
                                        @cell.SizeName
                                        <code class="text-[11px] text-ink-faint" dir="ltr">@cell.SizeKey</code>
                                    </div>
                                    @* The effective figure, so an operator does not have to resolve
                                       the precedence in their head across two columns. *@
                                    <div class="text-[11px] text-ink-faint" dir="ltr">
                                        @FamilyLabel(cell.Family) ·
                                        @Harbora.Web.Infrastructure.RateDisplay.HourlyAndMonthly(cell.EffectiveRunningMinor, isFa)
                                    </div>
                                </div>

                                <div>
                                    <label class="form-label" for="offer-@row.ServerId-@cell.SizeKey">
                                        @(isFa ? "ارائه می‌شود" : "Offered")
                                    </label>
                                    @* A hidden false before the checkbox: an unchecked box posts
                                       nothing at all, and the action would then read the missing value
                                       as false only by accident of model binding. Said explicitly, so
                                       withdrawing a tier is a value somebody sent. *@
                                    <input type="hidden" name="offered" value="false" />
                                    <input id="offer-@row.ServerId-@cell.SizeKey" type="checkbox"
                                           name="offered" value="true" checked="@cell.IsOffered"
                                           class="mt-2 block" />
                                </div>

                                <div>
                                    <label class="form-label" for="srun-@row.ServerId-@cell.SizeKey">
                                        @(isFa ? "در حال اجرا — هر ساعت" : "Running — per hour")
                                    </label>
                                    <input id="srun-@row.ServerId-@cell.SizeKey" name="runningRate"
                                           value="@Harbora.Web.Infrastructure.MinorUnits.Box(cell.RunningMinor)"
                                           inputmode="decimal" autocomplete="off" class="form-control w-32" dir="ltr"
                                           placeholder="@(cell.InheritedRunningMinor is { } inheritedRun
                                               ? $"{Harbora.Web.Infrastructure.MinorUnits.Format(inheritedRun)} ({(isFa ? "سراسری" : "global")})"
                                               : (isFa ? "سراسری: قیمت‌گذاری‌نشده" : "global: not priced"))" />
                                </div>

                                <div>
                                    <label class="form-label" for="sstop-@row.ServerId-@cell.SizeKey">
                                        @(isFa ? "متوقف — هر ساعت" : "Stopped — per hour")
                                    </label>
                                    <div class="flex items-center gap-2">
                                        <input id="sstop-@row.ServerId-@cell.SizeKey" name="stoppedRate"
                                               value="@Harbora.Web.Infrastructure.MinorUnits.Box(cell.StoppedMinor)"
                                               inputmode="decimal" autocomplete="off" class="form-control w-32" dir="ltr"
                                               placeholder="@(cell.InheritedStoppedMinor is { } inheritedStop
                                                   ? $"{Harbora.Web.Infrastructure.MinorUnits.Format(inheritedStop)} ({(isFa ? "سراسری" : "global")})"
                                                   : (isFa ? "سراسری: قیمت‌گذاری‌نشده" : "global: not priced"))" />
                                        <button class="btn-primary shrink-0 px-3 py-2 text-sm">@(isFa ? "ذخیره" : "Save")</button>
                                    </div>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
}

@if (Model.IsProvider)
{
    @* ---- the fields, said once ----
       Both forms below use the same labels and the same units. The edit form used to be eight bare
       boxes in a four-column grid with a legend underneath, so working out which box was memory
       meant counting along a row that wrapped. *@
    <section class="rounded-xl border border-line bg-surface p-5 max-w-3xl">
        <h2 class="text-[15px] font-semibold text-ink mb-1">@(isFa ? "ساخت پلن جدید" : "Create a plan")</h2>
        <p class="text-xs text-ink-faint mb-4">@(isFa ? "در هر سقفی، ۰ یعنی نامحدود." : "In any limit, 0 means unlimited.")</p>

        <form asp-controller="Plans" asp-action="CreatePlan" method="post" class="grid gap-4 sm:grid-cols-2">
            @Html.AntiForgeryToken()

            <div>
                <label class="form-label" for="new-name">@(isFa ? "نام پلن" : "Plan name")</label>
                <input id="new-name" name="name" required class="form-control" placeholder="@(isFa ? "مثلاً: استاندارد" : "e.g. Standard")" />
            </div>
            <div>
                <label class="form-label" for="new-price">@(isFa ? "قیمت ماهانه" : "Monthly price")</label>
                <input id="new-price" name="monthlyPrice" type="number" step="0.01" min="0" value="0" class="form-control" dir="ltr" />
                <p class="mt-1 text-xs text-ink-faint">@(isFa ? "به دلار. ۰ یعنی رایگان." : "In dollars. 0 is free.")</p>
            </div>
            <div>
                <label class="form-label" for="new-apps">@(isFa ? "حداکثر تعداد اپلیکیشن" : "Maximum applications")</label>
                <input id="new-apps" name="maxApps" type="number" min="0" value="1" class="form-control" dir="ltr" />
            </div>
            <div>
                <label class="form-label" for="new-services">@(isFa ? "حداکثر تعداد دیتابیس" : "Maximum databases")</label>
                <input id="new-services" name="maxServices" type="number" min="0" value="1" class="form-control" dir="ltr" />
            </div>
            <div><label class="form-label" for="new-members">@(isFa ? "حداکثر اعضا و دعوت‌ها" : "Maximum members & invitations")</label><input id="new-members" name="maxMembers" type="number" min="0" value="3" class="form-control" dir="ltr" /></div>
            <div><label class="form-label" for="new-projects">@(isFa ? "حداکثر پروژه‌ها" : "Maximum projects")</label><input id="new-projects" name="maxProjects" type="number" min="0" value="3" class="form-control" dir="ltr" /></div>
            <div><label class="form-label" for="new-environments">@(isFa ? "حداکثر محیط‌ها" : "Maximum environments")</label><input id="new-environments" name="maxEnvironments" type="number" min="0" value="6" class="form-control" dir="ltr" /></div>
            <div><label class="form-label" for="new-domains">@(isFa ? "حداکثر دامنه‌ها" : "Maximum domains")</label><input id="new-domains" name="maxDomains" type="number" min="0" value="5" class="form-control" dir="ltr" /></div>
            <div><label class="form-label" for="new-volumes">@(isFa ? "حداکثر والیوم‌ها" : "Maximum volumes")</label><input id="new-volumes" name="maxVolumes" type="number" min="0" value="5" class="form-control" dir="ltr" /></div>
            <div><label class="form-label" for="new-backup-schedules">@(isFa ? "حداکثر زمان‌بندی پشتیبان" : "Maximum backup schedules")</label><input id="new-backup-schedules" name="maxBackupSchedules" type="number" min="0" value="2" class="form-control" dir="ltr" /></div>
            <div><label class="form-label" for="new-cron-jobs">@(isFa ? "حداکثر کارهای Cron" : "Maximum cron jobs")</label><input id="new-cron-jobs" name="maxCronJobs" type="number" min="0" value="2" class="form-control" dir="ltr" /></div>
            <div><label class="form-label" for="new-concurrent-deployments">@(isFa ? "حداکثر استقرار هم‌زمان" : "Maximum concurrent deployments")</label><input id="new-concurrent-deployments" name="maxConcurrentDeployments" type="number" min="0" value="1" class="form-control" dir="ltr" /></div>
            <div><label class="form-label" for="new-backup-retention">@(isFa ? "حداکثر نسخه نگهداری‌شده در هر زمان‌بندی" : "Maximum retained backups per schedule")</label><input id="new-backup-retention" name="maxBackupRetentionCount" type="number" min="0" value="7" class="form-control" dir="ltr" /></div>
            <div>
                <label class="form-label" for="new-memory">@(isFa ? "حافظه — مگابایت (MB)" : "Memory — megabytes (MB)")</label>
                <input id="new-memory" name="maxMemoryMb" type="number" min="0" value="1024" class="form-control" dir="ltr" />
                <p class="mt-1 text-xs text-ink-faint">
                    @(isFa
                        ? "مجموع حافظهٔ رزروشدهٔ همهٔ اپ‌ها و دیتابیس‌های این مشتری. ۱۰۲۴ یعنی ۱ گیگابایت."
                        : "The total reserved by all of this tenant's apps and databases. 1024 is 1 GB.")
                </p>
            </div>
            <div>
                <label class="form-label" for="new-cpu">@(isFa ? "پردازنده — تعداد هسته" : "CPU — cores")</label>
                <input id="new-cpu" name="maxCpu" type="number" step="0.25" min="0" value="1" class="form-control" dir="ltr" />
                <p class="mt-1 text-xs text-ink-faint">@(isFa ? "اعشاری مجاز است؛ ۰٫۵ یعنی نصف یک هسته." : "Fractions are fine; 0.5 is half a core.")</p>
            </div>
            <div>
                <label class="form-label" for="new-disk">@(isFa ? "دیسک — گیگابایت (GB)" : "Disk — gigabytes (GB)")</label>
                <input id="new-disk" name="maxDiskGb" type="number" min="0" value="0" class="form-control" dir="ltr" />
            </div>
            <div>
                <label class="form-label" for="new-sizes">@(isFa ? "اندازه‌های مجاز" : "Allowed instance sizes")</label>
                <input id="new-sizes" name="allowedSizeKeys" class="form-control font-mono" dir="ltr" placeholder="nano,micro,small" />
                <p class="mt-1 text-xs text-ink-faint">
                    @(isFa ? "با ویرگول جدا کنید. خالی یعنی همهٔ اندازه‌ها مجازند." : "Comma separated. Empty means every size is allowed.")
                    @if (Model.Sizes.Count > 0)
                    {
                        <span dir="ltr" class="font-mono">(@string.Join(", ", Model.Sizes.Select(s => s.Key)))</span>
                    }
                </p>
            </div>

            @* ---- what the meter charges, as opposed to what the card advertises ----
               The monthly price above is display only and nothing collects it. These two are the
               hourly meter, and until one of them is set this plan bills nobody. *@
            <div class="sm:col-span-2 border-t border-line pt-4">
                <h3 class="text-sm font-semibold text-ink">@(isFa ? "نرخ‌های ساعتی" : "Hourly rates")</h3>
                <p class="mt-1 text-xs text-ink-faint">
                    @(isFa
                        ? "این‌ها همان چیزی است که هر ساعت از موجودی مشتری کم می‌شود. «قیمت ماهانه» بالا فقط نمایشی است و چیزی از آن برداشت نمی‌شود."
                        : "These are what is taken from the customer's balance each hour. The monthly price above is display only and nothing collects it.")
                </p>
            </div>
            <div>
                <label class="form-label" for="new-base-rate">@(isFa ? "حداقل هزینهٔ هر ساعت" : "Hourly minimum")</label>
                <input id="new-base-rate" name="baseRatePerHour" inputmode="decimal" autocomplete="off" class="form-control" dir="ltr"
                       placeholder="@(isFa ? "قیمت‌گذاری‌نشده" : "not priced")" />
                <p class="mt-1 text-xs text-ink-faint">
                    @(isFa
                        ? "کف پرداخت: مشتری این پلن دست‌کم این مبلغ را در هر ساعت می‌پردازد، حتی وقتی چیزی اجرا نمی‌کند."
                        : "The floor: a tenant on this plan pays at least this much per hour, even running nothing.")
                </p>
            </div>
            <div>
                <label class="form-label" for="new-disk-rate">@(isFa ? "دیسک — هر گیگابایت، هر ساعت" : "Disk — per GB, per hour")</label>
                <input id="new-disk-rate" name="diskGbHour" inputmode="decimal" autocomplete="off" class="form-control" dir="ltr"
                       placeholder="@(isFa ? "قیمت‌گذاری‌نشده" : "not priced")" />
                <p class="mt-1 text-xs text-ink-faint">
                    @(isFa
                        ? "بابت هر گیگابایت حجم اختصاص‌یافته، رو به بالا گرد می‌شود."
                        : "Charged per gibibyte of allocated volume, rounded up.")
                </p>
            </div>
            <div class="sm:col-span-2">
                <label class="flex items-start gap-2 text-sm text-ink">
                    <input type="checkbox" name="allowsOverage" value="true" class="mt-0.5" />
                    <span>
                        @(isFa ? "اجازهٔ عبور از سقف‌های محاسباتی و دیسک" : "Let tenants go past compute and disk caps")
                        <span class="mt-1 block text-xs text-ink-faint">
                            @(isFa
                                ? "مازاد با همان نرخ‌های بالا حساب می‌شود، نه با نرخ جریمه‌ای جدا. تا وقتی صورت‌حساب ساعتی روشن نشده باشد این گزینه هیچ کاری نمی‌کند و سقف‌ها همچنان دیوارند. سقف پلن تنها چیزی است که ظرفیت سرور را محدود می‌کند، پس پلنی که از سقف عبور می‌کند بهتر است به یک استخر سرور مشخص بسته شود."
                                : "The excess is charged at the ordinary rates above, not at a separate burst rate. Member/project/domain/volume-count/backup-schedule limits remain hard walls. This does nothing until hourly billing is switched on — until then the caps are still walls. An overage plan is best pinned to a node pool.")
                        </span>
                    </span>
                </label>
            </div>

            <div class="sm:col-span-2"><button class="btn-primary px-4 py-2">@(isFa ? "ساخت پلن" : "Create plan")</button></div>
        </form>
        <p class="mt-3 text-xs text-ink-faint">
            @(isFa
                ? "در جعبه‌های قیمت، خالی یعنی «قیمت‌گذاری‌نشده» — نه رایگان. برای رایگان بودن عمدی، ۰ بنویسید."
                : "In a price box, empty means 'not priced' — not free. Type 0 for deliberately free.")
        </p>
    </section>

    @* ---- correcting a plan ----
       Plans could only be created, so a wrong limit or a changed price meant a new plan and moving
       every tenant across by hand. *@
    <section class="mt-8 rounded-xl border border-line bg-surface p-5">
        <h2 class="text-[15px] font-semibold text-ink mb-1">@(isFa ? "ویرایش پلن‌های موجود" : "Edit existing plans")</h2>
        <p class="text-xs text-ink-faint mb-4">
            @(isFa
                ? "کم کردن یک سقف چیزی را از مشتری نمی‌گیرد: آنچه دارد می‌ماند و فقط نمی‌تواند مورد تازه‌ای اضافه کند."
                : "Lowering a limit takes nothing away: a tenant keeps what they have and simply cannot add more.")
        </p>

        <div class="space-y-4">
            @foreach (var p in Model.Plans)
            {
                @* One open card per plan rather than an accordion. A payment surface that hides what
                   it charges behind a disclosure triangle makes checking two plans against each other
                   a matter of remembering the first one — and the figures were already on the summary
                   line precisely because nobody wanted to open the form to read them. *@
                <div class="rounded-xl border border-line bg-surface-2">
                    <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
                        <span class="flex items-center gap-2">
                            <strong class="text-sm text-ink">@(isFa ? p.NameFa : p.Name)</strong>
                            @if (p.IsDefault)
                            {
                                <span class="status-pill bg-accent-soft text-accent-text">@(isFa ? "پیش‌فرض" : "default")</span>
                            }
                            @if (!p.IsEnabled)
                            {
                                <span class="status-pill bg-warn-soft text-warn">@(isFa ? "برداشته‌شده" : "withdrawn")</span>
                            }
                        </span>
                        @* The heading line still carries the figures. It was written when the form
                           below was folded away, and it earns its place either way: it is the row
                           somebody scans when comparing plans, and the boxes below are what they
                           change once they have found the one they meant. *@
                        <span class="flex flex-wrap items-baseline gap-x-3 text-xs text-ink-muted" dir="ltr">
                            <span>@Count(p.MaxApps) apps · @Count(p.MaxServices) db · @Mem(p.MaxMemoryBytes) · @Cores(p.MaxCpuCores) vCPU · @Disk(p.MaxDiskBytes)</span>
                            <span class="@RateClass(p.BaseRatePerHourMinor)">
                                @Harbora.Web.Infrastructure.RateDisplay.HourlyAndMonthly(p.BaseRatePerHourMinor, isFa)
                            </span>
                        </span>
                    </div>

                    <div class="border-t border-line p-4">
                        <form asp-controller="Plans" asp-action="UpdatePlan" asp-route-id="@p.Id" method="post"
                              class="grid gap-4 sm:grid-cols-2">
                            @Html.AntiForgeryToken()

                            <div>
                                <label class="form-label" for="name-@p.Id">@(isFa ? "نام پلن" : "Plan name")</label>
                                <input id="name-@p.Id" name="name" value="@p.Name" required class="form-control" />
                            </div>
                            <div>
                                <label class="form-label" for="price-@p.Id">@(isFa ? "قیمت ماهانه" : "Monthly price")</label>
                                <input id="price-@p.Id" name="monthlyPrice" type="number" step="0.01" min="0" value="@p.MonthlyPrice" class="form-control" dir="ltr" />
                            </div>
                            <div>
                                <label class="form-label" for="apps-@p.Id">@(isFa ? "حداکثر تعداد اپلیکیشن" : "Maximum applications")</label>
                                <input id="apps-@p.Id" name="maxApps" type="number" min="0" value="@p.MaxApps" class="form-control" dir="ltr" />
                            </div>
                            <div>
                                <label class="form-label" for="services-@p.Id">@(isFa ? "حداکثر تعداد دیتابیس" : "Maximum databases")</label>
                                <input id="services-@p.Id" name="maxServices" type="number" min="0" value="@p.MaxServices" class="form-control" dir="ltr" />
                            </div>
                            <div><label class="form-label" for="members-@p.Id">@(isFa ? "اعضا و دعوت‌ها" : "Members & invitations")</label><input id="members-@p.Id" name="maxMembers" type="number" min="0" value="@p.MaxMembers" class="form-control" dir="ltr" /></div>
                            <div><label class="form-label" for="projects-@p.Id">@(isFa ? "پروژه‌ها" : "Projects")</label><input id="projects-@p.Id" name="maxProjects" type="number" min="0" value="@p.MaxProjects" class="form-control" dir="ltr" /></div>
                            <div><label class="form-label" for="environments-@p.Id">@(isFa ? "محیط‌ها" : "Environments")</label><input id="environments-@p.Id" name="maxEnvironments" type="number" min="0" value="@p.MaxEnvironments" class="form-control" dir="ltr" /></div>
                            <div><label class="form-label" for="domains-@p.Id">@(isFa ? "دامنه‌ها" : "Domains")</label><input id="domains-@p.Id" name="maxDomains" type="number" min="0" value="@p.MaxDomains" class="form-control" dir="ltr" /></div>
                            <div><label class="form-label" for="volumes-@p.Id">@(isFa ? "والیوم‌ها" : "Volumes")</label><input id="volumes-@p.Id" name="maxVolumes" type="number" min="0" value="@p.MaxVolumes" class="form-control" dir="ltr" /></div>
                            <div><label class="form-label" for="backup-schedules-@p.Id">@(isFa ? "زمان‌بندی پشتیبان" : "Backup schedules")</label><input id="backup-schedules-@p.Id" name="maxBackupSchedules" type="number" min="0" value="@p.MaxBackupSchedules" class="form-control" dir="ltr" /></div>
                            <div><label class="form-label" for="cron-jobs-@p.Id">@(isFa ? "کارهای Cron" : "Cron jobs")</label><input id="cron-jobs-@p.Id" name="maxCronJobs" type="number" min="0" value="@p.MaxCronJobs" class="form-control" dir="ltr" /></div>
                            <div><label class="form-label" for="concurrent-deployments-@p.Id">@(isFa ? "استقرار هم‌زمان" : "Concurrent deployments")</label><input id="concurrent-deployments-@p.Id" name="maxConcurrentDeployments" type="number" min="0" value="@p.MaxConcurrentDeployments" class="form-control" dir="ltr" /></div>
                            <div><label class="form-label" for="backup-retention-@p.Id">@(isFa ? "نگهداری پشتیبان در هر زمان‌بندی" : "Backups retained per schedule")</label><input id="backup-retention-@p.Id" name="maxBackupRetentionCount" type="number" min="0" value="@p.MaxBackupRetentionCount" class="form-control" dir="ltr" /></div>
                            <div>
                                <label class="form-label" for="memory-@p.Id">@(isFa ? "حافظه — مگابایت (MB)" : "Memory — megabytes (MB)")</label>
                                <input id="memory-@p.Id" name="maxMemoryMb" type="number" min="0" value="@(p.MaxMemoryBytes / 1024 / 1024)" class="form-control" dir="ltr" />
                                <p class="mt-1 text-xs text-ink-faint">@(isFa ? $"الان: {Mem(p.MaxMemoryBytes)}" : $"Currently {Mem(p.MaxMemoryBytes)}")</p>
                            </div>
                            <div>
                                <label class="form-label" for="cpu-@p.Id">@(isFa ? "پردازنده — تعداد هسته" : "CPU — cores")</label>
                                <input id="cpu-@p.Id" name="maxCpu" type="number" step="0.25" min="0" value="@p.MaxCpuCores" class="form-control" dir="ltr" />
                            </div>
                            <div>
                                <label class="form-label" for="disk-@p.Id">@(isFa ? "دیسک — گیگابایت (GB)" : "Disk — gigabytes (GB)")</label>
                                <input id="disk-@p.Id" name="maxDiskGb" type="number" min="0" value="@(p.MaxDiskBytes / 1024 / 1024 / 1024)" class="form-control" dir="ltr" />
                            </div>
                            <div>
                                <label class="form-label" for="sizes-@p.Id">@(isFa ? "اندازه‌های مجاز" : "Allowed instance sizes")</label>
                                <input id="sizes-@p.Id" name="allowedSizeKeys" value="@p.AllowedSizeKeys" class="form-control font-mono" dir="ltr" placeholder="nano,micro,small" />
                                <p class="mt-1 text-xs text-ink-faint">@(isFa ? "خالی یعنی همهٔ اندازه‌ها." : "Empty means every size.")</p>
                            </div>

                            <div class="sm:col-span-2 border-t border-line pt-4">
                                <h3 class="text-sm font-semibold text-ink">@(isFa ? "نرخ‌های ساعتی" : "Hourly rates")</h3>
                                <p class="mt-1 text-xs text-ink-faint">
                                    @(isFa
                                        ? "خالی یعنی «قیمت‌گذاری‌نشده» — نه رایگان. برای رایگان بودن عمدی، ۰ بنویسید."
                                        : "Empty means 'not priced' — not free. Type 0 for deliberately free.")
                                </p>
                            </div>
                            <div>
                                <label class="form-label" for="base-rate-@p.Id">@(isFa ? "حداقل هزینهٔ هر ساعت" : "Hourly minimum")</label>
                                <input id="base-rate-@p.Id" name="baseRatePerHour" value="@Harbora.Web.Infrastructure.MinorUnits.Box(p.BaseRatePerHourMinor)"
                                       inputmode="decimal" autocomplete="off" class="form-control" dir="ltr"
                                       placeholder="@(isFa ? "قیمت‌گذاری‌نشده" : "not priced")" />
                            </div>
                            <div>
                                <label class="form-label" for="disk-rate-@p.Id">@(isFa ? "دیسک — هر گیگابایت، هر ساعت" : "Disk — per GB, per hour")</label>
                                <input id="disk-rate-@p.Id" name="diskGbHour" value="@Harbora.Web.Infrastructure.MinorUnits.Box(p.DiskGbHourMinor)"
                                       inputmode="decimal" autocomplete="off" class="form-control" dir="ltr"
                                       placeholder="@(isFa ? "قیمت‌گذاری‌نشده" : "not priced")" />
                            </div>
                            <div class="sm:col-span-2">
                                <label class="flex items-start gap-2 text-sm text-ink">
                                    <input type="checkbox" name="allowsOverage" value="true" class="mt-0.5" checked="@p.AllowsOverage" />
                                    <span>
                                        @(isFa ? "اجازهٔ عبور از سقف‌های محاسباتی و دیسک" : "Let tenants go past compute and disk caps")
                                        <span class="mt-1 block text-xs text-ink-faint">
                                            @(isFa
                                                ? "مازاد با همان نرخ‌های بالا حساب می‌شود، نه با نرخ جریمه‌ای جدا. تا وقتی صورت‌حساب ساعتی روشن نشده باشد این گزینه هیچ کاری نمی‌کند."
                                                : "The excess is charged at the ordinary rates above. Governance limits remain hard walls. This does nothing until hourly billing is switched on.")
                                        </span>
                                    </span>
                                </label>
                            </div>

                            <div class="sm:col-span-2">
                                <button class="btn-primary px-4 py-2">@(isFa ? "ذخیرهٔ تغییرات" : "Save changes")</button>
                            </div>
                        </form>

                        <form asp-controller="Plans" asp-action="SetEnabled" asp-route-id="@p.Id" method="post" class="mt-3 border-t border-line pt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="enabled" value="@((!p.IsEnabled).ToString().ToLowerInvariant())" />
                            <button class="text-xs @(p.IsEnabled ? "text-warn" : "text-ok")">
                                @(p.IsEnabled
                                    ? (isFa ? "برداشتن از فهرست پلن‌های جدید" : "withdraw from new tenants")
                                    : (isFa ? "در دسترس کردن دوباره" : "make available again"))
                            </button>
                            <p class="mt-1 text-[11px] text-ink-faint">
                                @(isFa
                                    ? "مشتری‌هایی که روی این پلن هستند تغییری نمی‌کنند؛ تا وقتی کسی روی آن باشد برداشتن رد می‌شود."
                                    : "Tenants on this plan are unaffected, and withdrawing is refused while anybody is on it.")
                            </p>
                        </form>
                    </div>
                </div>
            }
        </div>
    </section>

    @* ---- object storage tiers ----
       Their own list rather than a column on the plans above: storage is bought in different
       amounts from memory, by people who may not want more memory at all. *@
    @if (Model.StoragePlans.Count > 0)
    {
        <section class="mb-8 rounded-xl border border-line bg-surface p-5">
            <h2 class="text-[15px] font-semibold text-ink mb-1">@(isFa ? "پلن‌های فضای ذخیره‌سازی" : "Object storage plans")</h2>
            <p class="text-xs text-ink-faint mb-4">
                @(isFa
                    ? "باکت‌هایی که از قبل ساخته شده‌اند همان سقفی را که موقع ساخت گرفته‌اند نگه می‌دارند."
                    : "Buckets already created keep the quota they were given.")
            </p>

            <div class="space-y-3">
                @foreach (var sp in Model.StoragePlans)
                {
                    <form asp-controller="Plans" asp-action="UpdateStoragePlan" asp-route-id="@sp.Id" method="post"
                          class="grid gap-3 rounded-lg border border-line bg-surface-2 p-3 sm:grid-cols-4">
                        @Html.AntiForgeryToken()
                        <div>
                            <label class="form-label" for="spname-@sp.Id">@(isFa ? "نام" : "Name")</label>
                            <input id="spname-@sp.Id" name="name" value="@sp.Name" class="form-control" />
                        </div>
                        <div>
                            <label class="form-label" for="spquota-@sp.Id">@(isFa ? "سقف هر باکت (GB)" : "Quota per bucket (GB)")</label>
                            <input id="spquota-@sp.Id" name="quotaGb" type="number" min="0" value="@(sp.QuotaBytes / 1024 / 1024 / 1024)" class="form-control" dir="ltr" />
                        </div>
                        <div>
                            <label class="form-label" for="spmax-@sp.Id">@(isFa ? "حداکثر تعداد باکت" : "Maximum buckets")</label>
                            <input id="spmax-@sp.Id" name="maxBuckets" type="number" min="0" value="@sp.MaxBuckets" class="form-control" dir="ltr" />
                        </div>
                        <div>
                            <label class="form-label" for="spprice-@sp.Id">@(isFa ? "قیمت ماهانه" : "Monthly price")</label>
                            <div class="flex items-center gap-2">
                                <input id="spprice-@sp.Id" name="monthlyPrice" type="number" step="0.01" min="0" value="@sp.MonthlyPrice" class="form-control" dir="ltr" />
                                <button class="btn-primary shrink-0 px-3 py-2 text-sm">@(isFa ? "ذخیره" : "Save")</button>
                            </div>
                        </div>
                    </form>
                }
            </div>
            <p class="mt-2 text-xs text-ink-faint">@(isFa ? "۰ یعنی بدون محدودیت." : "0 means no limit.")</p>
        </section>
    }

    @* ---- who a limit change is already biting ----
       Lowering a limit takes nothing away from anyone, so without this the effect is invisible. *@
    @if (Model.Overages.Count > 0)
    {
        <section class="mt-8 rounded-xl border border-warn bg-warn-soft p-5">
            <h2 class="font-semibold text-warn mb-2">@(isFa ? "بالاتر از سقف پلن" : "Over their plan")</h2>
            <p class="text-xs text-warn/70 mb-3">
                @(isFa
                    ? "چیزی از آن‌ها گرفته نشده — فقط نمی‌توانند مورد جدیدی اضافه کنند."
                    : "Nothing has been taken away from them; they simply cannot add anything new.")
            </p>
            <div class="space-y-1 text-sm">
                @foreach (var row in Model.Overages)
                {
                    @* Formatted per resource: bytes as MB, cores as cores. A single format for all
                       of them is how "4294967296 memory, limit 2147483648" gets onto a screen. *@
                    var b = row.Breach;
                    var problem = b.Resource switch
                    {
                        PlanResource.Memory => $"{Mem((long)b.Used)} / {Mem((long)b.Limit)}",
                        PlanResource.Disk => $"{Disk((long)b.Used)} / {Disk((long)b.Limit)}",
                        PlanResource.Cpu => $"{b.Used:0.##} / {b.Limit:0.##} " + (isFa ? "هسته" : "cores"),
                        PlanResource.Services => $"{b.Used:0} / {b.Limit:0} " + (isFa ? "دیتابیس" : "databases"),
                        PlanResource.Members => $"{b.Used:0} / {b.Limit:0} " + (isFa ? "عضو/دعوت" : "members/invitations"),
                        PlanResource.Projects => $"{b.Used:0} / {b.Limit:0} " + (isFa ? "پروژه" : "projects"),
                        PlanResource.Environments => $"{b.Used:0} / {b.Limit:0} " + (isFa ? "محیط" : "environments"),
                        PlanResource.Domains => $"{b.Used:0} / {b.Limit:0} " + (isFa ? "دامنه" : "domains"),
                        PlanResource.Volumes => $"{b.Used:0} / {b.Limit:0} " + (isFa ? "والیوم" : "volumes"),
                        PlanResource.BackupSchedules => $"{b.Used:0} / {b.Limit:0} " + (isFa ? "زمان‌بندی پشتیبان" : "backup schedules"),
                        PlanResource.CronJobs => $"{b.Used:0} / {b.Limit:0} " + (isFa ? "کار زمان‌بندی‌شده" : "scheduled jobs"),
                        PlanResource.ActiveDeployments => $"{b.Used:0} / {b.Limit:0} " + (isFa ? "استقرار فعال" : "active deployments"),
                        _ => $"{b.Used:0} / {b.Limit:0} " + (isFa ? "اپلیکیشن" : "apps")
                    };
                    <div class="flex flex-wrap justify-between gap-2">
                        <span class="text-ink">@row.Tenant <span class="text-ink-faint">· @row.PlanName</span></span>
                        <span class="text-warn" dir="ltr">@problem</span>
                    </div>
                }
            </div>
        </section>
    }
}
