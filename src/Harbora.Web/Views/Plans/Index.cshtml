@model PlansPageViewModel
@{
    ViewData["Title"] = "Plans";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var u = Model.Usage;
    string Mb(long b) => b <= 0 ? "∞" : $"{b / 1024 / 1024} MB";
    string Bar(double used, double max)
    {
        if (max <= 0) return "5";
        var pct = Math.Min(100, used / max * 100);
        return pct.ToString("0");
    }
}
<h1 class="text-2xl font-bold tracking-tight text-ink mb-1">@(isFa ? "پلن و مصرف" : "Plan & Usage")</h1>
<p class="text-ink-muted text-sm mb-6">@(isFa ? "پلن فعلی:" : "Current plan:") <span class="text-ink font-medium">@u.PlanName</span>
    @if (u.Suspended){<span class="ms-2 text-xs rounded bg-danger/15 text-danger px-2 py-0.5">@(isFa ? "معلق" : "suspended")</span>}
</p>

<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    @{
        (string label, string used, double u1, double m1)[] cards =
        {
            (isFa ? "اپلیکیشن‌ها" : "Apps", $"{u.Apps} / {(u.MaxApps == 0 ? "∞" : u.MaxApps.ToString())}", u.Apps, u.MaxApps),
            (isFa ? "سرویس‌ها" : "Services", $"{u.Services} / {(u.MaxServices == 0 ? "∞" : u.MaxServices.ToString())}", u.Services, u.MaxServices),
            (isFa ? "حافظه" : "Memory", $"{Mb(u.MemoryUsedBytes)} / {Mb(u.MaxMemoryBytes)}", u.MemoryUsedBytes, u.MaxMemoryBytes),
            ("CPU", $"{u.CpuUsed:0.##} / {(u.MaxCpuCores == 0 ? "∞" : u.MaxCpuCores.ToString("0.##"))}", u.CpuUsed, u.MaxCpuCores),
        };
    }
    @foreach (var c in cards)
    {
        <div class="rounded-xl border border-line bg-surface p-4">
            <div class="text-ink-muted text-sm">@c.label</div>
            <div class="mt-1 text-xl font-bold">@c.used</div>
            <div class="mt-2 h-1.5 rounded-full bg-surface-2 overflow-hidden">
                <div class="h-full bg-accent-hover" style="width:@(Bar(c.u1, c.m1))%"></div>
            </div>
        </div>
    }
</div>

<h2 class="text-lg font-semibold text-ink mb-3">@(isFa ? "پلن‌های ارائه‌شده" : "Offered plans")</h2>
<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
    @foreach (var p in Model.Plans)
    {
        <div class="rounded-xl border border-line bg-surface p-5">
            <div class="flex items-center justify-between">
                <span class="font-semibold text-lg">@(isFa ? p.NameFa : p.Name)</span>
                @if (p.MonthlyPrice > 0){<span class="text-accent-text font-semibold">$@p.MonthlyPrice<span class="text-xs text-ink-faint">/mo</span></span>}
            </div>
            <ul class="mt-3 space-y-1 text-sm text-ink-muted">
                <li>@(p.MaxApps == 0 ? (isFa ? "اپ نامحدود" : "Unlimited apps") : $"{p.MaxApps} apps")</li>
                <li>@(p.MaxServices == 0 ? (isFa ? "سرویس نامحدود" : "Unlimited services") : $"{p.MaxServices} services")</li>
                <li>@(isFa ? "حافظه:" : "Memory:") @Mb(p.MaxMemoryBytes)</li>
                <li>@(isFa ? "پردازنده:" : "CPU:") @(p.MaxCpuCores == 0 ? "∞" : p.MaxCpuCores.ToString("0.##"))</li>
                @if (!string.IsNullOrWhiteSpace(p.AllowedSizeKeys)){<li>@(isFa ? "اندازه‌ها:" : "Sizes:") @p.AllowedSizeKeys</li>}
            </ul>
        </div>
    }
</div>

<h2 class="text-lg font-semibold text-ink mb-3">@(isFa ? "اندازه‌های منبع" : "Instance sizes")</h2>
<div class="rounded-xl border border-line bg-surface divide-y divide-line mb-8">
    @foreach (var s in Model.Sizes)
    {
        <div class="flex items-center justify-between p-3 text-sm">
            <span class="font-medium">@(isFa ? s.NameFa : s.Name) <span class="text-ink-faint font-mono">@s.Key</span></span>
            <span class="text-ink-muted">@s.CpuCores vCPU · @(s.MemoryBytes / 1024 / 1024) MB</span>
        </div>
    }
</div>

@if (Model.IsProvider)
{
    <section class="rounded-xl border border-line bg-surface p-5 max-w-2xl">
        <h2 class="text-[15px] font-semibold text-ink mb-3">@(isFa ? "ساخت پلن جدید" : "Create a plan")</h2>
        <form asp-controller="Plans" asp-action="CreatePlan" method="post" class="grid sm:grid-cols-2 gap-3">
            @Html.AntiForgeryToken()
            <input name="name" placeholder="Name" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            <input name="monthlyPrice" type="number" step="0.01" placeholder="Price /mo" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            <input name="maxApps" type="number" value="1" placeholder="Max apps" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            <input name="maxServices" type="number" value="1" placeholder="Max services" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            <input name="maxMemoryMb" type="number" value="1024" placeholder="Max memory (MB)" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            <input name="maxCpu" type="number" step="0.25" value="1" placeholder="Max CPU cores" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            @* This field existed on the plan and on this screen, and the form never sent it — so
               every plan carried a disk limit of zero while a column promised one. *@
            <input name="maxDiskGb" type="number" value="0" placeholder="Max disk (GB)" class="rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm" />
            <input name="allowedSizeKeys" placeholder="nano,micro,small" class="sm:col-span-2 rounded-lg bg-surface-2 border border-line-strong px-3 py-2 text-sm font-mono" />
            <div class="sm:col-span-2"><button class="rounded-lg bg-accent hover:bg-accent-hover text-white px-4 py-2 text-sm font-semibold">@(isFa ? "ذخیره" : "Save")</button></div>
        </form>
        <p class="mt-2 text-xs text-ink-faint">@(isFa ? "۰ یعنی نامحدود." : "0 means unlimited.")</p>
    </section>

    @* ---- correcting a plan ----
       Plans could only be created, so a wrong limit or a changed price meant a new plan and moving
       every tenant across by hand. *@
    <section class="mt-8 rounded-xl border border-line bg-surface p-5">
        <h2 class="text-[15px] font-semibold text-ink mb-3">@(isFa ? "ویرایش پلن‌ها" : "Edit plans")</h2>
        <div class="space-y-4">
            @foreach (var p in Model.Plans)
            {
                <form asp-controller="Plans" asp-action="UpdatePlan" asp-route-id="@p.Id" method="post"
                      class="grid sm:grid-cols-4 gap-2 items-center">
                    @Html.AntiForgeryToken()
                    <input name="name" value="@p.Name" class="rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm" />
                    <input name="monthlyPrice" type="number" step="0.01" value="@p.MonthlyPrice" class="rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm" />
                    <input name="maxApps" type="number" value="@p.MaxApps" class="rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm" />
                    <input name="maxServices" type="number" value="@p.MaxServices" class="rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm" />
                    <input name="maxMemoryMb" type="number" value="@(p.MaxMemoryBytes / 1024 / 1024)" class="rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm" />
                    <input name="maxCpu" type="number" step="0.25" value="@p.MaxCpuCores" class="rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm" />
                    <input name="maxDiskGb" type="number" value="@(p.MaxDiskBytes / 1024 / 1024 / 1024)" class="rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm" />
                    <input name="allowedSizeKeys" value="@p.AllowedSizeKeys" class="rounded-lg bg-surface-2 border border-line-strong px-2 py-1.5 text-sm font-mono" />
                    <div class="sm:col-span-4 flex items-center gap-2">
                        <button class="rounded-lg bg-surface-2 hover:bg-surface-2 px-3 py-1.5 text-sm">@(isFa ? "ذخیره" : "save")</button>
                        @if (!p.IsDefault)
                        {
                            <span></span>
                        }
                        <span class="text-xs text-ink-faint">
                            @(isFa ? "نام / قیمت / اپ / دیتابیس / حافظه(MB) / CPU / دیسک(GB) / سایزها"
                                   : "name / price / apps / databases / memory MB / cpu / disk GB / sizes")
                        </span>
                    </div>
                </form>
                <form asp-controller="Plans" asp-action="SetEnabled" asp-route-id="@p.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="enabled" value="@((!p.IsEnabled).ToString().ToLowerInvariant())" />
                    <button class="text-xs @(p.IsEnabled ? "text-warn" : "text-ok")">
                        @(p.IsEnabled
                            ? (isFa ? "برداشتن از فهرست پلن‌های جدید" : "withdraw from new tenants")
                            : (isFa ? "در دسترس کردن دوباره" : "make available again"))
                    </button>
                </form>
            }
        </div>
    </section>

    @* ---- who a limit change is already biting ----
       Lowering a limit takes nothing away from anyone, so without this the effect is invisible. *@
    var over = ViewBag.OverPlan as List<(string Tenant, string Plan, string Problem)> ?? new();
    @if (over.Count > 0)
    {
        <section class="mt-8 rounded-xl border border-warn bg-warn-soft p-5">
            <h2 class="font-semibold text-warn mb-2">@(isFa ? "بالاتر از سقف پلن" : "Over their plan")</h2>
            <p class="text-xs text-warn/70 mb-3">
                @(isFa
                    ? "چیزی از آن‌ها گرفته نشده — فقط نمی‌توانند مورد جدیدی اضافه کنند."
                    : "Nothing has been taken away from them; they simply cannot add anything new.")
            </p>
            <div class="space-y-1 text-sm">
                @foreach (var row in over)
                {
                    <div class="flex flex-wrap justify-between gap-2">
                        <span class="text-ink">@row.Tenant <span class="text-ink-faint">· @row.Plan</span></span>
                        <span class="text-warn">@row.Problem</span>
                    </div>
                }
            </div>
        </section>
    }
}
