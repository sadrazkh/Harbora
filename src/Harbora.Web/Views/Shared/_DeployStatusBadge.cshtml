@model Harbora.Domain.Common.DeploymentStatus
@{
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";

    // The word comes from StatusLabel so every badge on the panel says the same thing in the same
    // language. Half of these used to print the enum raw — "Cancelled", "Building" — which put the
    // one word a person actually reads on a row in the wrong language. Only colours are decided here.
    var cls = Model switch
    {
        DeploymentStatus.Succeeded => "bg-ok/15 text-ok",
        DeploymentStatus.Failed => "bg-danger/15 text-danger",
        DeploymentStatus.Cancelled => "bg-slate-500/15 text-ink",
        DeploymentStatus.RolledBack => "bg-warn/15 text-warn",
        // 5.2: deliberately not the pulsing "in-flight" colour below — nothing is running, and a
        // pulsing badge on a deployment nobody has looked at yet reads as "the platform is busy"
        // when the honest fact is "a person needs to act".
        DeploymentStatus.PendingApproval => "bg-warn/15 text-warn",
        _ => "bg-accent-hover/15 text-accent-text animate-pulse"
    };
}
<span class="rounded-full px-2.5 py-0.5 text-xs font-medium @cls">@Harbora.Web.Infrastructure.StatusLabel.For(Model, isFa)</span>
