@model Harbora.Domain.Common.DeploymentStatus
@{
    var (cls, label) = Model switch
    {
        DeploymentStatus.Succeeded => ("bg-ok/15 text-ok", T["Succeeded"].Value),
        DeploymentStatus.Failed => ("bg-danger/15 text-danger", T["Failed"].Value),
        DeploymentStatus.Cancelled => ("bg-slate-500/15 text-ink", "Cancelled"),
        DeploymentStatus.RolledBack => ("bg-warn/15 text-warn", T["Rollback"].Value),
        _ => ("bg-accent-hover/15 text-accent-text animate-pulse", Model.ToString())
    };
}
<span class="rounded-full px-2.5 py-0.5 text-xs font-medium @cls">@label</span>
