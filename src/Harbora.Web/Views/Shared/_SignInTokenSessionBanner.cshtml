@using System.Globalization
@inject Harbora.Web.Infrastructure.SignInTokenSessionView TokenSession
@{
    // Nothing at all when this session was not opened by a token — which is every ordinary sign-in.
    var token = TokenSession.Current;
}
@if (token is not null)
{
    var isFa = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";

    @* Same fixture-not-notice shape as _SupportSessionBanner: no dismiss control that leaves the
       session it announces still running. The owner gave an agent a browser session on purpose, but
       whoever is looking at the screen while it runs is owed the same visibility a customer gets
       while support is signed in as them. *@
    <div data-signin-token-session="@token.Id"
         class="flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-info/25 bg-info-soft px-4 py-2.5 text-sm text-info md:px-6"
         role="status">
        <i data-lucide="key-round" class="h-4 w-4 shrink-0" aria-hidden="true"></i>
        <span>
            @(isFa
                ? "این نشست با یک توکن ورود یک‌بارمصرف باز شده است."
                : "This session was opened with a one-time sign-in token.")
        </span>
        <span class="text-xs">
            @(isFa ? "تا" : "until")
            <span class="font-mono" dir="ltr">@token.SessionExpiresAt!.Value.ToLocalTime().ToString(Dates.Stamp)</span>
        </span>
        <span class="w-full text-xs md:w-auto">
            @(isFa ? "هدف:" : "Purpose:") @token.Purpose
        </span>
        <a class="text-xs font-medium underline" href="/account/tokens">@(isFa ? "مدیریت توکن‌ها" : "Manage tokens")</a>
        <form method="post" action="/account/tokens/@token.Id/revoke" class="ms-auto">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-info/40 bg-surface px-3 py-1.5 text-xs font-semibold text-info hover:bg-surface-2">
                @(isFa ? "پایان نشست" : "End session")
            </button>
        </form>
    </div>
}
