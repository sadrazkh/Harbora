@using System.Globalization
@inject ViteManifest Vite
@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = culture == "fa";
    var dir = isRtl ? "rtl" : "ltr";
    var (viteJs, viteCss) = Vite.Resolve("Scripts/main.ts");
    string Active(string controller) =>
        string.Equals((string?)ViewContext.RouteData.Values["controller"], controller, StringComparison.OrdinalIgnoreCase)
            ? "bg-accent-soft text-accent-text" : "text-ink hover:bg-surface-2 hover:text-white";
}
<!DOCTYPE html>
<html lang="@culture" dir="@dir" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] · Harbora</title>
    <meta name="theme-color" content="#0f172a" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/favicon.ico" />
    @if (Vite.UseDevServer)
    {
        <script type="module" src="@(Vite.DevServerUrl)/@@vite/client"></script>
        <script type="module" src="@(Vite.DevServerUrl)/Scripts/main.ts"></script>
    }
    else
    {
        foreach (var css in viteCss) { <link rel="stylesheet" href="@css" /> }
        @* Fallback base styles so the shell is usable even before `npm run build`. *@
        <link rel="stylesheet" href="~/css/fallback.css" />
    }
    <script>
        // Apply persisted theme before paint to avoid a flash. Values: dark | light | system.
        (function () {
            var t = localStorage.getItem('harbora-theme') || 'system';
            var dark = t === 'dark' || (t === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.classList.toggle('dark', dark);
            document.documentElement.dataset.themeChoice = t;

            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', dark ? '#0f0d17' : '#f8f7fd');

            // "System" has to keep meaning system: follow the OS while that is the choice.
            matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
                if ((localStorage.getItem('harbora-theme') || 'system') !== 'system') return;
                document.documentElement.classList.toggle('dark', e.matches);
                if (meta) meta.setAttribute('content', e.matches ? '#0f172a' : '#e2e8f0');
            });
        })();
    </script>
</head>
<body class="h-full bg-canvas text-ink antialiased">
<div class="flex h-full">
    <div id="backdrop" class="app-backdrop hidden md:hidden"></div>
    <aside id="sidebar" class="app-sidebar flex md:w-60 flex-col border-e border-line bg-surface">
        <div class="flex items-center gap-2.5 px-5 h-16 border-b border-line">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-accent font-bold text-white">H</span>
            <span class="text-lg font-semibold tracking-tight text-ink">Harbora</span>
        </div>
        <partial name="Design/_Sidebar" />
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
        <partial name="Design/_Topbar" />

        @* The rail is rendered exactly once. A Razor section cannot be rendered twice, so its
           placement is a CSS concern: beside the content on wide screens, beneath it otherwise.
           It moves rather than disappearing, because on these pages it carries information. *@
        <div class="flex flex-1 min-h-0 flex-col overflow-y-auto xl:flex-row">
            <main class="flex-1 min-w-0 p-4 md:p-6">
                @RenderBody()
            </main>
            @if (IsSectionDefined("RightRail"))
            {
                <aside class="w-full shrink-0 border-t border-line bg-surface p-5 space-y-5 xl:w-80 xl:border-t-0 xl:border-s">
                    @await RenderSectionAsync("RightRail", required: false)
                </aside>
            }
        </div>
    </div>
</div>

@if (Vite.UseDevServer is false && viteJs is not null)
{
    <script type="module" src="@viteJs"></script>
}
<script>
    // Theme: system / light / dark. The pre-paint script above resolves it; this only records the
    // choice and applies it immediately, so switching never needs a reload.
    (function () {
        var root = document.documentElement;
        var buttons = document.querySelectorAll('[data-theme-choice]');

        function paint() {
            var choice = root.dataset.themeChoice || 'system';
            var dark = choice === 'dark' || (choice === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
            root.classList.toggle('dark', dark);

            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', dark ? '#0f0d17' : '#f8f7fd');

            buttons.forEach(function (b) {
                var on = b.dataset.themeChoice === choice;
                // Selected state is a filled chip plus aria-pressed, not colour alone.
                b.classList.toggle('bg-surface', on);
                b.classList.toggle('shadow-panel', on);
                b.classList.toggle('text-ink', on);
                b.classList.toggle('text-ink-faint', !on);
                b.setAttribute('aria-pressed', on ? 'true' : 'false');
            });
        }

        buttons.forEach(function (b) {
            b.addEventListener('click', function () {
                root.dataset.themeChoice = b.dataset.themeChoice;
                localStorage.setItem('harbora-theme', b.dataset.themeChoice);
                paint();
            });
        });

        paint();
    })();

    // Mobile slide-over sidebar.
    (function () {
        var sidebar = document.getElementById('sidebar'), backdrop = document.getElementById('backdrop');
        function open(v) { sidebar.classList.toggle('is-open', v); backdrop.classList.toggle('hidden', !v); }
        document.querySelector('[data-toggle-sidebar]')?.addEventListener('click', function () {
            open(!sidebar.classList.contains('is-open'));
        });
        backdrop?.addEventListener('click', function () { open(false); });
        sidebar?.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { open(false); }); });
    })();

    // Loading state: disable submit + spinner once a form really submits.
    // Bubble phase + defaultPrevented check so a cancelled confirm() never leaves a stuck button.
    document.addEventListener('submit', function (e) {
        var form = e.target;
        if (e.defaultPrevented || form.hasAttribute('data-no-loading')) return;
        var btn = form.querySelector('button[type=submit], button:not([type])');
        if (btn && !btn.disabled) {
            setTimeout(function () { btn.classList.add('btn-spin'); btn.disabled = true; }, 0);
        }
    });

    if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(function(){});
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
