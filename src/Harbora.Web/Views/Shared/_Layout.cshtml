@using System.Globalization
@inject ViteManifest Vite
@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = culture == "fa";
    var dir = isRtl ? "rtl" : "ltr";
    var (viteJs, viteCss) = Vite.Resolve("Scripts/main.ts");
}
<!DOCTYPE html>
<html lang="@culture" dir="@dir" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] · Harbora</title>
    <meta name="theme-color" content="#f8f7fd" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" href="~/favicon.ico" />
    @if (Vite.UseDevServer)
    {
        <script type="module" src="@(Vite.DevServerUrl)/@@vite/client"></script>
        <script type="module" src="@(Vite.DevServerUrl)/Scripts/main.ts"></script>
    }
    else
    {
        foreach (var css in viteCss) { <link rel="stylesheet" href="@css" /> }
        @* Never layer the emergency sheet on top of the generated design system: its deliberately
           broad selectors are only meant to keep a checkout usable before `npm run build`. *@
        if (viteCss.Count == 0) { <link rel="stylesheet" href="~/css/fallback.css" asp-append-version="true" /> }
    }
    <script>
        // Apply persisted theme before paint to avoid a flash. Values: dark | light | system.
        (function () {
            var t = localStorage.getItem('harbora-theme') || 'light';
            var dark = t === 'dark' || (t === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.classList.toggle('dark', dark);
            document.documentElement.dataset.themeChoice = t;

            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', dark ? '#0f0d17' : '#f8f7fd');

            // "System" has to keep meaning system: follow the OS while that is the choice.
            matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
                if ((localStorage.getItem('harbora-theme') || 'light') !== 'system') return;
                document.documentElement.classList.toggle('dark', e.matches);
                if (meta) meta.setAttribute('content', e.matches ? '#0f172a' : '#e2e8f0');
            });
        })();
    </script>
</head>
<body class="h-full bg-canvas text-ink antialiased">
<div class="flex h-full">
    <div id="backdrop" class="app-backdrop hidden md:hidden"></div>
    <aside id="sidebar" class="app-sidebar flex w-64 shrink-0 flex-col border-e border-line bg-surface transition-[width] duration-200">
        <div class="sidebar-brand flex h-16 items-center gap-2.5 border-b border-line px-5">
            <span class="harbora-mark" aria-hidden="true">
                <svg viewBox="0 0 32 32" class="h-8 w-8" fill="none"><path d="M16 2.5 28 9.4v13.2L16 29.5 4 22.6V9.4L16 2.5Z" fill="currentColor" opacity=".14"/><path d="m9 11.6 7-4 7 4-7 4-7-4Zm0 2.9 5.6 3.2v6.5L9 21v-6.5Zm14 0v6.5l-5.6 3.2v-6.5l5.6-3.2Z" fill="currentColor"/></svg>
            </span>
            <span class="sidebar-label text-lg font-bold tracking-tight text-ink">Harbora</span>
        </div>
        <partial name="Design/_Sidebar" />
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
        @* Draws nothing unless a platform administrator is signed in as this account. *@
        <partial name="_SupportSessionBanner" />
        @* Draws one row per active, undismissed platform announcement. Composes with the banner
           above rather than fighting it — both are plain, unconditionally-rendered partials, so a
           support session and an announcement can be on screen at the same time. *@
        <partial name="_AnnouncementBanner" />
        <partial name="Design/_Topbar" />

        @* The rail is rendered exactly once. A Razor section cannot be rendered twice, so its
           placement is a CSS concern: beside the content on wide screens, beneath it otherwise.
           It moves rather than disappearing, because on these pages it carries information.

           The row below is Flexbox (`flex … 2xl:flex-row`), with `<main>` as `flex-1` and the rail as
           `shrink-0` at a fixed width — not a grid with a reserved track, so a sibling that is not
           rendered at all is space `<main>` reclaims on its own; nothing here has to compensate for it.

           Whether the aside itself appears now depends on what the section actually puts on the page,
           not on a page-agnostic flag: some pages (Users, Domains, Templates) draw their rail
           unconditionally and must keep doing so, while Apps and Databases can legitimately close
           every panel they own and end up with nothing to draw. Rendering the section into a buffer
           first and checking whether it produced anything answers both without the layout needing to
           know which panels belong to which page. *@
        @{
            var railBuffer = new StringWriter();
            PushWriter(railBuffer);
            // Apps/Index.cshtml's RightRail section awaits Rails.AnyOpenAsync() and two
            // IsOpenAsync() calls — all three reach the database, so all three can throw. Without
            // the finally, a throw here would leave the writer stack pushed at a buffer nobody
            // reads again, and everything this layout renders afterwards would go into it instead
            // of the response.
            try
            {
                await RenderSectionAsync("RightRail", required: false);
            }
            finally
            {
                PopWriter();
            }
            var railHtml = railBuffer.ToString();
        }
        <div class="flex min-h-0 flex-1 flex-col overflow-y-auto 2xl:flex-row">
            <main class="min-w-0 flex-1 p-4 md:p-6 2xl:p-7">
                @RenderBody()
            </main>
            @if (!string.IsNullOrWhiteSpace(railHtml))
            {
                <aside class="w-full shrink-0 space-y-5 border-t border-line bg-surface p-5 2xl:w-80 2xl:border-s 2xl:border-t-0">
                    @Html.Raw(railHtml)
                </aside>
            }
        </div>
    </div>
</div>

@if (Vite.UseDevServer is false && viteJs is not null)
{
    <script type="module" src="@viteJs"></script>
}
<script>
    // Theme: system / light / dark. The pre-paint script above resolves it; this only records the
    // choice and applies it immediately, so switching never needs a reload.
    (function () {
        var root = document.documentElement;
        var buttons = document.querySelectorAll('[data-theme-choice]');

        function paint() {
            var choice = root.dataset.themeChoice || 'system';
            var dark = choice === 'dark' || (choice === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
            root.classList.toggle('dark', dark);

            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', dark ? '#0f0d17' : '#f8f7fd');

            buttons.forEach(function (b) {
                var on = b.dataset.themeChoice === choice;
                // Selected state is a filled chip plus aria-pressed, not colour alone.
                b.classList.toggle('bg-surface', on);
                b.classList.toggle('shadow-panel', on);
                b.classList.toggle('text-ink', on);
                b.classList.toggle('text-ink-faint', !on);
                b.setAttribute('aria-pressed', on ? 'true' : 'false');
            });
        }

        buttons.forEach(function (b) {
            b.addEventListener('click', function () {
                root.dataset.themeChoice = b.dataset.themeChoice;
                localStorage.setItem('harbora-theme', b.dataset.themeChoice);
                paint();
            });
        });

        paint();
    })();

    // Mobile slide-over sidebar.
    (function () {
        var sidebar = document.getElementById('sidebar'), backdrop = document.getElementById('backdrop');
        function open(v) { sidebar.classList.toggle('is-open', v); backdrop.classList.toggle('hidden', !v); }
        document.querySelector('[data-toggle-sidebar]')?.addEventListener('click', function () {
            open(!sidebar.classList.contains('is-open'));
        });
        backdrop?.addEventListener('click', function () { open(false); });
        sidebar?.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { open(false); }); });
    })();

    // Loading state: disable submit + spinner once a form really submits.
    // Bubble phase + defaultPrevented check so a cancelled confirm() never leaves a stuck button.
    document.addEventListener('submit', function (e) {
        var form = e.target;
        if (e.defaultPrevented || form.hasAttribute('data-no-loading')) return;
        var btn = form.querySelector('button[type=submit], button:not([type])');
        if (btn && !btn.disabled) {
            setTimeout(function () { btn.classList.add('btn-spin'); btn.disabled = true; }, 0);
        }
    });

    if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(function(){});
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
