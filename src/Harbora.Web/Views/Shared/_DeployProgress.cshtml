@model Harbora.Domain.Common.DeploymentStatus
@using Harbora.Infrastructure.Deployments
@{
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    string[] labels = isFa
        ? ["در صف", "ساخت", "استقرار", "سلامت‌سنجی", "زنده"]
        : ["Queued", "Build", "Deploy", "Health", "Live"];

    // The mapping is serialised for the browser so the script looks a status up rather than
    // carrying its own copy. Before this the bar was drawn once from the status at page load and
    // nothing ever moved it: the logs streamed, the deployment progressed, and the steps sat still.
    // The comment here used to say the Vue island updated it live. Nothing did.
    var map = System.Text.Json.JsonSerializer.Serialize(DeploymentSteps.Map);
    var terminal = System.Text.Json.JsonSerializer.Serialize(DeploymentSteps.TerminalNames);

    string StateName(StepState state) => state switch
    {
        StepState.Done => "done",
        StepState.Active => "active",
        StepState.Failed => "failed",
        StepState.Cancelled => "cancelled",
        _ => "pending"
    };
}
@* State is a data attribute rather than a list of utility classes, so the browser can move the bar
   by flipping one value and the look stays defined in exactly one place. *@
<div class="mb-4 rounded-xl border border-line bg-surface px-4 py-4"
     data-deploy-progress
     data-status="@Model"
     data-step-map="@map"
     data-terminal-statuses="@terminal">
    <ol class="deploy-steps">
        @for (var i = 0; i < labels.Length; i++)
        {
            <li class="deploy-step" data-step="@i" data-state="@StateName(DeploymentSteps.StateOf(i, Model))">
                <span class="deploy-step-mark">
                    <span class="deploy-step-number">@(i + 1)</span>
                    <span class="deploy-step-tick" aria-hidden="true">✓</span>
                    <span class="deploy-step-cross" aria-hidden="true">✕</span>
                </span>
                <span class="deploy-step-label">@labels[i]</span>
                @if (i < labels.Length - 1)
                {
                    <span class="deploy-step-line"></span>
                }
            </li>
        }
    </ol>

    <p class="mt-3 text-sm text-danger" data-deploy-note="Failed"
       hidden="@(Model is not Harbora.Domain.Common.DeploymentStatus.Failed)">
        @(isFa
            ? "استقرار ناموفق بود — نسخهٔ قبلی همچنان در حال سرویس‌دهی است. می‌توانید دوباره تلاش یا rollback کنید."
            : "Deploy failed — the previous version is still serving. You can retry or roll back.")
    </p>
    <p class="mt-3 text-sm text-ink-muted" data-deploy-note="Cancelled"
       hidden="@(Model is not Harbora.Domain.Common.DeploymentStatus.Cancelled)">
        @(isFa ? "استقرار لغو شد." : "Deployment was cancelled.")
    </p>
</div>
