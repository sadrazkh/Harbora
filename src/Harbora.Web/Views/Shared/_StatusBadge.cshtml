@model Harbora.Domain.Common.AppStatus
@{
    var (cls, label) = Model switch
    {
        AppStatus.Running => ("bg-ok/15 text-ok", T["Running"].Value),
        AppStatus.Stopped => ("bg-slate-500/15 text-ink", T["Stopped"].Value),
        AppStatus.Failed or AppStatus.Crashed => ("bg-danger/15 text-danger", T["Failed"].Value),
        AppStatus.Deploying => ("bg-accent-hover/15 text-accent-text", T["Deploy"].Value),
        _ => ("bg-slate-500/15 text-ink", Model.ToString())
    };
}
<span class="rounded-full px-2.5 py-0.5 text-xs font-medium @cls">@label</span>
