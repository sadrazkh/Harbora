@using Harbora.Infrastructure.Navigation
@inject Harbora.Web.Infrastructure.PanelModeProvider PanelModes
@inject Microsoft.Extensions.Options.IOptions<Harbora.Modules.Backup.Infrastructure.BackupFeatureOptions> BackupFeatures
@inject Microsoft.Extensions.Options.IOptions<Harbora.Modules.Sync.Infrastructure.SyncFeatureOptions> SyncFeatures
@using Harbora.Web.Infrastructure
@{
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    // Simple hides the specialist destinations; their routes stay live, so a bookmark or a link in
    // a runbook still works for somebody in Simple mode.
    var panelMode = await PanelModes.GetAsync();
    // The backup module contributes its entry only when Features:Backup is on, so the sidebar never
    // offers a destination whose feature is switched off.
    var navSource = Harbora.Modules.Backup.Infrastructure.BackupNavigation.Augment(
        NavigationMap.All, BackupFeatures.Value.Backup);
    navSource = Harbora.Modules.Sync.Infrastructure.SyncNavigation.Augment(
        navSource, SyncFeatures.Value.Sync);
    var groups = NavigationMap.VisibleTo(navSource, NavigationCapabilities.For(User), panelMode);
    var currentController = (string?)ViewContext.RouteData.Values["controller"];

    string GroupLabel(string key) => (key, isFa) switch
    {
        ("overview", true) => "نمای کلی",   ("overview", false) => "Overview",
        ("deploy",   true) => "استقرار",     ("deploy",   false) => "Deploy",
        ("connect",  true) => "اتصال",       ("connect",  false) => "Connect",
        ("data",     true) => "داده",        ("data",     false) => "Data",
        ("intelligence", true) => "هوش مصنوعی", ("intelligence", false) => "AI",
        ("insight",  true) => "بینش",        ("insight",  false) => "Insight",
        ("build",    true) => "ساخت",        ("build",    false) => "Build",
        ("platform", true) => "پلتفرم",      ("platform", false) => "Platform",
        _ => key
    };

    string ItemLabel(string key) => (key, isFa) switch
    {
        ("dashboard",    true) => "داشبورد",       ("dashboard",    false) => "Dashboard",
        ("billing",      true) => "صورت‌حساب",     ("billing",      false) => "Billing",
        ("applications", true) => "برنامه‌ها",      ("applications", false) => "Applications",
        ("services",     true) => "دیتابیس‌ها",      ("services",     false) => "Databases",
        ("deployments",  true) => "استقرارها",      ("deployments",  false) => "Deployments",
        ("networks",     true) => "شبکه‌ها",        ("networks",     false) => "Networks",
        ("domains",      true) => "دامنه‌ها و SSL", ("domains",      false) => "Domains & SSL",
        ("routing",      true) => "مسیریابی",       ("routing",      false) => "Routing",
        ("backups",      true) => "پشتیبان‌ها",     ("backups",      false) => "Backups",
        ("storage",      true) => "فضای ذخیره‌سازی", ("storage",      false) => "Storage",
        ("backup-center", true) => "مرکز پشتیبان",  ("backup-center", false) => "Backup Center",
        ("sync",         true) => "همگام‌سازی",     ("sync",         false) => "Sync",
        ("monitoring",   true) => "پایش",           ("monitoring",   false) => "Monitoring",
        ("ai",           true) => "هوش مصنوعی",    ("ai",           false) => "AI",
        ("ai-admin",     true) => "مدیریت AI",     ("ai-admin",     false) => "AI admin",
        ("audit",        true) => "گزارش رخدادها",  ("audit",        false) => "Audit log",
        ("templates",    true) => "قالب‌ها",         ("templates",    false) => "Templates",
        ("template-versions", true) => "نسخه‌های قالب", ("template-versions", false) => "Template versions",
        ("git",          _)    => "Git",
        ("users",        true) => "کاربران و تیم", ("users",        false) => "Users & Team",
        ("servers",      true) => "سرورها",         ("servers",      false) => "Servers",
        ("nodes",        true) => "نودها",          ("nodes",        false) => "Nodes",
        ("plans",        true) => "پلن‌ها",          ("plans",        false) => "Plans",
        ("tenants",      true) => "مستأجرها",       ("tenants",      false) => "Tenants",
        ("settings",     true) => "تنظیمات",        ("settings",     false) => "Settings",
        ("platform-settings", true) => "تنظیمات پلتفرم", ("platform-settings", false) => "Platform settings",
        _ => key
    };
}
<nav class="flex-1 overflow-y-auto px-3 py-4 space-y-5 scrollbar-thin">
    @foreach (var group in groups)
    {
        <div>
            <div class="sidebar-group-label px-3 pb-1.5 text-[10px] font-semibold uppercase tracking-[.12em] text-ink-faint">
                @GroupLabel(group.Key)
            </div>
            <div class="space-y-0.5">
                @foreach (var item in group.Items)
                {
                    var active = string.Equals(currentController, item.Controller, StringComparison.OrdinalIgnoreCase);
                    <a asp-controller="@item.Controller" asp-action="@item.Action"
                       class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm transition @(active ? "bg-accent-soft text-accent-text font-medium" : "text-ink-muted hover:bg-surface-2 hover:text-ink")">
                        <i data-lucide="@item.Icon" class="h-4 w-4 shrink-0"></i>
                        <span class="sidebar-label truncate">@ItemLabel(item.Key)</span>
                    </a>
                }
            </div>
        </div>
    }
</nav>

<div class="border-t border-line p-3">
    <a href="/settings" class="mb-2 flex items-center gap-2.5 rounded-xl border border-line bg-surface-2 p-2.5 hover:border-accent/20">
        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-accent text-xs font-bold text-white">
            @((User.Identity?.Name ?? "H").Trim()[..1].ToUpperInvariant())
        </span>
        <span class="sidebar-footer-copy min-w-0 flex-1">
            <span class="block truncate text-xs font-semibold text-ink">@(User.Identity?.Name ?? (isFa ? "کاربر Harbora" : "Harbora user"))</span>
            <span class="block text-[10px] text-ink-faint">@(isFa ? "فضای کاری" : "Workspace")</span>
        </span>
        <i data-lucide="chevron-right" class="sidebar-footer-copy h-3.5 w-3.5 text-ink-faint rtl:rotate-180"></i>
    </a>
    <button type="button" data-collapse-sidebar class="flex w-full items-center justify-center gap-2 rounded-lg px-3 py-2 text-xs text-ink-faint hover:bg-surface-2 hover:text-ink" aria-label="@(isFa ? "جمع‌کردن نوار کناری" : "Collapse sidebar")">
        <i data-lucide="panel-left-close" class="h-4 w-4 rtl:rotate-180"></i>
        <span class="sidebar-footer-copy">@(isFa ? "جمع‌کردن" : "Collapse")</span>
    </button>
</div>
