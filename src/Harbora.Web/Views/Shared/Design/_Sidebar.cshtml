@using Harbora.Infrastructure.Navigation
@inject Harbora.Web.Infrastructure.PanelModeProvider PanelModes
@inject Microsoft.Extensions.Options.IOptions<Harbora.Modules.Backup.Infrastructure.BackupFeatureOptions> BackupFeatures
@inject Microsoft.Extensions.Options.IOptions<Harbora.Modules.Sync.Infrastructure.SyncFeatureOptions> SyncFeatures
@inject Harbora.Web.Infrastructure.FeatureView Features
@inject Harbora.Data.HarboraDbContext Db
@inject Harbora.Application.Abstractions.ICurrentUser CurrentUser
@using Harbora.Web.Infrastructure
@using Harbora.Domain.Features
@using Microsoft.EntityFrameworkCore
@{
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    // Simple hides the specialist destinations; their routes stay live, so a bookmark or a link in
    // a runbook still works for somebody in Simple mode.
    var panelMode = await PanelModes.GetAsync();
    // The backup module contributes its entry only when Features:Backup is on, so the sidebar never
    // offers a destination whose feature is switched off.
    var navSource = Harbora.Modules.Backup.Infrastructure.BackupNavigation.Augment(
        NavigationMap.All, BackupFeatures.Value.Backup);
    navSource = Harbora.Modules.Sync.Infrastructure.SyncNavigation.Augment(
        navSource, SyncFeatures.Value.Sync);
    // Account visibility is independent from automatic hourly charging. Even with the meter off,
    // customers can inspect their balance and redeem vouchers, while operators can fund accounts.
    // Entitlements do not filter the way capabilities do. A capability the caller lacks is removed;
    // a feature they are not entitled to is drawn greyed with a lock, because a customer who cannot
    // see what they are not buying has no way to ask for it. Only Hidden removes an entry.
    var featureStates = new Dictionary<string, FeatureState>();
    foreach (var key in navSource.SelectMany(g => g.Items).Select(i => i.Feature).Where(f => f is not null).Distinct())
        featureStates[key!] = (await Features.GetAsync(key!)).State;

    var groups = NavigationMap.Draw(navSource, NavigationCapabilities.For(User), panelMode,
        key => featureStates.TryGetValue(key, out var state) ? state : FeatureState.Locked);
    var currentController = (string?)ViewContext.RouteData.Values["controller"];

    // Redesign 3a: four destinations pinned above the fold with a live count, everything else
    // folds into collapsible groups below. Pulled from `groups` rather than NavigationMap.All
    // directly, so a pinned entry still respects whatever capability/feature check already decided
    // whether this person can see it — the sidebar's one hard rule, unchanged by this redesign.
    string[] pinnedKeys = ["dashboard", "applications", "services", "deployments"];
    var allEntries = groups.SelectMany(g => g.Entries).ToList();
    var pinned = pinnedKeys
        .Select(key => allEntries.FirstOrDefault(e => e.Item.Key == key))
        .Where(e => e is not null)
        .Select(e => e!)
        .ToList();
    var collapsibleGroups = groups
        .Select(g => new NavRow(g.Key, g.Entries.Where(e => !pinnedKeys.Contains(e.Item.Key)).ToList()))
        .Where(g => g.Entries.Count > 0)
        .ToList();

    // Live counts for the three pinned resource types, the same facts the redesigned stat bar
    // shows — read here too because the sidebar renders on every page, not only the dashboard.
    var workspaceId = CurrentUser.WorkspaceId ?? Guid.Empty;
    var pinnedAppCount = await Db.Apps.CountAsync(a => a.WorkspaceId == workspaceId);
    var pinnedDatabaseCount = await Db.ManagedServices.CountAsync(s => s.WorkspaceId == workspaceId);
    var pinnedFailedDeployments = await Db.Deployments
        .CountAsync(d => d.App!.WorkspaceId == workspaceId && d.Status == Harbora.Domain.Common.DeploymentStatus.Failed);

    (string? Count, bool Danger) PinnedBadge(string key) => key switch
    {
        "applications" => (pinnedAppCount.ToString(), false),
        "services" => (pinnedDatabaseCount.ToString(), false),
        "deployments" => (pinnedFailedDeployments > 0 ? pinnedFailedDeployments.ToString() : null, true),
        _ => (null, false)
    };

    string GroupLabel(string key) => (key, isFa) switch
    {
        ("overview", true) => "نمای کلی",   ("overview", false) => "Overview",
        ("deploy",   true) => "استقرار",     ("deploy",   false) => "Deploy",
        ("connect",  true) => "اتصال",       ("connect",  false) => "Connect",
        ("data",     true) => "داده",        ("data",     false) => "Data",
        ("intelligence", true) => "هوش مصنوعی", ("intelligence", false) => "AI",
        ("insight",  true) => "بینش",        ("insight",  false) => "Insight",
        ("build",    true) => "ساخت",        ("build",    false) => "Build",
        ("platform", true) => "پلتفرم",      ("platform", false) => "Platform",
        _ => key
    };

    string ItemLabel(string key) => (key, isFa) switch
    {
        ("dashboard",    true) => "داشبورد",       ("dashboard",    false) => "Dashboard",
        ("notifications", true) => "اعلان‌ها",      ("notifications", false) => "Notifications",
        ("workspaces",   true) => "ورک‌اسپیس‌ها و اعضا", ("workspaces", false) => "Workspaces & members",
        ("billing",      true) => "صورت‌حساب",     ("billing",      false) => "Billing",
        ("applications", true) => "برنامه‌ها",      ("applications", false) => "Applications",
        ("services",     true) => "دیتابیس‌ها",      ("services",     false) => "Databases",
        ("deployments",  true) => "استقرارها",      ("deployments",  false) => "Deployments",
        ("networks",     true) => "شبکه‌ها",        ("networks",     false) => "Networks",
        ("domains",      true) => "دامنه‌ها و SSL", ("domains",      false) => "Domains & SSL",
        ("routing",      true) => "مسیریابی",       ("routing",      false) => "Routing",
        ("backups",      true) => "پشتیبان‌ها",     ("backups",      false) => "Backups",
        ("mail",         true) => "ایمیل",           ("mail",         false) => "Email",
        ("storage",      true) => "فضای ذخیره‌سازی", ("storage",      false) => "Storage",
        ("email-providers", true) => "ارائه‌دهنده‌های SMTP", ("email-providers", false) => "SMTP providers",
        ("error-tracking", true) => "رهگیری خطا", ("error-tracking", false) => "Error tracking",
        ("registry-credentials", true) => "اعتبارنامه‌های رجیستری", ("registry-credentials", false) => "Registry credentials",
        ("config-groups", true) => "گروه‌های متغیر مشترک", ("config-groups", false) => "Config groups",
        ("backup-center", true) => "مرکز پشتیبان",  ("backup-center", false) => "Backup Center",
        ("sync",         true) => "همگام‌سازی",     ("sync",         false) => "Sync",
        ("monitoring",   true) => "پایش",           ("monitoring",   false) => "Monitoring",
        ("activity-jobs", true) => "فعالیت",         ("activity-jobs", false) => "Activity",
        ("ai",           true) => "هوش مصنوعی",    ("ai",           false) => "AI",
        ("ai-admin",     true) => "مدیریت AI",     ("ai-admin",     false) => "AI admin",
        ("audit",        true) => "گزارش رخدادها",  ("audit",        false) => "Audit log",
        ("functions",    true) => "فانکشن‌ها",        ("functions",    false) => "Functions",
        ("templates",    true) => "قالب‌ها",         ("templates",    false) => "Templates",
        ("template-versions", true) => "نسخه‌های قالب", ("template-versions", false) => "Template versions",
        ("git",          _)    => "Git",
        ("users",        true) => "کاربران و تیم", ("users",        false) => "Users & Team",
        ("announcements", true) => "اعلامیه‌های پلتفرم", ("announcements", false) => "Announcements",
        ("vouchers",     true) => "ووچرهای اعتبار", ("vouchers",     false) => "Billing vouchers",
        ("billing-runs", true) => "اجرای حسابداری", ("billing-runs", false) => "Billing runs",
        ("revenue",      true) => "درآمد پلتفرم",   ("revenue",      false) => "Revenue",
        ("cloudflare",   _) => "Cloudflare",
        ("servers",      true) => "سرورها",         ("servers",      false) => "Servers",
        ("nodes",        true) => "نودها",          ("nodes",        false) => "Nodes",
        ("plans",        true) => "پلن‌ها",          ("plans",        false) => "Plans",
        ("feature-admin", true) => "قابلیت‌ها",      ("feature-admin", false) => "Features",
        ("tenants",      true) => "مستأجرها",       ("tenants",      false) => "Tenants",
        ("settings",     true) => "تنظیمات",        ("settings",     false) => "Settings",
        ("platform-settings", true) => "تنظیمات پلتفرم", ("platform-settings", false) => "Platform settings",
        _ => key
    };
}
<nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1 scrollbar-thin">
    @* Redesign 3a: four always-visible essentials with a live count, instead of every destination
       carrying equal weight inside eight named groups. *@
    <div class="space-y-0.5 pb-3 mb-2 border-b border-line">
        @foreach (var entry in pinned)
        {
            var badge = PinnedBadge(entry.Item.Key);
            var active = string.Equals(currentController, entry.Item.Controller, StringComparison.OrdinalIgnoreCase);
            <partial name="Design/_SidebarItem" model="@(new Harbora.Web.ViewModels.SidebarItemModel(entry, ItemLabel(entry.Item.Key), active, badge.Count, badge.Danger))" />
        }
    </div>

    @* Everything else folds away by default and remembers whether this person opened it — per
       device, the same way the whole-sidebar collapse button below already works, since a full-page
       round trip on every expand/collapse click would be a worse interaction than what the rail
       already does for that. A group that holds the page currently open starts expanded regardless,
       so arriving here by URL never hides where you already are. *@
    @foreach (var group in collapsibleGroups)
    {
        var hasActive = group.Entries.Any(e => string.Equals(currentController, e.Item.Controller, StringComparison.OrdinalIgnoreCase));
        <details class="group sidebar-group" data-sidebar-group="@group.Key" open="@hasActive">
            <summary class="sidebar-group-label flex list-none items-center gap-2 rounded-lg px-3 py-2 cursor-pointer select-none [&::-webkit-details-marker]:hidden hover:text-ink-muted">
                <span class="flex-1 text-[10px] font-semibold uppercase tracking-[.12em] text-ink-faint">@GroupLabel(group.Key)</span>
                <i data-lucide="chevron-down" class="h-3 w-3 text-ink-faint transition-transform duration-150 group-open:rotate-180"></i>
            </summary>
            <div class="space-y-0.5 pb-2">
                @foreach (var entry in group.Entries)
                {
                    var active = string.Equals(currentController, entry.Item.Controller, StringComparison.OrdinalIgnoreCase);
                    <partial name="Design/_SidebarItem" model="@(new Harbora.Web.ViewModels.SidebarItemModel(entry, ItemLabel(entry.Item.Key), active))" />
                }
            </div>
        </details>
    }
</nav>

<div class="border-t border-line p-3">
    <a href="/settings" class="mb-2 flex items-center gap-2.5 rounded-xl border border-line bg-surface-2 p-2.5 hover:border-accent/20">
        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-accent text-xs font-bold text-white">
            @((User.Identity?.Name ?? "H").Trim()[..1].ToUpperInvariant())
        </span>
        <span class="sidebar-footer-copy min-w-0 flex-1">
            <span class="block truncate text-xs font-semibold text-ink">@(User.Identity?.Name ?? (isFa ? "کاربر Harbora" : "Harbora user"))</span>
            <span class="block text-[10px] text-ink-faint">@(isFa ? "فضای کاری" : "Workspace")</span>
        </span>
        <i data-lucide="chevron-right" class="sidebar-footer-copy h-3.5 w-3.5 text-ink-faint rtl:rotate-180"></i>
    </a>
    <button type="button" data-collapse-sidebar class="flex w-full items-center justify-center gap-2 rounded-lg px-3 py-2 text-xs text-ink-faint hover:bg-surface-2 hover:text-ink" aria-label="@(isFa ? "جمع‌کردن نوار کناری" : "Collapse sidebar")">
        <i data-lucide="panel-left-close" class="h-4 w-4 rtl:rotate-180"></i>
        <span class="sidebar-footer-copy">@(isFa ? "جمع‌کردن" : "Collapse")</span>
    </button>
</div>
