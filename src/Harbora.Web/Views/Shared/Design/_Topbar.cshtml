@using Microsoft.AspNetCore.Mvc.Localization
@inject Harbora.Web.Infrastructure.PanelModeProvider PanelModes
@using Harbora.Infrastructure.Navigation
@using Harbora.Infrastructure.Learning
@using Harbora.Web.Infrastructure
@{
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var groups = NavigationMap.VisibleTo(NavigationCapabilities.For(User));
    var identity = User.Identity?.Name ?? "Harbora";
    var initial = identity.Trim()[..1].ToUpperInvariant();

    // Which tutorial chapter explains the screen this request is actually on — see HelpMap for the
    // longest-prefix matching that lets an app's volumes tab differ from the rest of the app page. No
    // match is an honest answer, not a guess: the control below still opens the index rather than
    // 404ing or opening chapter one (spec: "an unhelpful Help button is worse than a missing one").
    var helpChapterSlug = HelpMap.ChapterFor(Context.Request.Path.Value ?? "/");
    var helpHref = helpChapterSlug is null ? "/learn" : $"/learn/{helpChapterSlug}";
    var helpState = helpChapterSlug is null ? "index" : "chapter";

    string ItemLabel(string key) => (key, isFa) switch
    {
        ("dashboard", true) => "داشبورد", ("dashboard", false) => "Dashboard",
        ("notifications", true) => "اعلان‌ها", ("notifications", false) => "Notifications",
        ("workspaces", true) => "ورک‌اسپیس‌ها و اعضا", ("workspaces", false) => "Workspaces & members",
        ("applications", true) => "برنامه‌ها", ("applications", false) => "Applications",
        ("services", true) => "دیتابیس‌ها", ("services", false) => "Databases",
        ("deployments", true) => "استقرارها", ("deployments", false) => "Deployments",
        ("networks", true) => "شبکه‌ها", ("networks", false) => "Networks",
        ("domains", true) => "دامنه‌ها و SSL", ("domains", false) => "Domains & SSL",
        ("routing", true) => "مسیریابی", ("routing", false) => "Routing",
        ("backups", true) => "پشتیبان‌ها", ("backups", false) => "Backups",
        ("monitoring", true) => "پایش", ("monitoring", false) => "Monitoring",
        ("audit", true) => "گزارش رخدادها", ("audit", false) => "Audit log",
        ("templates", true) => "قالب‌های آماده", ("templates", false) => "Templates",
        ("users", true) => "کاربران و تیم", ("users", false) => "Users & Team",
        ("billing", true) => "صورت‌حساب", ("billing", false) => "Billing",
        ("vouchers", true) => "ووچرهای اعتبار", ("vouchers", false) => "Billing vouchers",
        ("billing-runs", true) => "اجرای حسابداری", ("billing-runs", false) => "Billing runs",
        ("cloudflare", _) => "Cloudflare",
        ("servers", true) => "سرورها", ("servers", false) => "Servers",
        ("plans", true) => "پلن‌ها", ("plans", false) => "Plans",
        ("tenants", true) => "فضاهای کاری", ("tenants", false) => "Workspaces",
        ("settings", true) => "تنظیمات", ("settings", false) => "Settings",
        _ => key
    };
}

<header class="relative z-20 flex h-16 shrink-0 items-center gap-2 border-b border-line bg-surface/95 px-3 backdrop-blur md:gap-3 md:px-5">
    <button data-toggle-sidebar class="rounded-lg p-2 text-ink-muted hover:bg-surface-2 md:hidden" aria-label="@(isFa ? "بازکردن منوی اصلی" : "Open main navigation")">
        <i data-lucide="menu" class="h-5 w-5"></i>
    </button>

    <div class="hidden sm:block">@await Component.InvokeAsync("WorkspaceSwitcher")</div>
    <div class="hidden xl:block">@await Component.InvokeAsync("EnvironmentSwitcher")</div>

    <div class="flex min-w-0 flex-1 justify-center px-1 md:px-3">
        <button type="button" data-command-open class="group flex w-full max-w-lg items-center gap-2 rounded-xl border border-line-strong bg-surface-2 px-3 py-2 text-start text-sm text-ink-faint hover:border-accent/30 hover:bg-surface">
            <i data-lucide="search" class="h-4 w-4 shrink-0"></i>
            <span class="min-w-0 flex-1 truncate">@(isFa ? "جست‌وجوی برنامه، پروژه، دامنه…" : "Search apps, projects, domains…")</span>
            <kbd class="hidden rounded-md border border-line bg-surface px-1.5 py-0.5 font-sans text-[10px] text-ink-faint md:inline">⌘ K</kbd>
        </button>
    </div>

    <div class="relative" data-menu-root>
        <button type="button" data-menu-trigger class="btn-primary inline-flex items-center gap-2 whitespace-nowrap px-3 md:px-4" aria-expanded="false" aria-label="@(isFa ? "منبع جدید" : "New resource")">
            <i data-lucide="plus" class="h-4 w-4"></i><span class="hidden lg:inline">@(isFa ? "منبع جدید" : "New resource")</span><i data-lucide="chevron-down" class="hidden h-3.5 w-3.5 lg:block"></i>
        </button>
        <div data-menu class="topbar-menu end-0 hidden w-56">
            <a href="/apps/create"><span class="menu-icon bg-accent-soft text-accent-text"><i data-lucide="box" class="h-4 w-4"></i></span><span><strong>@(isFa ? "برنامه" : "Application")</strong><small>@(isFa ? "از Git یا Docker" : "From Git or Docker")</small></span></a>
            <a href="/databases/create"><span class="menu-icon bg-info-soft text-info"><i data-lucide="database" class="h-4 w-4"></i></span><span><strong>@(isFa ? "دیتابیس" : "Database")</strong><small>@(isFa ? "سرویس مدیریت‌شده" : "Managed service")</small></span></a>
            <a href="/templates"><span class="menu-icon bg-warn-soft text-warn"><i data-lucide="sparkles" class="h-4 w-4"></i></span><span><strong>@(isFa ? "پروژهٔ آماده" : "Template project")</strong><small>@(isFa ? "استک کامل" : "Complete stack")</small></span></a>
        </div>
    </div>

    @* Context-aware: HelpMap resolves the request path to a chapter slug above, and this only ever
       renders the honest outcome of that lookup — the chapter for the current screen, or the index
       with data-help-state="index" when there is none. Never chapter one as a fallback guess. *@
    <a href="@helpHref" data-help-control data-help-state="@helpState"
       class="rounded-lg p-2 text-ink-muted hover:bg-surface-2"
       title="@(isFa ? "راهنما" : "Help")" aria-label="@(isFa ? "راهنما" : "Help")">
        <i data-lucide="circle-help" class="h-4.5 w-4.5"></i>
    </a>

    @* N3 (2026-08-16 notification-system spec): the bell goes to this person's own inbox now, and the
       badge is what they have not read — see UnreadNotificationsViewComponent. It used to count open
       incidents for the whole workspace; that count did not go away, it moved to where incidents live,
       the timeline on /monitoring, because "conditions open here" and "things I have not read" are
       different facts with different lifecycles and one badge cannot honestly be both. *@
    <a href="/notifications" class="relative hidden rounded-lg p-2 text-ink-muted hover:bg-surface-2 md:block" title="@(isFa ? "اعلان‌ها" : "Notifications")">
        <i data-lucide="bell" class="h-4.5 w-4.5"></i>
        @await Component.InvokeAsync("UnreadNotifications")
    </a>

    <div class="hidden items-center rounded-lg bg-surface-2 p-0.5 xl:flex" role="group" aria-label="@T["Theme"]">
        @foreach (var (value, icon, label) in new[] { ("system", "monitor", T["System"].Value), ("light", "sun", T["Light"].Value), ("dark", "moon", T["Dark"].Value) })
        {
            <button type="button" data-theme-choice="@value" title="@label" aria-label="@label" class="rounded-md px-2 py-1 text-ink-faint"><i data-lucide="@icon" class="h-4 w-4"></i></button>
        }
    </div>

    <div class="relative" data-menu-root>
        <button type="button" data-menu-trigger class="flex items-center gap-2 rounded-xl p-1.5 hover:bg-surface-2" aria-expanded="false" aria-label="@(isFa ? "منوی حساب کاربری" : "Account menu")">
            <span class="hidden md:block">@await Component.InvokeAsync("AccountBalance", new { compact = true })</span>
            <span class="grid h-8 w-8 place-items-center rounded-lg bg-accent text-xs font-bold text-white">@initial</span>
            <span class="hidden max-w-28 truncate text-xs font-medium text-ink 2xl:block">@identity</span>
            <i data-lucide="chevron-down" class="hidden h-3.5 w-3.5 text-ink-faint lg:block"></i>
        </button>
        <div data-menu class="topbar-menu end-0 hidden w-52">
            <div class="border-b border-line px-3 py-2"><strong class="block truncate text-xs text-ink">@identity</strong><small class="text-[10px] text-ink-faint">@(isFa ? "حساب Harbora" : "Harbora account")</small></div>
            <a href="/billing"><i data-lucide="wallet" class="h-4 w-4"></i>@await Component.InvokeAsync("AccountBalance")</a>
            <a href="/settings"><i data-lucide="settings" class="h-4 w-4"></i><span><strong>@(isFa ? "تنظیمات" : "Settings")</strong></span></a>
            @* Simple / Advanced. The return URL is the page they are on, so switching keeps them
               where they were rather than dropping them on the dashboard mid-task. *@
            @{ var mode = await PanelModes.GetAsync(); var toAdvanced = mode == Harbora.Domain.Identity.PanelMode.Simple; }
            <form asp-controller="Account" asp-action="SetPanelMode" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <input type="hidden" name="mode" value="@(toAdvanced ? "Advanced" : "Simple")" />
                <button type="submit">
                    <i data-lucide="@(toAdvanced ? "sliders-horizontal" : "gauge")" class="h-4 w-4"></i>
                    <span>@(toAdvanced
                        ? (isFa ? "حالت پیشرفته" : "Advanced mode")
                        : (isFa ? "حالت ساده" : "Simple mode"))</span>
                </button>
            </form>
            <form asp-controller="Account" asp-action="SetLanguage" method="post">
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" /><input type="hidden" name="culture" value="@(isFa ? "en" : "fa")" />
                <button type="submit"><i data-lucide="languages" class="h-4 w-4"></i><span>@(isFa ? "English" : "فارسی")</span></button>
            </form>
            <form asp-controller="Account" asp-action="Logout" method="post" class="border-t border-line"><button type="submit" class="text-danger"><i data-lucide="log-out" class="h-4 w-4"></i><span>@T["Logout"]</span></button></form>
        </div>
    </div>
</header>

<div data-command-palette class="command-palette hidden" aria-hidden="true">
    <div data-command-backdrop class="absolute inset-0 bg-black/35 backdrop-blur-sm"></div>
    <section class="command-dialog" role="dialog" aria-modal="true" aria-label="@(isFa ? "جست‌وجوی سریع" : "Quick search")">
        <div class="flex items-center gap-3 border-b border-line px-4">
            <i data-lucide="search" class="h-5 w-5 text-ink-faint"></i>
            <input data-command-input type="search" autocomplete="off" placeholder="@(isFa ? "نام یک بخش یا اقدام را بنویسید…" : "Type a page or action…")" class="h-14 min-w-0 flex-1 bg-transparent text-sm text-ink outline-none placeholder:text-ink-faint" />
            <kbd class="rounded-md border border-line bg-surface-2 px-2 py-1 text-[10px] text-ink-faint">ESC</kbd>
        </div>
        <div data-command-results class="max-h-[24rem] overflow-y-auto p-2">
            <div class="px-2 py-2 text-[10px] font-semibold uppercase tracking-wider text-ink-faint">@(isFa ? "رفتن به" : "Go to")</div>
            @foreach (var item in groups.SelectMany(g => g.Items))
            {
                <a asp-controller="@item.Controller" asp-action="@item.Action" data-command-item data-search="@ItemLabel(item.Key) @item.Key" class="command-item"><span class="menu-icon bg-surface-2 text-ink-muted"><i data-lucide="@item.Icon" class="h-4 w-4"></i></span><span class="flex-1">@ItemLabel(item.Key)</span><i data-lucide="arrow-up-left" class="h-3.5 w-3.5 text-ink-faint"></i></a>
            }
        </div>
        <div class="flex items-center justify-between border-t border-line px-4 py-2 text-[10px] text-ink-faint"><span>@(isFa ? "↑↓ انتخاب · Enter بازکردن" : "↑↓ select · Enter open")</span><span>Harbora</span></div>
    </section>
</div>
