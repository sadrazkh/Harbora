@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Html
@inject Harbora.Web.Infrastructure.PanelModeProvider PanelModes
@model IReadOnlyList<Harbora.Infrastructure.Dashboard.AttentionItem>
@{
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";

    // Do-not-change item 23, the PanelMode fold-never-remove principle. Simple mode folds the
    // verbatim technical line — exit codes, npm output, a certificate's own error — because the
    // sentence above it and the button beside it are the whole story for somebody who is not going
    // to read a build log. Folded, never dropped: one click reaches it, in either mode.
    //
    // Deliberately folded at every level, including Critical. Exempting Critical was the first
    // design and it was wrong: in Attention.Build, every item that carries DetailText is Critical
    // except one certificate case, so the exemption would have left a fold that almost never folded
    // — a control that looks like it does something and does nothing. The line it defers is the
    // first line of a build log, and the action button on the same row goes to that log.
    var detailUnfolded = Harbora.Infrastructure.Navigation.PanelSections.StartsOpen(
        await PanelModes.GetAsync());

    // Status is never carried by colour alone — each level has its own word, spoken by the badge
    // itself (aria-label / title), not inferred from a colour a screen reader cannot see.
    (string badgeClass, string word) Style(Harbora.Infrastructure.Dashboard.AttentionLevel level) =>
        level switch
        {
            Harbora.Infrastructure.Dashboard.AttentionLevel.Critical =>
                ("attention-badge is-critical", isFa ? "بحرانی" : "critical"),
            Harbora.Infrastructure.Dashboard.AttentionLevel.Warning =>
                ("attention-badge is-warning", isFa ? "هشدار" : "warning"),
            _ => ("attention-badge is-info", isFa ? "پیشنهاد" : "suggestion")
        };

    // Turns a resource key ("{0}: deploy failed") plus its arguments into markup where every
    // interpolated value — an app name, a deploy number, a host — sits inside its own monospace,
    // dir="ltr" span, exactly like every other technical token on this page (binding rule: "every
    // technical token... monospace, dir=ltr, even in Persian"). The surrounding prose stays in the
    // page's own language and direction; only the data inside it is pinned to LTR.
    //
    // Reads the raw resource value rather than calling the indexer with the args, because the
    // indexer's own formatting has nowhere to hang a <span> around one argument and not the rest.
    IHtmlContent Sentence(string key, IReadOnlyList<string> args)
    {
        var template = T[key].Value;
        if (args.Count == 0) return new HtmlString(Html.Encode(template));

        var sb = new System.Text.StringBuilder();
        var last = 0;
        foreach (Match m in Regex.Matches(template, @"\{(\d+)\}"))
        {
            sb.Append(Html.Encode(template[last..m.Index]));
            var index = int.Parse(m.Groups[1].Value);
            var arg = index < args.Count ? args[index] : string.Empty;
            sb.Append("<span class=\"font-mono\" dir=\"ltr\">").Append(Html.Encode(arg)).Append("</span>");
            last = m.Index + m.Length;
        }
        sb.Append(Html.Encode(template[last..]));
        return new HtmlString(sb.ToString());
    }
}

<section class="mb-6">
    @if (Model.Count == 0)
    {
        @* The good case says so plainly, instead of leaving a blank space that reads as broken. *@
        <div class="rounded-xl border border-line bg-surface p-4 flex items-center gap-3">
            <span class="h-2 w-2 rounded-full bg-ok"></span>
            <div>
                <div class="text-sm text-ink">@(isFa ? "همه‌چیز مرتب است" : "Everything looks fine")</div>
                <div class="text-xs text-ink-faint">
                    @(isFa
                        ? "دیپلوی ناموفق، اپ خوابیده، بکاپ خراب یا گواهی رو به انقضا پیدا نشد."
                        : "No failed deploys, stopped apps, broken backups or expiring certificates.")
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="attention-card">
            <div class="attention-header">
                <span class="attention-header-dot"></span>
                <span class="attention-header-title">
                    @(isFa ? $"{Model.Count} مورد نیاز به توجه شما دارد" : Model.Count == 1 ? "1 thing needs you" : $"{Model.Count} things need you")
                </span>
                <span class="attention-header-note">
                    @(isFa
                        ? "تولید در حال سرویس‌دهی است — هیچ‌کدام از این موارد قطعی نیستند"
                        : "Production is serving traffic — none of these are outages")
                </span>
                @* The reference mockup puts a "Mute for 24h" control here and it was carried over as
                   inert text. Removed: nothing in the platform can silence these yet, and offering it
                   in words is the same claim as offering it as a button — this panel exists precisely
                   to stop the page reporting things it has not done. It comes back when muting does. *@
            </div>
            @foreach (var item in Model)
            {
                var s = Style(item.Level);
                <div class="attention-row">
                    <span class="@s.badgeClass" title="@s.word" aria-label="@s.word">@s.word</span>
                    <div class="min-w-0 flex-1">
                        <div class="attention-title">@Sentence(item.TitleKey, item.TitleArgs)</div>
                        @if (item.DetailText is not null)
                        {
                            @* Verbatim data from the failing thing itself — a summarised error, never
                               localised — so the whole line is technical and always reads LTR. *@
                            if (detailUnfolded)
                            {
                                <div class="attention-detail font-mono" dir="ltr" data-detail="open">@item.DetailText</div>
                            }
                            else
                            {
                                <details class="attention-detail-fold" data-detail="folded">
                                    <summary>@(isFa ? "جزئیات فنی" : "Technical detail")</summary>
                                    <div class="attention-detail font-mono" dir="ltr">@item.DetailText</div>
                                </details>
                            }
                        }
                        else if (item.DetailKey is not null)
                        {
                            <div class="attention-detail">@Sentence(item.DetailKey, item.DetailArgs)</div>
                        }
                    </div>
                    @if (item.ActionUrl is not null && item.ActionKey is not null)
                    {
                        <a href="@item.ActionUrl" class="attention-action">@T[item.ActionKey]</a>
                    }
                </div>
            }
        </div>
    }
</section>
