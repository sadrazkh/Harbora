@model IReadOnlyList<Harbora.Infrastructure.Dashboard.AttentionItem>
@{
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";

    // Status is never carried by colour alone — each level has its own mark and word.
    (string mark, string text, string border, string word) Style(Harbora.Infrastructure.Dashboard.AttentionLevel level) =>
        level switch
        {
            Harbora.Infrastructure.Dashboard.AttentionLevel.Critical =>
                ("✗", "text-danger", "border-danger", isFa ? "بحرانی" : "critical"),
            Harbora.Infrastructure.Dashboard.AttentionLevel.Warning =>
                ("!", "text-warn", "border-warn", isFa ? "هشدار" : "warning"),
            _ => ("→", "text-ink", "border-line", isFa ? "پیشنهاد" : "suggestion")
        };
}

<section class="mb-6">
    <h2 class="text-sm font-semibold text-ink-muted mb-2">
        @(isFa ? "نیازمند توجه شما" : "Needs your attention")
    </h2>

    @if (Model.Count == 0)
    {
        @* The good case says so plainly, instead of leaving a blank space that reads as broken. *@
        <div class="rounded-xl border border-line bg-surface p-4 flex items-center gap-3">
            <span class="text-ok">●</span>
            <div>
                <div class="text-sm text-ink">@(isFa ? "همه‌چیز مرتب است" : "Everything looks fine")</div>
                <div class="text-xs text-ink-faint">
                    @(isFa
                        ? "دیپلوی ناموفق، اپ خوابیده، بکاپ خراب یا گواهی رو به انقضا پیدا نشد."
                        : "No failed deploys, stopped apps, broken backups or expiring certificates.")
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="space-y-2">
            @foreach (var item in Model)
            {
                var s = Style(item.Level);
                <div class="rounded-xl border @s.border bg-surface p-3 flex items-start justify-between gap-3">
                    <div class="flex items-start gap-3 min-w-0">
                        <span class="@s.text mt-0.5" title="@s.word" aria-label="@s.word">@s.mark</span>
                        <div class="min-w-0">
                            <div class="text-sm font-medium text-ink">@item.Title</div>
                            <div class="text-xs text-ink-muted break-words">@item.Detail</div>
                        </div>
                    </div>
                    @if (item.ActionUrl is not null)
                    {
                        <a href="@item.ActionUrl"
                           class="shrink-0 rounded-lg bg-surface-2 hover:bg-surface-2 px-3 py-1.5 text-xs">
                            @item.ActionText
                        </a>
                    }
                </div>
            }
        </div>
    }
</section>
