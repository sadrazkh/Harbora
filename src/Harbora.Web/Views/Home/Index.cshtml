@model DashboardViewModel
@using Harbora.Domain.Common
@using Harbora.Web.ViewModels
@{
    ViewData["Title"] = "Dashboard";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";

    string Bytes(long? bytes) => bytes switch
    {
        null => "—",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        < 1024L * 1024 * 1024 => $"{bytes / 1024.0 / 1024:0.#} MB",
        _ => $"{bytes / 1024.0 / 1024 / 1024:0.##} GB"
    };
    string SourceLabel(AppSourceType source) => source switch
    {
        AppSourceType.GitRepository => isFa ? "Git" : "Git",
        AppSourceType.Dockerfile => "Dockerfile",
        AppSourceType.DockerCompose => "Compose",
        AppSourceType.PrebuiltImage => isFa ? "ایمیج داکر" : "Docker image",
        AppSourceType.StaticSite => isFa ? "استاتیک" : "Static site",
        AppSourceType.Template => isFa ? "قالب" : "Template",
        AppSourceType.Upload => isFa ? "آپلود CLI" : "CLI upload",
        AppSourceType.InlineCode => isFa ? "فانکشن" : "Function",
        _ => source.ToString()
    };
    string AppDot(AppStatus status) => status switch
    {
        AppStatus.Running => "bg-ok",
        AppStatus.Failed or AppStatus.Crashed => "bg-danger",
        AppStatus.Deploying => "bg-info",
        _ => "bg-idle"
    };
    string DbDot(ServiceStatus status) => status switch
    {
        ServiceStatus.Running => "bg-ok",
        ServiceStatus.Failed => "bg-danger",
        ServiceStatus.Provisioning => "bg-info",
        _ => "bg-idle"
    };
    string DeployTone(DeploymentStatus status) => status switch
    {
        DeploymentStatus.Succeeded => "bg-ok",
        DeploymentStatus.Failed or DeploymentStatus.Cancelled => "bg-danger",
        _ => "bg-accent"
    };

    // Setup progress: the same four onboarding facts the old getting-started panel tracked, now a
    // single line beside the heading instead of a whole panel — the redesign's own description of
    // the change (spec 3a, step 1).
    var steps = new (bool Done, string Label, string Url)[]
    {
        (Model.ServersOnline > 0, isFa ? "اتصال سرور" : "Connect a server", "/servers"),
        (Model.DomainsTotal > 0, isFa ? "افزودن دامنه" : "Add a domain", "/domains"),
        (Model.AppCount > 0, isFa ? "ساخت اولین برنامه" : "Create your first app", "/apps/create"),
        (Model.BackupSchedulesEnabled > 0, isFa ? "فعال‌سازی پشتیبان" : "Enable backups", "/backups")
    };
    var completedSteps = steps.Count(s => s.Done);
    var nextStep = steps.FirstOrDefault(s => !s.Done);

    var resourceRows = Model.ResourceApps.Count + Model.ResourceDatabases.Count;
}

<div class="page-heading">
    <partial name="Design/_PageHeader" model="@(new PageHeaderModel(
        isFa ? "بازبینی تولید" : "Production overview",
        isFa
            ? $"{Model.AppCount} برنامه · {Model.DatabaseCount} دیتابیس · همین الان به‌روز شد"
            : $"{Model.AppCount} application{(Model.AppCount == 1 ? "" : "s")} · {Model.DatabaseCount} database{(Model.DatabaseCount == 1 ? "" : "s")} · updated just now"))" />
    @if (completedSteps < steps.Length)
    {
        <div class="setup-progress">
            <span class="setup-progress-label">@(isFa ? $"راه‌اندازی {completedSteps} از {steps.Length}" : $"Setup {completedSteps} of {steps.Length}")</span>
            <span class="setup-progress-track"><i style="width:@(completedSteps * 100 / steps.Length)%"></i></span>
            <a href="@nextStep.Url" class="setup-progress-next">@nextStep.Label</a>
        </div>
    }
</div>

<partial name="_Attention" model="Model.Attention" />
@if (!Model.DockerAvailable)
{
    <div class="alert-warning mb-5"><i data-lucide="triangle-alert" class="h-4 w-4"></i><span>@(isFa ? "Docker در دسترس نیست؛ متریک زنده و استقرار موقتاً متوقف است." : "Docker is unreachable; live metrics and deployments are temporarily paused.")</span><a href="/servers">@(isFa ? "بررسی سرورها" : "Check servers")</a></div>
}

@* Redesign 3a: five hairline-divided cells replace the five icon cards — Platform status folds
   into the last cell (still one click from /servers), and the wall of coloured tiles becomes one
   quiet strip. *@
<section class="stat-bar mb-5">
    <a href="/projects">
        <div class="stat-bar-label">@(isFa ? "پروژه‌ها" : "Projects")</div>
        <div class="stat-bar-value">@Model.ProjectCount</div>
    </a>
    <a href="/apps">
        <div class="stat-bar-label">@T["Applications"]</div>
        <div class="stat-bar-value">@Model.AppCount <span class="text-ok">@Model.RunningCount @(isFa ? "در حال اجرا" : "running")</span></div>
    </a>
    <a href="/databases">
        <div class="stat-bar-label">@T["Databases"]</div>
        <div class="stat-bar-value">@Model.DatabaseCount <span class="text-ok">@Model.HealthyDatabaseCount @(isFa ? "سالم" : "healthy")</span></div>
    </a>
    <a href="/deployments">
        <div class="stat-bar-label">@(isFa ? "استقرار · ۳۰ روز" : "Deployments · 30d")</div>
        <div class="stat-bar-value">@Model.DeploymentsTotal <span class="@(Model.FailedDeployments > 0 ? "text-danger" : "text-ok")">@Model.FailedDeployments @(isFa ? "ناموفق" : "failed")</span></div>
    </a>
    <a href="/servers">
        <div class="stat-bar-label">@(isFa ? "سرورها" : "Servers")</div>
        <div class="stat-bar-value">@Model.ServersOnline/@Model.ServersTotal <span class="@(Model.ServersOnline == Model.ServersTotal && Model.ServersTotal > 0 ? "text-ok" : "text-warn")">@(isFa ? "آنلاین" : "online")</span></div>
    </a>
</section>

<section class="grid gap-4 lg:grid-cols-[1.5fr_1fr]">
    <div class="dashboard-panel">
        <div class="dashboard-panel-heading">
            <div><h2>@(isFa ? "منابع در حال اجرا" : "Resources in Production")</h2><p>@(isFa ? "اپ‌ها و دیتابیس‌ها، یک‌جا" : "Apps and databases, together")</p></div>
            <a href="/apps">@(isFa ? "مشاهده همه" : "View all")</a>
        </div>
        @if (resourceRows == 0)
        {
            <partial name="Design/_EmptyState" model="@(new EmptyStateModel("boxes",
                isFa ? "هنوز هیچ اپ یا دیتابیسی ساخته نشده است." : "No apps or databases yet.",
                isFa ? "ساخت منبع" : "New resource", "/apps/create"))" />
        }
        else
        {
            <div class="-mx-4 mt-3 overflow-x-auto">
                <table class="resource-table min-w-[560px]">
                    <thead><tr>
                        <th>@(isFa ? "منبع" : "RESOURCE")</th>
                        <th>@(isFa ? "سلامت" : "HEALTH")</th>
                        <th>@(isFa ? "آدرس" : "ENDPOINT")</th>
                        <th>@(isFa ? "آخرین استقرار" : "LAST DEPLOY")</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var app in Model.ResourceApps)
                    {
                        <tr>
                            <td>
                                <a href="/apps/details/@app.Id" class="resource-identity">
                                    <span class="resource-avatar bg-accent-soft text-accent-text"><i data-lucide="boxes" class="h-4 w-4"></i></span>
                                    <span><strong dir="ltr" class="font-mono">@app.Name</strong><small>@(app.Kind) · @SourceLabel(app.SourceType)</small></span>
                                </a>
                            </td>
                            <td>
                                <div class="flex items-center gap-1.5">
                                    <span class="h-1.5 w-1.5 rounded-full @AppDot(app.Status)"></span>
                                    @if (app.LastDeploymentStatus is null)
                                    {
                                        <span class="table-secondary">@(isFa ? "هنوز مستقر نشده" : "never deployed")</span>
                                    }
                                    else if (app.CpuPercent is not null)
                                    {
                                        <span class="font-mono text-[11.5px] text-ink-muted" dir="ltr">@($"{app.CpuPercent:0.#}%") · @Bytes(app.MemoryBytes)</span>
                                    }
                                    else
                                    {
                                        <span class="table-secondary">@(isFa ? "بدون متریک" : "no metrics")</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (app.Domain is { Length: > 0 } host)
                                { <span class="domain-link" dir="ltr">@host</span> }
                                else
                                { <span class="table-secondary">—</span> }
                            </td>
                            <td>
                                @if (app.LastDeploymentNumber is { } number)
                                { <span class="table-primary" dir="ltr">#@number · @(app.LastDeploymentStatus == DeploymentStatus.Succeeded ? (isFa ? "موفق" : "ok") : app.LastDeploymentStatus?.ToString())</span> }
                                else
                                { <span class="table-secondary">—</span> }
                            </td>
                        </tr>
                    }
                    @foreach (var database in Model.ResourceDatabases)
                    {
                        <tr>
                            <td>
                                <a href="/databases?selected=@database.Id" class="resource-identity">
                                    <span class="resource-avatar bg-info-soft text-info"><i data-lucide="database" class="h-4 w-4"></i></span>
                                    <span><strong dir="ltr" class="font-mono">@database.Name</strong><small>@database.Type · @database.Version</small></span>
                                </a>
                            </td>
                            <td>
                                <div class="flex items-center gap-1.5">
                                    <span class="h-1.5 w-1.5 rounded-full @DbDot(database.Status)"></span>
                                    @if (database.StorageBytes is { } stored)
                                    { <span class="font-mono text-[11.5px] text-ink-muted" dir="ltr">@Bytes(stored)</span> }
                                    else
                                    { <span class="table-secondary">@(isFa ? "بدون متریک" : "no metrics")</span> }
                                </div>
                            </td>
                            <td><span class="table-secondary font-mono" dir="ltr">@(database.ContainerName):@database.InternalPort</span></td>
                            <td>
                                @if (database.LastBackupStatus is { } backupStatus)
                                {
                                    <span class="@(backupStatus == BackupStatus.Completed ? "text-ok" : backupStatus == BackupStatus.Failed ? "text-danger" : "text-ink-muted") text-[11.5px]">
                                        @(backupStatus == BackupStatus.Completed ? (isFa ? "پشتیبان: موفق" : "backup: ok") : backupStatus == BackupStatus.Failed ? (isFa ? "پشتیبان: ناموفق" : "backup: failed") : backupStatus.ToString())
                                    </span>
                                }
                                else
                                {
                                    <span class="text-warn text-[11.5px]">@(isFa ? "بدون پشتیبان" : "no backup")</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="dashboard-panel">
        <div class="dashboard-panel-heading">
            <div><h2>@(isFa ? "فعالیت" : "Activity")</h2><p>@(isFa ? "آخرین رویدادها" : "Latest events")</p></div>
            <a href="/deployments">@(isFa ? "همه رویدادها" : "All events")</a>
        </div>
        @if (Model.RecentDeployments.Count == 0)
        {
            <partial name="Design/_EmptyState" model="@(new EmptyStateModel("list-checks",
                isFa ? "هنوز رویدادی ثبت نشده است." : "No activity yet.", null, null))" />
        }
        else
        {
            <div class="activity-list mt-3">
                @foreach (var deployment in Model.RecentDeployments.Take(6))
                {
                    <div class="activity-item">
                        <span class="activity-dot @DeployTone(deployment.Status)"></span>
                        <div>
                            <div class="activity-text">
                                <span class="font-mono" dir="ltr">#@deployment.Number @deployment.App?.Name</span>
                                @(deployment.Status switch
                                {
                                    DeploymentStatus.Succeeded => isFa ? "موفق شد" : "succeeded",
                                    DeploymentStatus.Failed => isFa ? "ناموفق بود" : "failed",
                                    DeploymentStatus.Cancelled => isFa ? "لغو شد" : "was cancelled",
                                    _ => isFa ? "در حال انجام است" : "is in progress"
                                })
                            </div>
                            <div class="activity-meta" dir="ltr">@deployment.Trigger · @deployment.CreatedAt.LocalDateTime.ToString(Dates.Stamp)</div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
