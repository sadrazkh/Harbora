@model DashboardViewModel
@using Harbora.Infrastructure.Monitoring
@using Harbora.Web.ViewModels
@{
    ViewData["Title"] = "Dashboard";
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";

    string Gb(long b) => b <= 0 ? "—" : $"{b / 1024.0 / 1024 / 1024:0.0} GB";

    // A percentage is only a number when a total is known. A server that has not reported its
    // capacity is not a server at 0%, and the honesty gate is what keeps those two apart.
    double? diskPercent = Model.DiskTotal > 0 ? (double)Model.DiskUsed / Model.DiskTotal * 100 : null;
    double? memoryPercent = Model.MemoryTotal > 0 && Model.MemoryUsed is { } used ? (double)used / Model.MemoryTotal * 100 : null;

    var hour = DateTimeOffset.Now.Hour;
    var greeting = hour switch
    {
        < 12 => isFa ? "صبح بخیر" : "Good morning",
        < 18 => isFa ? "ظهر بخیر" : "Good afternoon",
        _ => isFa ? "شب بخیر" : "Good evening"
    };
    var who = User.Identity?.Name is { Length: > 0 } name ? name.Split('@')[0] : null;
}

<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-ink">
            @greeting@(who is null ? "" : (isFa ? $"، {who}" : $", {who}"))@(isFa ? " 👋" : "! 👋")
        </h1>
        <p class="mt-1 text-sm text-ink-muted">
            @(isFa ? "وضعیت پلتفرم و سرویس‌های شما در یک نگاه." : "Here's what's happening with your platform today.")
        </p>
    </div>
    <a href="/apps/create" class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent-hover">
        + @T["New App"]
    </a>
</div>

@* What needs a person's attention comes before anything decorative. *@
<partial name="_Attention" model="Model.Attention" />

@if (!Model.DockerAvailable)
{
    <div class="mb-6 rounded-xl border border-warn bg-warn-soft px-4 py-3 text-sm text-warn">
        @(isFa
            ? "دیمن Docker در دسترس نیست — متریک‌ها و استقرارها تا برقراری اتصال متوقف‌اند."
            : "The Docker daemon is not reachable. Metrics and deployments are paused until it is back.")
    </div>
}

@* ---- headline figures ----
   Every one of these is measured. The mockup also shows uptime, request counts and latency; those
   are not collected yet, so they are not invented here — they arrive with the collector. *@
@{
    // Built as variables rather than inline attributes: the labels contain double quotes, which a
    // Razor attribute cannot hold without escaping the whole expression into unreadability.
    var appsCard = new StatCardModel("boxes", T["Applications"].Value,
        MetricDisplay.For(Model.AppCount),
        $"{Model.RunningCount} {(isFa ? "در حال اجرا" : "running")}");

    var deploymentsCard = new StatCardModel("rocket", T["Deployments"].Value,
        MetricDisplay.For(Model.DeploymentsTotal),
        Model.FailedDeployments > 0
            ? $"{Model.FailedDeployments} {(isFa ? "ناموفق" : "failed")}"
            : (isFa ? "بدون خطا" : "none failed"));

    var cpuCard = new StatCardModel("server", T["CPU"].Value,
        MetricDisplay.For(Model.DockerAvailable ? Model.CpuPercent : null, "%"),
        $"{Model.ContainersRunning} {(isFa ? "کانتینر" : "containers")}");

    var diskCard = new StatCardModel("archive", T["Disk"].Value,
        MetricDisplay.For(diskPercent, "%"),
        Model.DiskTotal > 0 ? $"{Gb(Model.DiskUsed)} / {Gb(Model.DiskTotal)}" : null);
}
<div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 2xl:grid-cols-4">
    <partial name="Design/_StatCard" model="appsCard" />
    <partial name="Design/_StatCard" model="deploymentsCard" />
    <partial name="Design/_StatCard" model="cpuCard" />
    <partial name="Design/_StatCard" model="diskCard" />
</div>

@if (Model.AppCount == 0)
{
    @* ---- first run ---- *@
    <section class="mb-6 rounded-xl border border-line bg-surface p-6 shadow-panel">
        <h2 class="text-lg font-bold text-ink">@(isFa ? "به Harbora خوش آمدید 🎉" : "Welcome to Harbora 🎉")</h2>
        <p class="mt-1 text-sm text-ink-muted">
            @(isFa ? "در سه قدم اولین سرویس خود را آنلاین کنید." : "Get your first service online in three steps.")
        </p>
        <div class="mt-5 grid gap-4 sm:grid-cols-3">
            @foreach (var (n, t, d) in new[]
            {
                ("1", isFa ? "ساخت سرویس" : "Create a service", isFa ? "از Git، ایمیج Docker یا قالب آماده" : "From Git, a Docker image or a template"),
                ("2", isFa ? "اتصال دامنه" : "Attach a domain", isFa ? "SSL خودکار از Let's Encrypt" : "SSL is automatic via Let's Encrypt"),
                ("3", isFa ? "استقرار" : "Deploy", isFa ? "لاگ زنده، سلامت‌سنجی و بازگشت" : "Live logs, health checks, rollback")
            })
            {
                <div class="rounded-xl border border-line bg-surface-2 p-4">
                    <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-accent text-sm font-bold text-white">@n</span>
                    <div class="mt-2 font-semibold text-ink">@t</div>
                    <div class="mt-1 text-xs text-ink-muted">@d</div>
                </div>
            }
        </div>
        <a href="/apps/create" class="mt-6 inline-block rounded-lg bg-accent px-5 py-2.5 font-semibold text-white hover:bg-accent-hover">
            @T["Create Application"]
        </a>
    </section>
}

@* ---- projects ---- *@
@if (Model.Projects.Count > 0)
{
    <div class="mb-6">
        @{ var projectsPanel = new PanelModel(isFa ? "پروژه‌ها" : "Projects", isFa ? "همه" : "View all", "/projects"); }
        <partial name="Design/_PanelStart" model="projectsPanel" />
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var p in Model.Projects)
            {
                <a href="/projects/@p.Id" class="rounded-xl border border-line bg-surface-2 p-3 transition hover:border-accent">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0">
                            <div class="truncate text-sm font-medium text-ink">@p.Name</div>
                            <div class="text-xs text-ink-faint">
                                @p.Services @(isFa ? "سرویس" : "services") · @p.Databases @(isFa ? "دیتابیس" : "databases")
                            </div>
                        </div>
                        @if (p.Unhealthy > 0)
                        {
                            <partial name="Design/_StatusPill" model="new StatusPillModel(p.Unhealthy.ToString(), Tone.Error)" />
                        }
                        else if (p.Services > 0)
                        {
                            <partial name="Design/_StatusPill" model="@(new StatusPillModel(isFa ? "سالم" : "healthy", Tone.Ok))" />
                        }
                    </div>
                </a>
            }
        </div>
        <partial name="Design/_PanelEnd" />
    </div>
}

@* ---- start from something ----
   The two rows the reference dashboard leads with. Every tile is a template that is installed and
   enabled, read from the database — a fixed menu of logos would offer things this installation
   cannot actually deploy, which is the same lie as a metric nobody measured. *@
@if (Model.StarterApps.Count > 0 || Model.StarterDatabases.Count > 0)
{
    <div class="mb-6 grid gap-6 lg:grid-cols-2">
        @if (Model.StarterApps.Count > 0)
        {
            <div>
                @{ var starterPanel = new PanelModel(isFa ? "اپ‌های آماده" : "One-click apps", isFa ? "همه" : "View all", "/templates"); }
                <partial name="Design/_PanelStart" model="starterPanel" />
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 p-3">
                    @foreach (var t in Model.StarterApps)
                    {
                        <a href="/templates/@t.Id"
                           class="group flex flex-col items-center gap-2 rounded-xl border border-line bg-surface-2 p-3 text-center hover:border-accent transition">
                            <span class="grid h-10 w-10 place-items-center rounded-xl bg-accent-soft text-accent-text text-sm font-bold">
                                @(t.Name.Trim().Length > 0 ? t.Name.Trim()[..1].ToUpperInvariant() : "?")
                            </span>
                            <span class="truncate w-full text-[11px] font-medium text-ink" title="@t.Name">
                                @(isFa && !string.IsNullOrWhiteSpace(t.NameFa) ? t.NameFa : t.Name)
                            </span>
                        </a>
                    }
                </div>
                <p class="px-4 pb-3 text-[11px] text-ink-faint">
                    @(isFa ? "قبل از اجرا، برنامه، دیتابیس، volume و متغیرهای هر قالب را بررسی کنید." : "Review every app, database, volume and variable before the stack is created.")
                </p>
                <partial name="Design/_PanelEnd" />
            </div>
        }

        @if (Model.StarterDatabases.Count > 0)
        {
            <div>
                @{ var dbPanel = new PanelModel(isFa ? "دیتابیس‌های آماده" : "Ready-made databases", isFa ? "همه" : "View all", "/databases"); }
                <partial name="Design/_PanelStart" model="dbPanel" />
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 p-3">
                    @foreach (var t in Model.StarterDatabases)
                    {
                        <a href="/databases/create?type=@t.Type"
                           class="group flex flex-col items-center gap-2 rounded-xl border border-line bg-surface-2 p-3 text-center hover:border-accent transition">
                            <span class="grid h-10 w-10 place-items-center rounded-xl bg-ok/10 text-ok text-sm font-bold">
                                @(t.Name.Trim().Length > 0 ? t.Name.Trim()[..1].ToUpperInvariant() : "?")
                            </span>
                            <span class="truncate w-full text-[11px] font-medium text-ink" title="@t.Name">
                                @(isFa && !string.IsNullOrWhiteSpace(t.NameFa) ? t.NameFa : t.Name)
                            </span>
                        </a>
                    }
                </div>
                <p class="px-4 pb-3 text-[11px] text-ink-faint">
                    @(isFa ? "در یک محیط ساخته می‌شود و اتصالش را به شما می‌دهد." : "Provisioned into an environment, with its connection details.")
                </p>
                <partial name="Design/_PanelEnd" />
            </div>
        }
    </div>
}

@* ---- applications ---- *@
<div class="mb-6">
    @{ var appsPanel = new PanelModel(T["Applications"].Value, Model.AppCount > 0 ? (isFa ? "همه" : "View all") : null, "/apps"); }
    <partial name="Design/_PanelStart" model="appsPanel" />
    @if (Model.Apps.Count == 0)
    {
        var appsEmpty = new EmptyStateModel("boxes",
            isFa ? "هنوز سرویسی ساخته نشده." : "No applications yet.",
            T["Create Application"].Value, "/apps/create");
        <partial name="Design/_EmptyState" model="appsEmpty" />
    }
    else
    {
        <div class="grid gap-4 sm:grid-cols-2">
            @foreach (var app in Model.Apps)
            {
                <a href="/apps/details/@app.Id" class="rounded-xl border border-line bg-surface-2 p-4 transition hover:border-accent">
                    <div class="flex items-center justify-between gap-2">
                        <span class="truncate font-semibold text-ink">@app.Name</span>
                        <partial name="_StatusBadge" model="app.Status" />
                    </div>
                    <div class="mt-1 truncate text-sm text-ink-muted">@app.Slug · @app.SourceType</div>
                    @if (app.PreviewBranch is { } branch)
                    {
                        <div class="mt-1 truncate text-[11px] text-warn">@(isFa ? "پیش‌نمایش" : "preview") · @branch</div>
                    }
                </a>
            }
        </div>
    }
    <partial name="Design/_PanelEnd" />
</div>

@section RightRail {
    @* ---- platform health ---- *@
    @{ var healthPanel = new PanelModel(isFa ? "سلامت پلتفرم" : "Platform health"); }
    <partial name="Design/_PanelStart" model="healthPanel" />
    @{
        (string label, string text, string tone)[] health =
        {
            (T["Servers"].Value,
             $"{Model.ServersOnline}/{Model.ServersTotal}",
             Model.ServersTotal > 0 && Model.ServersOnline == Model.ServersTotal ? Tone.Ok : Tone.Warn),
            ("Traefik",
             Model.TraefikRunning switch
             {
                 true => isFa ? "در حال اجرا" : "running",
                 false => isFa ? "متوقف" : "stopped",
                 _ => isFa ? "نامشخص" : "unknown"
             },
             Model.TraefikRunning switch { true => Tone.Ok, false => Tone.Error, _ => Tone.Idle }),
            ("SSL",
             Model.DomainsTotal == 0
                ? (isFa ? "بدون دامنه" : "no domains")
                : $"{Model.DomainsSsl}/{Model.DomainsTotal}",
             Model.DomainsTotal == 0 ? Tone.Idle : Model.DomainsSsl == Model.DomainsTotal ? Tone.Ok : Tone.Warn),
            ("Docker",
             Model.DockerAvailable ? Model.DockerVersion : (isFa ? "در دسترس نیست" : "unreachable"),
             Model.DockerAvailable ? Tone.Ok : Tone.Error),
        };
    }
    <div class="space-y-3 text-sm">
        @foreach (var h in health)
        {
            <div class="flex items-center justify-between gap-2">
                <span class="text-ink-muted">@h.label</span>
                <partial name="Design/_StatusPill" model="new StatusPillModel(h.text, h.tone)" />
            </div>
        }
    </div>
    <partial name="Design/_PanelEnd" />

    @* ---- resources ---- *@
    @{ var resourcePanel = new PanelModel(isFa ? "منابع" : "Resources", isFa ? "پایش" : "Monitoring", "/monitoring"); }
    <partial name="Design/_PanelStart" model="resourcePanel" />
    <div class="space-y-4">
        <div class="text-accent-text">
            @{ var cpuMetric = new MetricModel(MetricDisplay.For(Model.DockerAvailable ? Model.CpuPercent : null, "%"), T["CPU"].Value); }
            <partial name="Design/_Metric" model="cpuMetric" />
            <div id="metrics-chart" data-name="cpu.percent" data-label="" data-color="#6d4aff" data-height="36" class="mt-1"></div>
        </div>
        @{ var memoryMetric = new MetricModel(MetricDisplay.For(memoryPercent, "%"), T["Memory"].Value); }
        <partial name="Design/_Metric" model="memoryMetric" />
        @{ var diskMetric = new MetricModel(MetricDisplay.For(diskPercent, "%"), T["Disk"].Value); }
        <partial name="Design/_Metric" model="diskMetric" />

        @* Network throughput. Blank until the collector has two comparable samples, which is the
           honest state rather than a zero. *@
        @{ var inMetric = new MetricModel(MetricDisplay.ForThroughput(Model.NetworkInPerSecond), isFa ? "شبکه ورودی" : "Network in"); }
        <partial name="Design/_Metric" model="inMetric" />
        @{ var outMetric = new MetricModel(MetricDisplay.ForThroughput(Model.NetworkOutPerSecond), isFa ? "شبکه خروجی" : "Network out"); }
        <partial name="Design/_Metric" model="outMetric" />
    </div>
    <partial name="Design/_PanelEnd" />

    @* ---- recent deployments ---- *@
    @{ var deployPanel = new PanelModel(T["Recent Deployments"].Value, isFa ? "همه" : "View all", "/deployments"); }
    <partial name="Design/_PanelStart" model="deployPanel" />
    @if (Model.RecentDeployments.Count == 0)
    {
        <p class="text-sm text-ink-faint">@(isFa ? "هنوز استقراری انجام نشده." : "No deployments yet.")</p>
    }
    else
    {
        <div class="-my-2 divide-y divide-line">
            @foreach (var d in Model.RecentDeployments)
            {
                <a href="/deployments/details/@d.Id" class="flex items-center justify-between gap-2 py-2.5">
                    <div class="min-w-0">
                        <div class="truncate text-sm font-medium text-ink">@d.App?.Name #@d.Number</div>
                        <div class="text-xs text-ink-faint">@d.CreatedAt.LocalDateTime.ToString("MM/dd HH:mm")</div>
                    </div>
                    <partial name="_DeployStatusBadge" model="d.Status" />
                </a>
            }
        </div>
    }
    <partial name="Design/_PanelEnd" />

    @* ---- recent errors ---- *@
    @if (Model.RecentErrors.Count > 0)
    {
        var errorPanel = new PanelModel(isFa ? "آخرین خطاها" : "Recent errors");
        <partial name="Design/_PanelStart" model="errorPanel" />
        <div class="-my-2 divide-y divide-line">
            @foreach (var e in Model.RecentErrors)
            {
                <a href="@e.Link" class="block py-2.5">
                    <div class="text-sm font-medium text-danger">@e.Title</div>
                    <div class="truncate text-xs text-ink-muted">@e.Detail</div>
                    <div class="mt-0.5 text-xs text-ink-faint">@e.At.LocalDateTime.ToString("MM/dd HH:mm")</div>
                </a>
            }
        </div>
        <partial name="Design/_PanelEnd" />
    }
}
