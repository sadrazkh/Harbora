@using Harbora.Web.ViewModels
@model LandingViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer T
@{
    Layout = "_LandingLayout";
    ViewData["Title"] = T["Deploy without the ceremony"].Value;
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    string Gb(long bytes) => bytes <= 0 ? T["Unlimited"].Value : $"{bytes / 1024d / 1024 / 1024:0.#} GB";
}

@* ---------------------------------------------------------------- hero *@
<section class="relative overflow-hidden">
    <div class="absolute inset-0 hb-aurora"></div>
    <div class="absolute inset-0 hb-grid"></div>

    <div class="relative mx-auto max-w-6xl px-4 pt-20 pb-16 md:pt-28 md:pb-24">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div class="hb-rise">
                <span class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs text-brand-300">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-400"></span>
                    @T["Self-hosted PaaS · Docker native"]
                </span>

                <h1 class="mt-5 text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.1]">
                    @T["Push your code."]
                    <span class="bg-gradient-to-r from-brand-400 via-brand-300 to-sky-300 bg-clip-text text-transparent">
                        @T["We handle the rest."]
                    </span>
                </h1>

                <p class="mt-5 text-base md:text-lg text-slate-400 leading-relaxed max-w-xl">
                    @T["Deploy from Git, a Dockerfile, a prebuilt image or a static site. Harbora builds it, gives it a domain with automatic SSL, health-checks it, and switches traffic only when the new version is actually up."]
                </p>

                <div class="mt-8 flex flex-wrap items-center gap-3">
                    <a href="/account/login" class="rounded-xl bg-brand-600 hover:bg-brand-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-900/40 transition">
                        @T["Get started"]
                    </a>
                    <a href="#how" class="rounded-xl border border-slate-700 hover:border-slate-600 hover:bg-slate-900/60 px-6 py-3 text-sm font-medium text-slate-200 transition">
                        @T["See how it works"]
                    </a>
                </div>

                <dl class="mt-10 grid grid-cols-3 gap-6 max-w-md">
                    <div>
                        <dt class="text-2xl font-bold text-white">@T["Zero"]</dt>
                        <dd class="text-xs text-slate-500 mt-1">@T["downtime cutover"]</dd>
                    </div>
                    <div>
                        <dt class="text-2xl font-bold text-white">@T["Auto"]</dt>
                        <dd class="text-xs text-slate-500 mt-1">@T["SSL certificates"]</dd>
                    </div>
                    <div>
                        <dt class="text-2xl font-bold text-white">1&nbsp;@T["click"]</dt>
                        <dd class="text-xs text-slate-500 mt-1">@T["instant rollback"]</dd>
                    </div>
                </dl>
            </div>

            @* Terminal mock — shows the actual product vocabulary, not lorem ipsum. *@
            <div class="hb-rise" style="animation-delay:.12s">
                <div class="rounded-2xl border border-slate-800 bg-slate-900/70 hb-card shadow-2xl shadow-black/40 overflow-hidden" dir="ltr">
                    <div class="flex items-center gap-2 px-4 py-3 border-b border-slate-800 bg-slate-900/80">
                        <span class="w-3 h-3 rounded-full bg-red-500/70"></span>
                        <span class="w-3 h-3 rounded-full bg-amber-500/70"></span>
                        <span class="w-3 h-3 rounded-full bg-emerald-500/70"></span>
                        <span class="ms-3 text-xs text-slate-500 font-mono">harbora deploy</span>
                    </div>
                    <pre class="p-5 text-[13px] leading-relaxed font-mono text-slate-300 overflow-x-auto"><code>$ <span class="text-brand-300">harbora deploy</span>
<span class="text-slate-500">→</span> checkout  main@@<span class="text-slate-500">a1b2c3d</span>
<span class="text-slate-500">→</span> build     detected <span class="text-sky-300">Node 22</span>
<span class="text-slate-500">→</span> push      harbora/shop:build-42
<span class="text-slate-500">→</span> deploy    starting alongside <span class="text-slate-500">build-41</span>
<span class="text-slate-500">→</span> health    GET /healthz <span class="text-emerald-400">200 OK</span>
<span class="text-slate-500">→</span> cutover   traffic switched
<span class="text-slate-500">→</span> retire    build-41 removed

<span class="text-emerald-400">✓ live</span>  https://shop.example.com
   <span class="text-slate-500">rollback anytime: harbora rollback 41</span></code></pre>
                </div>
            </div>
        </div>
    </div>
</section>

@* ---------------------------------------------------------------- features *@
<section id="features" class="mx-auto max-w-6xl px-4 py-20">
    <div class="max-w-2xl">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">@T["Everything a deploy needs"]</h2>
        <p class="mt-4 text-slate-400 leading-relaxed">@T["Not a thin wrapper over docker run — the parts that are tedious to get right are the parts Harbora owns."]</p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var f in Model.Features)
        {
            <div class="group rounded-2xl border border-slate-800 bg-slate-900/40 p-6 hover:border-slate-700 hover:bg-slate-900/70 transition">
                <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-700/10 border border-brand-500/20 grid place-items-center text-xl">
                    @f.Icon
                </div>
                <h3 class="mt-4 font-semibold text-white">@T[f.Title]</h3>
                <p class="mt-2 text-sm text-slate-400 leading-relaxed">@T[f.Body]</p>
            </div>
        }
    </div>
</section>

@* ---------------------------------------------------------------- how it works *@
<section id="how" class="relative border-y border-slate-800/60 bg-slate-900/20">
    <div class="mx-auto max-w-6xl px-4 py-20">
        <div class="max-w-2xl">
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">@T["Three steps to production"]</h2>
            <p class="mt-4 text-slate-400 leading-relaxed">@T["From an empty server to a running app with a valid certificate."]</p>
        </div>

        <ol class="mt-12 grid gap-6 md:grid-cols-3">
            @{ var stepNo = 0; }
            @foreach (var s in Model.Steps)
            {
                stepNo++;
                <li class="relative rounded-2xl border border-slate-800 bg-slate-950/60 p-6">
                    <span class="absolute -top-3 @(isFa ? "right-6" : "left-6") inline-grid place-items-center w-7 h-7 rounded-full bg-brand-600 text-white text-xs font-bold">@stepNo</span>
                    <h3 class="mt-2 font-semibold text-white">@T[s.Title]</h3>
                    <p class="mt-2 text-sm text-slate-400 leading-relaxed">@T[s.Body]</p>
                </li>
            }
        </ol>
    </div>
</section>

@* ---------------------------------------------------------------- plans *@
<section id="plans" class="mx-auto max-w-6xl px-4 py-20">
    <div class="max-w-2xl">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">@T["Plans"]</h2>
        <p class="mt-4 text-slate-400 leading-relaxed">@T["Quotas are enforced by the platform, not by trust."]</p>
    </div>

    @if (Model.Plans.Count == 0)
    {
        <div class="mt-10 rounded-2xl border border-slate-800 bg-slate-900/40 p-8 text-sm text-slate-400">
            @T["No plans have been published yet."]
        </div>
    }
    else
    {
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var (plan, index) in Model.Plans.Select((p, i) => (p, i)))
            {
                var featured = index == 1 && Model.Plans.Count > 2;
                <div class="relative rounded-2xl border @(featured ? "border-brand-500/50 bg-gradient-to-b from-brand-500/10 to-slate-900/40" : "border-slate-800 bg-slate-900/40") p-6 flex flex-col">
                    @if (featured)
                    {
                        <span class="absolute -top-3 @(isFa ? "left-6" : "right-6") rounded-full bg-brand-600 px-3 py-1 text-[11px] font-medium text-white">@T["Popular"]</span>
                    }
                    <h3 class="font-semibold text-white text-lg">@(isFa && !string.IsNullOrWhiteSpace(plan.NameFa) ? plan.NameFa : plan.Name)</h3>

                    <div class="mt-4 flex items-baseline gap-1">
                        @if (plan.MonthlyPrice <= 0)
                        {
                            <span class="text-3xl font-bold text-white">@T["Free"]</span>
                        }
                        else
                        {
                            <span class="text-3xl font-bold text-white">@plan.MonthlyPrice.ToString("0.##")</span>
                            <span class="text-sm text-slate-500">/ @T["month"]</span>
                        }
                    </div>

                    <ul class="mt-6 space-y-3 text-sm text-slate-400 flex-1">
                        <li class="flex items-center gap-2">
                            <span class="text-brand-400">✓</span>
                            @(plan.MaxApps <= 0 ? T["Unlimited apps"].Value : $"{plan.MaxApps} {T["apps"].Value}")
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="text-brand-400">✓</span>
                            @(plan.MaxServices <= 0 ? T["Unlimited databases"].Value : $"{plan.MaxServices} {T["databases"].Value}")
                        </li>
                        <li class="flex items-center gap-2"><span class="text-brand-400">✓</span> @Gb(plan.MaxMemoryBytes) @T["memory"]</li>
                        <li class="flex items-center gap-2"><span class="text-brand-400">✓</span> @Gb(plan.MaxDiskBytes) @T["disk"]</li>
                        <li class="flex items-center gap-2"><span class="text-brand-400">✓</span> @T["Automatic SSL & backups"]</li>
                    </ul>

                    <a href="/account/login" class="mt-6 rounded-xl @(featured ? "bg-brand-600 hover:bg-brand-500 text-white" : "border border-slate-700 hover:border-slate-600 text-slate-200") px-4 py-2.5 text-sm font-medium text-center transition">
                        @T["Get started"]
                    </a>
                </div>
            }
        </div>
    }
</section>

@* ---------------------------------------------------------------- faq *@
<section id="faq" class="border-t border-slate-800/60 bg-slate-900/20">
    <div class="mx-auto max-w-3xl px-4 py-20">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">@T["Questions"]</h2>
        <div class="mt-10 divide-y divide-slate-800 border-y border-slate-800">
            @foreach (var q in Model.Faqs)
            {
                <details class="group py-5">
                    <summary class="flex cursor-pointer items-center justify-between gap-4 font-medium text-slate-100 list-none">
                        @T[q.Question]
                        <span class="text-slate-500 transition group-open:rotate-45 text-xl leading-none">+</span>
                    </summary>
                    <p class="mt-3 text-sm text-slate-400 leading-relaxed">@T[q.Answer]</p>
                </details>
            }
        </div>
    </div>
</section>

@* ---------------------------------------------------------------- cta *@
<section class="mx-auto max-w-6xl px-4 py-20">
    <div class="relative overflow-hidden rounded-3xl border border-slate-800 bg-slate-900/50 p-10 md:p-14 text-center">
        <div class="absolute inset-0 hb-aurora opacity-70"></div>
        <div class="relative">
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">@T["Ready to deploy?"]</h2>
            <p class="mt-4 text-slate-400 max-w-xl mx-auto leading-relaxed">
                @T["Sign in to the panel and put your first app live in about a minute."]
            </p>
            <a href="/account/login" class="mt-8 inline-block rounded-xl bg-brand-600 hover:bg-brand-500 px-8 py-3.5 text-sm font-semibold text-white shadow-lg shadow-brand-900/40 transition">
                @T["Get started"]
            </a>
        </div>
    </div>
</section>
