@using Harbora.Web.ViewModels
@model AuditPageViewModel
@{
    string Query(int page) =>
        $"/audit?page={page}&action={Uri.EscapeDataString(Model.ActionFilter ?? "")}&actor={Uri.EscapeDataString(Model.ActorFilter ?? "")}";
}

<div class="flex items-center justify-between mb-4">
    <div>
        <h1 class="text-xl font-semibold">@T["Audit Log"]</h1>
        <p class="text-sm text-ink-muted">@T["Privileged actions across the platform, newest first."]</p>
    </div>
    <a href="/audit/export?action=@Uri.EscapeDataString(Model.ActionFilter ?? "")&actor=@Uri.EscapeDataString(Model.ActorFilter ?? "")"
       class="rounded-lg bg-surface-2 hover:bg-surface-2 px-4 py-2 text-sm">@T["Export CSV"]</a>
</div>

<form method="get" action="/audit" class="flex flex-wrap gap-2 mb-4">
    <select name="action" class="rounded-lg bg-surface border border-line px-3 py-2 text-sm">
        <option value="">@T["All actions"]</option>
        @foreach (var a in Model.Actions)
        {
            <option value="@a" selected="@(a == Model.ActionFilter)">@a</option>
        }
    </select>
    <input type="text" name="actor" value="@Model.ActorFilter" placeholder="@T["Actor email"]"
           class="rounded-lg bg-surface border border-line px-3 py-2 text-sm" />
    <button class="rounded-lg bg-surface-2 hover:bg-surface-2 px-4 py-2 text-sm">@T["Filter"]</button>
</form>

<section class="rounded-xl border border-line bg-surface overflow-hidden">
    @if (Model.Entries.Count == 0)
    {
        <div class="p-6 text-ink-muted text-sm">@T["No audit entries match this filter."]</div>
    }
    else
    {
        <table class="w-full text-sm">
            <thead class="text-xs uppercase tracking-wide text-ink-faint border-b border-line">
                <tr>
                    <th class="text-start px-4 py-2">@T["When"]</th>
                    <th class="text-start px-4 py-2">@T["Actor"]</th>
                    <th class="text-start px-4 py-2">@T["Action"]</th>
                    <th class="text-start px-4 py-2">@T["Target"]</th>
                    <th class="text-start px-4 py-2">@T["IP"]</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-line">
                @foreach (var e in Model.Entries)
                {
                    <tr>
                        <td class="px-4 py-2 whitespace-nowrap text-ink-muted">@e.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td class="px-4 py-2">@e.ActorEmail</td>
                        <td class="px-4 py-2"><code class="text-xs">@e.Action</code></td>
                        <td class="px-4 py-2 text-ink-muted text-xs">
                            @if (e.TargetType is not null)
                            {
                                @e.TargetType<text> </text><span class="font-mono">@(e.TargetId?[..Math.Min(8, e.TargetId.Length)])</span>
                            }
                            else { <text>—</text> }
                        </td>
                        <td class="px-4 py-2 text-ink-faint font-mono text-xs">@(e.IpAddress ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@if (Model.TotalPages > 1)
{
    <div class="flex items-center justify-between mt-4 text-sm">
        <span class="text-ink-faint">@T["Page"] @Model.Page / @Model.TotalPages · @Model.TotalCount @T["entries"]</span>
        <div class="flex gap-2">
            @if (Model.HasPrevious)
            {
                <a href="@Query(Model.Page - 1)" class="rounded-lg bg-surface-2 hover:bg-surface-2 px-3 py-1">@T["Previous"]</a>
            }
            @if (Model.HasNext)
            {
                <a href="@Query(Model.Page + 1)" class="rounded-lg bg-surface-2 hover:bg-surface-2 px-3 py-1">@T["Next"]</a>
            }
        </div>
    </div>
}
