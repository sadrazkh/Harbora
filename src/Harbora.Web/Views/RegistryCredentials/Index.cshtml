@model RegistryCredentialsPageViewModel
@{
    var isFa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var message = TempData["Message"] as string;
    var error = TempData["Error"] as string;
}

<partial name="Design/_PageHeader" model="@(new PageHeaderModel(
    isFa ? "اعتبارنامه‌های رجیستری خصوصی" : "Private registry credentials",
    isFa
        ? "برای اپ‌هایی با تصویر از یک رجیستری خصوصی (Harbor خودتان، یک مخزن خصوصی در Docker Hub، GHCR یا هر رجیستری دیگری که بدون احراز هویت پاسخ نمی‌دهد)، نام کاربری و رمز را اینجا ذخیره کنید. رمز رمزنگاری‌شده ذخیره می‌شود و هرگز پس از ذخیره به‌صورت خوانا برنمی‌گردد. تطبیق خودکار و بر اساس میزبان رجیستری است: هنگام استقرار، Harbora میزبان تصویر تنظیم‌شدهٔ اپ را می‌خواند و اگر اعتبارنامه‌ای دقیقاً برای همان میزبان در این ورک‌اسپیس ثبت شده باشد از آن استفاده می‌کند. هر ورک‌اسپیس حداکثر یک اعتبارنامه برای هر میزبان می‌تواند داشته باشد — پس هرگز بین چند اعتبارنامه انتخابی انجام نمی‌شود، فقط «هست» یا «نیست»."
        : "For an app whose image lives on a private registry — your own Harbor, a private Docker Hub repository, GHCR, or any other registry that refuses an anonymous pull — store a username and secret here. The secret is stored encrypted and never comes back in readable form once saved. Matching is automatic and by registry host: at deploy time, Harbora reads the app's configured image's registry host and uses whichever credential in this workspace is stored for that exact host. A workspace may have at most one credential per host, so this is never a choice between several candidates — only whether one exists or not."))" />

@if (message is not null) { <div class="alert-success mb-4">@message</div> }
@if (error is not null) { <div class="alert-danger mb-4">@error</div> }

@if (Model.Credentials.Count == 0)
{
    <partial name="Design/_EmptyState" model="@(new EmptyStateModel("lock",
        isFa ? "هنوز اعتبارنامه‌ای اضافه نشده." : "No registry credentials yet."))" />
}
else
{
    <div class="mb-6 space-y-3">
        @foreach (var cred in Model.Credentials)
        {
            <section class="rounded-xl border border-line bg-surface p-5 shadow-panel" data-registry-credential="@cred.RegistryHost" data-registry-credential-id="@cred.Id">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0">
                        <strong class="text-sm text-ink font-mono" dir="ltr">@cred.RegistryHost</strong>
                        <p class="mt-1 text-xs text-ink-faint">
                            @(isFa ? "به‌روزرسانی شده:" : "Last saved:") @cred.UpdatedAt.LocalDateTime.ToString(Dates.Stamp)
                        </p>
                    </div>
                    <form asp-action="Delete" asp-route-id="@cred.Id" method="post"
                          onsubmit="return confirm('@(isFa ? "این اعتبارنامه حذف شود؟" : "Delete this credential?")');">
                        @Html.AntiForgeryToken()
                        <button class="btn-secondary px-3 py-1.5 text-xs">@(isFa ? "حذف" : "Delete")</button>
                    </form>
                </div>

                <dl class="mt-4 grid gap-3 border-t border-line pt-3 text-xs sm:grid-cols-2">
                    <div>
                        <dt class="text-ink-faint">@(isFa ? "نام کاربری" : "Username")</dt>
                        <dd class="text-ink" dir="ltr"><code>@(string.IsNullOrEmpty(cred.Username) ? "—" : cred.Username)</code></dd>
                    </div>
                    <div>
                        <dt class="text-ink-faint">@(isFa ? "رمز/توکن" : "Secret / token")</dt>
                        <dd class="text-ink" dir="ltr">
                            @if (cred.Secret is { } secret)
                            {
                                <code>@secret</code>
                            }
                            else
                            {
                                @* One at a time, and only on a click — the EmailProviders/StorageController rule. *@
                                <a href="/registry-credentials?reveal=@cred.Id" class="text-accent-text hover:underline">
                                    @(isFa ? "نمایش" : "Reveal")
                                </a>
                            }
                        </dd>
                    </div>
                </dl>

                @* Rotation: the host is fixed (it is what a pull is matched by), but the username and
                   secret can be changed here at any time. A blank secret leaves the stored one alone —
                   the same "blank means unchanged" rule the backup destinations' secret key follows. *@
                <details class="mt-4 border-t border-line pt-3">
                    <summary class="cursor-pointer text-xs font-semibold text-ink-muted select-none">
                        @(isFa ? "چرخش نام کاربری/رمز" : "Rotate username / secret")
                    </summary>
                    <form asp-action="Update" asp-route-id="@cred.Id" method="post" class="mt-3 grid gap-3 sm:grid-cols-2">
                        @Html.AntiForgeryToken()
                        <div>
                            <label class="form-label" for="rc-user-@cred.Id">@(isFa ? "نام کاربری" : "Username")</label>
                            <input id="rc-user-@cred.Id" name="username" value="@cred.Username" class="form-control font-mono" dir="ltr" />
                        </div>
                        <div>
                            <label class="form-label" for="rc-secret-@cred.Id">@(isFa ? "رمز/توکن جدید" : "New secret / token")</label>
                            <input id="rc-secret-@cred.Id" name="secret" type="password" autocomplete="new-password"
                                   class="form-control font-mono" dir="ltr"
                                   placeholder="@(isFa ? "ذخیره‌شده — برای تغییر بنویسید" : "stored — type to change")" />
                        </div>
                        <div class="sm:col-span-2">
                            <button class="btn-secondary px-4 py-2 text-xs">@(isFa ? "ذخیره" : "Save")</button>
                        </div>
                    </form>
                </details>
            </section>
        }
    </div>
}

<section class="rounded-xl border border-line bg-surface p-5">
    <h2 class="text-[15px] font-semibold text-ink mb-3">@(isFa ? "اعتبارنامهٔ جدید" : "New credential")</h2>

    <form asp-action="Create" method="post" class="grid gap-4 sm:grid-cols-2">
        @Html.AntiForgeryToken()
        <div class="sm:col-span-2">
            <label class="form-label" for="rc-host">@(isFa ? "میزبان رجیستری" : "Registry host")</label>
            <input id="rc-host" name="registryHost" required class="form-control font-mono" dir="ltr"
                   placeholder="ghcr.io" />
            <p class="mt-1 text-[11px] text-ink-faint">
                @(isFa
                    ? "دقیقاً همان میزبانی که در تصویر ظاهر می‌شود — مثلاً ghcr.io، registry.example.com:5000، یا docker.io برای یک مخزن خصوصی در Docker Hub."
                    : "The exact host that appears in the image reference — e.g. ghcr.io, registry.example.com:5000, or docker.io for a private Docker Hub repository.")
            </p>
        </div>
        <div>
            <label class="form-label" for="rc-new-user">@(isFa ? "نام کاربری" : "Username")</label>
            <input id="rc-new-user" name="username" class="form-control font-mono" dir="ltr" />
        </div>
        <div>
            <label class="form-label" for="rc-new-secret">@(isFa ? "رمز/توکن" : "Secret / token")</label>
            <input id="rc-new-secret" name="secret" type="password" required class="form-control font-mono" dir="ltr" autocomplete="new-password" />
        </div>

        <div class="sm:col-span-2">
            <button class="btn-primary px-4 py-2">@(isFa ? "ساخت اعتبارنامه" : "Create credential")</button>
        </div>
    </form>
</section>
