<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Harbora.Application\Harbora.Application.csproj" />
    <ProjectReference Include="..\Harbora.Infrastructure\Harbora.Infrastructure.csproj" />
    <ProjectReference Include="..\Harbora.Data\Harbora.Data.csproj" />
    <ProjectReference Include="..\Harbora.Domain\Harbora.Domain.csproj" />
    <ProjectReference Include="..\Harbora.Shared\Harbora.Shared.csproj" />
    <ProjectReference Include="..\Modules\Backup\Harbora.Modules.Backup.Infrastructure\Harbora.Modules.Backup.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Sync\Harbora.Modules.Sync.Infrastructure\Harbora.Modules.Sync.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- So tests/Harbora.Tests can validate the seeded catalogue (DbSeeder.BuiltInTemplates) the
         same way ReadyAppCatalogTests validates the other one, against the real data rather than a
         copy that could drift from it. -->
    <InternalsVisibleTo Include="Harbora.Tests" />
  </ItemGroup>

</Project>
