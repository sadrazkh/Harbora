<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Harbora.Application\Harbora.Application.csproj" />
    <ProjectReference Include="..\Harbora.Domain\Harbora.Domain.csproj" />
    <ProjectReference Include="..\Harbora.Data\Harbora.Data.csproj" />
    <ProjectReference Include="..\Harbora.NodeAgent.Contracts\Harbora.NodeAgent.Contracts.csproj" />
    <ProjectReference Include="..\Harbora.Shared\Harbora.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.100.2" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <!-- Docker.DotNet 3.125.15 (abandoned 2022) is unusable against the live Docker 29.7.2 daemon:
         seven consecutive deployments died mid-build-context-upload with a broken pipe. Docker 29
         support landed in Docker.DotNet.Enhanced (the Testcontainers team's maintained fork) in
         3.131.0, and that release regenerated the model classes — the API break IS the Docker 29
         support, so there is no version that is both drop-in and Docker-29-aware. The fork ships an
         assembly also called Docker.DotNet with the same root namespaces, so this is a package swap,
         not a namespace migration. See tests/Harbora.Postgres.Tests's own comment: it already pulls
         this exact fork in transitively via Testcontainers.PostgreSql, and the build unifies on it. -->
    <PackageReference Include="Docker.DotNet.Enhanced" Version="3.131.1" />
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <!-- Renders the tutorial chapters in docs/tutorial to HTML. No markdown renderer existed in this
         solution before the Learning Centre; this is the standard .NET choice. -->
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageReference Include="StackExchange.Redis" Version="3.0.11" />
    <PackageReference Include="Tomlyn" Version="0.17.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test project reaches into internals rather than widening the public surface for tests. -->
    <InternalsVisibleTo Include="Harbora.Tests" />
  </ItemGroup>

</Project>
