<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately references nothing. This is what an engine adapter, an out-of-process agent or a
    future replacement for Kopia compiles against, so a dependency added here is a dependency
    imposed on all of them.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Harbora.Modules.Backup.Contracts</RootNamespace>
  </PropertyGroup>

</Project>
